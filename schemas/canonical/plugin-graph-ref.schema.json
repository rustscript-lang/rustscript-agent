{
  "$id": "https://schemas.rustscript.local/v1/plugin-graph-ref.schema.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A durable reference that keeps one exact graph lock from unreferenced collection. It does not pin a live run, enable hot reload, or authorize a tool call. owner_kind is only run or checkpoint.\n",
  "properties": {
    "graph_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "owner_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "owner_kind": {
      "enum": [
        "run",
        "checkpoint"
      ],
      "type": "string"
    },
    "ref_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "graph_id",
    "owner_kind",
    "owner_id",
    "ref_id"
  ],
  "title": "RustScript plugin graph retention reference",
  "type": "object"
}
