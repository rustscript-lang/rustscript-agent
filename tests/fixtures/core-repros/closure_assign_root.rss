// ROOT module probe: a closure that BY-VALUE-USES a captured movable local.
// In RustScript's move semantics the by-value read inside the closure body
// is a move, so `CaptureBindingMode::Move` forces the source slot and the
// external use of `state` after the closure is rejected at compile time with
// `local 'state' was moved earlier; use 'state.copy()' to copy it before
// moving`. This rejection is intentionally preserved after the A3 core
// fixes (core revision fd4b570): B3 shares MUTATION captures through
// `BorrowMut` cells, while pure by-value reads keep their move semantics.
// The streaming adapter therefore aggregates through assignment to captured
// mutable locals (`state = state + delta`), not by-value reads.
pub fn run(context: map) -> map {
    let state: string = "";
    let sink = |item| {
        { action: "continue", text: state }
    };
    let _ = sink({});
    { kind: "ok", text: state }
}
