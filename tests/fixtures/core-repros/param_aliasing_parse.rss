// Shared parse helpers for the fd4b570 slot-aliasing repro pair. Mirrors
// the openai_chat.rss parse chain shapes (2-param context forms). The
// trigger is caller-side, so these callees are identical in both probes.
use json;
use self::chain_m1 as types;

pub fn usage_new(input_tokens: int, output_tokens: int, total_tokens: int) -> map {
    { input_tokens: input_tokens, output_tokens: output_tokens, total_tokens: total_tokens }
}

pub fn tool_call_new(id: string, name: string, arguments: map) -> map {
    { id: id, name: name, arguments: arguments }
}

pub fn response_new(text: string, tool_calls: array, usage: map, reasoning: string, stop_reason: string) -> map {
    { text: text, tool_calls: tool_calls, usage: usage, reasoning: reasoning, stop_reason: stop_reason }
}

pub fn error_new(status: int, error_type: string, code: string, message: string, param: string, request_id: string) -> map {
    { status: status, type: error_type, code: code, message: message, param: param, request_id: request_id }
}

pub fn error_malformed(status: int, message: string) -> map {
    error_new(status, "malformed_payload", "malformed_payload", message, "", "")
}

pub fn ok(response: map) -> map {
    { ok: true, response: response, error: {} }
}

pub fn fail(error: map) -> map {
    { ok: false, response: {}, error: error }
}

pub fn chat_parse_response_body(body: map, status: int, provider: string) -> map {
    let choices: array = types::request_array(body, "choices");
    if choices.length > 0 => {
        chat_parse_first_choice(choices, {
            body: body,
            status: status,
            provider: provider
        })
    } else => {
        fail(error_malformed(status, "chat completion response is missing 'choices'"))
    }
}

pub fn chat_parse_first_choice(choices: array, ctx: map) -> map {
    let first: map = types::array_entry(choices, 0);
    let stop_reason: string = types::request_string(first, "finish_reason");
    let body: map = types::request_map(ctx, "body");
    let status: int = types::request_int(ctx, "status", 0);
    let usage: map = types::request_map(body, "usage");
    let usage_input: int = types::request_int(usage, "prompt_tokens", 0);
    let usage_output: int = types::request_int(usage, "completion_tokens", 0);
    let usage_total: int = types::request_int(usage, "total_tokens", 0);
    let message: map = types::request_map(first, "message");
    let result: map = if first.has("message") => {
        let tool_calls: array = types::request_array(message, "tool_calls");
        chat_parse_message(message, {
            stop_reason: stop_reason,
            usage_input: usage_input,
            usage_output: usage_output,
            usage_total: usage_total,
            tool_calls: tool_calls,
            provider: types::request_string(ctx, "provider")
        })
    } else => {
        fail(error_malformed(status, "chat completion response is missing 'choices[0].message'"))
    };
    result
}

pub fn chat_parse_message(message: map, ctx: map) -> map {
    let content: string = chat_message_text(message);
    let reasoning: string = types::request_string(message, "reasoning_content");
    let stop_reason: string = types::request_string(ctx, "stop_reason");
    let usage_input: int = types::request_int(ctx, "usage_input", 0);
    let usage_output: int = types::request_int(ctx, "usage_output", 0);
    let usage_total: int = types::request_int(ctx, "usage_total", 0);
    let tool_calls: array = types::request_array(ctx, "tool_calls");
    let calls: array = chat_parse_tool_calls(tool_calls);
    ok(response_new(content, calls, usage_new(usage_input, usage_output, usage_total), reasoning, stop_reason))
}

pub fn chat_message_text(message: map) -> string {
    let direct: string = types::request_string(message, "content");
    let mut text: string = direct;
    if type(message["content"]) == "array" {
        let parts: array = message["content"];
        let mut joined: string = "";
        let mut i = 0;
        while i < parts.length {
            let part: map = types::array_entry(parts, i);
            let part_type: string = types::request_string(part, "type");
            if part_type == "text" {
                joined = joined + types::request_string(part, "text");
            }
            if part_type == "output_text" {
                joined = joined + types::request_string(part, "text");
            }
            i += 1;
        }
        text = joined;
    }
    text
}

pub fn chat_parse_tool_calls(tool_calls: array) -> array {
    let mut calls: array = [];
    let mut i = 0;
    while i < tool_calls.length {
        let call: map = types::array_entry(tool_calls, i);
        if call.has("id") {
            let id: string = types::request_string(call, "id");
            let function: map = types::request_map(call, "function");
            let name: string = types::request_string(function, "name");
            let args_text: string = types::request_string(function, "arguments");
            let mut args: map = {};
            if args_text != "" {
                let decoded: map = json::decode(args_text);
                args = decoded;
            }
            calls[calls.length] = tool_call_new(id, name, args);
        }
        i += 1;
    }
    calls
}
