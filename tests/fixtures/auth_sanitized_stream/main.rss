// Attempt one stream start with a caller-supplied body and publish the one-shot
// access handle for a later retry, so a denied attempt can be checked for
// unchanged cleanup at the caller.
pub fn stream_post_body_probe_result(
    credential_id: string,
    generation: int,
    path: string,
    body: string,
    markers: array<string>,
    policy: resource<auth.policy>
) -> StreamLimitView {
    let issued: AccessHandleResultEnvelope =
        auth::access_handle_result(credential_id, generation, &policy);
    let ok: bool = issued.ok;
    let code: string = failure_code(issued.error);
    match issued.value {
        None => { ok: false, code: code, handle: None },
        Some(inner) => if !ok || code != "" => {
            { ok: false, code: code, handle: None }
        } else => {
            let handle: resource<auth.access> = inner.handle;
            let request: TransportPublicRequest = post_request(policy, credential_id, path, body);
            let usage: TransportCredentialUse = {
                kind: "access",
                access_handle: Some(handle),
                refresh_handle: None,
                code_handle: None,
                verifier_handle: None,
                device_handle: None
            };
            let started: OAuthStreamStartResultEnvelope =
                oauth::stream_start_result(&request, &usage, markers);
            let started_ok: bool = started.ok;
            let started_code: string = failure_code(started.error);
            { ok: started_ok, code: started_code, handle: usage.access_handle }
        }
    }
}

// Retry the same published one-shot access handle with an admitted body.
pub fn stream_with_access_body_first_json_result(
    access: resource<auth.access>,
    credential_id: string,
    path: string,
    body: string,
    markers: array<string>,
    policy: resource<auth.policy>
) -> StreamFirstView {
    let request: TransportPublicRequest = post_request(policy, credential_id, path, body);
    let usage: TransportCredentialUse = {
        kind: "access",
        access_handle: Some(access),
        refresh_handle: None,
        code_handle: None,
        verifier_handle: None,
        device_handle: None
    };
    let started: OAuthStreamStartResultEnvelope =
        oauth::stream_start_result(&request, &usage, markers);
    let start_ok: bool = started.ok;
    let start_code: string = failure_code(started.error);
    match started.value {
        None => { ok: false, code: start_code, status: 0, content_type: "", read_ok: false, read_code: "", kind: "", json: "", literal_index: -1, close_ok: false },
        Some(envelope) => if !start_ok || start_code != "" => {
            { ok: false, code: start_code, status: 0, content_type: "", read_ok: false, read_code: "", kind: "", json: "", literal_index: -1, close_ok: false }
        } else => {
            let stream: resource<oauth.stream> = envelope.stream;
            let head: OAuthStreamHead = envelope.head;
            let status: int = head.status;
            let content_type: string = head.content_type.copy();
            oauth::stream_close(stream);
            {
                ok: true,
                code: "",
                status: status,
                content_type: content_type,
                read_ok: false,
                read_code: "",
                kind: "",
                json: "",
                literal_index: -1,
                close_ok: true
            }
        }
    }
}

// Open the stream and return the live typed resource so host-driven lifecycle
// tests can cancel, expire or read via separate guest callables.
pub fn stream_open_result(
    credential_id: string,
    generation: int,
    path: string,
    markers: array<string>,
    policy: resource<auth.policy>
) -> StreamOpenView {
    let issued: AccessHandleResultEnvelope =
        auth::access_handle_result(credential_id, generation, &policy);
    let issued_ok: bool = issued.ok;
    let issued_failed: bool = match issued.error { Some(_) => true, None => false };
    match issued.value {
        None => { ok: false, code: "access_unavailable", status: 0, content_type: "", stream: None },
        Some(inner) => if !issued_ok || issued_failed => {
            { ok: false, code: "access_unavailable", status: 0, content_type: "", stream: None }
        } else => {
            let handle: resource<auth.access> = inner.handle;
            let request: TransportPublicRequest = get_request(policy, credential_id, path);
            let usage: TransportCredentialUse = {
                kind: "access",
                access_handle: Some(handle),
                refresh_handle: None,
                code_handle: None,
                verifier_handle: None,
                device_handle: None
            };
            let started: OAuthStreamStartResultEnvelope =
                oauth::stream_start_result(&request, &usage, markers);
            let start_ok: bool = started.ok;
            let start_code: string = failure_code(started.error);
            match started.value {
                None => { ok: false, code: start_code, status: 0, content_type: "", stream: None },
                Some(envelope) => if !start_ok || start_code != "" => {
                    { ok: false, code: start_code, status: 0, content_type: "", stream: None }
                } else => {
                    let stream: resource<oauth.stream> = envelope.stream;
                    let head: OAuthStreamHead = envelope.head;
                    {
                        ok: true,
                        code: "",
                        status: head.status,
                        content_type: head.content_type.copy(),
                        stream: Some(stream)
                    }
                }
            }
        }
    }
}

// Read one record from an already-open live stream inside this callable.
pub fn stream_read_one_result(stream: resource<oauth.stream>) -> RecordParts {
    read_parts(oauth::stream_read_result(&stream))
}

// Explicit typed close of an open stream.
pub fn stream_close(stream: resource<oauth.stream>) -> () {
    oauth::stream_close(stream)
}

// A rejected attempt (invalid public markers) must not consume the access
// credential; the same live usage/request is reused for an accepted start.
pub fn stream_marker_retry_result(
    credential_id: string,
    generation: int,
    path: string,
    markers_bad: array<string>,
    markers_good: array<string>,
    policy: resource<auth.policy>
) -> StreamRetryView {
    let issued: AccessHandleResultEnvelope =
        auth::access_handle_result(credential_id, generation, &policy);
    let issued_ok: bool = issued.ok;
    let issued_failed: bool = match issued.error { Some(_) => true, None => false };
    match issued.value {
        None => { reject_ok: false, reject_code: "access_unavailable", retry_ok: false, retry_code: "", retry_status: 0 },
        Some(inner) => if !issued_ok || issued_failed => {
            { reject_ok: false, reject_code: "access_unavailable", retry_ok: false, retry_code: "", retry_status: 0 }
        } else => {
            let handle: resource<auth.access> = inner.handle;
            let request: TransportPublicRequest = get_request(policy, credential_id, path);
            let usage: TransportCredentialUse = {
                kind: "access",
                access_handle: Some(handle),
                refresh_handle: None,
                code_handle: None,
                verifier_handle: None,
                device_handle: None
            };
            let rejected: OAuthStreamStartResultEnvelope =
                oauth::stream_start_result(&request, &usage, markers_bad);
            let reject_ok: bool = rejected.ok;
            let reject_code: string = failure_code(rejected.error);
            let retried: OAuthStreamStartResultEnvelope =
                oauth::stream_start_result(&request, &usage, markers_good);
            let retry_ok: bool = retried.ok;
            let retry_code: string = failure_code(retried.error);
            match retried.value {
                None => { reject_ok: reject_ok, reject_code: reject_code, retry_ok: false, retry_code: retry_code, retry_status: 0 },
                Some(envelope) => if !retry_ok || retry_code != "" => {
                    { reject_ok: reject_ok, reject_code: reject_code, retry_ok: false, retry_code: retry_code, retry_status: 0 }
                } else => {
                    let stream: resource<oauth.stream> = envelope.stream;
                    let head: OAuthStreamHead = envelope.head;
                    let status: int = head.status;
                    oauth::stream_close(stream);
                    { reject_ok: reject_ok, reject_code: reject_code, retry_ok: true, retry_code: "", retry_status: status }
                }
            }
        }
    }
}

// Issue one real access capability into the live execution scope. The harness
// calls this repeatedly to fill the scope up to the existing host limit.
pub fn stream_limit_step(
    credential_id: string,
    generation: int,
    policy: resource<auth.policy>
) -> StreamLimitView {
    let issued: AccessHandleResultEnvelope =
        auth::access_handle_result(credential_id, generation, &policy);
    let ok: bool = issued.ok;
    let code: string = failure_code(issued.error);
    match issued.value {
        None => { ok: false, code: code, handle: None },
        Some(inner) => if !ok || code != "" => {
            { ok: false, code: code, handle: None }
        } else => {
            { ok: true, code: "", handle: Some(inner.handle) }
        }
    }
}

// Release one real issued access capability, freeing exactly one live slot.
pub fn stream_release_result(access: resource<auth.access>) -> () {
    auth::close_access(access)
}

// With the scope already full, attempt to publish one stream. The real host
// resource limit must reject publication with resource_limit and the reader
// started for the attempt must be cancelled and released; no stream resource
// is exposed.
pub fn stream_publication_probe(
    credential_id: string,
    generation: int,
    path: string,
    markers: array<string>,
    policy: resource<auth.policy>
) -> StreamLimitView {
    let issued: AccessHandleResultEnvelope =
        auth::access_handle_result(credential_id, generation, &policy);
    match issued.value {
        None => { ok: false, code: "access_unavailable", handle: None },
        Some(inner) => probe_publication(inner.handle, policy, credential_id, path, markers)
    }
}

fn probe_publication(
    handle: resource<auth.access>,
    policy: resource<auth.policy>,
    credential_id: string,
    path: string,
    markers: array<string>
) -> StreamLimitView {
    let request: TransportPublicRequest = get_request(policy, credential_id, path);
    let usage: TransportCredentialUse = {
        kind: "access",
        access_handle: Some(handle),
        refresh_handle: None,
        code_handle: None,
        verifier_handle: None,
        device_handle: None
    };
    let started: OAuthStreamStartResultEnvelope =
        oauth::stream_start_result(&request, &usage, markers);
    let ok: bool = started.ok;
    let code: string = failure_code(started.error);
    { ok: ok, code: code, handle: None }
}

pub fn stream_refresh_usage_then_access_result(
    credential_id: string,
    generation: int,
    path: string,
    markers: array<string>,
    policy: resource<auth.policy>
) -> StreamRetryView {
    let refresh_issued: RefreshHandleResultEnvelope =
        auth::refresh_handle_result(credential_id, generation, &policy);
    let access_issued: AccessHandleResultEnvelope =
        auth::access_handle_result(credential_id, generation, &policy);
    let access_ok: bool = access_issued.ok;
    let access_failed: bool = match access_issued.error { Some(_) => true, None => false };
    match refresh_issued.value {
        None => { reject_ok: false, reject_code: "access_unavailable", retry_ok: false, retry_code: "", retry_status: 0 },
        Some(refresh_inner) => match access_issued.value {
            None => { reject_ok: false, reject_code: "access_unavailable", retry_ok: false, retry_code: "", retry_status: 0 },
            Some(access_inner) => if !access_ok || access_failed => {
                { reject_ok: false, reject_code: "access_unavailable", retry_ok: false, retry_code: "", retry_status: 0 }
            } else => {
                let request: TransportPublicRequest = get_request(policy, credential_id, path);
                let reject_usage: TransportCredentialUse = {
                    kind: "refresh",
                    access_handle: None,
                    refresh_handle: Some(refresh_inner.handle),
                    code_handle: None,
                    verifier_handle: None,
                    device_handle: None
                };
                let rejected: OAuthStreamStartResultEnvelope =
                    oauth::stream_start_result(&request, &reject_usage, markers);
                let reject_ok: bool = rejected.ok;
                let reject_code: string = failure_code(rejected.error);
                let usage: TransportCredentialUse = {
                    kind: "access",
                    access_handle: Some(access_inner.handle),
                    refresh_handle: None,
                    code_handle: None,
                    verifier_handle: None,
                    device_handle: None
                };
                let retried: OAuthStreamStartResultEnvelope =
                    oauth::stream_start_result(&request, &usage, markers);
                let retry_ok: bool = retried.ok;
                let retry_code: string = failure_code(retried.error);
                match retried.value {
                    None => { reject_ok: reject_ok, reject_code: reject_code, retry_ok: false, retry_code: retry_code, retry_status: 0 },
                    Some(envelope) => if !retry_ok || retry_code != "" => {
                        { reject_ok: reject_ok, reject_code: reject_code, retry_ok: false, retry_code: retry_code, retry_status: 0 }
                    } else => {
                        let stream: resource<oauth.stream> = envelope.stream;
                        let head: OAuthStreamHead = envelope.head;
                        let status: int = head.status;
                        oauth::stream_close(stream);
                        { reject_ok: reject_ok, reject_code: reject_code, retry_ok: true, retry_code: "", retry_status: status }
                    }
                }
            }
        }
    }
}
