use auth;
use provider_runtime;

struct OpaqueProviderIntent {
    credential_id: string,
    method: string,
    path: string,
    public_headers: array<PublicHeader>,
    public_body: string
}

struct OpaqueHostHomeBinding {
    home: resource<auth.host_home>
}

pub fn run(context: map) -> map {
    let binding: OpaqueHostHomeBinding = { "home": context["host_home"], };
    let mut credential_id: string = "fixture-codex";
    let mut path: string = "/oauth/token";
    let mut header_name: string = "accept";
    if context.has("credential_id") {
        credential_id = context["credential_id"];
    }
    if context.has("path") {
        path = context["path"];
    }
    if context.has("header_name") {
        header_name = context["header_name"];
    }
    let intent: OpaqueProviderIntent = {
        credential_id: credential_id,
        method: "GET",
        path: path,
        public_headers: [{name: header_name, value: "application/json"}],
        public_body: ""
    };
    let envelope: TransportResultEnvelope = provider_runtime::call(binding, intent);
    let has_response: bool = envelope.has("value");
    let maybe_error: AuthBridgeFailure? = envelope.error;
    let error: AuthBridgeFailure = maybe_error.unwrap_or({
        code: "",
        cancelled: false,
        deadline_exceeded: false,
        revoked: false
    });
    let maybe_response: TransportResponseEnvelope? = if has_response => {
        envelope.value
    } else => {
        null
    };
    let response: TransportResponseEnvelope = maybe_response.unwrap_or({
        ok: false,
        error: null,
        status: 0,
        public_headers: [],
        body_without_secret_fields: "",
        retry_after_ms: 0,
        access_slot: null,
        refresh_slot: null,
        device_handle: null
    });
    let mut retry_after_ms: int = 0;
    if response.has("retry_after_ms") {
        let maybe_retry_after_ms: int? = response.retry_after_ms;
        retry_after_ms = maybe_retry_after_ms.unwrap_or(0);
    }
    let public_response: map = {
        ok: envelope.ok,
        error_code: error.code,
        cancelled: error.cancelled,
        deadline_exceeded: error.deadline_exceeded,
        revoked: error.revoked,
        status: response.status,
        body: response.body_without_secret_fields,
        retry_after_ms: retry_after_ms
    };
    public_response
}
