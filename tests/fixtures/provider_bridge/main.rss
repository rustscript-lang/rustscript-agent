use auth;
use provider_runtime;

struct OpaqueProviderIntent {
    credential_id: string,
    method: string,
    path: string,
    public_headers: array<PublicHeader>,
    public_body: string
}

struct OpaqueHostHomeBinding {
    home: resource<auth.host_home>
}

struct BridgeContext {
    host_home: resource<auth.host_home>,
    credential_id: Option<string>,
    path: Option<string>,
    header_name: Option<string>
}

struct BridgeReport {
    ok: bool,
    error_code: string,
    cancelled: bool,
    deadline_exceeded: bool,
    revoked: bool,
    status: int,
    body: string,
    retry_after_ms: int
}

struct ResponseView { status: int, body: string, retry_after_ms: int }

fn project_response(response: TransportResponseEnvelope) -> ResponseView {
    let retry = match response.retry_after_ms { Some(value) => value, None => 0 };
    {status: response.status, body: response.body_without_secret_fields, retry_after_ms: retry}
}

pub fn run(context: BridgeContext) -> BridgeReport {
    let binding: OpaqueHostHomeBinding = {home: context.host_home};
    let credential_id = match context.credential_id { Some(value) => value, None => "fixture-codex" };
    let path = match context.path { Some(value) => value, None => "/oauth/token" };
    let header_name = match context.header_name { Some(value) => value, None => "accept" };
    let intent: OpaqueProviderIntent = {
        credential_id: credential_id,
        method: "GET",
        path: path,
        public_headers: [{name: header_name, value: "application/json"}],
        public_body: ""
    };
    let envelope: TransportResultEnvelope = provider_runtime::call(binding, intent);
    let error: AuthBridgeFailure = match envelope.error {
        Some(value) => value,
        None => {code: "", cancelled: false, deadline_exceeded: false, revoked: false}
    };
    let response: ResponseView = match envelope.value {
        Some(value) => project_response(value),
        None => {status: 0, body: "", retry_after_ms: 0}
    };
    {
        ok: envelope.ok,
        error_code: error.code,
        cancelled: error.cancelled,
        deadline_exceeded: error.deadline_exceeded,
        revoked: error.revoked,
        status: response.status,
        body: response.body,
        retry_after_ms: response.retry_after_ms
    }
}
