// Custom production-loop program for the A5 approval-park race fixtures.
//
// Performs ONE delayed provider-style round trip (the fixture server sleeps
// before answering), then yields `approval.wait` — no tool cycle, no emitted
// events, no message sync — so the service's park sequence (durable
// approval.request -> run transition -> park insert -> approval.required
// append) is the only storage traffic. The provider delay widens the margin
// between the race-control hold and the park's arrival, making the window
// the SQLite lock helper controls deterministic.
use http;

fn ctx_string(value: map, key: string, fallback: string) -> string {
    let mut result: string = fallback;
    if value.has(key) {
        if type(value[key].copy()) == "string" {
            let coerced: string = value[key].copy();
            result = coerced;
        }
    }
    result
}

fn provider_url(context: map) -> string {
    let mut url: string = "";
    if context.has("provider_options") {
        let options: map = context["provider_options"].copy();
        if options.has("base_url") {
            if type(options["base_url"].copy()) == "string" {
                let base: string = options["base_url"].copy();
                url = base + "/chat/completions";
            }
        }
    }
    url
}

pub fn agent_run(context: map) -> map {
    let url: string = provider_url(context);
    let response: map = http::client::request({
        method: "POST",
        url: url,
        headers: {
            "content-type": "application/json"
        },
        body: "{}"
    });
    {
        kind: "approval.wait",
        turn: 0,
        messages: [],
        approval: {
            tool_call_id: "call-1",
            tool_name: "file.write",
            arguments: {},
            risk_class: "write"
        },
        config: {}
    }
}
