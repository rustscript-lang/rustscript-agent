// Public-input fixture for the pure RSS OpenAI Chat stream codec.
//
// Invokes the real production body builder and codec state machine with plain
// public maps. No fake native resource, no mirrored Rust parsing, no
// credentials: the records are ordinary decoded chunk objects.
use super::super::super::rss::llm::openai_chat;
use super::super::super::rss::llm::openai_stream_codec;
use super::super::super::rss::llm::types;

pub fn request_body(request: map) -> string {
    let model: string = types::request_string(request, "model");
    openai_chat::chat_build_public_stream_body(request, model)
}

pub fn collect(chunks: array, done: bool) -> map {
    let mut state: map = openai_stream_codec::begin();
    let mut i = 0;
    while i < chunks.length {
        let chunk: map = types::array_entry(chunks, i);
        state = openai_stream_codec::push_chunk(state, chunk);
        i += 1;
    }
    if done {
        state = openai_stream_codec::push_done(state);
    }
    openai_stream_codec::finish(state)
}

pub fn late_record(chunks: array, late: map) -> map {
    let mut state: map = openai_stream_codec::begin();
    let mut i = 0;
    while i < chunks.length {
        let chunk: map = types::array_entry(chunks, i);
        state = openai_stream_codec::push_chunk(state, chunk);
        i += 1;
    }
    state = openai_stream_codec::push_done(state);
    state = openai_stream_codec::push_chunk(state, late);
    openai_stream_codec::finish(state)
}
