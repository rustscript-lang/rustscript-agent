// Public fixture driving the production codec through the restricted runner.
use self::llm::openai_responses_codec as codec;
use self::llm::types;
use self::llm::tool_descriptor;

pub fn request_body(args: array) -> string {
    let request: map = args[0];
    let model: string = types::request_string(request, "model");
    codec::responses_build_public_body(request, model, false)
}

pub fn native_descriptor_body(args: array) -> string {
    let mut request: map = args[0];
    let model: string = types::request_string(request, "model");
    let tools: array = types::request_array(request, "tools");
    let descriptor: map = types::array_entry(tools, 0);
    let tool = tool_descriptor::from_native(descriptor);
    request["tools"] = [tool];
    codec::responses_build_public_body(request, model, false)
}

pub fn stream_body(args: array) -> string {
    let request: map = args[0];
    let model: string = types::request_string(request, "model");
    codec::responses_build_public_body(request, model, true)
}

pub fn collect(args: array) -> map {
    let chunks: array<string> = args[0];
    let done: bool = args[1];
    let mut state: map = codec::begin();
    let mut i = 0;
    while i < chunks.length {
        state = codec::push_json(state, chunks[i].copy());
        i += 1;
    }
    if done {
        state = codec::push_done(state);
    }
    codec::finish(state)
}

pub fn parse_body_text(args: array) -> map {
    let text: string = args[0];
    codec::responses_parse_public_response(text)
}

pub fn parse_error(args: array) -> map {
    let text: string = args[0];
    let status: int = args[1];
    codec::responses_parse_public_error(text, status)
}
