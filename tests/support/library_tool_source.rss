use bytes;
use json;
use text::{format};

struct ReplayFailure { code: string, message: string }
struct ReadReplay {
    ok: bool,
    content: string,
    data: string,
    error: Option<ReplayFailure>,
    truncated: bool,
    artifacts: array<string>
}

fn replay_result(text: string) -> map {
    let value = json::decode::<ReadReplay>(text);
    let mut result: map = {
        ok: value.ok, content: value.content, data: value.data, error: (),
        truncated: value.truncated, artifacts: value.artifacts
    };
    match value.error {
        Some(detail) => { kind: "replay", result: with_replay_error(result, detail) },
        None => { kind: "replay", result: result }
    }
}

fn with_replay_error(result: map, error: ReplayFailure) -> map {
    result.error = { code: error.code, message: error.message };
    result
}
fn map_string(value: map, key: string, fallback: string) -> string {
    let mut result: string = fallback;
    if value.has(key) {
        if type(value[key]) == "string" {
            let coerced: string = value[key];
            result = coerced;
        }
    }
    result
}

fn map_map(value: map, key: string) -> map {
    let mut result: map = {};
    if value.has(key) {
        if type(value[key]) == "map" {
            let coerced: map = value[key];
            result = coerced;
        }
    }
    result
}

fn failure(error: Option<AgentCapabilityError>) -> map {
    let detail: map = match error {
        Some(value) => { code: value.code, message: value.message },
        None => { code: "read_failed", message: "read failed" }
    };
    { ok: false, content: "", data: {}, error: detail, truncated: false, artifacts: [] }
}

pub fn run(context: map) -> map {
    let metadata = agent::json_text(map_map(context, "prepare"));
    let prepared = agent_runtime::tool_prepare(metadata.text);
    if prepared.kind == "replay" => {
        replay_result(prepared.result)
    } else if prepared.ok == false => {
        failure(prepared.error)
    } else => {
        let token: string = prepared.execution_token;
        let arguments: map = map_map(context, "arguments");
        let path: string = map_string(arguments, "path", "");
        let meta = cap::fs_metadata(token, path);
        if meta.ok == false => {
            failure(meta.error)
        } else => {
            let read = cap::fs_read_range(token, path, 0, meta.len);
            if read.ok == false => {
                failure(read.error)
            } else => {
                let payload: bytes = read.bytes;
                let labeled: string = format(bytes::to_utf8(payload));
                let result: map = { ok: true, content: labeled, data: {}, error: (), truncated: false, artifacts: [] };
                let encoded = agent::json_text(result);
                let committed = agent_runtime::tool_commit(token, encoded.text);
                if committed.ok => { result } else => { failure(committed.error) }
            }
        }
    }
}
