use json;
use sqlite;
use self::schema as schema;
use self::existence as existence;

fn events_query_limits(max_rows: int, max_bytes: int) -> map<int> {
    { max_rows: max_rows, max_result_bytes: if max_bytes < 4096 => { 4096 } else => { max_bytes } }
}


struct EventAppendInput {
    run_id: string,
    event_id: string,
    event_type: string,
    payload_json: string,
    now_ms: int,
    max_events: int
}

struct EventReplayInput {
    run_id: string,
    after_seq: int,
    max_events: int,
    max_bytes: int
}

struct EventPruneInput {
    run_id: string,
    max_events: int,
    now_ms: int
}

struct CursorInput {
    session_id: string,
    consumer: string,
    event_seq: int,
    now_ms: int
}

pub fn storage_event_append(db_id: int, payload_json: string) -> map {
    let input: EventAppendInput = json::decode::<EventAppendInput>(payload_json);
    let mut result = { ok: true, code: "ok", message: "", result: [] };
    if input.run_id.copy() == "" || input.event_id.copy() == "" || input.event_type.copy() == "" || input.payload_json.copy() == "" {
        result = { ok: false, code: "invalid_event", message: "event id, type, run id, and payload are required", result: [] };
    } else if !existence::run_exists(db_id, input.run_id.copy()) {
        result = { ok: false, code: "run_not_found", message: "event append targets an unknown run", result: [] };
    } else {
// Exact-once: a durable event row with this event_id may already
        // exist because a previous request's SQLite commit landed while its
        // response was lost/timed out (the caller then retried the SAME fixed
        // event_id). Re-read the authoritative durable row by event_id and
        // reconcile BEFORE inserting:
        //   - same run_id + event_type + payload_json -> idempotent replay:
        //     return the EXISTING durable event as success (no second row,
        //     no extra publish, seq untouched).
        //   - same event_id but a different run/content -> typed conflict,
        //     never a silent swallow and never a fabricated second event.
        // On a truly new event_id we fall through to the unchanged atomic
        // insert (retention + prune + high-water in one transaction). The
        // UNIQUE(event_id) constraint backstops a cross-process race where
        // two callers both pass the pre-check before either row exists; the
        // loser surfaces a typed storage error and its retry hits this
        // pre-check's replay path.
        let existing: map = sqlite::query(
            db_id,
            "SELECT seq, run_id, event_type, payload_json FROM run_events WHERE event_id = ? LIMIT 1",
            [&input.event_id],
            { max_rows: 1, max_result_bytes: 4096 }
        );
        let existing_rows: array = existing["rows"];
        if existing_rows.length > 0 {
            let existing_row: array = existing_rows[0];
            let existing_seq: int = existing_row[0];
            let existing_run: string = existing_row[1];
            let existing_type: string = existing_row[2];
            let existing_payload: string = existing_row[3];
            if existing_run == input.run_id && existing_type == input.event_type && existing_payload == input.payload_json {
                // Same identity + same content: an idempotent replay of an
                // event that already committed durably. Expose the original
                // seq (never a new allocation).
                let replay_result: array = [
                    {
                        rows_affected: 0,
                        replayed: true,
                        existing_seq: existing_seq
                    }
                ];
                result = { ok: true, code: "ok", message: "event already durable (idempotent replay)", result: replay_result };
            } else {
                result = { ok: false, code: "event_id_conflict", message: "event_id already exists with a different run or content", result: [] };
            }
        } else {
            let max_events: int = schema::max_events_limit(input.max_events.copy());
            let statements = [
                {
sql: "INSERT INTO run_events (run_id, seq, event_id, event_type, payload_json, created_at_ms) SELECT ?, COALESCE((SELECT MAX(events.seq) FROM run_events events WHERE events.run_id = ?), 0) + 1, ?, ?, ?, ? WHERE EXISTS (SELECT 1 FROM runs WHERE id = ?)",
                    params: [&input.run_id, &input.run_id, &input.event_id, &input.event_type, &input.payload_json, input.now_ms.copy(), &input.run_id]
                },
                {
                    sql: "DELETE FROM run_events WHERE rowid IN (SELECT rowid FROM run_events WHERE run_id = ? ORDER BY seq ASC LIMIT CASE WHEN (SELECT COUNT(*) FROM run_events WHERE run_id = ?) > ? THEN (SELECT COUNT(*) FROM run_events WHERE run_id = ?) - ? ELSE 0 END)",
                    params: [&input.run_id, &input.run_id, max_events.copy(), &input.run_id, max_events.copy()]
                },
                {
                    sql: "INSERT INTO run_retention (run_id, first_seq, high_water_seq, updated_at_ms) SELECT ?, COALESCE((SELECT MIN(seq) FROM run_events WHERE run_id = ?), 0), COALESCE((SELECT MAX(seq) FROM run_events WHERE run_id = ?), 0), ? ON CONFLICT (run_id) DO UPDATE SET first_seq = excluded.first_seq, high_water_seq = MAX(run_retention.high_water_seq, excluded.high_water_seq), updated_at_ms = excluded.updated_at_ms",
                    params: [&input.run_id, &input.run_id, &input.run_id, input.now_ms.copy()]
                },
                {
                    sql: "UPDATE runs SET updated_at_ms = ? WHERE id = ?",
                    params: [input.now_ms.copy(), &input.run_id]
                }
            ];
            result = { ok: true, code: "ok", message: "", result: sqlite::transaction(db_id, statements) };
        }
    }
    result
}

/// Returns the persisted retention floor for one run: the oldest retained
/// sequence and the highest sequence ever allocated. Runs without retained
/// events report floor 1 / high-water 0. The query always yields exactly one
/// row (COALESCE), so extraction is unconditional.
pub fn storage_event_retention(db_id: int, run_id: string) -> map {
    let result: map = sqlite::query(
        db_id,
        "SELECT COALESCE((SELECT first_seq FROM run_retention WHERE run_id = ?), 1) AS first_seq, COALESCE((SELECT high_water_seq FROM run_retention WHERE run_id = ?), 0) AS high_water_seq",
        [&run_id, &run_id],
        { max_rows: 1, max_result_bytes: 4096 }
    );
    let rows: array = result["rows"];
    let row: array = rows[0];
    let first_seq: int = row[0];
    let high_water_seq: int = row[1];
    { first_seq: first_seq, high_water_seq: high_water_seq }
}

pub fn storage_event_replay(db_id: int, payload_json: string) -> map {
    let input: EventReplayInput = json::decode::<EventReplayInput>(payload_json);
    sqlite::query(
        db_id,
        "SELECT events.seq, events.run_id, events.event_id, events.event_type, CASE WHEN length(CAST(events.payload_json AS BLOB)) > CASE WHEN ? <= 0 THEN 16384 WHEN ? > 32768 THEN 16384 WHEN ? < 128 THEN 64 ELSE ? / 2 END THEN '{\"truncated\":true,\"original_bytes\":' || length(CAST(events.payload_json AS BLOB)) || '}' ELSE events.payload_json END AS payload_json, events.created_at_ms FROM run_events events WHERE events.run_id = ? AND events.seq >= ? ORDER BY events.seq ASC LIMIT (CASE WHEN ? <= 0 THEN 128 WHEN ? > 16384 THEN 16384 ELSE ? END) + 1",
        [input.max_bytes.copy(), input.max_bytes.copy(), input.max_bytes.copy(), input.max_bytes.copy(), &input.run_id, input.after_seq.copy(), input.max_events.copy(), input.max_events.copy(), input.max_events.copy()],
        schema::event_replay_limits(input.max_events.copy(), input.max_bytes.copy())
    )
}

/// Prunes a run's retained events down to `max_events` and updates the
/// persisted retention floor/high-water in the same transaction, so the
/// floor always matches what replay can actually serve.
pub fn storage_event_prune(db_id: int, payload_json: string) -> array {
    let input: EventPruneInput = json::decode::<EventPruneInput>(payload_json);
    let statements = [
        {
            sql: "DELETE FROM run_events WHERE rowid IN (SELECT rowid FROM run_events WHERE run_id = ? ORDER BY seq ASC LIMIT CASE WHEN (SELECT COUNT(*) FROM run_events WHERE run_id = ?) > CASE WHEN ? <= 0 THEN 128 WHEN ? > 256 THEN 256 ELSE ? END THEN (SELECT COUNT(*) FROM run_events WHERE run_id = ?) - CASE WHEN ? <= 0 THEN 128 WHEN ? > 256 THEN 256 ELSE ? END ELSE 0 END)",
            params: [&input.run_id, &input.run_id, input.max_events.copy(), input.max_events.copy(), input.max_events.copy(), &input.run_id, input.max_events.copy(), input.max_events.copy(), input.max_events.copy()]
        },
        {
            sql: "INSERT INTO run_retention (run_id, first_seq, high_water_seq, updated_at_ms) SELECT ?, COALESCE((SELECT MIN(seq) FROM run_events WHERE run_id = ?), 0), COALESCE((SELECT MAX(seq) FROM run_events WHERE run_id = ?), 0), ? ON CONFLICT (run_id) DO UPDATE SET first_seq = excluded.first_seq, high_water_seq = MAX(run_retention.high_water_seq, excluded.high_water_seq), updated_at_ms = excluded.updated_at_ms",
            params: [&input.run_id, &input.run_id, &input.run_id, input.now_ms.copy()]
        }
    ];
    sqlite::transaction(db_id, statements)
}

pub fn storage_delivery_cursor_get(db_id: int, session_id: string, consumer: string, max_rows: int, max_bytes: int) -> map {
    sqlite::query(
        db_id,
        "SELECT session_id, consumer, last_event_seq, updated_at_ms FROM delivery_cursors WHERE session_id = ? AND consumer = ? LIMIT ?",
        [&session_id, &consumer, (max_rows)],
        events_query_limits(max_rows, max_bytes)
    )
}

/// Monotonic unvalidated cursor upsert for values that are not run-event
/// sequence numbers (for example the Telegram getUpdates offset). `advance`
/// stays the validated path for per-run event delivery; `set` is the
/// sibling command for transport-level cursors whose values are unrelated
/// to `run_events.seq`.
pub fn storage_delivery_cursor_set(db_id: int, payload_json: string) -> map {
    let input: CursorInput = json::decode::<CursorInput>(payload_json);
    sqlite::execute(
        db_id,
        "INSERT INTO delivery_cursors (session_id, consumer, last_event_seq, updated_at_ms) VALUES (?, ?, ?, ?) ON CONFLICT (session_id, consumer) DO UPDATE SET last_event_seq = MAX(delivery_cursors.last_event_seq, excluded.last_event_seq), updated_at_ms = excluded.updated_at_ms",
        [&input.session_id, &input.consumer, input.event_seq.copy(), input.now_ms.copy()]
    )
}

pub fn storage_delivery_cursor_advance(db_id: int, payload_json: string) -> map {
    let input: CursorInput = json::decode::<CursorInput>(payload_json);
    sqlite::execute(
        db_id,
        "INSERT INTO delivery_cursors (session_id, consumer, last_event_seq, updated_at_ms) SELECT ?, ?, ?, ? WHERE ? >= 0 AND ? <= COALESCE((SELECT MAX(events.seq) FROM run_events events JOIN runs event_runs ON event_runs.id = events.run_id WHERE event_runs.session_id = ?), 0) ON CONFLICT (session_id, consumer) DO UPDATE SET last_event_seq = MAX(delivery_cursors.last_event_seq, excluded.last_event_seq), updated_at_ms = excluded.updated_at_ms",
        [&input.session_id, &input.consumer, input.event_seq.copy(), input.now_ms.copy(), input.event_seq.copy(), input.event_seq.copy(), &input.session_id]
    )
}
