// Privileged plugin-control commands. The closed op set in storage_dispatch is
// the only writer. Guest approval operations are not plugin-control operations,
// and this module does not accept caller SQL.
use json;
use sqlite;

fn sql_text(value: string) -> SqliteValue {
    { kind: "text", int_value: null, float_value: null, text_value: value, blob_value: null }
}

fn sql_int(value: int) -> SqliteValue {
    { kind: "int", int_value: value, float_value: null, text_value: null, blob_value: null }
}

fn plugin_limits() -> SqliteLimits {
    {
        max_connections: 16,
        max_statements: 128,
        max_rows: 512,
        max_columns: 24,
        max_result_bytes: 1048576,
        max_statement_bytes: 1048576,
        max_parameters: 128,
        max_parameter_bytes: 1048576,
        max_pending_operations: 32,
        max_transaction_ms: 5000,
        busy_timeout_ms: 5000
    }
}

fn query_map(result: SqliteQueryResult) -> map {
    {
        columns: result.columns,
        rows: result.rows,
        truncated: result.truncated
    }
}

fn ok_query(result: SqliteQueryResult) -> map {
    { ok: true, code: "ok", message: "", result: query_map(result) }
}

fn ok_value(value: map) -> map {
    { ok: true, code: "ok", message: "", result: value }
}

fn plugin_control_error(code: string, message: string) -> map {
    { ok: false, code: code, message: message, result: {} }
}

fn plugin_tx_rows(entry: SqliteTransactionResult) -> int {
    let mut affected: int = 0;
    if entry.kind == "execute" {
        let exec: SqliteExecuteResult = entry.execute;
        affected = exec.rows_affected;
    }
    affected
}

fn plugin_query_int(entry: SqliteTransactionResult, column: int) -> int {
    let mut value: int = -1;
    if entry.kind == "query" {
        let queried: SqliteQueryResult = entry.query;
        let rows = queried.rows.copy();
        if rows.length > 0 {
            let row: SqliteRow = rows[0].copy();
            let cells = row.cells.copy();
            if cells.length > column {
                let cell: SqliteValue = cells[column].copy();
                if cell.kind == "int" && cell.int_value.copy() != null {
                    value = cell.int_value;
                }
            }
        }
    }
    value
}

fn plugin_query_text(entry: SqliteTransactionResult, column: int) -> string {
    let mut value: string = "";
    if entry.kind == "query" {
        let queried: SqliteQueryResult = entry.query;
        let rows = queried.rows.copy();
        if rows.length > 0 {
            let row: SqliteRow = rows[0].copy();
            let cells = row.cells.copy();
            if cells.length > column {
                let cell: SqliteValue = cells[column].copy();
                if cell.kind == "text" && cell.text_value.copy() != null {
                    value = cell.text_value;
                }
            }
        }
    }
    value
}

