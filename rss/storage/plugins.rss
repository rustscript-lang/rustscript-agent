            params: [sql_text(input.run_id.copy())],
            query: true,
            limits: plugin_limits(),
        }
    ];
    let result: array<SqliteTransactionResult> = sqlite::transaction(&db_id, statements);
    let mut response: map = plugin_control_error("plugin_state_unavailable", "plugin state storage is unavailable");
    if result.length >= 2 {
        let inserted: int = plugin_tx_rows(result[0].copy());
        let binding: SqliteTransactionResult = result[1].copy();
        if plugin_state_binding_matches(binding.copy(), input.copy()) {
            response = ok_value({
                run_id: input.run_id.copy(),
                owner_kind: input.owner_kind.copy(),
                owner_id: input.owner_id.copy(),
                schema_version: input.schema_version.copy(),
                revision: input.revision.copy(),
                object_id: input.object_id.copy(),
                idempotent: inserted == 0
            });
        } else {
            let live_run: string = plugin_query_text(binding.copy(), 0);
            if live_run.copy() == "" {
                response = plugin_control_error("plugin_state_binding_invalid", "run or state object is not available for binding");
            } else {
