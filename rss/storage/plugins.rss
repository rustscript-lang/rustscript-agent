            params: [sql_int(input.schema_version.copy()), sql_text(input.object_id.copy()), sql_int(input.now_ms.copy()), sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy()), sql_text(input.workspace_id.copy()), sql_text(input.branch_id.copy()), sql_text(input.plugin_id.copy()), sql_int(input.expected_revision.copy()), sql_text(input.expected_object_id.copy()), sql_text(input.run_id.copy()), sql_int(input.expected_revision.copy() + 1), sql_text(input.object_id.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "SELECT schema_version,revision,object_id FROM plugin_state_run_bindings WHERE run_id=?",
            params: [sql_text(input.run_id.copy())],
