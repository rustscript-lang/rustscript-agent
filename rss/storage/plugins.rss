pub fn storage_pin_by_owner(db_id: resource<sqlite.connection>, owner_id: string) -> map {
    let queried: SqliteQueryResult = sqlite::query(&db_id, "SELECT COALESCE(json_extract(idem.response_json, '$.tool_graph_id'), ''), COALESCE(json_extract(idem.response_json, '$.tool_ref_id'), ''), COALESCE(CAST(json_extract(idem.response_json, '$.tool_generation') AS INTEGER), 0), idem.resource_id, COALESCE((SELECT session_id FROM runs WHERE id = idem.resource_id), ''), COALESCE(json_extract(idem.response_json, '$.registry_identity'), ''), COALESCE(json_extract(idem.response_json, '$.workspace'), ''), COALESCE(json_extract(idem.response_json, '$.profile'), ''), COALESCE(json_extract(idem.response_json, '$.harness_selection'), 'null') FROM idempotency_records idem JOIN runs original ON original.id = idem.resource_id WHERE idem.resource_id = ? AND ((original.idempotency_key <> '' AND idem.scope = original.idempotency_scope AND idem.key = original.idempotency_key) OR (original.idempotency_key = '' AND idem.scope = 'native.tool-pin' AND idem.key = original.id)) AND EXISTS (SELECT 1 FROM plugin_graph_refs refs WHERE refs.graph_id = json_extract(idem.response_json, '$.tool_graph_id') AND refs.owner_kind = 'run' AND refs.owner_id = idem.resource_id AND refs.ref_id = json_extract(idem.response_json, '$.tool_ref_id'))", [sql_text(owner_id.copy())], plugin_limits());
    let mut graph_id: string = "";
    let mut ref_id: string = "";
    let mut generation: int = 0;
    let mut run_id: string = "";
    let mut session_id: string = "";
    let mut registry_identity: string = "";
    let mut workspace: string = "";
    let mut profile: string = "";
    let mut harness_selection_json: string = "null";
    let mut pinned: bool = false;
    let rows = queried.rows.copy();
    if rows.length == 1 {
        let row: SqliteRow = rows[0].copy();
        let cells: array<SqliteValue> = row.cells.copy();
        graph_id = cells[0].text_value;
        ref_id = cells[1].text_value;
        generation = cells[2].int_value;
        run_id = cells[3].text_value;
        session_id = cells[4].text_value;
        registry_identity = cells[5].text_value;
        workspace = cells[6].text_value;
        profile = cells[7].text_value;
        harness_selection_json = cells[8].text_value;
        pinned = graph_id.copy() != "" && ref_id.copy() != "";
    }
    {
        graph_id: graph_id,
        ref_id: ref_id,
        generation: generation,
        run_id: run_id,
        session_id: session_id,
        registry_identity: registry_identity,
        workspace: workspace,
        profile: profile,
        harness_selection: decode_pin_selection(harness_selection_json),
        pinned: pinned
    }
}

