fn plugin_state_object_matches(entry: SqliteTransactionResult, input: PluginStateObjectInput) -> bool {
    let object_id: string = plugin_query_text(entry.copy(), 0);
    let package_id: string = plugin_query_text(entry.copy(), 1);
    let artifact_id: string = plugin_query_text(entry.copy(), 2);
    let schema_version: int = plugin_query_int(entry.copy(), 3);
    let document_bytes: int = plugin_query_int(entry.copy(), 4);
    object_id.copy() == input.object_id.copy()
        && package_id.copy() == input.package_id.copy()
        && artifact_id.copy() == input.artifact_id.copy()
        && schema_version == input.schema_version.copy()
        && document_bytes == input.document_bytes.copy()
}

pub fn storage_plugin_state_object_put(db_id: resource<sqlite.connection>, payload_json: string) -> map {
    let input: PluginStateObjectInput = json::decode::<PluginStateObjectInput>(payload_json);
    let statements: array<SqliteStatement> = [
        {
            sql: "INSERT INTO plugin_state_objects(object_id,package_id,artifact_id,schema_version,document_json,document_bytes,created_at_ms) SELECT ?,?,?,?,?,?,? WHERE NOT EXISTS(SELECT 1 FROM plugin_state_objects WHERE object_id=?)",
            params: [sql_text(input.object_id.copy()), sql_text(input.package_id.copy()), sql_text(input.artifact_id.copy()), sql_int(input.schema_version.copy()), sql_text(input.document_json.copy()), sql_int(input.document_bytes.copy()), sql_int(input.now_ms.copy()), sql_text(input.object_id.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "SELECT object_id,package_id,artifact_id,schema_version,document_bytes FROM plugin_state_objects WHERE object_id=?",
            params: [sql_text(input.object_id.copy())],
            query: true,
            limits: plugin_limits(),
        }
    ];
    let result: array<SqliteTransactionResult> = sqlite::transaction(&db_id, statements);
    let mut response: map = plugin_control_error("plugin_state_unavailable", "plugin state storage is unavailable");
    if result.length >= 2 {
        let inserted: int = plugin_tx_rows(result[0].copy());
        let existing: SqliteTransactionResult = result[1].copy();
        if inserted == 1 {
            response = ok_value({
                object_id: input.object_id.copy(),
                schema_version: input.schema_version.copy(),
                document_bytes: input.document_bytes.copy(),
                idempotent: false
            });
        } else if plugin_state_object_matches(existing.copy(), input.copy()) {
            response = ok_value({
                object_id: input.object_id.copy(),
                schema_version: input.schema_version.copy(),
                document_bytes: input.document_bytes.copy(),
                idempotent: true
            });
        } else {
            response = plugin_control_error("plugin_state_object_conflict", "plugin state object identity is immutable");
        }
    }
    response
}

