pub fn storage_plugin_retain(db_id: resource<sqlite.connection>, payload_json: string) -> map {
    let input: PluginRetainInput = json::decode::<PluginRetainInput>(payload_json);
    let statements: array<SqliteStatement> = [
        {
            sql: "INSERT INTO plugin_graph_refs (graph_id, owner_kind, owner_id, ref_id, retained_at_ms) SELECT ?, ?, ?, ?, ? WHERE EXISTS (SELECT 1 FROM plugin_graph_locks WHERE graph_id = ?) AND ? IN ('run', 'checkpoint') AND NOT EXISTS (SELECT 1 FROM plugin_graph_refs WHERE graph_id = ? AND owner_kind = ? AND owner_id = ? AND ref_id <> ?) ON CONFLICT (graph_id, owner_kind, owner_id) DO NOTHING",
            params: [sql_text(input.graph_id.copy()), sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy()), sql_text(input.ref_id.copy()), sql_int(input.now_ms.copy()), sql_text(input.graph_id.copy()), sql_text(input.owner_kind.copy()), sql_text(input.graph_id.copy()), sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy()), sql_text(input.ref_id.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "INSERT INTO plugin_control_guard (id) SELECT 2 WHERE ? = 'after_partial_write'",
            params: [sql_text(input.failpoint.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "SELECT CASE WHEN EXISTS (SELECT 1 FROM plugin_graph_locks WHERE graph_id = ?) THEN 1 ELSE 0 END, COALESCE((SELECT ref_id FROM plugin_graph_refs WHERE graph_id = ? AND owner_kind = ? AND owner_id = ?), '')",
            params: [sql_text(input.graph_id.copy()), sql_text(input.graph_id.copy()), sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy())],
            query: true,
            limits: plugin_limits(),
        }
    ];
    let transaction_result: array<SqliteTransactionResult> = sqlite::transaction(&db_id, statements);
    let mut result: map = plugin_control_error("plugin_control_unavailable", "plugin control storage is unavailable");
    if transaction_result.length >= 3 {
        let inserted: int = plugin_tx_rows(transaction_result[0]);
        let classification: SqliteTransactionResult = transaction_result[2].copy();
        let graph_present: int = plugin_query_int(classification.copy(), 0);
        let live_ref: string = plugin_query_text(classification, 1);
        if inserted == 1 && live_ref.copy() == input.ref_id.copy() {
            let stored: map = {
                idempotent: false,
                graph_id: input.graph_id.copy(),
                owner_kind: input.owner_kind.copy(),
                owner_id: input.owner_id.copy(),
                ref_id: input.ref_id.copy()
            };
            result = ok_value(stored);
        } else if inserted == 0 && graph_present == 1 && live_ref.copy() == input.ref_id.copy() {
            let stored: map = {
                idempotent: true,
                graph_id: input.graph_id.copy(),
                owner_kind: input.owner_kind.copy(),
                owner_id: input.owner_id.copy(),
                ref_id: input.ref_id.copy()
            };
            result = ok_value(stored);
        } else if graph_present == 0 {
            result = plugin_control_error("plugin_graph_missing", "plugin graph lock is not stored");
        } else {
            result = plugin_control_error("plugin_ref_invalid", "plugin graph reference is invalid");
        }
    }
    result
}

pub fn storage_plugin_release(db_id: resource<sqlite.connection>, payload_json: string) -> map {
    let input: PluginRetainInput = json::decode::<PluginRetainInput>(payload_json);
    let statements: array<SqliteStatement> = [
        {
            sql: "DELETE FROM plugin_graph_refs WHERE graph_id = ? AND owner_kind = ? AND owner_id = ? AND ref_id = ?",
            params: [sql_text(input.graph_id.copy()), sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy()), sql_text(input.ref_id.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "INSERT INTO plugin_control_guard (id) SELECT 2 WHERE ? = 'after_partial_write'",
            params: [sql_text(input.failpoint.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "SELECT COALESCE((SELECT ref_id FROM plugin_graph_refs WHERE graph_id = ? AND owner_kind = ? AND owner_id = ?), '')",
            params: [sql_text(input.graph_id.copy()), sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy())],
            query: true,
            limits: plugin_limits(),
        }
    ];
    let transaction_result: array<SqliteTransactionResult> = sqlite::transaction(&db_id, statements);
    let mut result: map = plugin_control_error("plugin_control_unavailable", "plugin control storage is unavailable");
    if transaction_result.length >= 3 {
        let deleted: int = plugin_tx_rows(transaction_result[0]);
        let live_ref: string = plugin_query_text(transaction_result[2], 0);
        if deleted == 1 && live_ref.copy() == "" {
            result = ok_value({ graph_id: input.graph_id.copy(), ref_id: input.ref_id.copy(), deleted: deleted.copy() });
        } else if deleted == 0 && live_ref.copy() == "" {
            result = ok_value({ graph_id: input.graph_id.copy(), ref_id: input.ref_id.copy(), deleted: deleted.copy() });
        } else if deleted == 0 && live_ref.copy() != "" {
            result = plugin_control_error("plugin_ref_invalid", "plugin graph reference is invalid");
        }
    }
    result
}

// Only the cfg(test) Native seam can enqueue this closed mutation command.
