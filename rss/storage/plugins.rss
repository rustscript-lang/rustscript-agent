pub fn storage_plugin_retain(db_id: resource<sqlite.connection>, payload_json: string) -> map {
    let input: PluginRetainInput = json::decode::<PluginRetainInput>(payload_json);
    let statements: array<SqliteStatement> = [
        {
            sql: "INSERT INTO plugin_graph_refs (graph_id, owner_kind, owner_id, ref_id, retained_at_ms) SELECT ?, ?, ?, ?, ? WHERE EXISTS (SELECT 1 FROM plugin_graph_locks WHERE graph_id = ?) AND ? IN ('run', 'checkpoint') ON CONFLICT (graph_id, owner_kind, owner_id) DO NOTHING",
            params: [sql_text(input.graph_id.copy()), sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy()), sql_text(input.ref_id.copy()), sql_int(input.now_ms.copy()), sql_text(input.graph_id.copy()), sql_text(input.owner_kind.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "INSERT INTO plugin_control_guard (id) SELECT 2 WHERE ? = 'after_partial_write'",
            params: [sql_text(input.failpoint.copy())],
            query: false,
            limits: plugin_limits(),
        }
    ];
    let transaction_result = sqlite::transaction(&db_id, statements);
    let stored: map = { graph_id: input.graph_id.copy() };
    let _used = transaction_result;
    ok_value(stored)
}

