    graph_id: string,
    now_ms: int,
    failpoint: string,
}

pub fn storage_plugin_graph_revoke(db_id: resource<sqlite.connection>, payload_json: string) -> map {
    let input: PluginGraphRevokeInput = json::decode::<PluginGraphRevokeInput>(payload_json);
    let statements: array<SqliteStatement> = [
        {
            sql: "INSERT INTO plugin_graph_revocations (graph_id, revoked_at_ms) SELECT ?, ? WHERE NOT EXISTS (SELECT 1 FROM plugin_graph_revocations WHERE graph_id = ?)",
            params: [sql_text(input.graph_id.copy()), sql_int(input.now_ms.copy()), sql_text(input.graph_id.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "INSERT INTO plugin_control_guard (id) SELECT 2 WHERE ? = 'after_partial_write'",
            params: [sql_text(input.failpoint.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "SELECT graph_id, revoked_at_ms FROM plugin_graph_revocations WHERE graph_id = ? LIMIT 1",
            params: [sql_text(input.graph_id.copy())],
            query: true,
            limits: plugin_limits(),
        }
    ];
    let result: array<SqliteTransactionResult> = sqlite::transaction(&db_id, statements);
    let last: SqliteTransactionResult = result[2].copy();
    let query: SqliteQueryResult = last.query;
