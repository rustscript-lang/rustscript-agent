            limits: plugin_limits(),
        }
    ];
    let result: array<SqliteTransactionResult> = sqlite::transaction(&db_id, statements);
    let mut response: map = plugin_control_error("plugin_state_unavailable", "plugin state storage is unavailable");
    if result.length >= 3 {
        let binding_changed: int = plugin_tx_rows(result[0].copy());
        let root_changed: int = plugin_tx_rows(result[1].copy());
        let binding: SqliteTransactionResult = result[2].copy();
        let revision: int = plugin_query_int(binding.copy(), 1);
        let object_id: string = plugin_query_text(binding.copy(), 2);
