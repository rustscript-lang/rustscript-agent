}

pub fn storage_plugin_state_root_put(db_id: resource<sqlite.connection>, payload_json: string) -> map {
    let input: PluginStateRootInput = json::decode::<PluginStateRootInput>(payload_json);
    let statements: array<SqliteStatement> = [
        {
            sql: "INSERT INTO plugin_state_roots(owner_kind,owner_id,workspace_id,branch_id,plugin_id,package_id,artifact_id,schema_version,revision,object_id,updated_at_ms) SELECT ?,?,?,?,?,?,?,?,1,?,? WHERE ?=0 AND NOT EXISTS(SELECT 1 FROM plugin_state_roots WHERE owner_kind=? AND owner_id=? AND workspace_id=? AND branch_id=? AND plugin_id=?) AND EXISTS(SELECT 1 FROM plugin_state_objects WHERE object_id=? AND package_id=? AND artifact_id=? AND schema_version=?)",
            params: [sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy()), sql_text(input.workspace_id.copy()), sql_text(input.branch_id.copy()), sql_text(input.plugin_id.copy()), sql_text(input.package_id.copy()), sql_text(input.artifact_id.copy()), sql_int(input.schema_version.copy()), sql_text(input.object_id.copy()), sql_int(input.now_ms.copy()), sql_int(input.expected_revision.copy()), sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy()), sql_text(input.workspace_id.copy()), sql_text(input.branch_id.copy()), sql_text(input.plugin_id.copy()), sql_text(input.object_id.copy()), sql_text(input.package_id.copy()), sql_text(input.artifact_id.copy()), sql_int(input.schema_version.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "UPDATE plugin_state_roots SET package_id=?,artifact_id=?,schema_version=?,revision=revision+1,object_id=?,updated_at_ms=? WHERE owner_kind=? AND owner_id=? AND workspace_id=? AND branch_id=? AND plugin_id=? AND revision=? AND EXISTS(SELECT 1 FROM plugin_state_objects WHERE object_id=? AND package_id=? AND artifact_id=? AND schema_version=?)",
            params: [sql_text(input.package_id.copy()), sql_text(input.artifact_id.copy()), sql_int(input.schema_version.copy()), sql_text(input.object_id.copy()), sql_int(input.now_ms.copy()), sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy()), sql_text(input.workspace_id.copy()), sql_text(input.branch_id.copy()), sql_text(input.plugin_id.copy()), sql_int(input.expected_revision.copy()), sql_text(input.object_id.copy()), sql_text(input.package_id.copy()), sql_text(input.artifact_id.copy()), sql_int(input.schema_version.copy())],
            query: false,
            limits: plugin_limits(),
        },
        {
            sql: "SELECT owner_kind,owner_id,workspace_id,branch_id,plugin_id,package_id,artifact_id,schema_version,revision,object_id FROM plugin_state_roots WHERE owner_kind=? AND owner_id=? AND workspace_id=? AND branch_id=? AND plugin_id=?",
            params: [sql_text(input.owner_kind.copy()), sql_text(input.owner_id.copy()), sql_text(input.workspace_id.copy()), sql_text(input.branch_id.copy()), sql_text(input.plugin_id.copy())],
            query: true,
            limits: plugin_limits(),
        }
    ];
    let result: array<SqliteTransactionResult> = sqlite::transaction(&db_id, statements);
    let mut response: map = plugin_control_error("plugin_state_unavailable", "plugin state storage is unavailable");
    if result.length >= 3 {
        let created: int = plugin_tx_rows(result[0].copy());
        let updated: int = plugin_tx_rows(result[1].copy());
        let root: SqliteTransactionResult = result[2].copy();
        if plugin_state_root_matches(root.copy(), input.copy()) && (created == 1 || updated == 1) {
            response = ok_value({
                owner_kind: input.owner_kind.copy(),
                owner_id: input.owner_id.copy(),
                schema_version: input.schema_version.copy(),
                revision: input.expected_revision.copy() + 1,
                object_id: input.object_id.copy()
            });
        } else {
            let live_revision: int = plugin_query_int(root.copy(), 8);
            if live_revision < 0 {
                response = plugin_control_error("plugin_state_root_missing", "plugin state root is not stored");
            } else {
                response = plugin_control_error("plugin_state_conflict", "plugin state root revision does not match");
            }
        }
    }
    response
}

