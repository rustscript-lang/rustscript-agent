pub fn storage_run_create(db_id: resource<sqlite.connection>, payload_json: string, max_rows: int, max_bytes: int) -> map {
    let input: RunCreateInput = json::decode::<RunCreateInput>(payload_json);
    let mut result = { ok: true, code: "ok", message: "", result: { columns: [], rows: [] } };
    if !(sqlite::query(&db_id, existence::session_exists_sql(), [sql_text(input.session_id.copy())], sql_limits(1, 4096)).rows.length > 0) {
        result = { ok: false, code: "session_not_found", message: "run create targets an unknown session", result: { columns: [], rows: [] } };
    } else {
        if input.parent_run_id.copy() != "" && !(sqlite::query(&db_id, existence::run_exists_sql(), [sql_text(input.parent_run_id.copy())], sql_limits(1, 4096)).rows.length > 0) {
            result = { ok: false, code: "parent_not_found", message: "parent run does not exist", result: { columns: [], rows: [] } };
        } else {
            sqlite::execute(&db_id, "INSERT OR IGNORE INTO runs (id, session_id, parent_run_id, status, input_json, provider, model, script_hash, idempotency_scope, idempotency_key, created_at_ms, updated_at_ms) SELECT ?, ?, ?, 'queued', ?, ?, ?, ?, ?, ?, ?, ? WHERE NOT EXISTS (SELECT 1 FROM runs existing WHERE existing.id = ? AND existing.session_id <> ?) AND EXISTS (SELECT 1 FROM sessions WHERE id = ?) AND (? = '' OR EXISTS (SELECT 1 FROM runs parent WHERE parent.id = ?))", [sql_text(input.id.copy()), sql_text(input.session_id.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.input_json.copy()), sql_text(input.provider.copy()), sql_text(input.model.copy()), sql_text(input.script_hash.copy()), sql_text(input.idempotency_scope.copy()), sql_text(input.idempotency_key.copy()), sql_int(input.now_ms.copy()), sql_int(input.now_ms.copy()), sql_text(input.id.copy()), sql_text(input.session_id.copy()), sql_text(input.session_id.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.parent_run_id.copy())]);
            result = {
                ok: true,
                code: "ok",
                message: "",
                result: sqlite::query(&db_id, "SELECT id, session_id, parent_run_id, status, input_json, provider, model, script_hash, idempotency_scope, idempotency_key, turn_count, input_tokens, output_tokens, error_code, error_message, recovery_reason, created_at_ms, started_at_ms, finished_at_ms, updated_at_ms FROM runs WHERE id = ? AND session_id = ? LIMIT ?", [sql_text(input.id.copy()), sql_text(input.session_id.copy()), sql_int(max_rows)], runs_query_limits(max_rows, max_bytes))
            };
        }
    }
    result
}

pub fn storage_run_get(db_id: resource<sqlite.connection>, run_id: string, max_rows: int, max_bytes: int) -> SqliteQueryResult {
    sqlite::query(&db_id, "SELECT id, session_id, parent_run_id, status, input_json, provider, model, script_hash, idempotency_scope, idempotency_key, turn_count, input_tokens, output_tokens, error_code, error_message, recovery_reason, created_at_ms, started_at_ms, finished_at_ms, updated_at_ms FROM runs WHERE id = ? LIMIT ?", [sql_text(run_id.copy()), sql_int(max_rows)], runs_query_limits(max_rows, max_bytes))
}

pub fn storage_run_list(db_id: resource<sqlite.connection>, session_id: string, status: string, max_rows: int, max_bytes: int) -> SqliteQueryResult {
    sqlite::query(&db_id, "SELECT id, session_id, parent_run_id, status, input_json, provider, model, script_hash, idempotency_scope, idempotency_key, turn_count, input_tokens, output_tokens, error_code, error_message, recovery_reason, created_at_ms, started_at_ms, finished_at_ms, updated_at_ms FROM runs WHERE session_id = ? AND (? = '' OR status = ?) ORDER BY created_at_ms DESC, id DESC LIMIT ?", [sql_text(session_id.copy()), sql_text(status), sql_text(status), sql_int(max_rows)], runs_query_limits(max_rows, max_bytes))
}

pub fn storage_run_status_allowed(status: string) -> bool {
    status == "queued" || status == "running" || status == "waiting_approval" || status == "compacting" || status == "completed" || status == "failed" || status == "cancelled"
}

pub fn storage_run_transition(db_id: resource<sqlite.connection>, payload_json: string) -> array {
    let input: RunTransitionInput = json::decode::<RunTransitionInput>(payload_json);
    assert(storage_run_status_allowed(input.to_status.copy()));
    let statements: array<SqliteStatement> = [
        {
            sql: "UPDATE runs SET status = ?, error_code = ?, error_message = ?, recovery_reason = ?, started_at_ms = CASE WHEN ? = 'running' AND started_at_ms = 0 THEN ? ELSE started_at_ms END, finished_at_ms = CASE WHEN ? IN ('completed', 'failed', 'cancelled') THEN ? ELSE finished_at_ms END, updated_at_ms = ? WHERE id = ? AND status = ? AND ((status = 'queued' AND ? IN ('running', 'cancelled', 'failed')) OR (status = 'running' AND ? IN ('waiting_approval', 'compacting', 'completed', 'failed', 'cancelled')) OR (status = 'waiting_approval' AND ? IN ('running', 'compacting', 'completed', 'failed', 'cancelled')) OR (status = 'compacting' AND ? IN ('running', 'completed', 'failed', 'cancelled')))",
            params: [sql_text(input.to_status.copy()), sql_text(input.error_code.copy()), sql_text(input.error_message.copy()), sql_text(input.recovery_reason.copy()), sql_text(input.to_status.copy()), sql_int(input.now_ms.copy()), sql_text(input.to_status.copy()), sql_int(input.now_ms.copy()), sql_int(input.now_ms.copy()), sql_text(input.run_id.copy()), sql_text(input.from_status.copy()), sql_text(input.to_status.copy()), sql_text(input.to_status.copy()), sql_text(input.to_status.copy()), sql_text(input.to_status.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        },
        {
            sql: "INSERT OR IGNORE INTO run_events (run_id, seq, event_id, event_type, payload_json, created_at_ms) SELECT id, COALESCE((SELECT MAX(seq) FROM run_events e WHERE e.run_id = runs.id), 0) + 1, 'run-transition:' || id || ':' || ? || ':' || ? || ':' || ? || ':' || (COALESCE((SELECT MAX(seq) FROM run_events e WHERE e.run_id = runs.id), 0) + 1), 'run.status_changed', '{}', ? FROM runs WHERE id = ? AND status = ? AND updated_at_ms = ? AND changes() = 1",
            params: [sql_int(input.now_ms.copy()), sql_text(input.from_status.copy()), sql_text(input.to_status.copy()), sql_int(input.now_ms.copy()), sql_text(input.run_id.copy()), sql_text(input.to_status.copy()), sql_int(input.now_ms.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        },
        {
            sql: "INSERT INTO run_retention (run_id, first_seq, high_water_seq, updated_at_ms) SELECT id, COALESCE((SELECT MIN(seq) FROM run_events e WHERE e.run_id = runs.id), 0), COALESCE((SELECT MAX(seq) FROM run_events e WHERE e.run_id = runs.id), 0), ? FROM runs WHERE id = ? AND changes() = 1 ON CONFLICT (run_id) DO UPDATE SET first_seq = excluded.first_seq, high_water_seq = MAX(run_retention.high_water_seq, excluded.high_water_seq), updated_at_ms = excluded.updated_at_ms",
            params: [sql_int(input.now_ms.copy()), sql_text(input.run_id.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        }
    ];
    sqlite::transaction(&db_id, statements)
}

pub fn storage_run_link_child(db_id: resource<sqlite.connection>, payload_json: string) -> map {
    let input: ChildLinkInput = json::decode::<ChildLinkInput>(payload_json);
    let mut result = { ok: true, code: "ok", message: "", result: { columns: [], rows: [] } };
    if !(sqlite::query(&db_id, existence::run_exists_sql(), [sql_text(input.parent_run_id.copy())], sql_limits(1, 4096)).rows.length > 0) {
        result = { ok: false, code: "run_not_found", message: "parent or child run does not exist", result: { columns: [], rows: [] } };
    } else {
        if !(sqlite::query(&db_id, existence::run_exists_sql(), [sql_text(input.child_run_id.copy())], sql_limits(1, 4096)).rows.length > 0) {
            result = { ok: false, code: "run_not_found", message: "parent or child run does not exist", result: { columns: [], rows: [] } };
        } else {
            // Idempotent: re-linking an existing pair is a no-op success,
            // never an orphan write or a duplicate error.
            sqlite::execute(&db_id, "INSERT OR IGNORE INTO child_run_links (parent_run_id, child_run_id, ordinal, relation, state, created_at_ms) SELECT ?, ?, ?, ?, ?, ? WHERE EXISTS (SELECT 1 FROM runs WHERE id = ?) AND EXISTS (SELECT 1 FROM runs WHERE id = ?)", [sql_text(input.parent_run_id.copy()), sql_text(input.child_run_id.copy()), sql_int(input.ordinal.copy()), sql_text(input.relation.copy()), sql_text(input.state.copy()), sql_int(input.now_ms.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.child_run_id.copy())]);
            result = {
                ok: true,
                code: "ok",
                message: "",
                result: sqlite::query(&db_id, "SELECT parent_run_id, child_run_id, ordinal, relation, state, created_at_ms FROM child_run_links WHERE parent_run_id = ? AND child_run_id = ? LIMIT 1", [sql_text(input.parent_run_id.copy()), sql_text(input.child_run_id.copy())], sql_limits(1, 4096))
            };
        }
    }
    result
}

/// One atomic terminal commit: the run transitions to a terminal status and
/// its terminal events (and optional assistant message) are appended in the
/// same transaction, so a terminal state is durable before anything is
/// published and a failed commit leaves no partial terminal state.
/// Sequence numbers are allocated transactionally as `max(seq) + 1` per run;
/// the returned rows let the caller reconcile in-memory sequences.
/// Strict extraction of one string member from the frozen publication document.
fn json_extract_text(document: string, path: string) -> string {
    let parsed: map = json::decode(document.copy());
    let mut text: string = "";
    if path == "$.proof" {
        let value: string = parsed["proof"].copy();
        text = value;
    }
    text
}

/// One atomic required-publication completion. The run terminal events,
/// assistant message, status transition, workspace pointer revision and
/// publication receipt commit in the same transaction, with every semantic
/// success predicate and exact-row guard in this statement array before commit.
/// The single entry owns the Native resource directly; replay, guard abort and
/// post-commit readback all happen here so no resource is forwarded onward.
pub fn storage_run_terminal_published(db_id: resource<sqlite.connection>, payload_json: string) -> map {
    let raw_payload: map = json::decode(payload_json.copy());
    let input: RunTerminalPublishedInput = json::decode::<RunTerminalPublishedInput>(payload_json.copy());
    assert(input.to_status.copy() == "completed");
    let mut reserved_ordinal: int = 0;
    if raw_payload.has("message_ordinal") {
        reserved_ordinal = raw_payload["message_ordinal"].copy();
    }
    // Read-only replay precheck: an exact receipt for this frozen request with
    // the run already completed writes nothing and returns the existing rows.
    let existing: SqliteQueryResult = sqlite::query(&db_id, "SELECT json_object('proof',original_request_proof,'receipt',json(receipt_json),'run_status',(SELECT status FROM runs WHERE id=json_extract(?,'$.run_id'))) AS record_json FROM managed_publish_receipts WHERE workspace_id=json_extract(?,'$.workspace_id') AND request_id=json_extract(?,'$.request_id')", [sql_text(input.run_id.copy()), sql_text(input.publication_json.copy()), sql_text(input.publication_json.copy())], sql_limits(1, 65536));
    let existing_rows = existing.rows;
    let mut replay: bool = false;
    let mut conflict: bool = false;
    let mut inconsistent: bool = false;
    if existing_rows.length > 0 {
        replay = true;
        let saved_row: SqliteRow = existing_rows[0].copy();
        let saved = saved_row.cells[0].text_value;
        let saved_decode: map = json::decode(saved.copy());
        let saved_proof: string = saved_decode["proof"].copy();
        let frozen_proof: string = json_extract_text(input.publication_json.copy(), "$.proof");
        if saved_proof != frozen_proof {
            conflict = true;
            replay = false;
        } else {
            let saved_status: string = saved_decode["run_status"].copy();
            if saved_status != "completed" {
                inconsistent = true;
                replay = false;
            }
        }
    }
    let publication = input.publication_json.copy();
    if !replay && !conflict && !inconsistent {

        let mut statements: array<SqliteStatement> = [];
        // Pre-commit guards: exact Native binding and running run. The session
        // relation is exact identity only: `sessions.profile` is the platform
        // session address written by session.create, while the managed
        // workspace principal is `managed_workspaces.profile`/binding profile.
        statements[statements.length] = {
            sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE NOT EXISTS (SELECT 1 FROM managed_run_bindings b JOIN runs r ON r.id=b.run_id JOIN sessions s ON s.id=b.session_id JOIN managed_workspaces w ON w.workspace_id=b.workspace_id AND w.profile=b.profile JOIN managed_branches h ON h.workspace_id=b.workspace_id AND h.branch_id=b.branch_id AND h.store_id=w.store_id WHERE b.run_id=json_extract(?,'$.run_id') AND b.profile=json_extract(?,'$.profile') AND b.session_id=json_extract(?,'$.session_id') AND b.workspace_id=json_extract(?,'$.workspace_id') AND b.branch_id=json_extract(?,'$.branch_id') AND b.epoch=json_extract(?,'$.epoch') AND b.schema_version=1 AND r.status='running' AND r.session_id=b.session_id)",
            params: [sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy())],
            query: false,
            limits: sql_limits(1000, 4194304)
        };
        // No other active run on this branch.
        statements[statements.length] = {
            sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE EXISTS (SELECT 1 FROM managed_run_bindings b JOIN runs r ON r.id=b.run_id WHERE b.workspace_id=json_extract(?,'$.workspace_id') AND b.branch_id=json_extract(?,'$.branch_id') AND b.run_id<>json_extract(?,'$.run_id') AND r.status NOT IN ('completed','failed','cancelled'))",
            params: [sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy())],
            query: false,
            limits: sql_limits(1000, 4194304)
        };
        // No unresolved managed effect on this branch.
        statements[statements.length] = {
            sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE EXISTS (SELECT 1 FROM managed_effect_calls WHERE workspace_id=json_extract(?,'$.workspace_id') AND branch_id=json_extract(?,'$.branch_id') AND state IN ('intent','prepared','indeterminate'))",
            params: [sql_text(publication.copy()), sql_text(publication.copy())],
            query: false,
            limits: sql_limits(1000, 4194304)
        };
        // Exact branch root/generation/epoch/store/schema/lineage.
        statements[statements.length] = {
            sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE NOT EXISTS (SELECT 1 FROM managed_branches b JOIN managed_workspaces w ON w.workspace_id=b.workspace_id AND w.profile=json_extract(?,'$.profile') WHERE b.workspace_id=json_extract(?,'$.expected_head.workspace_id') AND b.branch_id=json_extract(?,'$.expected_head.branch_id') AND b.status='active' AND b.epoch=json_extract(?,'$.expected_head.epoch') AND b.head_object_id=json_extract(?,'$.expected_head.head_object_id') AND b.head_version=json_extract(?,'$.expected_head.head_version') AND b.store_id=json_extract(?,'$.expected_head.store_id') AND b.schema_version=json_extract(?,'$.expected_head.schema_version') AND b.process_lineage_tainted=json_extract(?,'$.expected_head.process_lineage_tainted'))",
            params: [sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy())],
            query: false,
            limits: sql_limits(1000, 4194304)
        };
        // Absolute lineage success predicate: the admitted branch must be
        // untainted, and the frozen expected head must agree. Equality of two
        // tainted values is not success, and the frozen expected-head false
        // condition is covered because the durable column is independently
        // required to be zero.
        statements[statements.length] = {
            sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE NOT EXISTS (SELECT 1 FROM managed_branches b WHERE b.workspace_id=json_extract(?,'$.expected_head.workspace_id') AND b.branch_id=json_extract(?,'$.expected_head.branch_id') AND b.process_lineage_tainted=0 AND json_extract(?,'$.expected_head.process_lineage_tainted')=0)",
            params: [sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy())],
            query: false,
            limits: sql_limits(1000, 4194304)
        };
        // Fresh Native source observation against the durable captured source
        // identity of this admitted workspace. The observation is taken from
        // the admitted path after the precommit pause; an equal-bytes
        // directory at another inode must never publish, and the frozen
        // captured value must agree with both.
        statements[statements.length] = {
            sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE NOT EXISTS (SELECT 1 FROM managed_workspaces w WHERE w.workspace_id=json_extract(?,'$.workspace_id') AND w.profile=json_extract(?,'$.profile') AND w.source_device=json_extract(?,'$.fresh_source_identity.device_decimal') AND w.source_inode=json_extract(?,'$.fresh_source_identity.inode_decimal') AND json_extract(?,'$.captured_source_identity.device_decimal')=json_extract(?,'$.fresh_source_identity.device_decimal') AND json_extract(?,'$.captured_source_identity.inode_decimal')=json_extract(?,'$.fresh_source_identity.inode_decimal'))",
            params: [sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy())],
            query: false,
            limits: sql_limits(1000, 4194304)
        };
        // Fresh Native authority generation against the value captured by the
        // admitted grant. Two equal real reads are the success fact; a stale
        // capture never publishes through this transaction.
        statements[statements.length] = {
            sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE json_extract(?,'$.authority_generation') IS NOT json_extract(?,'$.observed_authority_generation') OR json_extract(?,'$.authority_generation')<1",
            params: [sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy())],
            query: false,
            limits: sql_limits(1000, 4194304)
        };
        // Cross-action request-id conflict: one request id never names two actions.
        statements[statements.length] = {
            sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE EXISTS (SELECT 1 FROM managed_publish_receipts WHERE workspace_id=json_extract(?,'$.workspace_id') AND request_id=json_extract(?,'$.request_id') AND original_request_proof<>json_extract(?,'$.proof')) OR EXISTS (SELECT 1 FROM managed_branch_receipts WHERE workspace_id=json_extract(?,'$.workspace_id') AND request_id=json_extract(?,'$.request_id')) OR EXISTS (SELECT 1 FROM managed_checkpoints WHERE workspace_id=json_extract(?,'$.workspace_id') AND request_id=json_extract(?,'$.request_id')) OR EXISTS (SELECT 1 FROM managed_restore_receipts WHERE workspace_id=json_extract(?,'$.workspace_id') AND request_id=json_extract(?,'$.request_id'))",
            params: [sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy())],
            query: false,
            limits: sql_limits(1000, 4194304)
        };
        // Pointer revision CAS.
        statements[statements.length] = {
            sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE (json_extract(?,'$.expected_revision')=0 AND EXISTS (SELECT 1 FROM managed_workspace_publications WHERE workspace_id=json_extract(?,'$.workspace_id'))) OR (json_extract(?,'$.expected_revision')<>0 AND NOT EXISTS (SELECT 1 FROM managed_workspace_publications WHERE workspace_id=json_extract(?,'$.workspace_id') AND revision=json_extract(?,'$.expected_revision')))",
            params: [sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy()), sql_text(publication.copy())],
            query: false,
            limits: sql_limits(1000, 4194304)
        };
        // Exact graph revocation facts for this run's admitted pin. A run with
        // no admitted graph pin has no revocation constraint (non-anchor stays
        // Unresolved only through the branch owner, never a fabricated pin).
        statements[statements.length] = {
            sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE EXISTS (SELECT 1 FROM plugin_graph_pin_requirements q JOIN plugin_graph_revocations r ON r.graph_id=q.graph_id WHERE q.run_id=json_extract(?,'$.run_id'))",
