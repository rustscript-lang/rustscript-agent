use json;
use sqlite;

fn no_int() -> Option<int> { None }
fn no_float() -> Option<float> { None }
fn no_string() -> Option<string> { None }
fn no_bytes() -> Option<bytes> { None }

fn sql_text(value: string) -> SqliteValue {
    { kind: "text", int_value: no_int(), float_value: no_float(), text_value: Some(value), blob_value: no_bytes() }
}

fn sql_int(value: int) -> SqliteValue {
    { kind: "int", int_value: Some(value), float_value: no_float(), text_value: no_string(), blob_value: no_bytes() }
}

fn sql_limits(max_rows: int, max_bytes: int) -> SqliteLimits {
    {
        max_connections: Some(16),
        max_statements: Some(128),
        max_rows: Some(max_rows),
        max_columns: Some(128),
        max_result_bytes: Some(max_bytes),
        max_statement_bytes: Some(1048576),
        max_parameters: Some(128),
        max_parameter_bytes: Some(1048576),
        max_pending_operations: Some(32),
        max_transaction_ms: Some(5000),
        busy_timeout_ms: Some(5000)
    }
}

use self::schema as schema;
use self::existence as existence;

fn approvals_query_limits(max_rows: int, max_bytes: int) -> SqliteLimits {
    sql_limits(max_rows, max_bytes)
}

struct ApprovalRequestInput {
    id: string,
    run_id: string,
    session_id: string,
    tool_call_id: string,
    tool_name: string,
    arguments_json: string,
    risk_class: string,
    decision_scope: string,
    one_time: int,
    requested_at_ms: int,
    expires_at_ms: int
}

struct ApprovalResolveInput {
    id: string,
    run_id: string,
    state: string,
    resolver: string,
    decision_reason: string,
    resolved_at_ms: int
}

struct ApprovalExpireInput {
    now_ms: int,
    run_id: string,
    force: int
}

struct ApprovalListInput {
    run_id: string,
    session_id: string
}

pub fn storage_approval_request(db_id: resource<sqlite.connection>, payload_json: string, max_rows: int, max_bytes: int) -> map {
    let input: ApprovalRequestInput = json::decode::<ApprovalRequestInput>(payload_json);
    let mut result = { ok: true, code: "ok", message: "", result: { columns: [], rows: [] } };
    let params: array<SqliteValue> = [sql_text(input.run_id.copy())];
    if !(sqlite::query(&db_id, existence::run_exists_sql(), params, sql_limits(1, 4096)).rows.length > 0) {
        result = { ok: false, code: "run_not_found", message: "approval request references an unknown run or session", result: { columns: [], rows: [] } };
    } else {
        let params: array<SqliteValue> = [sql_text(input.session_id.copy())];
        if !(sqlite::query(&db_id, existence::session_exists_sql(), params, sql_limits(1, 4096)).rows.length > 0) {
            result = { ok: false, code: "run_not_found", message: "approval request references an unknown run or session", result: { columns: [], rows: [] } };
        } else {
            let params: array<SqliteValue> = [sql_text(input.id.copy()), sql_text(input.run_id.copy()), sql_text(input.session_id.copy()), sql_text(input.tool_call_id.copy()), sql_text(input.tool_name.copy()), sql_text(input.arguments_json.copy()), sql_text(input.risk_class.copy()), sql_text(input.decision_scope.copy()), sql_int(input.one_time.copy()), sql_int(input.requested_at_ms.copy()), sql_int(input.expires_at_ms.copy()), sql_text(input.run_id.copy()), sql_text(input.session_id.copy()), sql_text(input.id.copy()), sql_text(input.session_id.copy())];
            sqlite::execute(&db_id, "INSERT OR IGNORE INTO approvals (id, run_id, session_id, tool_call_id, tool_name, arguments_json, risk_class, state, decision_scope, one_time, requested_at_ms, expires_at_ms) SELECT ?, ?, ?, ?, ?, ?, ?, 'pending', ?, ?, ?, ? WHERE EXISTS (SELECT 1 FROM runs WHERE runs.id = ? AND runs.session_id = ? AND runs.status IN ('running', 'waiting_approval')) AND NOT EXISTS (SELECT 1 FROM approvals existing JOIN runs owner ON owner.id = existing.run_id WHERE existing.id = ? AND owner.session_id <> ?)", params);
            let params: array<SqliteValue> = [sql_text(input.id.copy()), sql_text(input.session_id.copy()), sql_int(max_rows)];
            result = {
                ok: true,
                code: "ok",
                message: "",
                result: sqlite::query(&db_id, "SELECT id, run_id, session_id, tool_call_id, tool_name, arguments_json, risk_class, state, decision_scope, one_time, requested_at_ms, expires_at_ms, resolved_at_ms, resolver, decision_reason FROM approvals WHERE id = ? AND session_id = ? LIMIT ?", params, approvals_query_limits(max_rows, max_bytes))
            };
        }
    }
    result
}

pub fn storage_approval_get(db_id: resource<sqlite.connection>, approval_id: string, max_rows: int, max_bytes: int) -> SqliteQueryResult {
    let params: array<SqliteValue> = [sql_text(approval_id), sql_int(max_rows)];
    sqlite::query(&db_id, "SELECT id, run_id, session_id, tool_call_id, tool_name, arguments_json, risk_class, state, decision_scope, one_time, requested_at_ms, expires_at_ms, resolved_at_ms, resolver, decision_reason FROM approvals WHERE id = ? LIMIT ?", params, approvals_query_limits(max_rows, max_bytes))
}

pub fn storage_approval_list(db_id: resource<sqlite.connection>, payload_json: string, max_rows: int, max_bytes: int) -> SqliteQueryResult {
    let input: ApprovalListInput = json::decode::<ApprovalListInput>(payload_json);
    let params: array<SqliteValue> = [sql_text(input.run_id.copy()), sql_text(input.session_id.copy()), sql_int(max_rows)];
    sqlite::query(&db_id, "SELECT id, run_id, session_id, tool_call_id, tool_name, arguments_json, risk_class, state, decision_scope, one_time, requested_at_ms, expires_at_ms, resolved_at_ms, resolver, decision_reason FROM approvals WHERE run_id = ? AND session_id = ? AND state = 'pending' ORDER BY requested_at_ms ASC, id ASC LIMIT ?", params, approvals_query_limits(max_rows, max_bytes))
}

pub fn storage_approval_resolve(db_id: resource<sqlite.connection>, payload_json: string) -> SqliteExecuteResult {
    let input: ApprovalResolveInput = json::decode::<ApprovalResolveInput>(payload_json);
    assert(input.state.copy() == "approved" || input.state.copy() == "denied");
    let params: array<SqliteValue> = [sql_text(input.state.copy()), sql_text(input.resolver.copy()), sql_text(input.decision_reason.copy()), sql_int(input.resolved_at_ms.copy()), sql_text(input.id.copy()), sql_text(input.run_id.copy()), sql_int(input.resolved_at_ms.copy())];
    sqlite::execute(&db_id, "UPDATE approvals SET state = ?, resolver = ?, decision_reason = ?, resolved_at_ms = ? WHERE id = ? AND run_id = ? AND state = 'pending' AND (expires_at_ms <= 0 OR expires_at_ms > ?) AND EXISTS (SELECT 1 FROM runs WHERE runs.id = approvals.run_id AND runs.status IN ('running', 'waiting_approval'))", params)
}

pub fn storage_approval_expire(db_id: resource<sqlite.connection>, payload_json: string) -> SqliteExecuteResult {
    let input: ApprovalExpireInput = json::decode::<ApprovalExpireInput>(payload_json);
    assert(input.force.copy() == 0 || input.force.copy() == 1);
    let params: array<SqliteValue> = [sql_int(input.now_ms.copy()), sql_int(input.now_ms.copy())];
    let mut result: SqliteExecuteResult = sqlite::execute(&db_id, "UPDATE approvals SET state = 'expired', resolved_at_ms = ?, resolver = 'storage-expiry' WHERE state = 'pending' AND expires_at_ms > 0 AND expires_at_ms <= ?", params);
    if input.run_id.copy().length > 0 {
        let params: array<SqliteValue> = [sql_int(input.now_ms.copy()), sql_text(input.run_id.copy()), sql_int(input.force.copy()), sql_int(input.now_ms.copy())];
        result = sqlite::execute(&db_id, "UPDATE approvals SET state = 'expired', resolved_at_ms = ?, resolver = 'storage-expiry' WHERE state = 'pending' AND run_id = ? AND (? = 1 OR (expires_at_ms > 0 AND expires_at_ms <= ?))", params);
    }
    result
}
