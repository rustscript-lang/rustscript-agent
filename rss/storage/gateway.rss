// LEGACY ADAPTER — NOT USED BY PRODUCTION.
//
// This module is the pre-A2-fix blob-per-record gateway storage path
// (gateway_sessions/gateway_runs/gateway_jobs/gateway_events/
// gateway_idempotency tables keyed by opaque record ids). Production now
// reads and writes only the normalized typed schema through `main.rss`
// (sessions/messages/runs/run_events/approvals/compactions/jobs/...), and
// `main.rss` never imports this module. This file is retained solely as the
// explicit legacy adapter for the unreleased prototype format (fixtures and
// compatibility tests); it must not be re-wired into the gateway.
use json;
use sqlite;

fn no_int() -> Option<int> { None }
fn no_float() -> Option<float> { None }
fn no_string() -> Option<string> { None }
fn no_bytes() -> Option<bytes> { None }

fn sql_text(value: string) -> SqliteValue {
    { kind: "text", int_value: no_int(), float_value: no_float(), text_value: Some(value), blob_value: no_bytes() }
}

fn sql_int(value: int) -> SqliteValue {
    { kind: "int", int_value: Some(value), float_value: no_float(), text_value: no_string(), blob_value: no_bytes() }
}

fn sql_limits(max_rows: int, max_bytes: int) -> SqliteLimits {
    {
        max_connections: Some(16),
        max_statements: Some(128),
        max_rows: Some(max_rows),
        max_columns: Some(128),
        max_result_bytes: Some(max_bytes),
        max_statement_bytes: Some(1048576),
        max_parameters: Some(128),
        max_parameter_bytes: Some(1048576),
        max_pending_operations: Some(32),
        max_transaction_ms: Some(5000),
        busy_timeout_ms: Some(5000)
    }
}

struct GatewayCommand {
    op: string,
    kind: string,
    record_id: string,
    db_path: string,
    db_mode: string,
    busy_timeout_ms: int,
    max_rows: int,
    max_bytes: int,
    max_events: int,
    max_messages: int,
    now_ms: int,
    payload_json: string
}

fn gateway_limits(command: GatewayCommand) -> SqliteLimits {
    sql_limits(command.max_rows, command.max_bytes)
}

fn gateway_open(command: GatewayCommand) -> resource<sqlite.connection> {
    let no_root: Option<string> = None;
    let options: SqliteOpenOptions = {
        path: Some(command.db_path),
        mode: Some(command.db_mode),
        root: no_root,
        limits: Some(sql_limits(command.max_rows, command.max_bytes))
    };
    sqlite::open(options)
}

/// One per-record upsert: sessions/runs/jobs/idempotency replace their row by
/// record_id; events additionally prune the run's retained tail to the
/// configured `max_events` so durable history matches in-memory retention.
fn gateway_put(db_id: resource<sqlite.connection>, command: GatewayCommand) -> map {
    if command.kind.copy() == "session" => {
        let params: array<SqliteValue> = [sql_text(command.record_id.copy()), sql_text(command.payload_json.copy()), sql_int(command.now_ms.copy())];
        sqlite::execute(&db_id, "INSERT INTO gateway_sessions (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?) ON CONFLICT (record_id) DO UPDATE SET payload_json = excluded.payload_json, updated_at_ms = excluded.updated_at_ms", params)
    } else => {
        if command.kind.copy() == "run" => {
            let params: array<SqliteValue> = [sql_text(command.record_id.copy()), sql_text(command.payload_json.copy()), sql_int(command.now_ms.copy())];
            sqlite::execute(&db_id, "INSERT INTO gateway_runs (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?) ON CONFLICT (record_id) DO UPDATE SET payload_json = excluded.payload_json, updated_at_ms = excluded.updated_at_ms", params)
        } else => {
            if command.kind.copy() == "job" => {
                let params: array<SqliteValue> = [sql_text(command.record_id.copy()), sql_text(command.payload_json.copy()), sql_int(command.now_ms.copy())];
                sqlite::execute(&db_id, "INSERT INTO gateway_jobs (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?) ON CONFLICT (record_id) DO UPDATE SET payload_json = excluded.payload_json, updated_at_ms = excluded.updated_at_ms", params)
            } else => {
                if command.kind.copy() == "event" => {
                    let upsert_params: array<SqliteValue> = [sql_text(command.record_id.copy()), sql_text(command.payload_json.copy()), sql_int(command.now_ms.copy())];
                    let prune_params: array<SqliteValue> = [sql_text(command.record_id.copy()), sql_text(command.record_id.copy()), sql_text(command.record_id.copy()), sql_text(command.record_id.copy()), sql_int(command.max_events.copy()), sql_int(command.max_events.copy()), sql_int(command.max_events.copy())];
                    let event_statements: array<SqliteStatement> = [
                        {
                            sql: "INSERT INTO gateway_events (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?) ON CONFLICT (record_id) DO UPDATE SET payload_json = excluded.payload_json, updated_at_ms = excluded.updated_at_ms",
                            params: Some(upsert_params),
                        query: Some(false),
                        limits: Some(sql_limits(1000, 4194304))
                        },
                        {
                            sql: "DELETE FROM gateway_events WHERE substr(record_id, 1, instr(record_id, ':') - 1) = substr(?, 1, instr(?, ':') - 1) AND record_id NOT IN (SELECT record_id FROM gateway_events WHERE substr(record_id, 1, instr(record_id, ':') - 1) = substr(?, 1, instr(?, ':') - 1) ORDER BY record_id DESC LIMIT CASE WHEN ? <= 0 THEN 128 WHEN ? > 256 THEN 256 ELSE ? END)",
                            params: Some(prune_params),
                        query: Some(false),
                        limits: Some(sql_limits(1000, 4194304))
                        }
                    ];
                    { results: sqlite::transaction(&db_id, event_statements) }
                } else => {
                    if command.kind.copy() == "idempotency" => {
                        let params: array<SqliteValue> = [sql_text(command.record_id.copy()), sql_text(command.payload_json.copy()), sql_int(command.now_ms.copy())];
                        sqlite::execute(&db_id, "INSERT INTO gateway_idempotency (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?) ON CONFLICT (record_id) DO UPDATE SET payload_json = excluded.payload_json, updated_at_ms = excluded.updated_at_ms", params)
                    } else => {
                        sqlite::execute(&db_id, "SELECT 1", [])
                    }
                }
            }
        }
    }
}

/// One per-record deletion; events delete by exact id or run prefix so a
/// session/run cascade can remove a run's whole retained history.
fn gateway_delete(db_id: resource<sqlite.connection>, command: GatewayCommand) -> map {
    if command.kind.copy() == "event" => {
        let params: array<SqliteValue> = [sql_text(command.record_id.copy()), sql_text(command.record_id.copy())];
        sqlite::execute(&db_id, "DELETE FROM gateway_events WHERE record_id = ? OR record_id LIKE ? || ':%'", params)
    } else => {
        if command.kind.copy() == "session" => {
            let params: array<SqliteValue> = [sql_text(command.record_id.copy())];
            sqlite::execute(&db_id, "DELETE FROM gateway_sessions WHERE record_id = ?", params)
        } else => {
            if command.kind.copy() == "run" => {
                let params: array<SqliteValue> = [sql_text(command.record_id.copy())];
                sqlite::execute(&db_id, "DELETE FROM gateway_runs WHERE record_id = ?", params)
            } else => {
                if command.kind.copy() == "job" => {
                    let params: array<SqliteValue> = [sql_text(command.record_id.copy())];
                    sqlite::execute(&db_id, "DELETE FROM gateway_jobs WHERE record_id = ?", params)
                } else => {
                    if command.kind.copy() == "idempotency" => {
                        let params: array<SqliteValue> = [sql_text(command.record_id.copy())];
                        sqlite::execute(&db_id, "DELETE FROM gateway_idempotency WHERE record_id = ?", params)
                    } else => {
                        sqlite::execute(&db_id, "SELECT 1", [])
                    }
                }
            }
        }
    }
}

pub fn run(command: GatewayCommand) -> map {
let db_id = gateway_open(command.copy());
sqlite::execute(&db_id, "CREATE TABLE IF NOT EXISTS gateway_sessions (record_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at_ms INTEGER NOT NULL)", []);
sqlite::execute(&db_id, "CREATE TABLE IF NOT EXISTS gateway_runs (record_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at_ms INTEGER NOT NULL)", []);
sqlite::execute(&db_id, "CREATE TABLE IF NOT EXISTS gateway_jobs (record_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at_ms INTEGER NOT NULL)", []);
sqlite::execute(&db_id, "CREATE TABLE IF NOT EXISTS gateway_events (record_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at_ms INTEGER NOT NULL)", []);
sqlite::execute(&db_id, "CREATE TABLE IF NOT EXISTS gateway_idempotency (record_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at_ms INTEGER NOT NULL)", []);
let raw_result: map = if command.op.copy() == "load" => {
    let params: array<SqliteValue> = [sql_int(command.max_rows.copy())];
    sqlite::query(&db_id, "SELECT 'session' AS kind, record_id, payload_json FROM gateway_sessions UNION ALL SELECT 'run', record_id, payload_json FROM gateway_runs UNION ALL SELECT 'job', record_id, payload_json FROM gateway_jobs UNION ALL SELECT 'event', record_id, payload_json FROM gateway_events UNION ALL SELECT 'idempotency', record_id, payload_json FROM gateway_idempotency ORDER BY kind, record_id LIMIT ?", params, gateway_limits(command.copy()))
} else => {
    if command.op.copy() == "put" => {
        gateway_put(db_id, command.copy())
    } else => {
        if command.op.copy() == "delete" => {
            gateway_delete(db_id, command.copy())
        } else => {
            sqlite::execute(&db_id, "SELECT 1", [])
        }
    }
};
sqlite::close(db_id);
{
    ok: true,
    op: command.op.copy(),
    data: raw_result
}
}
