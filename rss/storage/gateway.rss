use json;
use sqlite;

struct GatewayCommand {
    op: string,
    kind: string,
    record_id: string,
    db_path: string,
    db_mode: string,
    busy_timeout_ms: int,
    max_rows: int,
    max_bytes: int,
    max_events: int,
    max_messages: int,
    now_ms: int,
    payload_json: string
}

struct GatewayRecord {
    record_id: string,
    payload_json: string
}

struct GatewayBatch {
    sessions: GatewayRecord[],
    runs: GatewayRecord[],
    jobs: GatewayRecord[],
    events: GatewayRecord[],
    idempotency: GatewayRecord[]
}

fn gateway_limits(command: GatewayCommand) -> map<int> {
    {max_rows: command.max_rows, max_result_bytes: command.max_bytes}
}

fn gateway_open(command: GatewayCommand) -> int {
    sqlite::open({
        path: command.db_path,
        mode: command.db_mode,
        limits: {
            busy_timeout_ms: command.busy_timeout_ms,
            max_connections: 1,
            max_rows: command.max_rows,
            max_result_bytes: command.max_bytes,
            max_statements: 1024,
            max_transaction_ms: 5000
        }
    })
}

pub fn run(command: GatewayCommand) -> map {
let db_id = gateway_open(command.copy());
sqlite::execute(db_id, "CREATE TABLE IF NOT EXISTS gateway_sessions (record_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at_ms INTEGER NOT NULL)", []);
sqlite::execute(db_id, "CREATE TABLE IF NOT EXISTS gateway_runs (record_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at_ms INTEGER NOT NULL)", []);
sqlite::execute(db_id, "CREATE TABLE IF NOT EXISTS gateway_jobs (record_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at_ms INTEGER NOT NULL)", []);
sqlite::execute(db_id, "CREATE TABLE IF NOT EXISTS gateway_events (record_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at_ms INTEGER NOT NULL)", []);
sqlite::execute(db_id, "CREATE TABLE IF NOT EXISTS gateway_idempotency (record_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at_ms INTEGER NOT NULL)", []);
let raw_result: map = if command.op.copy() == "load" => {
    sqlite::query(db_id, "SELECT 'session' AS kind, record_id, payload_json FROM gateway_sessions UNION ALL SELECT 'run', record_id, payload_json FROM gateway_runs UNION ALL SELECT 'job', record_id, payload_json FROM gateway_jobs UNION ALL SELECT 'event', record_id, payload_json FROM gateway_events UNION ALL SELECT 'idempotency', record_id, payload_json FROM gateway_idempotency ORDER BY kind, record_id LIMIT ?", [command.max_rows.copy()], gateway_limits(command.copy()))
} else => {
    if command.op.copy() == "replace" => {
        let batch: GatewayBatch = json::decode::<GatewayBatch>(command.payload_json.copy());
        let sessions = batch.sessions.copy();
        let runs = batch.runs.copy();
        let jobs = batch.jobs.copy();
        let events = batch.events.copy();
        let idempotency = batch.idempotency.copy();
        let mut statements = [
            { sql: "DELETE FROM gateway_sessions", params: [] },
            { sql: "DELETE FROM gateway_runs", params: [] },
            { sql: "DELETE FROM gateway_jobs", params: [] },
            { sql: "DELETE FROM gateway_events", params: [] },
            { sql: "DELETE FROM gateway_idempotency", params: [] }
        ];
        let mut index = 0;
        while index < sessions.length {
            let record = sessions[index].copy();
            statements[statements.length] = { sql: "INSERT INTO gateway_sessions (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?)" , params: [record.record_id, record.payload_json, command.now_ms.copy()] };
            index += 1;
        }
        index = 0;
        while index < runs.length {
            let record = runs[index].copy();
            statements[statements.length] = { sql: "INSERT INTO gateway_runs (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?)" , params: [record.record_id, record.payload_json, command.now_ms.copy()] };
            index += 1;
        }
        index = 0;
        while index < jobs.length {
            let record = jobs[index].copy();
            statements[statements.length] = { sql: "INSERT INTO gateway_jobs (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?)" , params: [record.record_id, record.payload_json, command.now_ms.copy()] };
            index += 1;
        }
        index = 0;
        while index < events.length {
            let record = events[index].copy();
            statements[statements.length] = { sql: "INSERT INTO gateway_events (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?)" , params: [record.record_id, record.payload_json, command.now_ms.copy()] };
            index += 1;
        }
        index = 0;
        while index < idempotency.length {
            let record = idempotency[index].copy();
            statements[statements.length] = { sql: "INSERT INTO gateway_idempotency (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?)" , params: [record.record_id, record.payload_json, command.now_ms.copy()] };
            index += 1;
        }
        sqlite::transaction(db_id, statements);
        sqlite::query(db_id, "SELECT 1 AS committed", [], gateway_limits(command.copy()))
    } else => {
        if command.op.copy() == "clear" => {
            sqlite::execute(db_id, "DELETE FROM gateway_sessions", []);
            sqlite::execute(db_id, "DELETE FROM gateway_runs", []);
            sqlite::execute(db_id, "DELETE FROM gateway_jobs", []);
            sqlite::execute(db_id, "DELETE FROM gateway_events", []);
            sqlite::execute(db_id, "DELETE FROM gateway_idempotency", [])
        } else => {
            if command.op.copy() == "put" => {
                if command.kind.copy() == "session" => {
                    sqlite::execute(db_id, "INSERT INTO gateway_sessions (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?) ON CONFLICT (record_id) DO UPDATE SET payload_json = excluded.payload_json, updated_at_ms = excluded.updated_at_ms", [command.record_id.copy(), command.payload_json.copy(), command.now_ms.copy()])
                } else => {
                    if command.kind.copy() == "run" => {
                        sqlite::execute(db_id, "INSERT INTO gateway_runs (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?) ON CONFLICT (record_id) DO UPDATE SET payload_json = excluded.payload_json, updated_at_ms = excluded.updated_at_ms", [command.record_id.copy(), command.payload_json.copy(), command.now_ms.copy()])
                    } else => {
                        if command.kind.copy() == "job" => {
                            sqlite::execute(db_id, "INSERT INTO gateway_jobs (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?) ON CONFLICT (record_id) DO UPDATE SET payload_json = excluded.payload_json, updated_at_ms = excluded.updated_at_ms", [command.record_id.copy(), command.payload_json.copy(), command.now_ms.copy()])
                        } else => {
                            if command.kind.copy() == "event" => {
                                sqlite::execute(db_id, "INSERT INTO gateway_events (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?) ON CONFLICT (record_id) DO UPDATE SET payload_json = excluded.payload_json, updated_at_ms = excluded.updated_at_ms", [command.record_id.copy(), command.payload_json.copy(), command.now_ms.copy()])
                            } else => {
                                sqlite::execute(db_id, "INSERT INTO gateway_idempotency (record_id, payload_json, updated_at_ms) VALUES (?, ?, ?) ON CONFLICT (record_id) DO UPDATE SET payload_json = excluded.payload_json, updated_at_ms = excluded.updated_at_ms", [command.record_id.copy(), command.payload_json.copy(), command.now_ms.copy()])
                            }
                        }
                    }
                }
            } else => {
                sqlite::execute(db_id, "SELECT 1", [])
            }
        }
    }
};
sqlite::close(db_id);
{
    ok: true,
    op: command.op.copy(),
    data: raw_result
}
}
