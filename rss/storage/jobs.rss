// Typed job commands over the normalized `jobs` table. Jobs are gateway
// domain records (schedules are JSON-encoded); every mutation is a typed
// command so production never writes blob rows.
use json;
use sqlite;

fn no_int() -> Option<int> { None }
fn no_float() -> Option<float> { None }
fn no_string() -> Option<string> { None }
fn no_bytes() -> Option<bytes> { None }

fn sql_text(value: string) -> SqliteValue {
    { kind: "text", int_value: no_int(), float_value: no_float(), text_value: Some(value), blob_value: no_bytes() }
}

fn sql_int(value: int) -> SqliteValue {
    { kind: "int", int_value: Some(value), float_value: no_float(), text_value: no_string(), blob_value: no_bytes() }
}

fn sql_limits(max_rows: int, max_bytes: int) -> SqliteLimits {
    {
        max_connections: Some(16),
        max_statements: Some(128),
        max_rows: Some(max_rows),
        max_columns: Some(128),
        max_result_bytes: Some(max_bytes),
        max_statement_bytes: Some(1048576),
        max_parameters: Some(128),
        max_parameter_bytes: Some(1048576),
        max_pending_operations: Some(32),
        max_transaction_ms: Some(5000),
        busy_timeout_ms: Some(5000)
    }
}

fn sqlite_query_map(result: SqliteQueryResult) -> map {
    {
        columns: result.columns,
        rows: result.rows,
        truncated: result.truncated
    }
}

fn jobs_query_limits(max_rows: int, max_bytes: int) -> SqliteLimits {
    sql_limits(max_rows, max_bytes)
}

struct JobCreateInput {
    id: string,
    name: string,
    schedule_json: string,
    prompt: string,
    deliver_json: string,
    skills_json: string,
    repeat_count: int,
    enabled: int,
    now_ms: int
}

struct JobUpdateInput {
    id: string,
    name: string,
    schedule_json: string,
    prompt: string,
    deliver_json: string,
    skills_json: string,
    repeat_count: int,
    enabled: int,
    now_ms: int
}

struct JobIdInput {
    job_id: string
}

pub fn storage_job_create(db_id: resource<sqlite.connection>, payload_json: string, max_rows: int, max_bytes: int) -> map {
    let input: JobCreateInput = json::decode::<JobCreateInput>(payload_json);
    let params: array<SqliteValue> = [sql_text(input.id.copy()), sql_text(input.name.copy()), sql_text(input.schedule_json.copy()), sql_text(input.prompt.copy()), sql_text(input.deliver_json.copy()), sql_text(input.skills_json.copy()), sql_int(input.repeat_count.copy()), sql_int(input.enabled.copy()), sql_int(input.now_ms.copy()), sql_int(input.now_ms.copy())];
    sqlite::execute(&db_id, "INSERT INTO jobs (id, name, schedule_json, prompt, deliver_json, skills_json, repeat_count, enabled, created_at_ms, updated_at_ms) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT (id) DO UPDATE SET name = excluded.name, schedule_json = excluded.schedule_json, prompt = excluded.prompt, deliver_json = excluded.deliver_json, skills_json = excluded.skills_json, repeat_count = excluded.repeat_count, enabled = excluded.enabled, updated_at_ms = excluded.updated_at_ms", params);
    { ok: true, result: sqlite_query_map(storage_job_query(db_id, input.id, max_rows, max_bytes)) }
}

pub fn storage_job_update(db_id: resource<sqlite.connection>, payload_json: string, max_rows: int, max_bytes: int) -> map {
    let input: JobUpdateInput = json::decode::<JobUpdateInput>(payload_json);
    let params: array<SqliteValue> = [sql_text(input.name.copy()), sql_text(input.schedule_json.copy()), sql_text(input.prompt.copy()), sql_text(input.deliver_json.copy()), sql_text(input.skills_json.copy()), sql_int(input.repeat_count.copy()), sql_int(input.enabled.copy()), sql_int(input.now_ms.copy()), sql_text(input.id.copy())];
    sqlite::execute(&db_id, "UPDATE jobs SET name = ?, schedule_json = ?, prompt = ?, deliver_json = ?, skills_json = ?, repeat_count = ?, enabled = ?, updated_at_ms = ? WHERE id = ?", params);
    { ok: true, result: sqlite_query_map(storage_job_query(db_id, input.id, max_rows, max_bytes)) }
}

pub fn storage_job_delete(db_id: resource<sqlite.connection>, payload_json: string) -> SqliteExecuteResult {
    let input: JobIdInput = json::decode::<JobIdInput>(payload_json);
    let params: array<SqliteValue> = [sql_text(input.job_id.copy())];
    sqlite::execute(&db_id, "DELETE FROM jobs WHERE id = ?", params)
}

pub fn storage_job_get(db_id: resource<sqlite.connection>, payload_json: string, max_rows: int, max_bytes: int) -> map {
    let input: JobIdInput = json::decode::<JobIdInput>(payload_json);
    { ok: true, result: sqlite_query_map(storage_job_query(db_id, input.job_id, max_rows, max_bytes)) }
}

pub fn storage_job_list(db_id: resource<sqlite.connection>, max_rows: int, max_bytes: int) -> map {
    let params: array<SqliteValue> = [sql_int(max_rows)];
    let result = sqlite::query(&db_id, "SELECT id, name, schedule_json, prompt, deliver_json, skills_json, repeat_count, enabled, output_json, created_at_ms, updated_at_ms, last_run_at_ms FROM jobs ORDER BY created_at_ms ASC, id ASC LIMIT ?", params, jobs_query_limits(max_rows, max_bytes));
    { ok: true, result: sqlite_query_map(result) }
}

fn storage_job_query(db_id: resource<sqlite.connection>, job_id: string, max_rows: int, max_bytes: int) -> SqliteQueryResult {
    let params: array<SqliteValue> = [sql_text(job_id), sql_int(max_rows)];
    sqlite::query(&db_id, "SELECT id, name, schedule_json, prompt, deliver_json, skills_json, repeat_count, enabled, output_json, created_at_ms, updated_at_ms, last_run_at_ms FROM jobs WHERE id = ? LIMIT ?", params, jobs_query_limits(max_rows, max_bytes))
}
