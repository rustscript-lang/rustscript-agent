    id: string,
    profile: string,
    platform: string,
    account_id: string,
    chat_id: string,
    thread_id: string,
    user_id: string,
    generation: int,
    system_prompt: string,
    model: string,
    provider: string,
    toolset_hash: string,
    metadata_json: string,
    title: string,
    end_reason: string,
    now_ms: int
}

struct SessionTouchInput {
    session_id: string,
    status: string,
    generation: int,
    system_prompt: string,
    model: string,
    provider: string,
    toolset_hash: string,
