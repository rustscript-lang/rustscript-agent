use json;
use sqlite;
use self::schema as schema;

fn messages_query_limits(max_rows: int, max_bytes: int) -> map<int> {
    { max_rows: max_rows, max_result_bytes: max_bytes }
}


struct MessageAppendInput {
    id: string,
    session_id: string,
    role: string,
    content_json: string,
    name: string,
    tool_call_id: string,
    parent_message_id: string,
    token_estimate: int,
    metadata_json: string,
    now_ms: int
}

struct MessageCompactInput {
    session_id: string,
    start_ordinal: int,
    end_ordinal: int
}

pub fn storage_message_append(db_id: int, payload_json: string, max_rows: int, max_bytes: int) -> map {
    let input: MessageAppendInput = json::decode::<MessageAppendInput>(payload_json);
    let statements = [
        {
            sql: "INSERT OR IGNORE INTO messages (id, session_id, ordinal, role, content_json, name, tool_call_id, parent_message_id, token_estimate, metadata_json, created_at_ms) SELECT ?, ?, COALESCE(MAX(ordinal), 0) + 1, ?, ?, ?, ?, ?, ?, ?, ? FROM messages WHERE session_id = ? AND NOT EXISTS (SELECT 1 FROM messages existing WHERE existing.id = ? AND existing.session_id <> ?)",
            params: [&input.id, &input.session_id, &input.role, &input.content_json, &input.name, &input.tool_call_id, &input.parent_message_id, input.token_estimate.copy(), &input.metadata_json, input.now_ms.copy(), &input.session_id, &input.id, &input.session_id]
        },
        {
            sql: "UPDATE sessions SET last_message_seq = COALESCE((SELECT MAX(ordinal) FROM messages WHERE session_id = ?), 0), updated_at_ms = ? WHERE id = ?",
            params: [&input.session_id, input.now_ms.copy(), &input.session_id]
        }
    ];
    sqlite::transaction(db_id, statements);
    sqlite::query(
        db_id,
        "SELECT id, session_id, ordinal, role, content_json, name, tool_call_id, parent_message_id, token_estimate, compacted, metadata_json, created_at_ms FROM messages WHERE id = ? AND session_id = ? LIMIT ?",
        [&input.id, &input.session_id, (max_rows)],
        messages_query_limits(max_rows, max_bytes)
    )
}

pub fn storage_message_get(db_id: int, message_id: string, max_rows: int, max_bytes: int) -> map {
    sqlite::query(
        db_id,
        "SELECT id, session_id, ordinal, role, content_json, name, tool_call_id, parent_message_id, token_estimate, compacted, metadata_json, created_at_ms FROM messages WHERE id = ? LIMIT ?",
        [message_id, (max_rows)],
        messages_query_limits(max_rows, max_bytes)
    )
}

pub fn storage_message_list(db_id: int, session_id: string, after_ordinal: int, max_rows: int, max_bytes: int) -> map {
    sqlite::query(
        db_id,
        "SELECT id, session_id, ordinal, role, content_json, name, tool_call_id, parent_message_id, token_estimate, compacted, metadata_json, created_at_ms FROM messages WHERE session_id = ? AND ordinal > ? ORDER BY ordinal ASC LIMIT ?",
        [session_id, after_ordinal, max_rows],
        messages_query_limits(max_rows, max_bytes)
    )
}

pub fn storage_message_mark_compacted(db_id: int, payload_json: string) -> map {
    let input: MessageCompactInput = json::decode::<MessageCompactInput>(payload_json);
    sqlite::execute(
        db_id,
        "UPDATE messages SET compacted = 1 WHERE session_id = ? AND ordinal >= ? AND ordinal <= ? AND EXISTS (SELECT 1 FROM compactions WHERE session_id = ? AND source_start_ordinal = ? AND source_end_ordinal = ? AND state = 'committed')",
        [&input.session_id, input.start_ordinal.copy(), input.end_ordinal.copy(), &input.session_id, input.start_ordinal.copy(), input.end_ordinal.copy()]
    )
}
