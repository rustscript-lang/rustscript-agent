// Atomic run admission: one transaction commits the session (created or
// touched), the first user message, the run, the parent/child link, the
// idempotency record, the `run.started` event, and the retention floor in a
// single durable commit. A failure leaves no partial admission state on
// disk, so a restart can never resurrect a half-admitted run.
use json;
use sqlite;

fn sql_text(value: string) -> SqliteValue {
    { kind: "text", int_value: null, float_value: null, text_value: value, blob_value: null }
}

fn sql_int(value: int) -> SqliteValue {
    { kind: "int", int_value: value, float_value: null, text_value: null, blob_value: null }
}

fn sql_limits(max_rows: int, max_bytes: int) -> SqliteLimits {
    {
        max_connections: 16,
        max_statements: 128,
        max_rows: max_rows,
        max_columns: 128,
        max_result_bytes: max_bytes,
        max_statement_bytes: 1048576,
        max_parameters: 128,
        max_parameter_bytes: 1048576,
        max_pending_operations: 32,
        max_transaction_ms: 5000,
        busy_timeout_ms: 5000
    }
}

fn sqlite_query_map(result: SqliteQueryResult) -> map {
    {
        columns: result.columns,
        rows: result.rows,
        truncated: result.truncated
    }
}

use self::existence as existence;
use self::messages as messages;
use self::plugins as plugins;

struct AdmissionReplayInput {
    idempotency_scope: string,
    idempotency_key: string,
    request_hash: string,
    request_selector_present: bool,
    request_selector: string
}

struct AdmissionCreateInput {
    session_id: string,
    session_new: int,
    profile: string,
    platform: string,
    account_id: string,
    model: string,
    provider: string,
    system_prompt: string,
    session_metadata_json: string,
    run_id: string,
    parent_run_id: string,
    input_json: string,
    message_id: string,
    message_run_id: string,
    script_hash: string,
    idempotency_scope: string,
    idempotency_key: string,
    request_hash: string,
    workspace_identity_json: string,
    event_id: string,
    now_ms: int,
    expires_at_ms: int,
    tool_graph_id: string,
    tool_graph_generation: int,
    tool_ref_id: string,
    tool_pin_now_ms: int
}

fn admission_owner_pin_sql() -> string {
    "SELECT COALESCE(json_extract(idem.response_json, '$.tool_graph_id'), ''), COALESCE(json_extract(idem.response_json, '$.tool_ref_id'), ''), COALESCE(CAST(json_extract(idem.response_json, '$.tool_generation') AS INTEGER), 0), idem.resource_id, COALESCE((SELECT session_id FROM runs WHERE id = idem.resource_id), ''), COALESCE(json_extract(idem.response_json, '$.registry_identity'), ''), COALESCE(json_extract(idem.response_json, '$.workspace'), ''), COALESCE(json_extract(idem.response_json, '$.profile'), '') FROM idempotency_records idem WHERE idem.scope = ? AND idem.key = ? AND idem.resource_id = ? AND EXISTS (SELECT 1 FROM plugin_graph_refs refs WHERE refs.graph_id = json_extract(idem.response_json, '$.tool_graph_id') AND refs.owner_kind = 'run' AND refs.owner_id = idem.resource_id AND refs.ref_id = json_extract(idem.response_json, '$.tool_ref_id'))"
}

fn admission_owner_pin(queried: SqliteQueryResult) -> map {
    let mut graph_id: string = "";
    let mut ref_id: string = "";
    let mut generation: int = 0;
    let mut run_id: string = "";
    let mut session_id: string = "";
    let mut registry_identity: string = "";
    let mut workspace: string = "";
    let mut profile: string = "";
    let mut pinned: bool = false;
    let rows = queried.rows.copy();
    if rows.length == 1 {
        let row: SqliteRow = rows[0].copy();
        let cells: array<SqliteValue> = row.cells.copy();
        graph_id = cells[0].text_value;
        ref_id = cells[1].text_value;
        generation = cells[2].int_value;
        run_id = cells[3].text_value;
        session_id = cells[4].text_value;
        registry_identity = cells[5].text_value;
        workspace = cells[6].text_value;
        profile = cells[7].text_value;
        pinned = graph_id.copy() != "" && ref_id.copy() != "";
    }
    {
        graph_id: graph_id,
        ref_id: ref_id,
        generation: generation,
        run_id: run_id,
        session_id: session_id,
        registry_identity: registry_identity,
        workspace: workspace,
        profile: profile,
        pinned: pinned
    }
}

pub fn storage_admission_create(db_id: resource<sqlite.connection>, payload_json: string) -> map {
    let raw_payload: map = json::decode(payload_json);
    let mut failpoint: string = "";
    let mut registry_identity: string = "";
    let mut workspace: string = "";
    if raw_payload.has("failpoint") {
        failpoint = raw_payload["failpoint"].copy();
    }
    if raw_payload.has("tool_registry_identity") {
        registry_identity = raw_payload["tool_registry_identity"].copy();
    }
    if raw_payload.has("tool_workspace") {
        workspace = raw_payload["tool_workspace"].copy();
    }
    let normalized: string = admission_with_pin_fields(payload_json);
    let input: AdmissionCreateInput = json::decode::<AdmissionCreateInput>(normalized);
    let mut failed: bool = false;
    let mut failure_code: string = "";
    let mut failure_message: string = "";
    if input.session_new.copy() == 0 {
        if !(sqlite::query(&db_id, existence::session_exists_sql(), [sql_text(input.session_id.copy())], sql_limits(1, 4096)).rows.length > 0) {
            failed = true;
            failure_code = "session_not_found";
            failure_message = "admission session does not exist";
        }
    }
    if failed == false {
        if input.parent_run_id.copy() != "" && !(sqlite::query(&db_id, existence::run_exists_sql(), [sql_text(input.parent_run_id.copy())], sql_limits(1, 4096)).rows.length > 0) {
            failed = true;
            failure_code = "parent_not_found";
            failure_message = "parent run does not exist";
        }
    }
    if failed == false && input.session_new.copy() == 0 && input.session_metadata_json.copy() != "{}" {
        let selector_conflict = sqlite::query(&db_id, "SELECT 1 FROM sessions existing WHERE existing.id = ? AND json_extract(existing.metadata_json, '$.workspace.selector') IS NOT NULL AND (json_extract(existing.metadata_json, '$.workspace.selector') <> json_extract(?, '$.workspace.selector') OR COALESCE(json_extract(existing.metadata_json, '$.workspace.canonical_path'), '') <> COALESCE(json_extract(?, '$.workspace.canonical_path'), '')) LIMIT 1", [sql_text(input.session_id.copy()), sql_text(input.session_metadata_json.copy()), sql_text(input.session_metadata_json.copy())], sql_limits(1, 4096));
        if selector_conflict.rows.length > 0 {
            failed = true;
            failure_code = "workspace_conflict";
            failure_message = "the session is bound to a different workspace";
        }
    }
    let mut replay: bool = false;
    let mut conflict: bool = false;
    let mut existing_run_id: string = "";
    let mut pinned: bool = false;
    let mut pin_graph_id: string = "";
    let mut pin_ref_id: string = "";
    let mut pin_generation: int = 0;
    let mut pin_run_id: string = "";
    let mut pin_session_id: string = "";
    let mut pin_registry: string = "";
    let mut pin_workspace: string = "";
    let mut pin_profile: string = "";
    if failed == false {
        if input.idempotency_key.copy() != "" {
            // Replay identity uses the original optional selector, never the current session default.
            let existing = sqlite::query(&db_id, "SELECT request_hash, resource_id, CASE WHEN json_type(response_json, '$.workspace_identity') IS NULL THEN CASE WHEN ? = '' OR json_extract(?, '$.request_selector_present') = 0 THEN 1 ELSE 0 END WHEN json_type(response_json, '$.workspace_identity') = 'object' AND json_extract(response_json, '$.workspace_identity.request_selector_present') IS CASE WHEN ? = '' THEN 0 ELSE json_extract(?, '$.request_selector_present') END AND json_extract(response_json, '$.workspace_identity.request_selector') IS CASE WHEN ? = '' THEN '' ELSE json_extract(?, '$.request_selector') END THEN 1 ELSE 0 END AS workspace_identity_match FROM idempotency_records WHERE scope = ? AND key = ? LIMIT 1", [sql_text(input.workspace_identity_json.copy()), sql_text(input.workspace_identity_json.copy()), sql_text(input.workspace_identity_json.copy()), sql_text(input.workspace_identity_json.copy()), sql_text(input.workspace_identity_json.copy()), sql_text(input.workspace_identity_json.copy()), sql_text(input.idempotency_scope.copy()), sql_text(input.idempotency_key.copy())], sql_limits(1, 8192));
            let rows = existing.rows;
            if rows.length > 0 {
                let row: SqliteRow = rows[0].copy();
                let cells: array<SqliteValue> = row.cells.copy();
                let existing_hash: string = cells[0].text_value;
                let existing_resource: string = cells[1].text_value;
                let workspace_identity_matches: bool = cells[2].int_value == 1;
                existing_run_id = existing_resource;
                if existing_hash == input.request_hash.copy() && workspace_identity_matches {
                    replay = true;
                } else {
                    conflict = true;
                }
            }
        }
    }
    if failed == false {
        if replay == false && conflict == false {
            let mut statements: array<SqliteStatement> = [];
            if input.session_new.copy() == 1 {
                statements[statements.length] = {
                    sql: "INSERT INTO sessions (id, profile, platform, account_id, chat_id, thread_id, user_id, generation, system_prompt, model, provider, toolset_hash, metadata_json, created_at_ms, updated_at_ms) SELECT ?, ?, ?, ?, '', '', '', 1, ?, ?, ?, '', ?, ?, ? WHERE NOT EXISTS (SELECT 1 FROM sessions existing WHERE existing.id = ?) AND (? = '' OR EXISTS (SELECT 1 FROM runs parent WHERE parent.id = ?)) AND NOT EXISTS (SELECT 1 FROM runs existing WHERE existing.id = ? AND existing.session_id <> ?)",
                    params: [sql_text(input.session_id.copy()), sql_text(input.profile.copy()), sql_text(input.platform.copy()), sql_text(input.account_id.copy()), sql_text(input.system_prompt.copy()), sql_text(input.model.copy()), sql_text(input.provider.copy()), sql_text(input.session_metadata_json.copy()), sql_int(input.now_ms.copy()), sql_int(input.now_ms.copy()), sql_text(input.session_id.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.run_id.copy()), sql_text(input.session_id.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        };
            } else {
                statements[statements.length] = {
                    sql: "UPDATE sessions SET model = CASE WHEN ? = '' THEN model ELSE ? END, provider = CASE WHEN ? = '' THEN provider ELSE ? END, system_prompt = CASE WHEN ? = '' THEN system_prompt ELSE ? END, metadata_json = CASE WHEN ? = '{}' THEN metadata_json ELSE json_set(CASE WHEN json_valid(metadata_json) THEN CASE WHEN json_type(metadata_json) = 'object' THEN metadata_json ELSE '{}' END ELSE '{}' END, '$.workspace', json_extract(?, '$.workspace')) END, updated_at_ms = ? WHERE id = ? AND (? = '{}' OR json_extract(metadata_json, '$.workspace.selector') IS NULL OR json_extract(metadata_json, '$.workspace.selector') = json_extract(?, '$.workspace.selector')) AND (? = '' OR EXISTS (SELECT 1 FROM runs parent WHERE parent.id = ?)) AND NOT EXISTS (SELECT 1 FROM runs existing WHERE existing.id = ? AND existing.session_id <> ?)",
                    params: [sql_text(input.model.copy()), sql_text(input.model.copy()), sql_text(input.provider.copy()), sql_text(input.provider.copy()), sql_text(input.system_prompt.copy()), sql_text(input.system_prompt.copy()), sql_text(input.session_metadata_json.copy()), sql_text(input.session_metadata_json.copy()), sql_int(input.now_ms.copy()), sql_text(input.session_id.copy()), sql_text(input.session_metadata_json.copy()), sql_text(input.session_metadata_json.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.run_id.copy()), sql_text(input.session_id.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        };
            }
            let user_content = storage_admission_user_content(input.input_json.copy());
            let encoded_content = messages::storage_message_encode_content(user_content);
            statements[statements.length] = {
                sql: "INSERT INTO messages (id, session_id, ordinal, role, content_json, metadata_json, run_id, finish_reason, created_at_ms) SELECT ?, ?, COALESCE(MAX(ordinal), 0) + 1, 'user', ?, '{}', ?, '', ? FROM messages WHERE session_id = ? HAVING NOT EXISTS (SELECT 1 FROM messages existing WHERE existing.id = ? AND existing.session_id <> ?) AND EXISTS (SELECT 1 FROM sessions workspace_session WHERE workspace_session.id = ? AND (? = '{}' OR json_extract(workspace_session.metadata_json, '$.workspace.selector') = json_extract(?, '$.workspace.selector'))) AND (? = '' OR EXISTS (SELECT 1 FROM runs parent WHERE parent.id = ?)) AND NOT EXISTS (SELECT 1 FROM runs existing WHERE existing.id = ? AND existing.session_id <> ?)",
                params: [sql_text(input.message_id.copy()), sql_text(input.session_id.copy()), sql_text(encoded_content), sql_text(input.message_run_id.copy()), sql_int(input.now_ms.copy()), sql_text(input.session_id.copy()), sql_text(input.message_id.copy()), sql_text(input.session_id.copy()), sql_text(input.session_id.copy()), sql_text(input.session_metadata_json.copy()), sql_text(input.session_metadata_json.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.run_id.copy()), sql_text(input.session_id.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        };
            statements[statements.length] = {
                sql: "INSERT INTO runs (id, session_id, parent_run_id, status, input_json, provider, model, script_hash, idempotency_scope, idempotency_key, created_at_ms, started_at_ms, updated_at_ms) SELECT ?, ?, ?, 'running', ?, ?, ?, ?, ?, ?, ?, ?, ? WHERE NOT EXISTS (SELECT 1 FROM runs existing WHERE existing.id = ? AND existing.session_id <> ?) AND EXISTS (SELECT 1 FROM sessions WHERE id = ?) AND (? = '' OR EXISTS (SELECT 1 FROM runs parent WHERE parent.id = ?)) AND EXISTS (SELECT 1 FROM sessions workspace_session WHERE workspace_session.id = ? AND (? = '{}' OR json_extract(workspace_session.metadata_json, '$.workspace.selector') = json_extract(?, '$.workspace.selector')))",
                params: [sql_text(input.run_id.copy()), sql_text(input.session_id.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.input_json.copy()), sql_text(input.provider.copy()), sql_text(input.model.copy()), sql_text(input.script_hash.copy()), sql_text(input.idempotency_scope.copy()), sql_text(input.idempotency_key.copy()), sql_int(input.now_ms.copy()), sql_int(input.now_ms.copy()), sql_int(input.now_ms.copy()), sql_text(input.run_id.copy()), sql_text(input.session_id.copy()), sql_text(input.session_id.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.session_id.copy()), sql_text(input.session_metadata_json.copy()), sql_text(input.session_metadata_json.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        };
            if input.parent_run_id.copy() != "" {
                statements[statements.length] = {
                    sql: "INSERT INTO child_run_links (parent_run_id, child_run_id, ordinal, relation, state, created_at_ms) SELECT ?, ?, COALESCE(MAX(ordinal), -1) + 1, 'subagent', 'pending', ? FROM child_run_links WHERE parent_run_id = ? HAVING EXISTS (SELECT 1 FROM runs parent WHERE parent.id = ?) AND EXISTS (SELECT 1 FROM runs child WHERE child.id = ? AND child.session_id = ?)",
                    params: [sql_text(input.parent_run_id.copy()), sql_text(input.run_id.copy()), sql_int(input.now_ms.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.parent_run_id.copy()), sql_text(input.run_id.copy()), sql_text(input.session_id.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        };
            }
            // Unkeyed admissions still need an exact original receipt for restart.
            let receipt_scope: string = if input.idempotency_key.copy() == "" => { "native.tool-pin" } else => { input.idempotency_scope.copy() };
            let receipt_key: string = if input.idempotency_key.copy() == "" => { input.run_id.copy() } else => { input.idempotency_key.copy() };
            if input.idempotency_key.copy() != "" || input.tool_graph_id.copy() != "" {
                statements[statements.length] = {
                    sql: "INSERT OR IGNORE INTO idempotency_records (scope, key, request_hash, resource_type, resource_id, state, response_json, created_at_ms, expires_at_ms) SELECT ?, ?, ?, 'run', ?, 'completed', json_set(CASE WHEN ? = '' THEN '{\"run_id\":\"' || ? || '\",\"status\":\"running\"}' ELSE json_object('run_id', ?, 'status', 'running', 'workspace_identity', json(?)) END, '$.tool_graph_id', ?, '$.tool_ref_id', ?, '$.tool_generation', ?, '$.registry_identity', ?, '$.workspace', ?, '$.profile', ?), ?, ? WHERE ? <> '' AND EXISTS (SELECT 1 FROM runs admitted WHERE admitted.id = ? AND admitted.session_id = ?)",
                    params: [sql_text(receipt_scope.copy()), sql_text(receipt_key.copy()), sql_text(input.request_hash.copy()), sql_text(input.run_id.copy()), sql_text(input.workspace_identity_json.copy()), sql_text(input.run_id.copy()), sql_text(input.run_id.copy()), sql_text(input.workspace_identity_json.copy()), sql_text(input.tool_graph_id.copy()), sql_text(input.tool_ref_id.copy()), sql_int(input.tool_graph_generation.copy()), sql_text(registry_identity.copy()), sql_text(workspace.copy()), sql_text(input.profile.copy()), sql_int(input.now_ms.copy()), sql_int(input.expires_at_ms.copy()), sql_text(receipt_key.copy()), sql_text(input.run_id.copy()), sql_text(input.session_id.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        };
            }
            statements[statements.length] = {
                sql: "INSERT INTO run_events (run_id, seq, event_id, event_type, payload_json, created_at_ms) SELECT ?, COALESCE((SELECT MAX(events.seq) FROM run_events events WHERE events.run_id = ?), 0) + 1, ?, 'run.started', '{\"status\":\"running\",\"session_id\":\"' || ? || '\"}', ? WHERE EXISTS (SELECT 1 FROM runs WHERE id = ?)",
                params: [sql_text(input.run_id.copy()), sql_text(input.run_id.copy()), sql_text(input.event_id.copy()), sql_text(input.session_id.copy()), sql_int(input.now_ms.copy()), sql_text(input.run_id.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        };
            statements[statements.length] = {
                sql: "INSERT INTO run_retention (run_id, first_seq, high_water_seq, updated_at_ms) SELECT ?, COALESCE((SELECT MIN(seq) FROM run_events WHERE run_id = ?), 0), COALESCE((SELECT MAX(seq) FROM run_events WHERE run_id = ?), 0), ? WHERE EXISTS (SELECT 1 FROM runs WHERE id = ?) ON CONFLICT (run_id) DO UPDATE SET first_seq = excluded.first_seq, high_water_seq = MAX(run_retention.high_water_seq, excluded.high_water_seq), updated_at_ms = excluded.updated_at_ms",
                params: [sql_text(input.run_id.copy()), sql_text(input.run_id.copy()), sql_text(input.run_id.copy()), sql_int(input.now_ms.copy()), sql_text(input.run_id.copy())],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        };
            if input.tool_graph_id.copy() != "" {
                let pin_statements: array<SqliteStatement> = plugins::storage_admission_pin_statements(input.tool_graph_id.copy(), input.tool_graph_generation.copy(), input.tool_ref_id.copy(), input.run_id.copy(), input.session_id.copy(), input.tool_pin_now_ms.copy());
                let mut pin_index: int = 0;
                while pin_index < pin_statements.length {
                    statements[statements.length] = pin_statements[pin_index].copy();
                    pin_index = pin_index + 1;
                }
                pinned = true;
            }
            let transaction_result: array<SqliteTransactionResult> = sqlite::transaction(&db_id, statements);
            if pinned == true && transaction_result.length > 0 {
                let last_index: int = transaction_result.length - 1;
                let receipt: SqliteTransactionResult = transaction_result[last_index].copy();
                pin_graph_id = plugins::storage_pin_text(receipt.copy(), 0);
                pin_ref_id = plugins::storage_pin_text(receipt.copy(), 1);
                pin_generation = plugins::storage_pin_int(receipt.copy(), 2);
                if pin_graph_id.copy() != input.tool_graph_id.copy() || pin_ref_id.copy() != input.tool_ref_id.copy() {
                    failed = true;
                    failure_code = "plugin_activation_conflict";
                    failure_message = "tool graph pin did not commit";
                }
            }
        }
    }
    let query_run_id: string = if replay => { existing_run_id.copy() } else => { input.run_id.copy() };
    let run_result = sqlite::query(&db_id, "SELECT id, session_id, parent_run_id, status, input_json, provider, model, script_hash, idempotency_scope, idempotency_key, turn_count, input_tokens, output_tokens, error_code, error_message, recovery_reason, created_at_ms, started_at_ms, finished_at_ms, updated_at_ms FROM runs WHERE id = ? LIMIT 1", [sql_text(query_run_id.copy())], sql_limits(1, 65536));
    let run_result_copy: map = sqlite_query_map(run_result);
    let run_rows = run_result.rows;
    if failed == false {
        if run_rows.length == 0 && replay == false {
            failed = true;
            failure_code = "session_not_found";
            failure_message = "admission could not create the run";
        }
        if run_rows.length == 0 && replay == true {
            failed = true;
            failure_code = "idempotency_conflict";
            failure_message = "replayed idempotency key references a missing run";
        }
    }
    let session_result = sqlite::query(&db_id, "SELECT id, profile, platform, account_id, chat_id, thread_id, user_id, generation, status, system_prompt, model, provider, toolset_hash, metadata_json, last_message_seq, created_at_ms, updated_at_ms FROM sessions WHERE id = ? LIMIT 1", [sql_text(input.session_id.copy())], sql_limits(1, 65536));
    let message_result = sqlite::query(&db_id, "SELECT id, session_id, ordinal, role, content_json, name, tool_call_id, parent_message_id, token_estimate, compacted, metadata_json, run_id, finish_reason, created_at_ms FROM messages WHERE id = ? AND session_id = ? LIMIT 1", [sql_text(input.message_id.copy()), sql_text(input.session_id.copy())], sql_limits(1, 65536));
    let idempotency_result: map = if input.idempotency_key.copy() == "" => {
        { columns: [], rows: [] }
    } else => {
        sqlite::query(&db_id, "SELECT scope, key, request_hash, resource_type, resource_id, state, response_json, created_at_ms, expires_at_ms, completed_at_ms FROM idempotency_records WHERE scope = ? AND key = ? LIMIT 1", [sql_text(input.idempotency_scope.copy()), sql_text(input.idempotency_key.copy())], sql_limits(1, 8192))
    };
    if replay == true {
        let recovered: map = admission_owner_pin(sqlite::query(&db_id, admission_owner_pin_sql(), [sql_text(input.idempotency_scope.copy()), sql_text(input.idempotency_key.copy()), sql_text(existing_run_id.copy())], sql_limits(1, 8192)));
        let recovered_graph_id: string = recovered["graph_id"];
        let recovered_ref_id: string = recovered["ref_id"];
        let recovered_generation: int = recovered["generation"];
        let recovered_run_id: string = recovered["run_id"];
        let recovered_session_id: string = recovered["session_id"];
        let recovered_registry: string = recovered["registry_identity"];
        let recovered_workspace: string = recovered["workspace"];
        let recovered_profile: string = recovered["profile"];
        let recovered_pinned: bool = recovered["pinned"];
        pin_graph_id = recovered_graph_id.copy();
        pin_ref_id = recovered_ref_id.copy();
        pin_generation = recovered_generation.copy();
        pin_run_id = recovered_run_id.copy();
        pin_session_id = recovered_session_id.copy();
        pin_registry = recovered_registry.copy();
        pin_workspace = recovered_workspace.copy();
        pin_profile = recovered_profile.copy();
        pinned = recovered_pinned;
    } else {
        pin_run_id = input.run_id.copy();
        pin_session_id = input.session_id.copy();
        pin_registry = registry_identity.copy();
        pin_workspace = workspace.copy();
        pin_profile = input.profile.copy();
    }
    let mut result = {
        ok: true,
        code: "ok",
        message: "",
        result: {
            replayed: replay,
            conflict: conflict,
            run: run_result_copy,
            session: session_result,
            message: message_result,
            idempotency: idempotency_result,
            pin: {
                graph_id: pin_graph_id,
                ref_id: pin_ref_id,
                generation: pin_generation,
                run_id: pin_run_id,
                session_id: pin_session_id,
                registry_identity: pin_registry,
                workspace: pin_workspace,
                profile: pin_profile,
                pinned: pinned
            }
        }
    };
    if conflict == true {
        result = {
            ok: false,
            code: "idempotency_key_conflict",
            message: "idempotency key was used with a different request",
            result: {
                replayed: false,
                conflict: conflict,
                run: run_result_copy,
                session: session_result,
                message: message_result,
                idempotency: idempotency_result
            }
        };
    } else {
        if failed == true {
            result = {
                ok: false,
                code: failure_code,
                message: failure_message,
                result: {
                    replayed: replay,
                    conflict: conflict,
                    run: run_result_copy,
                    session: session_result,
                    message: message_result,
                    idempotency: idempotency_result
                }
            };
        }
    }
    let published: bool = result["ok"];
    if published == true && failpoint == "after_commit_before_publish" {
        let published_result: map = result["result"];
        result = {
            ok: false,
            code: "failpoint_after_commit_before_publish",
            message: "durable commit succeeded; live publish skipped",
            result: published_result
        };
    }
    result
}

pub fn storage_admission_replay(db_id: resource<sqlite.connection>, payload_json: string) -> map {
    let input: AdmissionReplayInput = json::decode::<AdmissionReplayInput>(payload_json);
    let mut selector_present: int = 0;
    if input.request_selector_present.copy() == true {
        selector_present = 1;
    }
    let existing = sqlite::query(&db_id, "SELECT request_hash, resource_id, CASE WHEN json_type(response_json, '$.workspace_identity') IS NULL THEN CASE WHEN ? = 0 THEN 1 ELSE 0 END WHEN json_type(response_json, '$.workspace_identity') = 'object' AND json_extract(response_json, '$.workspace_identity.request_selector_present') IS ? AND json_extract(response_json, '$.workspace_identity.request_selector') IS ? THEN 1 ELSE 0 END AS workspace_identity_match FROM idempotency_records WHERE scope = ? AND key = ? LIMIT 1", [sql_int(selector_present.copy()), sql_int(selector_present.copy()), sql_text(input.request_selector.copy()), sql_text(input.idempotency_scope.copy()), sql_text(input.idempotency_key.copy())], sql_limits(1, 8192));
    let rows = existing.rows;
    let empty_run: map = { columns: [], rows: [], truncated: false };
    let mut result = {
        ok: true,
        code: "ok",
        message: "",
        result: { replayed: false, conflict: false, run: empty_run.copy() }
    };
    if rows.length > 0 {
        let row: SqliteRow = rows[0].copy();
        let cells: array<SqliteValue> = row.cells.copy();
        let existing_hash: string = cells[0].text_value;
        let existing_run_id: string = cells[1].text_value;
        let workspace_identity_matches: bool = cells[2].int_value == 1;
        if existing_hash != input.request_hash.copy() || workspace_identity_matches == false {
            result = {
                ok: false,
                code: "idempotency_key_conflict",
                message: "idempotency key was used with a different request",
                result: { replayed: false, conflict: true, run: empty_run.copy() }
            };
        } else {
            let run_result = sqlite::query(&db_id, "SELECT id, session_id, parent_run_id, status, input_json, provider, model, script_hash, idempotency_scope, idempotency_key, turn_count, input_tokens, output_tokens, error_code, error_message, recovery_reason, created_at_ms, started_at_ms, finished_at_ms, updated_at_ms FROM runs WHERE id = ? LIMIT 1", [sql_text(existing_run_id.copy())], sql_limits(1, 65536));
            let run_result_copy: map = sqlite_query_map(run_result);
            let run_rows = run_result.rows;
            if run_rows.length == 0 {
                result = {
                    ok: false,
                    code: "admission_replay_corrupt",
                    message: "durable idempotency record references a missing run",
                    result: { replayed: false, conflict: false, run: run_result_copy }
                };
            } else {
                let recovered: map = admission_owner_pin(sqlite::query(&db_id, admission_owner_pin_sql(), [sql_text(input.idempotency_scope.copy()), sql_text(input.idempotency_key.copy()), sql_text(existing_run_id.copy())], sql_limits(1, 8192)));
                let recovered_graph_id: string = recovered["graph_id"];
                let recovered_ref_id: string = recovered["ref_id"];
                let recovered_generation: int = recovered["generation"];
                let recovered_run_id: string = recovered["run_id"];
                let recovered_session_id: string = recovered["session_id"];
                let recovered_registry: string = recovered["registry_identity"];
                let recovered_workspace: string = recovered["workspace"];
                let recovered_profile: string = recovered["profile"];
                let recovered_pinned: bool = recovered["pinned"];
                result = {
                    ok: true,
                    code: "ok",
                    message: "",
                    result: {
                        replayed: true,
                        conflict: false,
                        run: run_result_copy,
                        pin: {
                            graph_id: recovered_graph_id,
                            ref_id: recovered_ref_id,
                            generation: recovered_generation,
                            run_id: recovered_run_id,
                            session_id: recovered_session_id,
                            registry_identity: recovered_registry,
                            workspace: recovered_workspace,
                            profile: recovered_profile,
                            pinned: recovered_pinned
                        }
                    }
                };
            }
        }
    }
    result
}

// Prefer the compact envelope's `run_context.input` as the user message body
// so conversation rows stay canonical; fall back to the raw payload.
fn storage_admission_user_content(input_json: string) -> string {
    let db_id = sqlite::open({
        path: ":memory:",
        mode: "memory",
        root: null,
        limits: sql_limits(1, 1048576)
    });
    let extracted = sqlite::query(&db_id, "SELECT CASE WHEN json_valid(?) AND json_extract(?, '$.run_context.input') IS NOT NULL THEN CAST(json_extract(?, '$.run_context.input') AS TEXT) ELSE ? END AS content", [sql_text(input_json), sql_text(input_json), sql_text(input_json), sql_text(input_json)], sql_limits(1, 1048576));
    let rows = extracted.rows;
    let mut content: string = input_json.copy();
    if rows.length > 0 {
        let row = rows[0];
        content = row.cells[0].text_value;
    }
    sqlite::close(db_id);
    content
}

fn admission_with_pin_fields(payload_json: string) -> string {
    let db_id = sqlite::open({
        path: ":memory:",
        mode: "memory",
        root: null,
        limits: sql_limits(1, 1048576)
    });
    let extracted = sqlite::query(&db_id, "SELECT json_set(json_set(json_set(json_set(?, '$.tool_graph_id', COALESCE(json_extract(?, '$.tool_graph_id'), '')), '$.tool_graph_generation', COALESCE(json_extract(?, '$.tool_graph_generation'), 0)), '$.tool_ref_id', COALESCE(json_extract(?, '$.tool_ref_id'), '')), '$.tool_pin_now_ms', COALESCE(json_extract(?, '$.tool_pin_now_ms'), 0))", [sql_text(payload_json.copy()), sql_text(payload_json.copy()), sql_text(payload_json.copy()), sql_text(payload_json.copy()), sql_text(payload_json.copy())], sql_limits(1, 1048576));
    let rows = extracted.rows;
    let mut normalized: string = payload_json.copy();
    if rows.length > 0 {
        let row: SqliteRow = rows[0].copy();
        let cells: array<SqliteValue> = row.cells.copy();
        normalized = cells[0].text_value;
    }
    sqlite::close(db_id);
    normalized
}
