use json;
use sqlite;

fn sql_text(value: string) -> SqliteValue {
    { kind: "text", int_value: null, float_value: null, text_value: value, blob_value: null }
}

fn sql_int(value: int) -> SqliteValue {
    { kind: "int", int_value: value, float_value: null, text_value: null, blob_value: null }
}

fn sql_limits(max_rows: int, max_bytes: int) -> SqliteLimits {
    {
        max_connections: 16,
        max_statements: 128,
        max_rows: max_rows,
        max_columns: 128,
        max_result_bytes: max_bytes,
        max_statement_bytes: 1048576,
        max_parameters: 128,
        max_parameter_bytes: 1048576,
        max_pending_operations: 32,
        max_transaction_ms: 5000,
        busy_timeout_ms: 5000
    }
}

use self::schema as schema;
use self::sessions as sessions;
use self::messages as messages;
use self::runs as runs;
use self::events as events;
use self::approvals as approvals;
use self::compactions as compactions;

// The storage worker receives one fully shaped JSON-compatible command per VM
// input. The native service supplies every envelope field, including zero or
// empty values for operation-specific fields, so decoding is deterministic.
struct StorageCommand {
    op: string,
    request_id: string,
    db_path: string,
    db_mode: string,
    busy_timeout_ms: int,
    max_rows: int,
    max_bytes: int,
    max_events: int,
    max_messages: int,
    now_ms: int,
    payload_json: string
}

struct StorageResult {
    request_id: string,
    op: string,
    ok: bool,
    code: string,
    message: string,
    data: map,
    rows_affected: int,
    truncated: bool,
    next_cursor: int
}

struct StorageOpenOptions {
    path: string,
    mode: string,
    busy_timeout_ms: int,
    max_connections: int,
    limits: map<int>
}

struct SessionIdInput {
    session_id: string
}

struct MessageIdInput {
    message_id: string
}

struct MessageListInput {
    session_id: string,
    after_ordinal: int
}

struct RunIdInput {
    run_id: string
}

struct SessionListInput {
    profile: string,
    platform: string
}

struct RunListInput {
    session_id: string,
    status: string
}

struct DeliveryGetInput {
    session_id: string,
    consumer: string
}

struct ApprovalIdInput {
    approval_id: string
}

struct CompactionIdInput {
    compaction_id: string
}


fn storage_open_options(db_path: string, db_mode: string, busy_timeout_ms: int, max_rows: int, max_bytes: int) -> SqliteOpenOptions {
    {
        path: db_path,
        mode: db_mode,
        root: null,
        limits: sql_limits(schema::max_rows_limit(max_rows), schema::max_bytes_limit(max_bytes))
    }
}

fn storage_apply_migrations(db_id: resource<sqlite.connection>, now_ms: int) {
    sqlite::execute(&db_id, schema::schema_migrations_table_sql(), []);
    let mut migration_index = 0;
    while migration_index < schema::schema_migration_count() {
        let mut statements: array<SqliteStatement> = [];
        let mut statement_index = 0;
        while statement_index < schema::schema_migration_statement_count(migration_index) {
            statements[statements.length] = {
                sql: schema::schema_migration_statement(migration_index, statement_index),
                params: [],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        };
            statement_index += 1;
        }
        statements[statements.length] = {
            sql: schema::schema_migration_record_sql(),
            params: [sql_int(schema::schema_migration_version(migration_index)), sql_text(schema::schema_migration_name(migration_index)), sql_text(schema::schema_migration_checksum(migration_index)), sql_int(now_ms)],
                        query: false,
                        limits: sql_limits(1000, 4194304)
                        };
        sqlite::transaction(&db_id, statements);
        migration_index += 1;
    }
    true
}

fn storage_ok(request_id: string, op: string, data: map, rows_affected: int, truncated: bool, next_cursor: int) -> StorageResult {
    {
        request_id: request_id,
        op: op,
        ok: true,
        code: "ok",
        message: "",
        data: data,
        rows_affected: rows_affected,
        truncated: truncated,
        next_cursor: next_cursor
    }
}

fn storage_query_data(result: SqliteQueryResult) -> map {
    {
        columns: result.columns,
        rows: result.rows,
        truncated: result.truncated
    }
}

fn storage_raw_ok(request_id: string, op: string, raw_result: SqliteQueryResult) -> StorageResult {
    storage_ok(request_id, op, storage_query_data(raw_result), 0, raw_result.truncated, 0)
}

fn storage_execute_ok(request_id: string, op: string, raw_result: SqliteExecuteResult) -> StorageResult {
    storage_ok(request_id, op, { rows_affected: raw_result.rows_affected, last_insert_rowid: raw_result.last_insert_rowid }, raw_result.rows_affected, false, 0)
}

fn storage_host_contract() -> string {
    "sqlite::open sqlite::execute sqlite::query sqlite::transaction sqlite::close"
}

fn storage_error(request_id: string, op: string, code: string, message: string) -> StorageResult {
    {
        request_id: request_id,
        op: op,
        ok: false,
        code: code,
        message: message,
        data: {},
        rows_affected: 0,
        truncated: false,
        next_cursor: 0
    }
}

fn storage_unwrap(request_id: string, op: string, wrapped: map) -> StorageResult {
    let ok_flag: bool = wrapped["ok"];
    let mut result = storage_error(request_id, op, "unwrap_missing", "unwrap result missing");
    if ok_flag == true {
        let raw: map = wrapped["result"];
        result = storage_ok(request_id, op, raw, 0, false, 0);
    } else {
        let code: string = wrapped["code"];
        let message: string = wrapped["message"];
        result = storage_error(request_id, op, code, message);
    }
    result
}

fn storage_dispatch(db_id: resource<sqlite.connection>, command: StorageCommand) -> StorageResult {
    let request_id = command.request_id.copy();
    let op = command.op.copy();
    let mut result = storage_error(request_id.copy(), op.copy(), "unknown_operation", "storage operation is not registered");

    if command.op == "migrate" => {
        result = storage_ok(request_id, op, {schema_version: schema::schema_migration_count(), host_contract: storage_host_contract()}, 0, false, 0);
        result
    } else => { null };

    if command.op == "session.create" => {
        result = storage_raw_ok(request_id, op, sessions::storage_session_create(db_id, command.payload_json, command.max_rows, command.max_bytes));
        result
    } else => { null };

    if command.op == "session.get" => {
        let input: SessionIdInput = json::decode::<SessionIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, sessions::storage_session_get(db_id, input.session_id, command.max_rows, command.max_bytes));
        result
    } else => { null };

    if command.op == "session.list" => {
        let input: SessionListInput = json::decode::<SessionListInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, sessions::storage_session_list(db_id, input.profile, input.platform, command.max_rows, command.max_bytes));
        result
    } else => { null };

    if command.op == "session.touch" => {
        result = storage_raw_ok(request_id, op, sessions::storage_session_touch(db_id, command.payload_json, command.max_rows, command.max_bytes));
        result
    } else => { null };

    if command.op == "message.append" => {
        result = storage_unwrap(request_id, op, messages::storage_message_append(db_id, command.payload_json, command.max_rows, command.max_bytes));
        result
    } else => { null };

    if command.op == "message.get" => {
        let input: MessageIdInput = json::decode::<MessageIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, messages::storage_message_get(db_id, input.message_id, command.max_rows, command.max_bytes));
        result
    } else => { null };

    if command.op == "message.list" => {
        let input: MessageListInput = json::decode::<MessageListInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, messages::storage_message_list(db_id, input.session_id, input.after_ordinal.copy(), command.max_messages, command.max_bytes));
        result
    } else => { null };

    if command.op == "message.compact" => {
        result = storage_execute_ok(request_id, op, messages::storage_message_mark_compacted(db_id, command.payload_json));
        result
    } else => { null };

    result
}

pub fn run(command: StorageCommand) -> StorageResult {
let db_id: resource<sqlite.connection> = sqlite::open(storage_open_options(command.db_path.copy(), command.db_mode.copy(), command.busy_timeout_ms, command.max_rows, command.max_bytes));
storage_apply_migrations(db_id, command.now_ms);
let result = storage_dispatch(db_id, command);
sqlite::close(db_id);
result
}
