// Explicit parent-record existence checks for the normalized schema.
// The core SQLite host does not enforce foreign keys (documented core
// blocker), so every typed command that references a parent record must
// verify the parent exists before writing; agent correctness never depends
// on FK enforcement.
//
// These helpers return SQL only. Guest functions cannot take
// `resource<sqlite.connection>` arguments (bound type is unknown), so
// callers run `sqlite::query(&db_id, ...)` themselves.

pub fn run_exists_sql() -> string {
    "SELECT 1 FROM runs WHERE id = ? LIMIT 1"
}

pub fn session_exists_sql() -> string {
    "SELECT 1 FROM sessions WHERE id = ? LIMIT 1"
}
