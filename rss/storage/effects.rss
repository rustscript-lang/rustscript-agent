fn text(value: string) -> SqliteValue { { kind: "text", int_value: null, float_value: null, text_value: value, blob_value: null } }
fn integer(value: int) -> SqliteValue { { kind: "int", int_value: value, float_value: null, text_value: null, blob_value: null } }
fn limits() -> SqliteLimits { { max_connections: 16, max_statements: 128, max_rows: 512, max_columns: 16, max_result_bytes: 1048576, max_statement_bytes: 1048576, max_parameters: 128, max_parameter_bytes: 1048576, max_pending_operations: 32, max_transaction_ms: 5000, busy_timeout_ms: 5000 } }
fn ok(result: SqliteQueryResult) -> map { { ok: true, code: "ok", message: "", result: { columns: result.columns, rows: result.rows, truncated: result.truncated } } }
struct ManagedStorageInput { record_json: string, prepared_json: string, workspace_json: string, projections_json: string, effect_id: string, receipt_id: string, commit_id: string, run_id: string, call_id: string, store_id: string, profile: string, source_device: string, source_inode: string, workspace_id: string, branch_id: string, now_ms: int, max_events: int, cut: string }
struct ManagedBeginInput { record_json: string, prepared_json: string, workspace_json: string, projections_json: string, effect_id: string, receipt_id: string, commit_id: string, run_id: string, call_id: string, store_id: string, profile: string, source_device: string, source_inode: string, workspace_id: string, branch_id: string, now_ms: int, max_events: int, cut: string, sealed_class: string }

pub fn migration_count() -> int { 18 }

pub fn migration(index: int) -> string {
 if index == 17 => { "CREATE TABLE managed_publish_receipts(workspace_id TEXT NOT NULL,request_id TEXT NOT NULL,branch_id TEXT NOT NULL,original_request_proof TEXT NOT NULL,receipt_json TEXT NOT NULL CHECK(json_valid(receipt_json)),action TEXT NOT NULL CHECK(action='publish'),PRIMARY KEY(workspace_id,request_id),FOREIGN KEY(workspace_id,branch_id) REFERENCES managed_branches(workspace_id,branch_id))" } else => { if index == 16 => { "CREATE TABLE managed_workspace_publications(workspace_id TEXT PRIMARY KEY REFERENCES managed_workspaces(workspace_id),profile TEXT NOT NULL,branch_id TEXT NOT NULL,epoch INTEGER NOT NULL CHECK(epoch>=1),head_object_id TEXT NOT NULL,head_version INTEGER NOT NULL CHECK(head_version>=1),previous_head_object_id TEXT,request_id TEXT NOT NULL,published_at_ms INTEGER NOT NULL,revision INTEGER NOT NULL CHECK(revision>=1),store_id TEXT NOT NULL,schema_version INTEGER NOT NULL CHECK(schema_version=1),record_json TEXT NOT NULL CHECK(json_valid(record_json)),FOREIGN KEY(workspace_id,branch_id) REFERENCES managed_branches(workspace_id,branch_id))" } else => { if index == 15 => { "CREATE TABLE managed_branch_receipts(workspace_id TEXT NOT NULL,request_id TEXT NOT NULL,checkpoint_id TEXT NOT NULL DEFAULT '',source_branch_id TEXT NOT NULL,original_request_proof TEXT NOT NULL,receipt_json TEXT NOT NULL CHECK(json_valid(receipt_json)),origin_json TEXT NOT NULL CHECK(json_valid(origin_json)),PRIMARY KEY(workspace_id,request_id),FOREIGN KEY(workspace_id,source_branch_id) REFERENCES managed_branches(workspace_id,branch_id))" } else => { if index == 14 => { "CREATE TABLE managed_restore_receipts(workspace_id TEXT NOT NULL,request_id TEXT NOT NULL,checkpoint_id TEXT NOT NULL,original_request_proof TEXT NOT NULL,envelope_json TEXT NOT NULL CHECK(json_valid(envelope_json)),result_json TEXT NOT NULL CHECK(json_valid(result_json)),PRIMARY KEY(workspace_id,request_id))" } else => { if index >= 10 => { checkpoint_schema(index - 10) } else => { effect_schema(index) } } } } }
}

fn effect_schema(index: int) -> string { if index == 0 => { "CREATE TABLE managed_objects (store_id TEXT NOT NULL, object_id TEXT NOT NULL, schema_version INTEGER NOT NULL CHECK(schema_version=1), kind TEXT NOT NULL CHECK(kind IN ('tree','canonical_result','intent_details')), record_json TEXT NOT NULL CHECK(json_valid(record_json)), readiness TEXT NOT NULL CHECK(readiness='synced'), PRIMARY KEY(store_id,object_id))" } else => { if index == 1 => { "CREATE TABLE managed_workspaces (workspace_id TEXT PRIMARY KEY, store_id TEXT NOT NULL, profile TEXT NOT NULL, source_device TEXT NOT NULL, source_inode TEXT NOT NULL, schema_version INTEGER NOT NULL CHECK(schema_version=1), seed_object_id TEXT NOT NULL, current_branch_id TEXT NOT NULL, record_json TEXT NOT NULL CHECK(json_valid(record_json)), UNIQUE(store_id,profile,source_device,source_inode), FOREIGN KEY(store_id,seed_object_id) REFERENCES managed_objects(store_id,object_id))" } else => { if index == 2 => { "CREATE TABLE managed_branches (workspace_id TEXT NOT NULL REFERENCES managed_workspaces(workspace_id), branch_id TEXT NOT NULL, epoch INTEGER NOT NULL CHECK(epoch>0), status TEXT NOT NULL DEFAULT 'active' CHECK(status IN ('active','retired')), lineage_json TEXT NOT NULL DEFAULT '{}', process_lineage_tainted INTEGER NOT NULL DEFAULT 0 CHECK(process_lineage_tainted IN (0,1)), head_object_id TEXT NOT NULL, head_version INTEGER NOT NULL CHECK(head_version>=1), store_id TEXT NOT NULL, schema_version INTEGER NOT NULL CHECK(schema_version=1), PRIMARY KEY(workspace_id,branch_id), FOREIGN KEY(store_id,head_object_id) REFERENCES managed_objects(store_id,object_id))" } else => { if index == 3 => { "CREATE TABLE managed_run_bindings (run_id TEXT PRIMARY KEY REFERENCES runs(id), profile TEXT NOT NULL, session_id TEXT NOT NULL REFERENCES sessions(id), workspace_id TEXT NOT NULL, branch_id TEXT NOT NULL, epoch INTEGER NOT NULL CHECK(epoch>0), graph_ref_id TEXT NOT NULL, original_deadline_ms INTEGER NOT NULL, schema_version INTEGER NOT NULL CHECK(schema_version=1), FOREIGN KEY(workspace_id,branch_id) REFERENCES managed_branches(workspace_id,branch_id))" } else => { if index == 4 => { "CREATE TABLE managed_effect_calls (effect_id TEXT PRIMARY KEY, run_id TEXT NOT NULL REFERENCES runs(id), call_id TEXT NOT NULL, workspace_id TEXT NOT NULL, branch_id TEXT NOT NULL, state TEXT NOT NULL CHECK(state IN ('intent','prepared','committed','read_only','not_published','conflict','indeterminate')), schema_version INTEGER NOT NULL CHECK(schema_version=1), identity_json TEXT NOT NULL CHECK(json_valid(identity_json)), record_json TEXT NOT NULL CHECK(json_valid(record_json)), commit_id TEXT, observed_head TEXT, observed_version INTEGER, UNIQUE(run_id,call_id), FOREIGN KEY(workspace_id,branch_id) REFERENCES managed_branches(workspace_id,branch_id))" } else => { if index == 5 => { "CREATE TABLE managed_effect_receipts (effect_id TEXT PRIMARY KEY REFERENCES managed_effect_calls(effect_id), receipt_id TEXT NOT NULL UNIQUE, prepared_record_json TEXT NOT NULL CHECK(json_valid(prepared_record_json)), outcome_json TEXT CHECK(outcome_json IS NULL OR json_valid(outcome_json)), schema_version INTEGER NOT NULL CHECK(schema_version=1))" } else => { if index == 6 => { "CREATE TABLE managed_head_history (workspace_id TEXT NOT NULL, branch_id TEXT NOT NULL, head_version INTEGER NOT NULL, epoch INTEGER NOT NULL, effect_id TEXT UNIQUE REFERENCES managed_effect_calls(effect_id), previous_head TEXT, head_object_id TEXT NOT NULL, schema_version INTEGER NOT NULL CHECK(schema_version=1), PRIMARY KEY(workspace_id,branch_id,head_version), FOREIGN KEY(workspace_id,branch_id) REFERENCES managed_branches(workspace_id,branch_id))" } else => { if index == 7 => { "CREATE TABLE managed_effect_guard (id INTEGER PRIMARY KEY CHECK(id=1))" } else => { if index == 8 => { "CREATE INDEX managed_effect_recovery ON managed_effect_calls(workspace_id,branch_id,state,effect_id)" } else => { if index == 9 => { "CREATE INDEX managed_effect_owner ON managed_effect_calls(run_id,call_id,effect_id)" } else => { "" } } } } } } } } } } }

pub fn workspace_get(db: resource<sqlite.connection>, payload: string) -> map { let input: ManagedStorageInput = json::decode::<ManagedStorageInput>(payload); ok(sqlite::query(&db, "SELECT record_json FROM managed_workspaces WHERE store_id=? AND profile=? AND source_device=? AND source_inode=?", [text(input.store_id.copy()), text(input.profile.copy()), text(input.source_device.copy()), text(input.source_inode.copy())], limits())) }

pub fn head(db: resource<sqlite.connection>, payload: string) -> map { let input: ManagedStorageInput = json::decode::<ManagedStorageInput>(payload); ok(sqlite::query(&db, "SELECT json_object('workspace_id',workspace_id,'branch_id',branch_id,'epoch',epoch,'head_object_id',head_object_id,'head_version',head_version,'store_id',store_id,'schema_version',schema_version,'process_lineage_tainted',json(CASE process_lineage_tainted WHEN 1 THEN 'true' ELSE 'false' END)) AS record_json FROM managed_branches WHERE workspace_id=? AND branch_id=COALESCE(NULLIF(?,''),(SELECT current_branch_id FROM managed_workspaces WHERE managed_workspaces.workspace_id=managed_branches.workspace_id))", [text(input.workspace_id.copy()), text(input.branch_id.copy())], limits())) }

pub fn get(db: resource<sqlite.connection>, payload: string) -> map { let input: ManagedStorageInput = json::decode::<ManagedStorageInput>(payload); ok(sqlite::query(&db, "SELECT record_json FROM managed_effect_calls WHERE run_id=? AND call_id=? AND json_extract(identity_json,'$.owner.profile')=?", [text(input.run_id.copy()), text(input.call_id.copy()), text(input.profile.copy())], limits())) }

pub fn workspace_register(db: resource<sqlite.connection>, payload: string) -> map {
 let input: ManagedStorageInput = json::decode::<ManagedStorageInput>(payload);
 let statements: array<SqliteStatement> = [
{ sql: "INSERT INTO managed_objects(store_id,object_id,schema_version,kind,record_json,readiness) SELECT json_extract(value,'$.store_id'),json_extract(value,'$.object_id'),1,json_extract(value,'$.object_kind'),value,'synced' FROM json_each(json_array(json_extract(?,'$.seed_root'))) WHERE value IS NOT NULL ON CONFLICT(store_id,object_id) DO NOTHING", params: [text(input.workspace_json.copy())], query: false, limits: limits() },
{ sql: "INSERT INTO managed_workspaces(workspace_id,store_id,profile,source_device,source_inode,schema_version,seed_object_id,record_json,current_branch_id) SELECT json_extract(?,'$.identity.workspace_id'),json_extract(?,'$.identity.store_id'),json_extract(?,'$.profile'),json_extract(?,'$.identity.source_identity.device_decimal'),json_extract(?,'$.identity.source_identity.inode_decimal'),1,json_extract(?,'$.seed_root.object_id'),?,json_extract(?,'$.identity.branch_id') ON CONFLICT(store_id,profile,source_device,source_inode) DO NOTHING", params: [text(input.workspace_json.copy()), text(input.workspace_json.copy()), text(input.workspace_json.copy()), text(input.workspace_json.copy()), text(input.workspace_json.copy()), text(input.workspace_json.copy()), text(input.workspace_json.copy()),text(input.workspace_json.copy())], query: false, limits: limits() },
{ sql: "INSERT INTO managed_effect_guard(id) SELECT 2 WHERE NOT EXISTS (SELECT 1 FROM managed_workspaces WHERE store_id=? AND profile=? AND source_device=? AND source_inode=? AND json_extract(record_json,'$.max_entries')=json_extract(?,'$.max_entries') AND json_extract(record_json,'$.max_bytes')=json_extract(?,'$.max_bytes') AND json_extract(record_json,'$.max_depth')=json_extract(?,'$.max_depth'))", params: [text(input.store_id.copy()), text(input.profile.copy()), text(input.source_device.copy()), text(input.source_inode.copy()), text(input.workspace_json.copy()), text(input.workspace_json.copy()), text(input.workspace_json.copy())], query: false, limits: limits() },
{ sql: "INSERT INTO managed_branches(workspace_id,branch_id,epoch,head_object_id,head_version,store_id,schema_version) SELECT workspace_id,json_extract(record_json,'$.identity.branch_id'),1,seed_object_id,1,store_id,1 FROM managed_workspaces WHERE store_id=? AND profile=? AND source_device=? AND source_inode=? ON CONFLICT(workspace_id,branch_id) DO NOTHING", params: [text(input.store_id.copy()), text(input.profile.copy()), text(input.source_device.copy()), text(input.source_inode.copy())], query: false, limits: limits() },
{ sql: "INSERT INTO managed_head_history(workspace_id,branch_id,head_version,epoch,effect_id,previous_head,head_object_id,schema_version) SELECT workspace_id,branch_id,1,1,NULL,NULL,head_object_id,1 FROM managed_branches WHERE workspace_id=(SELECT workspace_id FROM managed_workspaces WHERE store_id=? AND profile=? AND source_device=? AND source_inode=?) ON CONFLICT(workspace_id,branch_id,head_version) DO NOTHING", params: [text(input.store_id.copy()), text(input.profile.copy()), text(input.source_device.copy()), text(input.source_inode.copy())], query: false, limits: limits() },
{ sql: "SELECT record_json FROM managed_workspaces WHERE store_id=? AND profile=? AND source_device=? AND source_inode=?", params: [text(input.store_id.copy()), text(input.profile.copy()), text(input.source_device.copy()), text(input.source_inode.copy())], query: true, limits: limits() }
];
 let result: array<SqliteTransactionResult> = sqlite::transaction(&db, statements);
 let last: SqliteTransactionResult = result[result.length - 1].copy();
 let query: SqliteQueryResult = last.query;
 ok(query)
}

pub fn admission_statements(payload: string, graph_id: string, ref_id: string) -> array<SqliteStatement> {
 let input: ManagedStorageInput = json::decode::<ManagedStorageInput>(payload);
 [
{sql:"INSERT INTO managed_effect_guard(id) SELECT 2 WHERE (NOT EXISTS(SELECT 1 FROM managed_branches b JOIN managed_workspaces w ON w.workspace_id=b.workspace_id WHERE b.workspace_id=? AND b.branch_id=? AND b.epoch=json_extract(?,'$.epoch') AND b.head_object_id=json_extract(?,'$.head_object_id') AND b.head_version=json_extract(?,'$.head_version') AND b.store_id=json_extract(?,'$.store_id') AND b.status='active' AND (w.current_branch_id=b.branch_id OR EXISTS(SELECT 1 FROM managed_branch_receipts r WHERE r.workspace_id=b.workspace_id AND json_extract(r.receipt_json,'$.branch.branch_id')=b.branch_id AND json_extract(r.origin_json,'$.workspace_id')=b.workspace_id AND ((json_extract(r.receipt_json,'$.branch.epoch')=b.epoch AND json_extract(r.receipt_json,'$.branch.head_object_id')=b.head_object_id AND json_extract(r.receipt_json,'$.branch.head_version')=b.head_version AND json_extract(r.origin_json,'$.head_object_id')=b.head_object_id) OR json_extract(r.origin_json,'$.kind')='checkpoint'))))) AND (? = '' OR (NOT EXISTS (SELECT 1 FROM plugin_graph_revocations WHERE graph_id = ?) AND NOT EXISTS (SELECT 1 FROM plugin_graph_pin_requirements q WHERE q.run_id = ? AND (q.graph_id <> ? OR q.ref_id <> ?)))) ",params:[text(input.workspace_id.copy()),text(input.branch_id.copy()),text(input.record_json.copy()),text(input.record_json.copy()),text(input.record_json.copy()),text(input.record_json.copy()), text(graph_id.copy()), text(graph_id.copy()), text(input.run_id.copy()), text(graph_id.copy()), text(ref_id.copy())],query:false,limits:limits()},
{ sql: "INSERT INTO managed_run_bindings(run_id,profile,session_id,workspace_id,branch_id,epoch,graph_ref_id,original_deadline_ms,schema_version) SELECT ?,?,json_extract(?,'$.session_id'),?,?,json_extract(?,'$.epoch'),json_extract(?,'$.graph_ref_id'),json_extract(?,'$.original_deadline_ms'),1 WHERE (?<>'') AND (? = '' OR (NOT EXISTS (SELECT 1 FROM plugin_graph_revocations WHERE graph_id = ?) AND NOT EXISTS (SELECT 1 FROM plugin_graph_pin_requirements q WHERE q.run_id = ? AND (q.graph_id <> ? OR q.ref_id <> ?)))) ", params: [text(input.run_id.copy()), text(input.profile.copy()), text(input.record_json.copy()), text(input.workspace_id.copy()), text(input.branch_id.copy()), text(input.record_json.copy()), text(input.record_json.copy()), text(input.record_json.copy()), text(input.workspace_id.copy()), text(graph_id.copy()), text(graph_id.copy()), text(input.run_id.copy()), text(graph_id.copy()), text(ref_id.copy())], query: false, limits: limits() }
 ]
}

pub fn begin(db: resource<sqlite.connection>, payload: string) -> map {
 let input: ManagedBeginInput = json::decode::<ManagedBeginInput>(payload.copy());
 let existing:SqliteQueryResult=sqlite::query(&db,"SELECT record_json FROM managed_effect_calls WHERE effect_id=? AND run_id=? AND call_id=? AND identity_json=json_extract(?,'$.identity')",[text(input.effect_id),text(input.run_id),text(input.call_id),text(input.record_json)],limits());
 let inspected:SqliteQueryResult=existing.copy();let count:int=inspected.rows.length;let truncated:bool=inspected.truncated;
 if count == 1 && truncated == false => {ok(existing)} else => {begin_new(db,payload)}
}
