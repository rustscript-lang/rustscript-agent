fn checkpoint_schema(index: int) -> string { if index == 0 => { "CREATE TABLE managed_checkpoints(checkpoint_id TEXT PRIMARY KEY,workspace_id TEXT NOT NULL,request_id TEXT NOT NULL,original_request_proof TEXT NOT NULL,receipt_json TEXT NOT NULL CHECK(json_valid(receipt_json)),compaction_json TEXT NOT NULL CHECK(json_valid(compaction_json)),execution_config_json TEXT NOT NULL CHECK(json_valid(execution_config_json)),UNIQUE(workspace_id,request_id))" } else => { if index == 1 => { "CREATE TABLE managed_checkpoint_history(history_root_id TEXT NOT NULL,ordinal INTEGER NOT NULL,source_message_id TEXT NOT NULL,record_json TEXT NOT NULL CHECK(json_valid(record_json)),PRIMARY KEY(history_root_id,ordinal))" } else => { if index == 2 => { "CREATE TABLE managed_checkpoint_refs(checkpoint_id TEXT NOT NULL,store_id TEXT NOT NULL,object_id TEXT NOT NULL,PRIMARY KEY(checkpoint_id,store_id,object_id))" } else => { if index == 3 => { "CREATE TABLE managed_checkpoint_public_configs(config_ref_id TEXT PRIMARY KEY,checkpoint_id TEXT NOT NULL UNIQUE,record_json TEXT NOT NULL CHECK(json_valid(record_json)))" } else => { "" } } } } }

