if command.op == "compaction.get" => {
        let input: CompactionIdInput = json::decode::<CompactionIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, compactions::storage_compaction_get(db_id, input.compaction_id, command.max_rows, command.max_bytes));
        result
    } else => { null };
if command.op == "compaction.latest" => {
        let input: SessionIdInput = json::decode::<SessionIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, compactions::storage_compaction_latest(db_id, input.session_id, command.max_rows, command.max_bytes));
        result
