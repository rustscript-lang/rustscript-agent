use json;
use sqlite;
use self::schema as schema;
use self::sessions as sessions;
use self::messages as messages;
use self::runs as runs;
use self::events as events;
use self::approvals as approvals;
use self::compactions as compactions;
use self::jobs as jobs;
use self::admission as admission;
use self::load as load;

struct StorageCommand {
    op: string,
    request_id: string,
    db_path: string,
    db_mode: string,
    busy_timeout_ms: int,
    max_rows: int,
    max_bytes: int,
    max_events: int,
    max_messages: int,
    now_ms: int,
    payload_json: string
}


struct StorageResult {
    request_id: string,
    op: string,
    ok: bool,
    code: string,
    message: string,
    data: map,
    rows_affected: int,
    truncated: bool,
    next_cursor: int,
    oldest_available_seq: int,
    high_water_seq: int,
    recovered: int
}

struct StorageOpenOptions {
    path: string,
    mode: string,
    limits: map<int>
}


struct SessionIdInput {
    session_id: string
}


struct MessageIdInput {
    message_id: string
}


struct MessageListInput {
    session_id: string,
    after_ordinal: int
}


struct RunIdInput {
    run_id: string
}


struct SessionListInput {
    profile: string,
    platform: string
}


struct RunListInput {
    session_id: string,
    status: string
}

struct ReplayFloorInput {
    run_id: string,
    after_seq: int
}


struct DeliveryGetInput {
    session_id: string,
    consumer: string
}


struct ApprovalIdInput {
    approval_id: string
}


struct CompactionIdInput {
    compaction_id: string
}




fn storage_open_options(db_path: string, db_mode: string, busy_timeout_ms: int, max_rows: int, max_bytes: int) -> StorageOpenOptions {
    {
        path: db_path,
        mode: db_mode,
        limits: {
            busy_timeout_ms: busy_timeout_ms,
            max_connections: 1,
            max_rows: max_rows,
            max_result_bytes: max_bytes,
            max_statements: 64,
            max_transaction_ms: 5000
        }
    }
}

fn storage_apply_migrations(db_id: int, now_ms: int) {
    sqlite::execute(db_id, schema::schema_migrations_table_sql(), []);
    let mut applied_version: int = storage_applied_version(db_id);
    let mut migration_index = 0;
    while migration_index < schema::schema_migration_count() {
        let migration_version: int = schema::schema_migration_version(migration_index);
        if migration_version > applied_version {
            let mut statements = [];
            let mut statement_index = 0;
            while statement_index < schema::schema_migration_statement_count(migration_index) {
                statements[statements.length] = {
                    sql: schema::schema_migration_statement(migration_index, statement_index),
                    params: []
                };
                statement_index += 1;
            }
            statements[statements.length] = {
                sql: schema::schema_migration_record_sql(),
                params: [
                    schema::schema_migration_version(migration_index),
                    schema::schema_migration_name(migration_index),
                    schema::schema_migration_checksum(migration_index),
                    now_ms
                ]
            };
            sqlite::transaction(db_id, statements);
            applied_version = migration_version;
        }
        migration_index += 1;
    }
    true
}

/// Reads the highest migration version already applied to this database.
/// The query always yields exactly one row (COALESCE), so extraction is
/// unconditional.
fn storage_applied_version(db_id: int) -> int {
    let result: map = sqlite::query(
        db_id,
        "SELECT COALESCE(MAX(version), 0) AS version FROM schema_migrations",
        [],
        { max_rows: 1, max_result_bytes: 4096 }
    );
    let rows: array = result["rows"];
    let row: array = rows[0];
    let version: int = row[0];
    version
}

fn storage_ok(request_id: string, op: string, data: map, rows_affected: int, truncated: bool, next_cursor: int) -> StorageResult {
    {
        request_id: request_id,
        op: op,
        ok: true,
        code: "ok",
        message: "",
        data: data,
        rows_affected: rows_affected,
        truncated: truncated,
        next_cursor: next_cursor,
        oldest_available_seq: 0,
        high_water_seq: 0,
        recovered: 0
    }
}

/// Wraps one atomic transaction result array under `data.results` so every
/// successful storage result carries a map payload.
fn storage_array_ok(request_id: string, op: string, results: array) -> StorageResult {
    storage_ok(request_id, op, { results: results }, 0, false, 0)
}

fn storage_raw_ok(request_id: string, op: string, raw_result: map) -> StorageResult {
    let rows_affected: int = sqlite::rows_affected(raw_result);
    let truncated: bool = sqlite::truncated(raw_result);
    let next_cursor: int = sqlite::next_cursor(raw_result);
    storage_ok(request_id, op, raw_result, rows_affected, truncated, next_cursor)
}

fn storage_host_contract() -> string {
    "sqlite::open sqlite::execute sqlite::query sqlite::transaction sqlite::close"
}

fn storage_error(request_id: string, op: string, code: string, message: string) -> StorageResult {
    {
        request_id: request_id,
        op: op,
        ok: false,
        code: code,
        message: message,
        data: {},
        rows_affected: 0,
        truncated: false,
        next_cursor: 0,
        oldest_available_seq: 0,
        high_water_seq: 0,
        recovered: 0
    }
}

/// Unwraps a module result that carries either `{ok: true, result: <raw
/// query map>}` or `{ok: false, code, message}` into the typed envelope.
fn storage_unwrap(request_id: string, op: string, wrapped: map) -> StorageResult {
    let ok_flag: bool = wrapped["ok"];
    let mut result = storage_error(request_id, op, "unwrap_missing", "unwrap result missing");
    if ok_flag == true {
        let raw: map = wrapped["result"];
        result = storage_raw_ok(request_id, op, raw);
    } else {
        let code: string = wrapped["code"];
        let message: string = wrapped["message"];
        result = storage_error(request_id, op, code, message);
    }
    result
}

/// Same unwrap for module results whose raw result is an atomic transaction
/// results array.
fn storage_unwrap_array(request_id: string, op: string, wrapped: map) -> StorageResult {
    let ok_flag: bool = wrapped["ok"];
    let mut result = storage_error(request_id, op, "unwrap_missing", "unwrap result missing");
    if ok_flag == true {
        let raw: array = wrapped["result"];
        result = storage_array_ok(request_id, op, raw);
    } else {
        let code: string = wrapped["code"];
        let message: string = wrapped["message"];
        result = storage_error(request_id, op, code, message);
    }
    result
}

/// Returns the `rows_affected` count of the first statement result of an
/// atomic transaction results array.
fn storage_first_rows_affected(results: array) -> int {
    let mut affected: int = 0;
    if results.length > 0 {
        let first: map = results[0];
        let count: int = first["rows_affected"];
        affected = count;
    }
    affected
}

/// Returns the `rows_affected` count of the statement result at `index`.
fn storage_nth_rows_affected(results: array, index: int) -> int {
    let mut affected: int = 0;
    if results.length > index {
        let first: map = results[index];
        let count: int = first["rows_affected"];
        affected = count;
    }
    affected
}

fn storage_dispatch(db_id: int, command: StorageCommand) -> StorageResult {
    let request_id = command.request_id.copy();
    let op = command.op.copy();
    let mut result = storage_error(request_id.copy(), op.copy(), "unknown_operation", "storage operation is not registered");
    if command.payload_json.length > 4194304 {
        result = storage_error(request_id, op, "payload_too_large", "storage command payload exceeds 4194304 bytes");
    } else if command.op == "migrate" {
        result = storage_ok(request_id, op, {schema_version: schema::schema_current_version(), host_contract: storage_host_contract()}, 0, false, 0);
    } else if command.op == "session.create" {
        result = storage_raw_ok(request_id, op, sessions::storage_session_create(db_id, command.payload_json, command.max_rows, command.max_bytes));
    } else if command.op == "session.get" {
        let input: SessionIdInput = json::decode::<SessionIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, sessions::storage_session_get(db_id, input.session_id, command.max_rows, command.max_bytes));
    } else if command.op == "session.list" {
        let input: SessionListInput = json::decode::<SessionListInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, sessions::storage_session_list(db_id, input.profile, input.platform, command.max_rows, command.max_bytes));
    } else if command.op == "session.touch" {
        result = storage_raw_ok(request_id, op, sessions::storage_session_touch(db_id, command.payload_json, command.max_rows, command.max_bytes));
    } else if command.op == "message.append" {
        result = storage_unwrap(request_id, op, messages::storage_message_append(db_id, command.payload_json, command.max_rows, command.max_bytes));
    } else if command.op == "message.get" {
        let input: MessageIdInput = json::decode::<MessageIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, messages::storage_message_get(db_id, input.message_id, command.max_rows, command.max_bytes));
    } else if command.op == "message.list" {
        let input: MessageListInput = json::decode::<MessageListInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, messages::storage_message_list(db_id, input.session_id, input.after_ordinal.copy(), command.max_messages, command.max_bytes));
    } else if command.op == "message.compact" {
        result = storage_raw_ok(request_id, op, messages::storage_message_mark_compacted(db_id, command.payload_json));
    } else if command.op == "run.create" {
        result = storage_unwrap(request_id, op, runs::storage_run_create(db_id, command.payload_json, command.max_rows, command.max_bytes));
    } else if command.op == "run.get" {
        let input: RunIdInput = json::decode::<RunIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, runs::storage_run_get(db_id, input.run_id, command.max_rows, command.max_bytes));
    } else if command.op == "run.list" {
        let input: RunListInput = json::decode::<RunListInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, runs::storage_run_list(db_id, input.session_id, input.status, command.max_rows, command.max_bytes));
    } else if command.op == "run.transition" {
        let transition_results: array = runs::storage_run_transition(db_id, command.payload_json);
        if storage_first_rows_affected(transition_results) == 0 {
            result = storage_error(request_id, op, "transition_conflict", "run status transition matched no row");
        } else {
            result = storage_array_ok(request_id, op, transition_results);
        }
    } else if command.op == "run.terminal" {
        result = storage_unwrap(request_id, op, runs::storage_run_terminal(db_id, command.payload_json));
    } else if command.op == "admission.create" {
        result = storage_unwrap(request_id, op, admission::storage_admission_create(db_id, command.payload_json));
    } else if command.op == "session.delete" {
        let delete_results: array = sessions::storage_session_delete(db_id, command.payload_json);
        if storage_nth_rows_affected(delete_results, 1) == 0 {
            result = storage_error(request_id, op, "session_not_found", "session does not exist");
        } else {
            result = storage_array_ok(request_id, op, delete_results);
        }
    } else if command.op == "load.all" {
        result = storage_unwrap(request_id, op, load::storage_load_all(db_id, command.payload_json));
    } else if command.op == "run.link_child" {
        result = storage_unwrap(request_id, op, runs::storage_run_link_child(db_id, command.payload_json));
    } else if command.op == "run.list_children" {
        let input: RunIdInput = json::decode::<RunIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, runs::storage_run_list_children(db_id, input.run_id, command.max_rows, command.max_bytes));
    } else if command.op == "run.usage" {
        result = storage_raw_ok(request_id, op, runs::storage_run_record_usage(db_id, command.payload_json));
    } else if command.op == "idempotency.begin" {
        result = storage_raw_ok(request_id, op, runs::storage_run_idempotency_begin(db_id, command.payload_json, command.max_rows, command.max_bytes));
    } else if command.op == "idempotency.complete" {
        result = storage_raw_ok(request_id, op, runs::storage_run_idempotency_complete(db_id, command.payload_json));
    } else if command.op == "recovery.recover_active" {
        let recovery_results: array = runs::storage_run_recover_active(db_id, command.payload_json);
        let recovered: int = storage_first_rows_affected(recovery_results);
        result = {
            request_id: request_id,
            op: op,
            ok: true,
            code: "ok",
            message: "",
            data: { results: recovery_results },
            rows_affected: 0,
            truncated: false,
            next_cursor: 0,
            oldest_available_seq: 0,
            high_water_seq: 0,
            recovered: recovered
        };
    } else if command.op == "event.append" {
        result = storage_unwrap_array(request_id, op, events::storage_event_append(db_id, command.payload_json));
    } else if command.op == "event.replay" {
        let replay_input: ReplayFloorInput = json::decode::<ReplayFloorInput>(command.payload_json);
        let floor: map = events::storage_event_retention(db_id, replay_input.run_id);
        let floor_first: int = floor["first_seq"];
        let floor_high: int = floor["high_water_seq"];
        if floor_first > 1 && replay_input.after_seq < floor_first {
            result = {
                request_id: request_id,
                op: op,
                ok: false,
                code: "cursor_too_old",
                message: "replay cursor precedes the retained event floor",
                data: {},
                rows_affected: 0,
                truncated: false,
                next_cursor: 0,
                oldest_available_seq: floor_first,
                high_water_seq: floor_high
            };
        } else {
            let replay_data: map = events::storage_event_replay(db_id, command.payload_json);
            let replay_truncated: bool = sqlite::truncated(replay_data);
            let replay_cursor: int = sqlite::next_cursor(replay_data);
            let mut next_cursor_value: int = 0;
            if replay_truncated {
                next_cursor_value = replay_cursor + 1;
            }
            result = {
                request_id: request_id,
                op: op,
                ok: true,
                code: "ok",
                message: "",
                data: replay_data,
                rows_affected: 0,
                truncated: replay_truncated,
                next_cursor: next_cursor_value,
                oldest_available_seq: floor_first,
                high_water_seq: floor_high
            };
        }
    } else if command.op == "event.prune" {
        result = storage_array_ok(request_id, op, events::storage_event_prune(db_id, command.payload_json));
    } else if command.op == "delivery.get" {
        let input: DeliveryGetInput = json::decode::<DeliveryGetInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, events::storage_delivery_cursor_get(db_id, input.session_id, input.consumer, command.max_rows, command.max_bytes));
    } else if command.op == "delivery.advance" {
        result = storage_raw_ok(request_id, op, events::storage_delivery_cursor_advance(db_id, command.payload_json));
    } else if command.op == "delivery.set" {
        result = storage_raw_ok(request_id, op, events::storage_delivery_cursor_set(db_id, command.payload_json));
    } else if command.op == "approval.request" {
        result = storage_unwrap(request_id, op, approvals::storage_approval_request(db_id, command.payload_json, command.max_rows, command.max_bytes));
    } else if command.op == "approval.get" {
        let input: ApprovalIdInput = json::decode::<ApprovalIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, approvals::storage_approval_get(db_id, input.approval_id, command.max_rows, command.max_bytes));
    } else if command.op == "approval.resolve" {
        result = storage_raw_ok(request_id, op, approvals::storage_approval_resolve(db_id, command.payload_json));
    } else if command.op == "approval.expire" {
        result = storage_raw_ok(request_id, op, approvals::storage_approval_expire(db_id, command.payload_json));
    } else if command.op == "compaction.start" {
        result = storage_unwrap(request_id, op, compactions::storage_compaction_start(db_id, command.payload_json, command.max_rows, command.max_bytes));
    } else if command.op == "compaction.get" {
        let input: CompactionIdInput = json::decode::<CompactionIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, compactions::storage_compaction_get(db_id, input.compaction_id, command.max_rows, command.max_bytes));
    } else if command.op == "compaction.latest" {
        let input: SessionIdInput = json::decode::<SessionIdInput>(command.payload_json);
        result = storage_raw_ok(request_id, op, compactions::storage_compaction_latest(db_id, input.session_id, command.max_rows, command.max_bytes));
    } else if command.op == "compaction.commit" {
        result = storage_array_ok(request_id, op, compactions::storage_compaction_commit(db_id, command.payload_json));
    } else if command.op == "compaction.fail" {
        result = storage_raw_ok(request_id, op, compactions::storage_compaction_fail(db_id, command.payload_json));
    } else if command.op == "job.create" {
        result = storage_unwrap(request_id, op, jobs::storage_job_create(db_id, command.payload_json, command.max_rows, command.max_bytes));
    } else if command.op == "job.update" {
        result = storage_unwrap(request_id, op, jobs::storage_job_update(db_id, command.payload_json, command.max_rows, command.max_bytes));
    } else if command.op == "job.delete" {
        result = storage_unwrap(request_id, op, jobs::storage_job_delete(db_id, command.payload_json));
    } else if command.op == "job.get" {
        result = storage_unwrap(request_id, op, jobs::storage_job_get(db_id, command.payload_json, command.max_rows, command.max_bytes));
    } else if command.op == "job.list" {
        result = storage_unwrap(request_id, op, jobs::storage_job_list(db_id, command.max_rows, command.max_bytes));
    }
    result
}

pub fn run(command: StorageCommand) -> StorageResult {
let db_id: int = sqlite::open(storage_open_options(command.db_path.copy(), command.db_mode.copy(), command.busy_timeout_ms.copy(), command.max_rows.copy(), command.max_bytes.copy()));
let _migration_result = if command.db_mode.copy() == "read_only" => { true } else => { storage_apply_migrations(db_id, command.now_ms.copy()) };
let result = storage_dispatch(db_id, command);
sqlite::close(db_id);
result
}
