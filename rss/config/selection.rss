struct EffectiveSelection {
    ok: bool,
    provider: string,
    model: string,
    source: string,
    error: Option<string>
}

fn failed_selection(code: string) -> EffectiveSelection {
    let error: Option<string> = Some(code);
    {ok: false, provider: "", model: "", source: "", error: error}
}

pub fn effective_selection(
    public_config: BoundedPublicConfig,
    provider_override: Option<string>
) -> EffectiveSelection {
    let mut provider_name: string = public_config.model.provider;
    let override_present: bool = match provider_override.copy() {
        Some(_) => true,
        None => false,
    };
    if override_present {
        let requested: string = provider_override.unwrap_or("");
        provider_name = requested;
    }
    let providers = public_config.providers;
    let mut index: int = 0;
    let mut found: bool = false;
    while index < providers.length && !found {
        let provider: ProviderEntry = providers[index].copy();
        if provider.name == provider_name {
            found = true;
        }
        index += 1;
    }
    if override_present && provider_name == "" => {
        failed_selection("provider_required")
    } else if !found => {
        failed_selection("provider_not_found")
    } else => {
        let missing: Option<string> = None;
        {
            ok: true,
            provider: provider_name,
            model: public_config.model.model,
            source: public_config.agent.source,
            error: missing
        }
    }
}
