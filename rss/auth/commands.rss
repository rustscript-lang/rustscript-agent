use auth;
use config;
use json;
use super::config::selection;
use self::login::{run as login_run};

struct AuthCommandInput {
    operation: string,
    provider: Option<string>,
    credential_id: Option<string>
}

struct AuthEntryResult {
    ok: bool,
    operation: string,
    credential_id: Option<string>,
    generation: int,
    status: string,
    error: Option<string>
}

struct CliAuthRow {
    provider: string,
    credential_id: Option<string>,
    status: string,
    source: Option<string>,
    generation: int
}

struct CliSelectionRow {
    kind: string,
    provider: string,
    model: string,
    source: string
}

struct CliLogoutRow {
    credential_id: string,
    status: string
}

struct ProviderStatus {
    ok: bool,
    row: string,
    credential_id: Option<string>,
    category: string,
    inactive: bool
}

struct EffectiveSelection {
    ok: bool,
    provider: string,
    model: string,
    source: string,
    error: Option<string>
}

fn entry(
    ok: bool,
    operation: string,
    credential_id: Option<string>,
    generation: int,
    status: string,
    error: Option<string>
) -> AuthEntryResult {
    {ok: ok, operation: operation, credential_id: credential_id, generation: generation, status: status, error: error}
}

fn failure_present(value: Option<AuthBridgeFailure>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn text_present(value: Option<string>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn envelope_present(value: Option<AuthMetadataEnvelope>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn mutation_present(value: Option<RedactedMutationResult>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn no_text() -> Option<string> {
    None
}

fn host_failure_bridge() -> AuthBridgeFailure {
    {code: "host_failure", cancelled: false, deadline_exceeded: false, revoked: false}
}

fn empty_metadata_envelope() -> AuthMetadataEnvelope {
    {ok: false, error: no_text(), metadata: empty_metadata(), outcome: ""}
}

fn empty_metadata() -> AuthMetadata {
    let account_id: Option<string> = None;
    let last_refresh_at_ms: Option<int> = None;
    {
        credential_id: "",
        provider: "",
        kind: "",
        source: "",
        token_type: "",
        expires_at_ms: 0,
        scopes: [],
        account_id: account_id,
        generation: 0,
        status: "",
        last_refresh_at_ms: last_refresh_at_ms,
        has_refresh_token: false
    }
}

fn empty_mutation() -> RedactedMutationResult {
    {ok: false, error: no_text(), deleted: false}
}

fn report_row(provider: string, credential_id: Option<string>, status: string, source: Option<string>, generation: int) -> string {
    let row: CliAuthRow = {
        provider: provider,
        credential_id: credential_id,
        status: status,
        source: source,
        generation: generation
    };
    json::encode(row) + "\n"
}

fn unconfigured_status(provider: ProviderEntry) -> ProviderStatus {
    let name: string = provider.name.copy();
    {
        ok: true,
        row: report_row(name.copy(), no_text(), "not_configured", no_text(), 0),
        credential_id: no_text(),
        category: "",
        inactive: false
    }
}

fn metadata_value_valid(envelope: AuthMetadataEnvelope) -> bool {
    envelope.ok.copy() && !text_present(envelope.error.copy()) && envelope.outcome.copy() == "loaded"
}

fn provider_status(provider: ProviderEntry, loaded: AuthMetadataResultEnvelope) -> ProviderStatus {
    let name: string = provider.name.copy();
    let credential_id: Option<string> = provider.auth.copy();
    let loaded_failure: Option<AuthBridgeFailure> = loaded.error.copy();
    let loaded_value: Option<AuthMetadataEnvelope> = loaded.value.copy();
    if loaded.ok => {
        if !failure_present(loaded_failure) && envelope_present(loaded_value) => {
            let envelope: AuthMetadataEnvelope = loaded_value.unwrap_or(empty_metadata_envelope());
            if metadata_value_valid(envelope.copy()) => {
                let metadata: AuthMetadata = envelope.metadata.copy();
                {
                    ok: true,
                    row: report_row(name.copy(), Some(metadata.credential_id.copy()), metadata.status.copy(), Some(metadata.source.copy()), metadata.generation.copy()),
                    credential_id: Some(metadata.credential_id.copy()),
                    category: "",
                    inactive: metadata.status.copy() == "disabled" || metadata.status.copy() == "reauth_required"
                }
            } else => {
                {
                    ok: false,
                    row: report_row(name.copy(), credential_id, "host_failure", no_text(), 0),
                    credential_id: credential_id,
                    category: "host_failure",
                    inactive: false
                }
            }
        } else => {
            {
                ok: false,
                row: report_row(name.copy(), credential_id, "host_failure", no_text(), 0),
                credential_id: credential_id,
                category: "host_failure",
                inactive: false
            }
        }
    } else => {
        if failure_present(loaded_failure) && !envelope_present(loaded_value) => {
            // The native failure carrier is consumed once: the code is the only
            // fact this projection needs.
            let code: string = match loaded_failure {
                Some(failure) => failure.code.copy(),
                None => "host_failure"
            };
            if code.copy() == "credential_not_found" => {
                {
                    ok: true,
                    row: report_row(name.copy(), credential_id, "missing", no_text(), 0),
                    credential_id: credential_id,
                    category: "",
                    inactive: true
                }
            } else => {
                {
                    ok: false,
                    row: report_row(name.copy(), credential_id, code.copy(), no_text(), 0),
                    credential_id: credential_id,
                    category: code.copy(),
                    inactive: false
                }
            }
        } else => {
            {
                ok: false,
                row: report_row(name.copy(), credential_id, "host_failure", no_text(), 0),
                credential_id: credential_id,
                category: "host_failure",
                inactive: false
            }
        }
    }
}

fn selection_row(provider: string, model: string, source: string) -> string {
    let row: CliSelectionRow = {
        kind: "selection",
        provider: provider,
        model: model,
        source: source
    };
    json::encode(row) + "\n"
}

fn logout_report(credential_id: string, status: string) -> string {
    let row: CliLogoutRow = {credential_id: credential_id, status: status};
    json::encode(row)
}

pub fn run(home: resource<auth.host_home>, command: AuthCommandInput) -> AuthEntryResult {
    let operation: string = command.operation.copy();
    if operation.copy() == "auth.login" => {
        login_run(home, command)
    } else if operation.copy() == "auth.status" => {
        if text_present(command.credential_id.copy()) => {
            entry(false, operation.copy(), no_text(), 0, "invalid_command", Some("invalid_command"))
        } else => {
            let snapshot = config::load_snapshot(&home);
            let generation: int = snapshot.policy_generation;
            let policy: resource<auth.policy> = snapshot.policy_handle;
            let public_config = snapshot.public_config;
            let providers = public_config.providers.copy();
            if !text_present(command.provider.copy()) => {
                let mut index: int = 0;
                let mut report: string = "";
                let mut failure: string = "";
                while index < providers.length {
                    let provider: ProviderEntry = providers[index].copy();
                    let state: ProviderStatus = if !text_present(provider.auth.copy()) => {
                    unconfigured_status(provider.copy())
                } else => {
                    let credential_id: string = provider.auth.copy().unwrap_or("");
                    let loaded: AuthMetadataResultEnvelope = auth::load_metadata_result(credential_id.copy(), &policy);
                    provider_status(provider.copy(), loaded)
                };
                    report = report + state.row.copy();
                    if !state.ok && failure.copy() == "" {
                        failure = state.category.copy();
                    }
                    index += 1;
                }
                if failure.copy() == "" => {
                    entry(true, operation.copy(), no_text(), generation.copy(), report, no_text())
                } else => {
                    entry(false, operation.copy(), no_text(), generation.copy(), report, Some(failure.copy()))
                }
            } else => {
                let selected: EffectiveSelection = selection::effective_selection(public_config.copy(), command.provider.copy());
                if !selected.ok.copy() => {
                    let code: string = selected.error.copy().unwrap_or("");
                    entry(false, operation.copy(), no_text(), generation.copy(), code.copy(), Some(code.copy()))
                } else => {
                    let requested: string = selected.provider.copy();
                    let mut index: int = 0;
                    let mut found: bool = false;
                    let mut result: AuthEntryResult = entry(false, operation.copy(), no_text(), generation.copy(), "provider_not_found", Some("provider_not_found"));
                    while index < providers.length && !found {
                        let provider: ProviderEntry = providers[index].copy();
                        if provider.name.copy() == requested.copy() {
                            found = true;
                            let state: ProviderStatus = if !text_present(provider.auth.copy()) => {
                                unconfigured_status(provider.copy())
                            } else => {
                                let credential_id: string = provider.auth.copy().unwrap_or("");
                                let loaded: AuthMetadataResultEnvelope = auth::load_metadata_result(credential_id.copy(), &policy);
                                provider_status(provider.copy(), loaded)
                            };
                            if !text_present(provider.auth.copy()) {
                                result = entry(true, operation.copy(), no_text(), generation.copy(), state.row.copy(), no_text());
                            } else {
                                if state.ok {
                                    result = entry(true, operation.copy(), state.credential_id, generation.copy(), state.row.copy(), no_text());
                                } else {
                                    result = entry(false, operation.copy(), state.credential_id, generation.copy(), state.row.copy(), Some(state.category.copy()));
                                }
                            }
                        }
                        index += 1;
                    }
                    result
                }
            }
        }
    } else if operation.copy() == "config.check" => {
        if text_present(command.provider.copy()) || text_present(command.credential_id.copy()) => {
            entry(false, operation.copy(), no_text(), 0, "invalid_command", Some("invalid_command"))
        } else => {
            let snapshot = config::load_snapshot(&home);
            let generation: int = snapshot.policy_generation;
            let policy: resource<auth.policy> = snapshot.policy_handle;
            let public_config: BoundedPublicConfig = snapshot.public_config;
            let selection: EffectiveSelection = selection::effective_selection(public_config.copy(), no_text());
            let providers = public_config.providers;
            let mut report: string = "";
            let mut index: int = 0;
            let mut native_failure: string = "";
            let mut credential_failure: bool = false;
            while index < providers.length {
                let provider: ProviderEntry = providers[index].copy();
                let state: ProviderStatus = if !text_present(provider.auth.copy()) => {
                    unconfigured_status(provider.copy())
                } else => {
                    let credential_id: string = provider.auth.copy().unwrap_or("");
                    let loaded: AuthMetadataResultEnvelope = auth::load_metadata_result(credential_id.copy(), &policy);
                    provider_status(provider.copy(), loaded)
                };
                report = report + state.row.copy();
                if !state.ok && native_failure.copy() == "" {
                    native_failure = state.category.copy();
                }
                if state.inactive {
                    credential_failure = true;
                }
                index += 1;
            }
            if selection.ok.copy() {
                report = report + selection_row(selection.provider.copy(), selection.model.copy(), selection.source.copy());
            }
            if native_failure.copy() != "" => {
                entry(false, operation.copy(), no_text(), generation.copy(), report, Some(native_failure.copy()))
            } else if !selection.ok.copy() => {
                let code: string = selection.error.copy().unwrap_or("");
                entry(false, operation.copy(), no_text(), generation.copy(), report, Some(code.copy()))
            } else if credential_failure => {
                entry(false, operation.copy(), no_text(), generation.copy(), report, Some("credential_check_failed"))
            } else => {
                entry(true, operation.copy(), no_text(), generation.copy(), report, no_text())
            }
        }
    } else if operation.copy() == "auth.logout" => {
        if text_present(command.provider.copy()) => {
            entry(false, operation.copy(), no_text(), 0, "invalid_command", Some("invalid_command"))
        } else if !text_present(command.credential_id.copy()) => {
            entry(false, operation.copy(), no_text(), 0, "credential_id_required", Some("credential_id_required"))
        } else => {
            let credential_id: string = command.credential_id.copy().unwrap_or("");
            if credential_id.copy() == "" => {
                entry(false, operation.copy(), no_text(), 0, "credential_id_required", Some("credential_id_required"))
            } else => {
                let snapshot = config::load_snapshot(&home);
                let generation: int = snapshot.policy_generation;
                let credential_refs = snapshot.credential_refs;
                let mut index: int = 0;
                let mut admitted: bool = false;
                while index < credential_refs.length && !admitted {
                    if credential_refs[index].copy() == credential_id.copy() {
                        admitted = true;
                    }
                    index += 1;
                }
                if admitted => {
                    let policy: resource<auth.policy> = snapshot.policy_handle;
                    let preflight: AuthMetadataResultEnvelope = auth::load_metadata_result(credential_id.copy(), &policy);
                    if preflight.ok.copy() => {
                        if !failure_present(preflight.error.copy()) && envelope_present(preflight.value.copy()) => {
                            let metadata: AuthMetadataEnvelope = preflight.value.copy().unwrap_or(empty_metadata_envelope());
                            if metadata_value_valid(metadata.copy()) => {
                                let deleted: AuthDeleteResultEnvelope = auth::delete_result(credential_id.copy(), &policy);
                                if deleted.ok.copy() => {
                                    if !failure_present(deleted.error.copy()) && mutation_present(deleted.value.copy()) => {
                                        let mutation: RedactedMutationResult = deleted.value.copy().unwrap_or(empty_mutation());
                                        if mutation.ok.copy() && !text_present(mutation.error.copy()) && mutation.deleted.copy() => {
                                            entry(true, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), "deleted"), no_text())
                                        } else => {
                                            entry(false, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), "host_failure"), Some("host_failure"))
                                        }
                                    } else => {
                                        entry(false, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), "host_failure"), Some("host_failure"))
                                    }
                                } else => {
                                    if failure_present(deleted.error.copy()) && !mutation_present(deleted.value.copy()) => {
                                        let bridge_failure: AuthBridgeFailure = deleted.error.copy().unwrap_or(host_failure_bridge());
                                        let logout_code: string = bridge_failure.code.copy();
                                        entry(false, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), logout_code.copy()), Some(logout_code.copy()))
                                    } else => {
                                        entry(false, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), "host_failure"), Some("host_failure"))
                                    }
                                }
                            } else => {
                                entry(false, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), "host_failure"), Some("host_failure"))
                            }
                        } else => {
                            entry(false, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), "host_failure"), Some("host_failure"))
                        }
                    } else => {
                        if failure_present(preflight.error.copy()) && !envelope_present(preflight.value.copy()) => {
                            let bridge_failure: AuthBridgeFailure = preflight.error.copy().unwrap_or(host_failure_bridge());
                            let preflight_code: string = bridge_failure.code.copy();
                            if preflight_code.copy() == "credential_not_found" => {
                                entry(true, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), "already_absent"), no_text())
                            } else => {
                                entry(false, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), preflight_code.copy()), Some(preflight_code.copy()))
                            }
                        } else => {
                            entry(false, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), "host_failure"), Some("host_failure"))
                        }
                    }
                } else => {
                    entry(true, operation.copy(), Some(credential_id.copy()), generation.copy(), logout_report(credential_id.copy(), "already_absent"), no_text())
                }
            }
        }
    } else => {
        entry(false, operation.copy(), command.credential_id.copy(), 0, "unsupported_operation", Some("unsupported_operation"))
    }
}
