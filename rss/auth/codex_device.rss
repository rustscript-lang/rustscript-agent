    verifier: VerifierHandlePresence
}

fn device_capture_parts(envelope: TransportCaptureEnvelope) -> DeviceCaptureParts {
    let has_code: bool = envelope.has("code_handle");
    let has_verifier: bool = envelope.has("verifier_handle");
    let capture_ok: bool = envelope.ok;
    let response: TransportResponseEnvelope = envelope.response;
    if has_code && has_verifier => {
        {ok: capture_ok, response: response, code: {handle: envelope.code_handle}, verifier: {handle: envelope.verifier_handle}}
    } else if has_code => {
        {ok: capture_ok, response: response, code: {handle: envelope.code_handle}, verifier: {handle: null}}
    } else if has_verifier => {
        {ok: capture_ok, response: response, code: {handle: null}, verifier: {handle: envelope.verifier_handle}}
    } else => {
        {ok: capture_ok, response: response, code: {handle: null}, verifier: {handle: null}}
    }
}

struct ExchangeResponseParts {
    status: int,
    ok: bool,
    body: string,
    access: SecretSlotPresence,
    refresh: SecretSlotPresence
}

struct PollResponseParts {
    status: int,
    has_retry_after: bool,
    retry_after_ms: int,
    access: SecretSlotPresence,
    refresh: SecretSlotPresence,
    device: DeviceHandlePresence
}

fn exchange_response_parts(response: TransportResponseEnvelope) -> ExchangeResponseParts {
    let has_access: bool = response.has("access_slot");
    let has_refresh: bool = response.has("refresh_slot");
    let response_status: int = response.status;
    let response_ok: bool = response.ok;
    let response_body: string = response.body_without_secret_fields;
    if has_access && has_refresh => {
        {status: response_status, ok: response_ok, body: response_body, access: {handle: response.access_slot}, refresh: {handle: response.refresh_slot}}
    } else if has_access => {
        {status: response_status, ok: response_ok, body: response_body, access: {handle: response.access_slot}, refresh: {handle: null}}
    } else if has_refresh => {
        {status: response_status, ok: response_ok, body: response_body, access: {handle: null}, refresh: {handle: response.refresh_slot}}
    } else => {
        {status: response_status, ok: response_ok, body: response_body, access: {handle: null}, refresh: {handle: null}}
    }
}

fn poll_response_parts(response: TransportResponseEnvelope) -> PollResponseParts {
    let has_access: bool = response.has("access_slot");
    let has_refresh: bool = response.has("refresh_slot");
    let has_device: bool = response.has("device_handle");
    let retry_after_field_present: bool = response.has("retry_after_ms");
    let response_status: int = response.status;
    let mut has_retry_after: bool = false;
    let mut retry_after: int = 0;
    if retry_after_field_present {
        let retry_after_value: int? = response.retry_after_ms;
        if retry_after_value != null {
            has_retry_after = true;
            retry_after = retry_after_value.copy();
        }
    }
    if has_access && has_refresh && has_device => {
        {status: response_status, has_retry_after: has_retry_after, retry_after_ms: retry_after, access: {handle: response.access_slot}, refresh: {handle: response.refresh_slot}, device: {handle: response.device_handle}}
    } else if has_access && has_refresh => {
        {status: response_status, has_retry_after: has_retry_after, retry_after_ms: retry_after, access: {handle: response.access_slot}, refresh: {handle: response.refresh_slot}, device: {handle: null}}
    } else if has_access && has_device => {
        {status: response_status, has_retry_after: has_retry_after, retry_after_ms: retry_after, access: {handle: response.access_slot}, refresh: {handle: null}, device: {handle: response.device_handle}}
    } else if has_refresh && has_device => {
        {status: response_status, has_retry_after: has_retry_after, retry_after_ms: retry_after, access: {handle: null}, refresh: {handle: response.refresh_slot}, device: {handle: response.device_handle}}
    } else if has_access => {
        {status: response_status, has_retry_after: has_retry_after, retry_after_ms: retry_after, access: {handle: response.access_slot}, refresh: {handle: null}, device: {handle: null}}
    } else if has_refresh => {
        {status: response_status, has_retry_after: has_retry_after, retry_after_ms: retry_after, access: {handle: null}, refresh: {handle: response.refresh_slot}, device: {handle: null}}
    } else if has_device => {
        {status: response_status, has_retry_after: has_retry_after, retry_after_ms: retry_after, access: {handle: null}, refresh: {handle: null}, device: {handle: response.device_handle}}
    } else => {
        {status: response_status, has_retry_after: has_retry_after, retry_after_ms: retry_after, access: {handle: null}, refresh: {handle: null}, device: {handle: null}}
    }
}

fn poll_until_complete(state: DevicePollState, credential_id: string, endpoints: DeviceEndpointChoice, deadline_ms: int, last_ms: int) -> DevicePoll {
    let mut complete: bool = false;
    let mut keep_polling: bool = true;
    let mut code_handle: resource<oauth.authorization_code>? = null;
    let mut verifier_handle: resource<oauth.verifier>? = null;
    let mut failure: CodexDeviceLoginResult = failed("poll_failed", "Codex device authorization did not complete.");
    let base_interval_ms: int = state.interval_ms;
    let mut retry_delay_ms: int = base_interval_ms;
    let mut next_poll_delay_ms: int = base_interval_ms;
    let mut current_ms: int = last_ms;
    let mut first_poll: bool = true;
    let poll_body: DevicePollJson = {user_code: state.user_code};
    let public_body: string = json::encode(poll_body);
    let request: TransportPublicRequest = {
        policy_handle: state.policy_handle,
        credential_id: credential_id,
        method: "POST",
        path: endpoints.poll_path,
        public_headers: [{name: "content-type", value: "application/json"}],
        public_body: public_body
    };
    let usage: TransportCredentialUse = {kind: "device_session", access_handle: null, refresh_handle: null, code_handle: null, verifier_handle: null, device_handle: state.device_handle};
    while keep_polling {
        if !first_poll {
            let before_wait: DeviceClockCheck = clock_check_value(oauth::now_ms_result(&request.policy_handle), deadline_ms, current_ms);
            current_ms = before_wait.now_ms.copy();
            if !before_wait.ok {
                failure = before_wait.failure;
                keep_polling = false;
            } else {
                let remaining: int = deadline_ms - before_wait.now_ms.copy();
                let mut delay: int = next_poll_delay_ms;
                if delay > max_interval_ms() { delay = max_interval_ms(); }
                if delay > remaining { delay = remaining; }
                if delay <= 0 {
                    failure = failed("timeout", "Codex device login timed out.");
                    keep_polling = false;
                } else {
                    let waited: OAuthWaitResultEnvelope = oauth::wait_ms_result(&request.policy_handle, delay);
                    if !waited.ok {
                        failure = static_failure(waited.error, "wait_failed", "The device-login wait could not continue.");
                        keep_polling = false;
                    } else {
                        let after_wait: DeviceClockCheck = clock_check_value(oauth::now_ms_result(&request.policy_handle), deadline_ms, before_wait.now_ms.copy());
                        current_ms = after_wait.now_ms;
                        if !after_wait.ok {
                            failure = after_wait.failure;
                            keep_polling = false;
                        }
                    }
                }
            }
        }
        first_poll = false;
        if keep_polling {
            let before: DeviceClockCheck = clock_check_value(oauth::now_ms_result(&request.policy_handle), deadline_ms, current_ms);
            current_ms = before.now_ms;
            if !before.ok {
                failure = before.failure;
                keep_polling = false;
            }
        }
        if keep_polling {
            let payload: TransportPayloadIntent = {encoding: "json_object", secret_fields: "device", device_field: "device_auth_id", code_field: null};
            let capture: TransportCaptureIntent = {code_field: "authorization_code", redirect_uri: endpoints.redirect_uri};
            let polled: TransportCaptureResultEnvelope = oauth::transport_capture_result(&request, &usage, payload, capture);
            let polled_value: TransportCaptureEnvelope? = polled.value;
            let envelope: TransportCaptureEnvelope = polled_value.unwrap_or(empty_transport_capture());
            let parts: DeviceCaptureParts = device_capture_parts(envelope);
            let envelope_ok: bool = parts.ok;
            let response: TransportResponseEnvelope = parts.response;
            let response_parts: PollResponseParts = poll_response_parts(response);
            let code_holder: CodeHandlePresence = parts.code;
            let verifier_holder: VerifierHandlePresence = parts.verifier;
            let has_code: bool = code_holder.has("handle");
            let has_verifier: bool = verifier_holder.has("handle");
            let captured_code: resource<oauth.authorization_code>? = code_holder?.handle;
            let captured_verifier: resource<oauth.verifier>? = verifier_holder?.handle;
            let response_status: int = response_parts.status;
            let retry_after_present: bool = response_parts.has_retry_after;
            let retry_after_value: int = response_parts.retry_after_ms;
            let response_access_holder: SecretSlotPresence = response_parts.access;
            let response_refresh_holder: SecretSlotPresence = response_parts.refresh;
            let response_device_holder: DeviceHandlePresence = response_parts.device;
            let has_response_access: bool = response_access_holder.has("handle");
            let has_response_refresh: bool = response_refresh_holder.has("handle");
            let has_response_device: bool = response_device_holder.has("handle");
            let after: DeviceClockCheck = clock_check_value(oauth::now_ms_result(&request.policy_handle), deadline_ms, current_ms);
            current_ms = after.now_ms.copy();
            if !after.ok {
                failure = after.failure;
                keep_polling = false;
            } else if !polled.ok {
                failure = static_failure(polled.error, "poll_transport_failed", "Codex device authorization could not be checked.");
                keep_polling = false;
            } else if !envelope_ok {
                failure = failed("invalid_poll_response", "The device authorization response is invalid.");
                keep_polling = false;
            } else {
                if response_status.copy() == 403 || response_status.copy() == 404 {
                    retry_delay_ms = base_interval_ms;
                    next_poll_delay_ms = base_interval_ms;
                    keep_polling = true;
                } else if response_status.copy() == 429 {
                    if retry_delay_ms < max_interval_ms() / 2 {
                        retry_delay_ms = retry_delay_ms * 2;
                    } else {
                        retry_delay_ms = max_interval_ms();
                    }
                    let mut requested: int = retry_delay_ms;
                    if requested < base_interval_ms { requested = base_interval_ms; }
                    if retry_after_present {
                        let mut retry_after: int = retry_after_value;
                        if retry_after > max_interval_ms() { retry_after = max_interval_ms(); }
                        if retry_after < 0 { retry_after = 0; }
                        if retry_after > requested { requested = retry_after; }
                    }
                    next_poll_delay_ms = requested;
                    keep_polling = true;
                } else if response_status.copy() >= 200 && response_status.copy() < 300 {
                    if !has_code || !has_verifier || captured_code == null || captured_verifier == null ||
                       has_response_access || has_response_refresh || has_response_device {
                        failure = failed("invalid_poll_response", "The device authorization response is invalid.");
                        keep_polling = false;
                    } else {
                        code_handle = captured_code;
                        verifier_handle = captured_verifier;
                        complete = true;
                        keep_polling = false;
                    }
                } else {
                    failure = failed("poll_rejected", "Codex device authorization was rejected.");
                    keep_polling = false;
                }
            }
        }
    }
    if complete => {
        {policy_handle: request.policy_handle, last_ms: current_ms, ok: true, failure: failed("", ""), code_handle: code_handle, verifier_handle: verifier_handle}
    } else => {
        {policy_handle: request.policy_handle, last_ms: current_ms, ok: false, failure: failure, code_handle: null, verifier_handle: null}
    }
}

fn safe_form_client_id(value: string) -> bool {
    let mut valid: bool = value.length > 0 && value.length <= 256;
    let mut index: int = 0;
    while valid && index < value.length {
        let character: string = char_at(value, index);
        if !is_ascii_alnum(character) && character != "-" && character != "." && character != "_" && character != "~" {
            valid = false;
        }
        index = index + 1;
    }
    valid
}

fn exchange_and_save(details: DeviceLoginDetails, endpoints: DeviceEndpointChoice, policy: resource<auth.policy>, last_ms: int, code_handle: resource<oauth.authorization_code>?, verifier_handle: resource<oauth.verifier>?, deadline_ms: int) -> DeviceLoginOutcome {
    let before: DeviceClockCheck = clock_check_value(oauth::now_ms_result(&policy), deadline_ms, last_ms);
    if !before.ok => {
        {policy_handle: policy, result: before.failure}
    } else if !safe_form_client_id(endpoints.client_id) => {
        {policy_handle: policy, result: failed("invalid_provider_config", "The selected provider client identifier is unsupported.")}
    } else => {
        let form: DeviceTokenForm = {grant_type: "authorization_code", client_id: endpoints.client_id};
        let public_body: string = "grant_type=" + form.grant_type + "&client_id=" + form.client_id;
        let transport_request: TransportPublicRequest = {
            policy_handle: policy,
            credential_id: details.credential_id,
            method: "POST",
            path: endpoints.token_path,
            public_headers: [{name: "content-type", value: "application/x-www-form-urlencoded"}],
            public_body: public_body
        };
        let usage: TransportCredentialUse = {kind: "code_verifier", access_handle: null, refresh_handle: null, code_handle: code_handle, verifier_handle: verifier_handle, device_handle: null};
        let payload: TransportPayloadIntent = {encoding: "form", secret_fields: "authorization_code", device_field: null, code_field: "code"};
        let exchanged: TransportResultEnvelope = oauth::transport_payload_result(&transport_request, &usage, payload);
        let exchanged_value: TransportResponseEnvelope? = exchanged.value;
        let response: TransportResponseEnvelope = exchanged_value.unwrap_or(empty_transport_response());
        let parts: ExchangeResponseParts = exchange_response_parts(response);
        let response_status: int = parts.status;
        let response_ok: bool = parts.ok;
        let token_response_body: string = parts.body;
        let access_holder: SecretSlotPresence = parts.access;
        let refresh_holder: SecretSlotPresence = parts.refresh;
        let has_access: bool = access_holder.has("handle");
        let has_refresh: bool = refresh_holder.has("handle");
        let response_access_slot: resource<auth.secret_slot>? = access_holder?.handle;
        let response_refresh_slot: resource<auth.secret_slot>? = refresh_holder?.handle;
        let after: DeviceClockCheck = clock_check_value(oauth::now_ms_result(&transport_request.policy_handle), deadline_ms, before.now_ms);
        let mut result_policy: resource<auth.policy> = transport_request.policy_handle;
        let mut exchange_result: CodexDeviceLoginResult = failed("exchange_transport_failed", "Codex device token exchange failed.");
        if !after.ok {
            exchange_result = after.failure;
        } else if !exchanged.ok {
            exchange_result = static_failure(exchanged.error, "exchange_transport_failed", "Codex device token exchange failed.");
        } else if !response_ok {
            exchange_result = failed("exchange_transport_failed", "Codex device token exchange failed.");
        } else if response_status.copy() < 200 || response_status.copy() >= 300 {
            exchange_result = failed("exchange_rejected", "Codex device token exchange was rejected.");
        } else if !has_access {
            exchange_result = failed("invalid_token_response", "The token response is invalid.");
        } else {
            let access_slot: resource<auth.secret_slot>? = response_access_slot;
            let refresh_slot: resource<auth.secret_slot>? = response_refresh_slot;
            let expiry_field: PublicJsonFieldResultEnvelope = oauth::public_json_field_result(&result_policy, token_response_body.copy(), "/expires_in");
            let token_type_field: PublicJsonFieldResultEnvelope = oauth::public_json_field_result(&result_policy, token_response_body.copy(), "/token_type");
            let mut expires_in: int = 0;
            let mut token_type: string = "Bearer";
            let mut valid: bool = expiry_field.ok && expiry_field.value.copy() != null && token_type_field.ok && token_type_field.value.copy() != null;
            if valid {
                let expiry: PublicJsonFieldEnvelope = expiry_field.value;
                if expiry.kind == "int" && expiry.int_value.copy() != null {
                    expires_in = expiry.int_value;
                    if expires_in <= 0 || expires_in > max_int() / 1000 {
                        valid = false;
                    }
                } else {
                    valid = false;
                }
                let token_type_value: PublicJsonFieldEnvelope = token_type_field.value;
                if token_type_value.kind.copy() == "missing" {
                    token_type = "Bearer";
                } else if token_type_value.kind == "string" && token_type_value.string_value.copy() != null {
                    token_type = token_type_value.string_value;
                    if token_type != "Bearer" || token_type.length > 64 {
                        valid = false;
                    }
                } else {
                    valid = false;
                }
            }
            let mut outcome: CodexDeviceLoginResult = failed("invalid_token_response", "The token response is invalid.");
            if valid {
                let lifetime_ms: int = expires_in * 1000;
                if after.now_ms.copy() > max_int() - lifetime_ms {
                    valid = false;
                } else {
                    let expires_at_ms: int = after.now_ms.copy() + lifetime_ms;
                    let mut refresh_action: string = "clear";
                    if has_refresh.copy() { refresh_action = "replace"; }
                    let metadata: CredentialMetadata = {
                        provider: details.provider.name,
                        kind: "oauth",
                        source: "codex-device",
                        token_type: token_type,
                        expires_at_ms: expires_at_ms,
                        scopes: [],
                        account_id: null,
                        generation: details.expected_generation,
                        status: "active",
                        last_refresh_at_ms: null,
                        has_refresh_token: has_refresh
                    };
                    let save_request: SaveCredentialRequest = {
                        credential_id: details.credential_id,
                        expected_generation: details.expected_generation,
                        policy_handle: result_policy,
                        metadata: metadata,
                        access_slot: access_slot,
                        refresh_action: refresh_action,
                        refresh_slot: refresh_slot
                    };
                    let save_check: DeviceClockCheck = clock_check_value(oauth::now_ms_result(&save_request.policy_handle), deadline_ms, after.now_ms.copy());
                    if !save_check.ok {
                        outcome = save_check.failure;
                    } else {
                        let saved: AuthSaveResultEnvelope = auth::save_if_generation_result(&save_request);
                        let saved_metadata: AuthMetadataEnvelope? = saved.value;
                        let has_saved_metadata: bool = saved_metadata != null;
                        let saved_value: AuthMetadataEnvelope = saved_metadata.unwrap_or(empty_auth_metadata());
                        if !saved.ok {
                            outcome = static_failure(saved.error, "save_failed", "The credential could not be saved.");
                        } else if !has_saved_metadata {
                            outcome = failed("save_failed", "The credential could not be saved.");
                        } else if !saved_value.ok.copy() {
                            outcome = failed("save_failed", "The credential could not be saved.");
                        } else {
                            outcome = succeeded(saved_value);
                        }
                    }
                    result_policy = save_request.policy_handle;
                }
            }
            exchange_result = outcome;
        }
        {policy_handle: result_policy, result: exchange_result}
    }
}

fn login_inner(request: CodexDeviceLoginRequest, on_instruction: fn(CodexDeviceInstruction) -> null) -> DeviceLoginOutcome {
    let details: DeviceLoginDetails = {
        provider: request.provider,
        credential_id: request.credential_id,
        expected_generation: request.expected_generation
    };
    let endpoint_details: DeviceLoginDetails = details.copy();
    let start_details: DeviceLoginDetails = details.copy();
    let poll_details: DeviceLoginDetails = details.copy();
    let exchange_details: DeviceLoginDetails = details.copy();
    let policy: resource<auth.policy> = request.policy_handle;
    let endpoints: DeviceEndpointChoice = endpoint_choice(endpoint_details.provider, endpoint_details.credential_id, endpoint_details.expected_generation);
    let start_endpoints: DeviceEndpointChoice = endpoints.copy();
    let poll_endpoints: DeviceEndpointChoice = endpoints.copy();
    let exchange_endpoints: DeviceEndpointChoice = endpoints.copy();
    if !endpoints.ok => {
        {policy_handle: policy, result: failed(endpoints.error_code, endpoints.error_message)}
    } else => {
        let initial: OAuthNowResultEnvelope = oauth::now_ms_result(&policy);
        if !initial.ok => {
            {policy_handle: policy, result: static_failure(initial.error, "clock_unavailable", "The login clock is unavailable.")}
        } else if initial.value.copy() == null => {
            {policy_handle: policy, result: failed("clock_unavailable", "The login clock is unavailable.")}
        } else => {
            let now_ms: int = initial.value.copy();
            if now_ms < 0 || now_ms > max_int() - flow_deadline_ms() => {
                {policy_handle: policy, result: failed("clock_unavailable", "The login clock is unavailable.")}
            } else => {
                let deadline_ms: int = now_ms + flow_deadline_ms();
                let started: DeviceStartState = device_start(policy, start_details.credential_id, start_endpoints);
                let start_response: DeviceStart = started.start;
                let start_ok: bool = start_response.ok;
                let start_failure: CodexDeviceLoginResult = start_response.failure;
                let instruction: CodexDeviceInstruction = start_response.instruction;
                let poll_user_code: string = start_response.user_code;
                let poll_interval_ms: int = start_response.interval_ms;
                let after_start: DeviceClockCheck = clock_check_value(oauth::now_ms_result(&started.policy_handle), deadline_ms, now_ms);
                if !after_start.ok => {
                    {policy_handle: started.policy_handle, result: after_start.failure}
                } else if !start_ok => {
                    {policy_handle: started.policy_handle, result: start_failure}
                } else => {
                    let remaining_seconds: int = (deadline_ms - after_start.now_ms.copy()) / 1000;
                    if remaining_seconds <= 0 => {
                        {policy_handle: started.policy_handle, result: failed("timeout", "Codex device login timed out.")}
                    } else => {
                        let mut bounded_expiry: int = instruction.expires_in_seconds;
                        if bounded_expiry > remaining_seconds { bounded_expiry = remaining_seconds; }
                        let bounded_instruction: CodexDeviceInstruction = {
                            verification_url: instruction.verification_url,
                            user_code: instruction.user_code,
                            expires_in_seconds: bounded_expiry
                        };
                        on_instruction(bounded_instruction);
                        let poll_state: DevicePollState = {
                            policy_handle: started.policy_handle,
                            device_handle: started.device_handle,
                            user_code: poll_user_code,
                            interval_ms: poll_interval_ms
                        };
                        let polled: DevicePoll = poll_until_complete(poll_state, poll_details.credential_id, poll_endpoints, deadline_ms, after_start.now_ms);
                        if !polled.ok => {
                            {policy_handle: polled.policy_handle, result: polled.failure}
                        } else => {
                            exchange_and_save(exchange_details, exchange_endpoints, polled.policy_handle, polled.last_ms, polled.code_handle, polled.verifier_handle, deadline_ms)
                        }
                    }
                }
            }
        }
    }
}

pub fn login(request: CodexDeviceLoginRequest, on_instruction: fn(CodexDeviceInstruction) -> null) -> CodexDeviceLoginResult {
    let outcome: DeviceLoginOutcome = login_inner(request, on_instruction);
    auth::cleanup_transients(&outcome.policy_handle);
    outcome.result
}
