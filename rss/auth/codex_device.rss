fn static_failure(error_code: AuthBridgeFailure?, stage_code: string, stage_message: string) -> CodexDeviceLoginResult {
    let mut code: string = stage_code;
    let mut message: string = stage_message;
    if error_code != null {
        let detail: AuthBridgeFailure = error_code;
        if detail.code.copy() == "policy_inactive" {
            code = "cancelled_or_inactive";
            message = "The login was cancelled or is no longer active.";
        }
        if detail.code.copy() == "wait_deadline_exceeded" {
            code = "deadline_or_inactive";
            message = "The login wait ended at an inactive deadline.";
        }
        if detail.code.copy() == "clock_unavailable" {
            code = "clock_unavailable";
            message = "The login clock is unavailable.";
        }
    }
    failed(code, message)
}

fn char_at(value: string, index: int) -> string {
    value[index:(index + 1)]
}

fn digit_value(value: string) -> int {
    if value == "0" => { 0 }
    else if value == "1" => { 1 }
    else if value == "2" => { 2 }
    else if value == "3" => { 3 }
    else if value == "4" => { 4 }
    else if value == "5" => { 5 }
    else if value == "6" => { 6 }
    else if value == "7" => { 7 }
    else if value == "8" => { 8 }
    else if value == "9" => { 9 }
    else => { -1 }
}

fn is_ascii_alnum(value: string) -> bool {
    value.length == 1 && find_text("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", value) >= 0
}

fn find_text(value: string, needle: string) -> int {
    let mut found: int = -1;
    let mut index: int = 0;
    while found < 0 && index + needle.length <= value.length {
        if value[index:(index + needle.length)] == needle {
            found = index;
        }
        index = index + 1;
    }
    found
}

fn safe_authority(value: string) -> bool {
    let mut valid: bool = value.length > 0 && value.length <= 253;
    let colon: int = find_text(value, ":");
    let mut host_end: int = value.length;
    let mut port_start: int = value.length;
    if colon >= 0 {
        host_end = colon;
        port_start = colon + 1;
        if find_text(value[port_start:value.length], ":") >= 0 {
            valid = false;
        }
        if port_start >= value.length || value.length - port_start > 5 {
            valid = false;
        }
        let mut port_value: int = 0;
        let mut port_index: int = port_start;
        while valid && port_index < value.length {
            let digit: string = char_at(value, port_index);
            if digit_value(digit) < 0 {
                valid = false;
            } else {
                port_value = port_value * 10 + digit_value(digit);
            }
            port_index = port_index + 1;
        }
        if port_value < 1 || port_value > 65535 {
            valid = false;
        }
    }
    if host_end == 0 {
        valid = false;
    }
    if valid {
        let host: string = value[0:host_end];
        if char_at(host, 0) == "." || char_at(host, host.length - 1) == "." ||
           char_at(host, 0) == "-" || char_at(host, host.length - 1) == "-" {
            valid = false;
        }
        let mut index: int = 0;
        while valid && index < host.length {
            let character: string = char_at(host, index);
            if !is_ascii_alnum(character) && character != "." && character != "-" {
                valid = false;
            }
            if character == "." && index > 0 && char_at(host, index - 1) == "." {
                valid = false;
            }
            index = index + 1;
        }
    }
    valid
}

fn safe_endpoint_path(value: string) -> bool {
    let mut valid: bool = value.length > 0 && value.length <= 2048 && char_at(value, 0) == "/";
    if value.length > 1 && char_at(value, 1) == "/" {
        valid = false;
    }
    let mut index: int = 0;
    while valid && index < value.length {
        let character: string = char_at(value, index);
        if !is_ascii_alnum(character) && character != "/" && character != "." &&
           character != "-" && character != "_" && character != "~" {
            valid = false;
        }
        if character == "." && index + 1 < value.length && char_at(value, index + 1) == "." {
            valid = false;
        }
        index = index + 1;
    }
    valid
}

fn parse_https_url(value: string) -> DeviceUrlParts {
    let separator: int = find_text(value, "://");
    let mut parts: DeviceUrlParts = {ok: false, authority: "", path: ""};
    if separator == 5 && value[0:5] == "https" {
        let authority_start: int = separator + 3;
        let mut authority_end: int = authority_start;
        while authority_end < value.length && char_at(value, authority_end) != "/" {
            authority_end = authority_end + 1;
        }
        let authority: string = value[authority_start:authority_end];
        let mut path: string = "/";
        if authority_end < value.length {
            path = value[authority_end:value.length];
        }
        if safe_authority(authority) && safe_endpoint_path(path) {
            parts = {ok: true, authority: authority, path: path};
        }
    }
    parts
}

fn safe_relative_path(value: string) -> bool {
    safe_endpoint_path(value)
}

fn trim_trailing_slashes(value: string) -> string {
    let mut end: int = value.length;
    while end > 0 && char_at(value, end - 1) == "/" {
        end = end - 1;
    }
    value[0:end]
}

fn configured(value: string?, fallback: string) -> string {
    let mut selected: string = fallback;
    if value != null {
        let actual: string = value;
        if actual != "" {
            selected = actual;
        }
    }
    selected
}

fn invalid_endpoints(message: string) -> DeviceEndpointChoice {
    {
        ok: false,
        issuer: "",
        client_id: "",
        start_path: "",
        poll_path: "",
        authorization_path: "",
        token_path: "",
        redirect_uri: "",
        error_code: "invalid_provider_config",
        error_message: message
    }
}

fn endpoint_choice(provider: ProviderEntry, credential_id: string, expected_generation: int) -> DeviceEndpointChoice {
    if expected_generation < 0 || credential_id == "" => {
        invalid_endpoints("The selected credential request is invalid.")
    } else if provider.auth == null => {
        invalid_endpoints("The selected provider does not match the credential.")
    } else if provider.oauth == null => {
        invalid_endpoints("The selected provider has no device-login configuration.")
    } else => {
        let selected_id: string = provider.auth;
        let config: OAuthConfig = provider.oauth;
        if selected_id != credential_id => {
            invalid_endpoints("The selected provider does not match the credential.")
        } else if config.flow != "codex-device" => {
            invalid_endpoints("The selected provider does not support Codex device login.")
        } else => {
            let issuer: string = configured(config.issuer, default_issuer());
            let issuer_parts: DeviceUrlParts = parse_https_url(issuer);
            let client_id: string = configured(config.client_id, default_client_id());
            let start_path: string = configured(config.device_user_code_path, default_start_path());
            let poll_path: string = configured(config.device_poll_path, default_poll_path());
            let authorization_path: string = configured(config.authorization_path, default_authorization_path());
            let token_value: string = configured(config.token_endpoint, "");
            let mut token_path: string = default_token_path();
            let mut token_valid: bool = true;
            if token_value != "" {
                let token_parts: DeviceUrlParts = parse_https_url(token_value);
                if !token_parts.ok || token_parts.authority != issuer_parts.authority {
                    token_valid = false;
                } else {
                    token_path = token_parts.path;
                }
            }
            let mut redirect_uri: string = configured(config.redirect_uri, "");
            if redirect_uri == "" {
                redirect_uri = trim_trailing_slashes(issuer) + default_redirect_suffix();
            }
            let mut config_valid: bool = issuer_parts.ok && token_valid &&
                safe_relative_path(start_path) && safe_relative_path(poll_path) &&
                safe_relative_path(authorization_path) && safe_relative_path(token_path) &&
                client_id.length > 0 && client_id.length <= 256 &&
                redirect_uri.length > 0 && redirect_uri.length <= 2048;
            if config_valid {
                let mut index: int = 0;
                while config_valid && index < redirect_uri.length {
                    let ch: string = char_at(redirect_uri, index);
                    if ch == "\n" || ch == "\r" || ch == "\t" || ch == "\0" {
                        config_valid = false;
                    }
                    index = index + 1;
                }
            }
            if !config_valid => {
                invalid_endpoints("The selected provider endpoints are not supported.")
            } else => {
                {
                    ok: true,
                    issuer: issuer,
                    client_id: client_id,
                    start_path: start_path,
                    poll_path: poll_path,
                    authorization_path: authorization_path,
                    token_path: token_path,
                    redirect_uri: redirect_uri,
                    error_code: "",
                    error_message: ""
                }
            }
        }
    }
}

fn clock_check_value(read: OAuthNowResultEnvelope, deadline_ms: int, previous_ms: int) -> DeviceClockCheck {
    if !read.ok => {
        {
            ok: false,
            timed_out: false,
            now_ms: previous_ms,
            failure: static_failure(read.error, "clock_unavailable", "The login clock is unavailable.")
        }
    } else if read.value.copy() == null => {
        {
            ok: false,
            timed_out: false,
            now_ms: previous_ms,
            failure: failed("clock_unavailable", "The login clock is unavailable.")
        }
    } else => {
        let current_ms: int = read.value.copy();
        if current_ms < 0 || current_ms < previous_ms => {
            {
                ok: false,
                timed_out: false,
                now_ms: current_ms,
                failure: failed("clock_unavailable", "The login clock is unavailable.")
            }
        } else if current_ms >= deadline_ms => {
            {
                ok: false,
                timed_out: true,
                now_ms: current_ms,
                failure: failed("timeout", "Codex device login timed out.")
            }
        } else => {
            {ok: true, timed_out: false, now_ms: current_ms, failure: failed("", "")}
        }
    }
}

fn clock_check(policy: resource<auth.policy>, deadline_ms: int, previous_ms: int) -> DeviceClockCheck {
    clock_check_value(oauth::now_ms_result(&policy), deadline_ms, previous_ms)
}

fn read_public_field(policy: resource<auth.policy>, body: string, pointer: string) -> PublicJsonFieldResultEnvelope {
    oauth::public_json_field_result(&policy, body, pointer)
}

fn interval_from_field(field: PublicJsonFieldResultEnvelope) -> DeviceInterval {
    if !field.ok || field.value.copy() == null => {
        {ok: false, milliseconds: 0}
    } else => {
        let parsed: PublicJsonFieldEnvelope = field.value.copy();
        if parsed.kind.copy() == "missing" => {
            {ok: true, milliseconds: default_interval_ms()}
        } else if parsed.kind.copy() == "int" && parsed.int_value.copy() != null => {
            let seconds: int = parsed.int_value.copy();
            if seconds < 0 => {
                {ok: false, milliseconds: 0}
            } else if seconds == 0 => {
                {ok: true, milliseconds: min_interval_ms()}
            } else if seconds >= 60 => {
                {ok: true, milliseconds: max_interval_ms()}
            } else => {
                {ok: true, milliseconds: seconds * 1000}
            }
        } else if parsed.kind.copy() == "string" && parsed.string_value.copy() != null => {
            let text: string = parsed.string_value.copy();
            parse_interval_string(text)
        } else => {
            {ok: false, milliseconds: 0}
        }
    }
}

fn parse_interval_string(value: string) -> DeviceInterval {
    let mut start: int = 0;
    let mut end: int = value.length;
    while start < end && (char_at(value, start) == " " || char_at(value, start) == "\t" || char_at(value, start) == "\r" || char_at(value, start) == "\n") {
        start = start + 1;
    }
    while end > start && (char_at(value, end - 1) == " " || char_at(value, end - 1) == "\t" || char_at(value, end - 1) == "\r" || char_at(value, end - 1) == "\n") {
        end = end - 1;
    }
    let mut valid: bool = end > start && end - start <= 32;
    let text: string = value[start:end];
    if valid && text.length > 1 && char_at(text, 0) == "0" {
        valid = false;
    }
    let mut seconds: int = 0;
    let mut index: int = 0;
    while valid && index < text.length {
        let digit: string = char_at(text, index);
        if digit_value(digit) < 0 {
            valid = false;
        } else if seconds <= 60 {
            let next: int = seconds * 10 + digit_value(digit);
            if next > 60 {
                seconds = 61;
            } else {
                seconds = next;
            }
        }
        index = index + 1;
    }
    if !valid => {
        {ok: false, milliseconds: 0}
    } else if seconds == 0 => {
        {ok: true, milliseconds: min_interval_ms()}
    } else if seconds >= 60 => {
        {ok: true, milliseconds: max_interval_ms()}
    } else => {
        {ok: true, milliseconds: seconds * 1000}
    }
}

fn valid_user_code(value: string) -> bool {
    let mut valid: bool = value.length > 0 && value.length <= 64;
    let mut index: int = 0;
    while valid && index < value.length {
        let character: string = char_at(value, index);
        if !is_ascii_alnum(character) && character != "-" {
            valid = false;
        }
        index = index + 1;
    }
    valid
}

fn user_code_from_body(primary: PublicJsonFieldResultEnvelope, legacy: PublicJsonFieldResultEnvelope) -> DeviceStart {
    let mut selected: string = "";
    let mut valid: bool = false;
    if primary.ok && primary.value.copy() != null && legacy.ok && legacy.value.copy() != null {
        let primary_value: PublicJsonFieldEnvelope = primary.value.copy();
        let legacy_value: PublicJsonFieldEnvelope = legacy.value.copy();
        if primary_value.kind.copy() == "string" && primary_value.string_value.copy() != null {
            selected = primary_value.string_value.copy();
            valid = true;
            if legacy_value.kind.copy() != "missing" {
                if legacy_value.kind.copy() != "string" || legacy_value.string_value.copy() == null {
                    valid = false;
                } else if legacy_value.string_value.copy() != selected.copy() {
                    valid = false;
                }
            }
        } else if primary_value.kind.copy() == "missing" && legacy_value.kind.copy() == "string" && legacy_value.string_value.copy() != null {
            selected = legacy_value.string_value.copy();
            valid = true;
        }
    }
    if valid && valid_user_code(selected.copy()) => {
        {ok: true, failure: failed("", ""), user_code: selected, interval_ms: 0, expires_in_seconds: 0, verification_url: "", instruction: empty_instruction()}
    } else => {
        {ok: false, failure: failed("invalid_start_response", "The device authorization response is invalid."), user_code: "", interval_ms: 0, expires_in_seconds: 0, verification_url: "", instruction: empty_instruction()}
    }
}

fn interval_from_body(field: PublicJsonFieldResultEnvelope) -> DeviceInterval {
    interval_from_field(field)
}

fn start_expiry(field: PublicJsonFieldResultEnvelope) -> int {
    if !field.ok || field.value.copy() == null => {
        0
    } else => {
        let parsed: PublicJsonFieldEnvelope = field.value.copy();
        if parsed.kind.copy() == "missing" => {
            900
        } else if parsed.kind.copy() == "int" && parsed.int_value.copy() != null => {
            let seconds: int = parsed.int_value.copy();
            if seconds > 0 => {
                if seconds > 900 => { 900 } else => { seconds }
            } else => { 0 }
        } else => { 0 }
    }
}

struct DeviceHandlePresence {
    handle: resource<oauth.device_session>?
}

struct DeviceStartResponseParts {
    status: int,
    ok: bool,
    body: string,
    device: DeviceHandlePresence
}

fn device_start_response_parts(response: TransportResponseEnvelope) -> DeviceStartResponseParts {
    let has_device: bool = response.has("device_handle");
    let device: DeviceHandlePresence = if has_device => {
        {handle: response.device_handle}
    } else => {
        {handle: null}
    };
    let response_status: int = response.status;
    let response_ok: bool = response.ok;
    let response_body: string = response.body_without_secret_fields;
    {status: response_status, ok: response_ok, body: response_body, device: device}
}

fn device_start(policy: resource<auth.policy>, credential_id: string, endpoints: DeviceEndpointChoice) -> DeviceStartState {
    let start_body: DeviceStartJson = {client_id: endpoints.client_id};
    let public_body: string = json::encode(start_body);
    let request: TransportPublicRequest = {
        policy_handle: policy,
        credential_id: credential_id,
        method: "POST",
        path: endpoints.start_path,
        public_headers: [{name: "content-type", value: "application/json"}],
        public_body: public_body
    };
    let usage: TransportCredentialUse = {kind: "none", access_handle: null, refresh_handle: null, code_handle: null, verifier_handle: null, device_handle: null};
    let response: TransportResultEnvelope = oauth::transport_result(&request, &usage);
    let response_value: TransportResponseEnvelope? = response.value;
    let value: TransportResponseEnvelope = response_value.unwrap_or(empty_transport_response());
    let parts: DeviceStartResponseParts = device_start_response_parts(value);
    let response_status: int = parts.status;
    let value_ok: bool = parts.ok;
    let start_response_body: string = parts.body;
    let device_holder: DeviceHandlePresence = parts.device;
    let has_device_handle: bool = device_holder.has("handle");
    let start: DeviceStart = if !response.ok => {
        {ok: false, failure: static_failure(response.error, "start_transport_failed", "Device authorization could not be started."), user_code: "", interval_ms: 0, expires_in_seconds: 0, verification_url: "", instruction: empty_instruction()}
    } else => {
        if !value_ok => {
            {ok: false, failure: failed("start_transport_failed", "Device authorization could not be started."), user_code: "", interval_ms: 0, expires_in_seconds: 0, verification_url: "", instruction: empty_instruction()}
        } else if response_status.copy() == 404 => {
            {ok: false, failure: failed("device_login_unavailable", "Codex device login is unavailable for this provider."), user_code: "", interval_ms: 0, expires_in_seconds: 0, verification_url: "", instruction: empty_instruction()}
        } else if response_status.copy() < 200 || response_status.copy() >= 300 => {
            {ok: false, failure: failed("start_rejected", "Device authorization was rejected."), user_code: "", interval_ms: 0, expires_in_seconds: 0, verification_url: "", instruction: empty_instruction()}
        } else if !has_device_handle => {
            {ok: false, failure: failed("invalid_start_response", "The device authorization response is invalid."), user_code: "", interval_ms: 0, expires_in_seconds: 0, verification_url: "", instruction: empty_instruction()}
        } else => {
            let parsed_user: DeviceStart = user_code_from_body(
                oauth::public_json_field_result(&request.policy_handle, start_response_body.copy(), "/user_code"),
                oauth::public_json_field_result(&request.policy_handle, start_response_body.copy(), "/usercode")
            );
            let parsed_interval: DeviceInterval = interval_from_body(oauth::public_json_field_result(&request.policy_handle, start_response_body.copy(), "/interval"));
            let expires: int = start_expiry(oauth::public_json_field_result(&request.policy_handle, start_response_body.copy(), "/expires_in"));
            if !parsed_user.ok || !parsed_interval.ok || expires <= 0 => {
                {ok: false, failure: failed("invalid_start_response", "The device authorization response is invalid."), user_code: "", interval_ms: 0, expires_in_seconds: 0, verification_url: "", instruction: empty_instruction()}
            } else => {
                let verification_url: string = trim_trailing_slashes(endpoints.issuer) + endpoints.authorization_path;
                let user_code: string = parsed_user.user_code.copy();
                let instruction: CodexDeviceInstruction = {verification_url: verification_url.copy(), user_code: user_code.copy(), expires_in_seconds: expires};
                {ok: true, failure: failed("", ""), user_code: user_code, interval_ms: parsed_interval.milliseconds, expires_in_seconds: expires, verification_url: verification_url, instruction: instruction}
            }
        }
    };
    let response_device_handle: resource<oauth.device_session>? = device_holder?.handle;
    {policy_handle: request.policy_handle, device_handle: response_device_handle, start: start}
}

