// Generic OAuth code-exchange bridge. Callers choose all public inputs and save metadata.
use config;
use auth;
use oauth;

pub fn snapshot(home: resource<auth.host_home>) -> ConfigSnapshotEnvelope {
    config::load_snapshot(&home)
}

pub fn begin(policy: resource<auth.policy>, intent: BoundedPublicOAuthIntent) -> PkceBeginEnvelope {
    oauth::pkce_begin(&policy, intent)
}

pub fn wait(callback: resource<oauth.callback>) -> CallbackEnvelope {
    oauth::callback_wait(&callback)
}

pub fn exchange(
    request: TransportPublicRequest,
    code: resource<oauth.authorization_code>,
    verifier: resource<oauth.verifier>
) -> TransportResponseEnvelope {
    let usage = {kind: "code_verifier", code_handle: code, verifier_handle: verifier};
    oauth::transport(&request, &usage)
}

pub fn save(request: SaveCredentialRequest) -> AuthMetadataEnvelope {
    auth::save_if_generation(&request)
}

pub fn close_callback(callback: resource<oauth.callback>) -> null {
    oauth::close_callback(callback)
}

pub fn close_verifier(verifier: resource<oauth.verifier>) -> null {
    oauth::close_verifier(verifier)
}

pub fn close_code(code: resource<oauth.authorization_code>) -> null {
    oauth::close_code(code)
}

pub fn close_slot(slot: resource<auth.secret_slot>) -> null {
    auth::close_slot(slot)
}
