use auth;
use config;
use json;
use oauth;
use self::codex_device;
use self::pkce_login::{run as pkce_run};
use self::types;

struct AuthCommandInput {
    operation: string,
    provider: Option<string>,
    credential_id: Option<string>
}

struct AuthEntryResult {
    ok: bool,
    operation: string,
    credential_id: Option<string>,
    generation: int,
    status: string,
    error: Option<string>
}

struct CodexDeviceLoginRequest {
    policy_handle: resource<auth.policy>,
    provider: ProviderEntry,
    credential_id: string,
    expected_generation: int
}

struct CodexDeviceInstruction {
    verification_url: string,
    user_code: string,
    expires_in_seconds: int
}

struct CodexDeviceLoginResult {
    ok: bool,
    code: string,
    message: string,
    metadata: Option<AuthMetadataEnvelope>
}

struct ProviderSelection {
    found: bool,
    provider: ProviderEntry
}

struct MetadataSelection {
    ok: bool,
    expected_generation: int,
    has_refresh_token: bool,
    error: string
}

struct LoginReportRow {
    provider: string,
    credential_id: string,
    status: string,
    generation: int,
    source: string
}

fn entry(
    ok: bool,
    operation: string,
    credential_id: Option<string>,
    generation: int,
    status: string,
    error: Option<string>
) -> AuthEntryResult {
    {ok: ok, operation: operation, credential_id: credential_id, generation: generation, status: status, error: error}
}

fn failed(operation: string, code: string, credential_id: Option<string>, generation: int) -> AuthEntryResult {
    entry(false, operation, credential_id, generation, code.copy(), Some(code.copy()))
}

fn failure_present(value: Option<AuthBridgeFailure>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn text_present(value: Option<string>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn envelope_present(value: Option<AuthMetadataEnvelope>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn oauth_present(value: Option<OAuthConfig>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn no_text() -> Option<string> {
    None
}

fn no_oauth() -> Option<OAuthConfig> {
    None
}

fn no_scopes() -> Option<array<string>> {
    None
}

fn no_query_entries() -> Option<array<PublicQueryEntry>> {
    None
}

fn host_failure_bridge() -> AuthBridgeFailure {
    {code: "host_failure", cancelled: false, deadline_exceeded: false, revoked: false}
}

fn empty_provider() -> ProviderEntry {
    {name: "", protocol: "", base_url: "", auth: no_text(), oauth: no_oauth()}
}

fn empty_oauth_config() -> OAuthConfig {
    {
        flow: no_text(),
        issuer: no_text(),
        client_id: no_text(),
        device_user_code_path: no_text(),
        device_poll_path: no_text(),
        authorization_path: no_text(),
        token_endpoint: no_text(),
        redirect_uri: no_text(),
        refresh_skew_seconds: 0,
        scopes: no_scopes(),
        authorization_parameters: no_query_entries()
    }
}

fn provider_selection(public_config: BoundedPublicConfig, requested: string) -> ProviderSelection {
    let providers = public_config.providers.copy();
    let mut found: bool = false;
    let mut provider: ProviderEntry = empty_provider();
    let mut index: int = 0;
    while index < providers.length && !found {
        let candidate: ProviderEntry = providers[index].copy();
        if candidate.name.copy() == requested.copy() {
            found = true;
            provider = candidate;
        }
        index += 1;
    }
    {found: found, provider: provider}
}

fn metadata_selection(
    loaded: AuthMetadataResultEnvelope,
    credential_id: string,
    provider: string
) -> MetadataSelection {
    let loaded_failure: Option<AuthBridgeFailure> = loaded.error.copy();
    let loaded_value: Option<AuthMetadataEnvelope> = loaded.value.copy();
    if loaded.ok.copy() && !failure_present(loaded_failure) && envelope_present(loaded_value) => {
        let envelope: AuthMetadataEnvelope = loaded_value.unwrap_or(empty_auth_metadata());
        if envelope.ok.copy() && !text_present(envelope.error.copy()) && envelope.outcome.copy() == "loaded" => {
            let metadata: AuthMetadata = envelope.metadata.copy();
            if metadata.credential_id.copy() != credential_id.copy() || metadata.generation.copy() < 0 => {
                {ok: false, expected_generation: 0, has_refresh_token: false, error: "host_failure"}
            } else if metadata.provider.copy() != provider.copy() => {
                {ok: false, expected_generation: metadata.generation.copy(), has_refresh_token: false, error: "credential_provider_mismatch"}
            } else => {
                {ok: true, expected_generation: metadata.generation.copy(), has_refresh_token: metadata.has_refresh_token.copy(), error: ""}
            }
        } else => {
            {ok: false, expected_generation: 0, has_refresh_token: false, error: "host_failure"}
        }
    } else if !loaded.ok.copy() && failure_present(loaded_failure) && !envelope_present(loaded_value) => {
        let failure: AuthBridgeFailure = loaded_failure.unwrap_or(host_failure_bridge());
        let code: string = failure.code.copy();
        if code.copy() == "credential_not_found" => {
            {ok: true, expected_generation: 0, has_refresh_token: false, error: ""}
        } else => {
            {ok: false, expected_generation: 0, has_refresh_token: false, error: code.copy()}
        }
    } else => {
        {ok: false, expected_generation: 0, has_refresh_token: false, error: "host_failure"}
    }
}

fn emit_device_instruction(instruction: CodexDeviceInstruction) -> DeviceInstructionResultEnvelope {
    oauth::emit_device_instruction_result(
        instruction.verification_url,
        instruction.user_code,
        instruction.expires_in_seconds
    )
}

fn report_row(provider: string, credential_id: string, status: string, generation: int, source: string) -> string {
    let row: LoginReportRow = {
        provider: provider,
        credential_id: credential_id,
        status: status,
        generation: generation,
        source: source
    };
    json::encode(row) + "\n"
}

fn empty_auth_metadata() -> AuthMetadataEnvelope {
    let account_id: Option<string> = None;
    let last_refresh_at_ms: Option<int> = None;
    {
        ok: false,
        error: no_text(),
        metadata: {credential_id: "", provider: "", kind: "", source: "", token_type: "", expires_at_ms: 0, scopes: [], account_id: account_id, generation: 0, status: "", last_refresh_at_ms: last_refresh_at_ms, has_refresh_token: false},
        outcome: ""
    }
}

fn workflow_result(
    result: CodexDeviceLoginResult,
    operation: string,
    provider: string,
    credential_id: string,
    expected_generation: int
) -> AuthEntryResult {
    if !result.ok.copy() => {
        if result.code.copy() != "" => {
            failed(operation.copy(), result.code.copy(), Some(credential_id.copy()), expected_generation.copy())
        } else => {
            failed(operation.copy(), "host_failure", Some(credential_id.copy()), expected_generation.copy())
        }
    } else if result.code.copy() == "ok" => {
        let optional_metadata: Option<AuthMetadataEnvelope> = result.metadata;
        let envelope: AuthMetadataEnvelope = optional_metadata.unwrap_or(empty_auth_metadata());
        if envelope.ok.copy() && !text_present(envelope.error.copy()) &&
           (envelope.outcome.copy() == "committed" || envelope.outcome.copy() == "adopted") => {
            let metadata: AuthMetadata = envelope.metadata.copy();
            if metadata.credential_id.copy() != credential_id.copy() ||
               metadata.provider.copy() != provider.copy() || metadata.generation.copy() < 0 => {
                failed(operation.copy(), "host_failure", Some(credential_id.copy()), expected_generation.copy())
            } else => {
                entry(
                    true,
                    operation.copy(),
                    Some(metadata.credential_id.copy()),
                    metadata.generation.copy(),
                    report_row(
                        metadata.provider.copy(),
                        metadata.credential_id.copy(),
                        metadata.status.copy(),
                        metadata.generation.copy(),
                        metadata.source.copy()
                    ),
                    no_text()
                )
            }
        } else => {
            failed(operation.copy(), "host_failure", Some(credential_id.copy()), expected_generation.copy())
        }
    } else => {
        failed(operation.copy(), "host_failure", Some(credential_id.copy()), expected_generation.copy())
    }
}

pub fn run(home: resource<auth.host_home>, command: AuthCommandInput) -> AuthEntryResult {
    let operation: string = command.operation.copy();
    let requested_credential: Option<string> = command.credential_id.copy();
    let requested_provider_holder: Option<string> = command.provider.copy();
    let requested_provider: string = requested_provider_holder.unwrap_or("");
    if operation.copy() != "auth.login" => {
        failed(operation.copy(), "unsupported_operation", no_text(), 0)
    } else if text_present(requested_credential) => {
        failed(operation.copy(), "invalid_command", no_text(), 0)
    } else if requested_provider == "" => {
        failed(operation.copy(), "provider_required", no_text(), 0)
    } else => {
        let snapshot = config::load_snapshot(&home);
        let snapshot_generation: int = snapshot.policy_generation;
        if !snapshot.ok || text_present(snapshot.error) || snapshot_generation < 0 => {
            failed(operation.copy(), "host_failure", no_text(), 0)
        } else => {
            let policy: resource<auth.policy> = snapshot.policy_handle;
            let public_config: BoundedPublicConfig = snapshot.public_config;
            let selected: ProviderSelection = provider_selection(public_config, requested_provider.copy());
            if !selected.found.copy() => {
                failed(operation.copy(), "provider_not_found", no_text(), snapshot_generation.copy())
            } else => {
                let provider: ProviderEntry = selected.provider.copy();
                let credential_holder: Option<string> = provider.auth.copy();
                let credential_id: string = credential_holder.unwrap_or("");
                let oauth_holder: Option<OAuthConfig> = provider.oauth.copy();
                let oauth_config: OAuthConfig = oauth_holder.unwrap_or(empty_oauth_config());
                let flow_holder: Option<string> = oauth_config.flow;
                let flow: string = flow_holder.unwrap_or("");
                if credential_id == "" => {
                    failed(operation.copy(), "credential_id_required", no_text(), snapshot_generation.copy())
                } else if !oauth_present(oauth_holder) => {
                    failed(operation.copy(), "login_flow_unsupported", Some(credential_id.copy()), snapshot_generation.copy())
                } else if flow != "codex-device" && flow != "authorization_code_pkce" => {
                    failed(operation.copy(), "login_flow_unsupported", Some(credential_id.copy()), snapshot_generation.copy())
                } else => {
                    let loaded: AuthMetadataResultEnvelope = auth::load_metadata_result(credential_id.copy(), &policy);
                        let metadata: MetadataSelection = metadata_selection(loaded, credential_id.copy(), provider.name.copy());
                        if !metadata.ok.copy() => {
                            failed(operation.copy(), metadata.error.copy(), Some(credential_id.copy()), metadata.expected_generation.copy())
                        } else => {
                            let expected_generation: int = metadata.expected_generation.copy();
                            if flow == "codex-device" => {
                                let request: CodexDeviceLoginRequest = {
                                    policy_handle: policy,
                                    provider: provider,
                                    credential_id: credential_id.copy(),
                                    expected_generation: expected_generation.copy()
                                };
                                let result: CodexDeviceLoginResult = codex_device::login_with_instruction_result(
                                    request,
                                    emit_device_instruction
                                );
                                workflow_result(
                                    result,
                                    operation.copy(),
                                    requested_provider.copy(),
                                    credential_id.copy(),
                                    expected_generation.copy()
                                )
                            } else => {
                                let result = pkce_run(
                                    home,
                                    policy,
                                    provider,
                                    credential_id.copy(),
                                    expected_generation.copy(),
                                    metadata.has_refresh_token.copy()
                                );
                                if !result.ok.copy() => {
                                    failed(operation.copy(), result.code.copy(), Some(credential_id.copy()), expected_generation.copy())
                                } else if !envelope_present(result.metadata.copy()) => {
                                    failed(operation.copy(), "host_failure", Some(credential_id.copy()), expected_generation.copy())
                                } else => {
                                    let envelope: AuthMetadataEnvelope = result.metadata.unwrap_or(empty_auth_metadata());
                                    let envelope_has_error: bool = text_present(envelope.error.copy());
                                    if !envelope.ok.copy() || envelope_has_error ||
                                       (envelope.outcome.copy() != "committed" && envelope.outcome.copy() != "adopted") => {
                                        failed(operation.copy(), "host_failure", Some(credential_id.copy()), expected_generation.copy())
                                    } else => {
                                        let saved: AuthMetadata = envelope.metadata.copy();
                                        if saved.credential_id.copy() != credential_id.copy() ||
                                           saved.provider.copy() != requested_provider.copy() || saved.generation.copy() < 0 => {
                                            failed(operation.copy(), "host_failure", Some(credential_id.copy()), expected_generation.copy())
                                        } else => {
                                            entry(
                                                true,
                                                operation.copy(),
                                                Some(saved.credential_id.copy()),
                                                saved.generation.copy(),
                                                report_row(
                                                    saved.provider.copy(),
                                                    saved.credential_id.copy(),
                                                    saved.status.copy(),
                                                    saved.generation.copy(),
                                                    saved.source.copy()
                                                ),
                                                no_text()
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
}
