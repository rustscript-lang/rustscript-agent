fn failed(code: string) -> PkceLoginResult {
    {ok: false, code: code, metadata: no_envelope()}
}

fn failed_configuration(code: string) -> PkceConfiguration {
    {
        ok: false,
        code: code,
        intent: {
            credential_id: "",
            path: "",
            flow: "authorization_code_pkce",
            callback_mode: "browser",
            scopes: [],
            public_query: []
        },
        token_path: ""
    }
}

fn find_text(value: string, needle: string) -> int {
    let mut found: int = -1;
    let mut index: int = 0;
    while found < 0 && index + needle.length <= value.length {
        if value[index:(index + needle.length)] == needle {
            found = index;
        }
        index = index + 1;
    }
    found
}

fn ascii_alnum(value: string) -> bool {
    value.length == 1 &&
        find_text("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", value) >= 0
}

fn safe_client_id(value: string) -> bool {
    let mut valid: bool = value.length > 0 && value.length <= 256;
    let mut index: int = 0;
    while valid && index < value.length {
        let character: string = value[index:(index + 1)];
        if !ascii_alnum(character) && character != "-" && character != "." &&
           character != "_" && character != "~" {
            valid = false;
        }
        index = index + 1;
    }
    valid
}

fn safe_relative_path(value: string) -> bool {
    value.length > 0 && value.length <= 2048 && value[0:1] == "/" &&
    find_text(value, "//") != 0 && find_text(value, "..") < 0 &&
    find_text(value, "://") < 0 && find_text(value, "?") < 0 && find_text(value, "#") < 0
}

fn token_path(endpoint: string) -> Option<string> {
    let mut selected_path: Option<string> = no_text();
    if find_text(endpoint, "https://") == 0 && find_text(endpoint, "?") < 0 &&
       find_text(endpoint, "#") < 0 {
        let authority_and_path: string = endpoint[8:];
        let slash: int = find_text(authority_and_path, "/");
        if slash < 0 {
            if authority_and_path != "" && find_text(authority_and_path, "@") < 0 {
                selected_path = Some("/");
            }
        } else {
            let authority: string = authority_and_path.copy()[0:slash];
            let path: string = authority_and_path[slash:];
            if authority != "" && find_text(authority, "@") < 0 && safe_relative_path(path) {
                selected_path = Some(path);
            }
        }
    }
    selected_path
}

fn query_name_reserved(name: string) -> bool {
    name == "" || name == "client_id" || name == "response_type" ||
    name == "redirect_uri" || name == "state" || name == "code" ||
    name == "code_challenge" || name == "code_challenge_method" ||
    name == "code_verifier" || name == "authorization" || name == "cookie" ||
    name == "host" || name == "authority"
}

fn public_query(configured: array<PublicQueryEntry>, client_id: string) -> PublicQueryChoice {
    let mut values: array<PublicQueryEntry> = [];
    values[values.length] = {name: "client_id", value: client_id};
    values[values.length] = {name: "response_type", value: "code"};
    let mut valid: bool = configured.length <= 32;
    let mut index: int = 0;
    while valid && index < configured.length {
        let item: PublicQueryEntry = configured[index].copy();
        let name: string = item.name.copy();
        let value: string = item.value.copy();
        let mut duplicate: bool = query_name_reserved(name) || name.length > 128 || value.length > 1024;
        let mut prior: int = 0;
        while !duplicate && prior < values.length {
            let prior_entry: PublicQueryEntry = values[prior].copy();
            if prior_entry.name.copy() == name.copy() {
                duplicate = true;
            }
            prior = prior + 1;
        }
        if duplicate {
            valid = false;
        } else {
            values[values.length] = {name: name, value: value};
        }
        index = index + 1;
    }
    {ok: valid, values: values}
}

fn configured_pkce(provider: ProviderEntry, credential_id: string) -> PkceConfiguration {
    let auth_holder: Option<string> = provider.auth.copy();
    let oauth_holder: Option<OAuthConfig> = provider.oauth.copy();
    if !text_present(auth_holder) || auth_holder.unwrap_or("") != credential_id || !oauth_present(oauth_holder) => {
        failed_configuration("invalid_provider_config")
    } else => {
        let oauth_config: OAuthConfig = oauth_holder.unwrap_or(empty_oauth_config());
        let client_holder: Option<string> = oauth_config.client_id;
        let path_holder: Option<string> = oauth_config.authorization_path;
        let token_holder: Option<string> = oauth_config.token_endpoint;
        let flow_holder: Option<string> = oauth_config.flow;
        let client_id: string = client_holder.unwrap_or("");
        let authorization_path: string = path_holder.unwrap_or("");
        let endpoint: string = token_holder.unwrap_or("");
        let flow: string = flow_holder.unwrap_or("");
        let path: Option<string> = token_path(endpoint);
        let configured_holder: Option<array<PublicQueryEntry>> = oauth_config.authorization_parameters;
        let configured_parameters: array<PublicQueryEntry> = configured_holder.unwrap_or(empty_query_entries());
        let query: PublicQueryChoice = public_query(configured_parameters, client_id.copy());
        if flow != "authorization_code_pkce" || !safe_client_id(client_id.copy()) ||
           !safe_relative_path(authorization_path.copy()) || !text_present(path) || !query.ok.copy() => {
            failed_configuration("invalid_provider_config")
        } else => {
            let selected_path: string = path.unwrap_or("");
            let scopes_holder: Option<array<string>> = oauth_config.scopes;
            let scopes: array<string> = scopes_holder.unwrap_or(empty_scopes());
            {
                ok: true,
                code: "ok",
                intent: {
                    credential_id: credential_id,
                    path: authorization_path,
                    flow: "authorization_code_pkce",
                    callback_mode: "browser",
                    scopes: scopes,
                    public_query: query.values
                },
                token_path: selected_path
            }
        }
    }
}

fn session_values(session: PkceSessionResult) -> PkceSessionValues {
    let begin_holder: BeginPeek = peek_begin(session.begin);
    let waited_holder: CallbackPeek = peek_callback(session.waited);
    let result_ok: bool = session.ok;
    let result_code: string = session.code;
    if result_ok && begin_holder.present && waited_holder.present => {
        {ok: true, code: "ok", begin: begin_holder.envelope, waited: waited_holder.envelope}
    } else if !result_ok => {
        {ok: false, code: result_code, begin: no_begin(), waited: no_callback()}
    } else => {
        {ok: false, code: "host_failure", begin: no_begin(), waited: no_callback()}
    }
}

fn generation_value(
    code_handle: resource<oauth.authorization_code>,
    verifier_handle: resource<oauth.verifier>,
    expected_generation: int
) -> CodeGenerationValue {
    let captured: CodeGenerationResultEnvelope = oauth::code_generation_result(&code_handle, &verifier_handle);
    let has_error: bool = match captured.error { Some(_) => true, None => false };
    let value: Option<int> = captured.value;
    let generation: int = value.unwrap_or(-1);
    if !captured.ok.copy() || has_error || generation < 0 || generation != expected_generation => {
        {
            ok: false,
            code: "generation_conflict",
            generation: expected_generation,
            code_handle: code_handle,
            verifier_handle: verifier_handle
        }
    } else => {
        {
            ok: true,
            code: "ok",
            generation: generation,
            code_handle: code_handle,
            verifier_handle: verifier_handle
        }
    }
}

fn metadata_value(
    policy: resource<auth.policy>,
    frame: MetadataFrame,
    provider: string,
    source: string,
    expected_generation: int,
    scopes: array<string>
) -> MetadataValue {
    let intent: TokenMetadataIntent = {
        provider: provider,
        source: source,
        expected_generation: expected_generation,
        scopes: scopes,
        expiry_pointer: "/expires_in",
        token_type_pointer: "/token_type",
        account_pointer: no_text()
    };
    let parsed: TokenMetadataResult = metadata_parse_frame(policy, frame, intent);
    let parsed_value: Option<CredentialMetadata> = parsed.value;
    let has_value: bool = metadata_present(parsed_value);
    if !parsed.ok.copy() || parsed.code.copy() != "ok" || !has_value => {
        {ok: false, code: "invalid_token_metadata", value: no_metadata()}
    } else => {
        {ok: true, code: "ok", value: parsed_value}
    }
}

fn saved_metadata(
    home: resource<auth.host_home>,
    policy: resource<auth.policy>,
    request: PkceLoginRequest,
    parsed_metadata: CredentialMetadata,
    expected_generation: int,
    access_slot: resource<auth.secret_slot>,
    refresh_slot: Option<resource<auth.secret_slot>>,
    has_refresh: bool
) -> PkceLoginResult {
    let mut metadata: CredentialMetadata = parsed_metadata;
    if has_refresh => {
        metadata.has_refresh_token = true;
        let save_input: TokenSaveInput = {
            credential_id: request.credential_id,
            expected_generation: expected_generation,
            metadata: metadata,
            refresh_action: "replace"
        };
        saved_result(token_save(home, policy, save_input, access_slot, refresh_slot))
    } else => {
        metadata.has_refresh_token = request.had_refresh_token;
        let refresh_action: string = if request.had_refresh_token => {
            "preserve"
        } else => {
            "clear"
        };
        let save_input: TokenSaveInput = {
            credential_id: request.credential_id,
            expected_generation: expected_generation,
            metadata: metadata,
            refresh_action: refresh_action
        };
        saved_result(token_save(home, policy, save_input, access_slot, no_slot()))
    }
}

fn saved_result(saved: TokenSaveResult) -> PkceLoginResult {
    let saved_value: Option<AuthMetadata> = saved.value;
    if !saved.ok.copy() || saved.code.copy() != "ok" || !auth_metadata_present(saved_value) => {
        failed(saved.code.copy())
    } else => {
        let metadata: AuthMetadata = saved_value.unwrap_or(empty_metadata_auth());
        let outcome: Option<string> = saved.outcome;
        let envelope: AuthMetadataEnvelope = {
            ok: true,
            error: no_text(),
            metadata: metadata,
            outcome: outcome.unwrap_or("")
        };
        {ok: true, code: "ok", metadata: Some(envelope)}
    }
}

fn auth_metadata_present(value: Option<AuthMetadata>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn exchange_and_save(
    home: resource<auth.host_home>,
    policy: resource<auth.policy>,
    request: PkceLoginRequest,
    config: PkceConfiguration,
    code_handle: resource<oauth.authorization_code>,
    verifier_handle: resource<oauth.verifier>,
    generation: int
) -> PkceLoginResult {
    let client_entry: PublicQueryEntry = config.intent.public_query[0].copy();
    let client_id: string = client_entry.value.copy();
    let token_path_value: string = config.token_path.copy();
    let scopes: array<string> = config.intent.scopes.copy();
    let body: string = "grant_type=authorization_code&client_id=" + client_id.copy();
    let transport_request: TransportPublicRequest = {
        policy_handle: policy,
        credential_id: request.credential_id.copy(),
        method: "POST",
        path: token_path_value,
        public_headers: [{name: "content-type", value: "application/x-www-form-urlencoded"}],
        public_body: body
    };
    let usage: TransportCredentialUse = {
        kind: "code_verifier",
        access_handle: no_access_slot(),
        refresh_handle: no_refresh_slot(),
        code_handle: Some(code_handle),
        verifier_handle: Some(verifier_handle),
        device_handle: no_device_slot()
    };
    let payload: TransportPayloadIntent = {
        encoding: "form",
        secret_fields: "authorization_code",
        device_field: "",
        code_field: "code"
    };
    let exchanged: TransportResultEnvelope = oauth::transport_payload_result(&transport_request, &usage, payload);
    let policy_after_exchange: resource<auth.policy> = transport_request.policy_handle;
    let exchange_failure: Option<AuthBridgeFailure> = exchanged.error;
    let response_holder: Option<TransportResponseEnvelope> = exchanged.value;
    if !exchanged.ok || failure_present(exchange_failure) => {
        failed("exchange_failed")
    } else => {
        match response_holder {
            Some(response) => exchange_complete(
                home,
                policy_after_exchange,
                request,
                config,
                response,
                generation,
                scopes
            ),
            None => failed("exchange_failed")
        }
    }
}

/// Completes one exchange: the token response frame is taken apart once here,
/// because the metadata parser consumes it while the slot handles are still
/// needed for the save.
fn exchange_complete(
    home: resource<auth.host_home>,
    policy: resource<auth.policy>,
    request: PkceLoginRequest,
    config: PkceConfiguration,
    response: TransportResponseEnvelope,
    generation: int,
    scopes: array<string>
) -> PkceLoginResult {
    let access_peek: SlotPeek = peek_slot(response.access_slot);
    let refresh_peek: SlotPeek = peek_slot(response.refresh_slot);
    // `SlotPeek` owns a handle, so its `present` flag may be read exactly once:
    // take both flags here and hand the shell's handle to the save below.
    let access_present: bool = access_peek.present;
    let refresh_present: bool = refresh_peek.present;
    let frame: MetadataFrame = {
        ok: response.ok,
        error: response.error,
        status: response.status,
        body: response.body_without_secret_fields,
        access_present: access_present,
        refresh_present: refresh_present
    };
    let parsed: MetadataValue = metadata_value(
        policy,
        frame,
        request.provider.name.copy(),
        "authorization-code-pkce",
        generation,
        scopes
    );
    let parsed_metadata: Option<CredentialMetadata> = parsed.value;
    if !parsed.ok.copy() || !metadata_present(parsed_metadata) => {
        failed(parsed.code.copy())
    } else if !access_present => {
        failed("invalid_token_metadata")
    } else => {
        match access_peek.handle {
            Some(access_slot) => saved_metadata(
                home,
                policy,
                request,
                parsed_metadata.unwrap_or(empty_credential_metadata()),
                generation,
                access_slot,
                refresh_peek.handle,
                refresh_present
            ),
            None => failed("invalid_token_metadata")
        }
    }
}

fn empty_credential_metadata() -> CredentialMetadata {
    {
        provider: "",
        kind: "",
        source: "",
        token_type: "",
        expires_at_ms: 0,
        scopes: [],
        account_id: no_text(),
        generation: 0,
        status: "",
        last_refresh_at_ms: no_int(),
        has_refresh_token: false
    }
}

fn complete_session(
    home: resource<auth.host_home>,
    policy: resource<auth.policy>,
    request: PkceLoginRequest,
    config: PkceConfiguration
) -> PkceLoginResult {
    let session_result: PkceSessionResult = instruction_run(policy, config.intent, true);
    let session_ok: bool = session_result.ok;
    let session_code: string = session_result.code;
    let begin_holder: BeginPeek = peek_begin(session_result.begin);
    let waited_holder: CallbackPeek = peek_callback(session_result.waited);
    if !session_ok => {
        failed(session_code)
    } else if !begin_holder.present || !waited_holder.present => {
        failed("host_failure")
    } else => {
        match begin_holder.envelope {
            Some(begin) => match waited_holder.envelope {
                Some(waited) => captured_session(home, policy, request, config, begin, waited),
                None => failed("host_failure")
            },
            None => failed("host_failure")
        }
    }
}

/// Runs the code generation and exchange once both envelopes are bound, so the
/// returned code handle is the live one the token request consumes.
fn captured_session(
    home: resource<auth.host_home>,
    policy: resource<auth.policy>,
    request: PkceLoginRequest,
    config: PkceConfiguration,
    begin: PkceBeginEnvelope,
    waited: CallbackEnvelope
) -> PkceLoginResult {
    let code_peek: CodeSlotPeek = peek_code_slot(waited.code_handle);
    if !code_peek.present => {
        failed("host_failure")
    } else => {
        match code_peek.handle {
            Some(code_handle) => code_generation_step(home, policy, request, config, begin, code_handle),
            None => failed("host_failure")
        }
    }
}

fn code_generation_step(
    home: resource<auth.host_home>,
    policy: resource<auth.policy>,
    request: PkceLoginRequest,
    config: PkceConfiguration,
    begin: PkceBeginEnvelope,
    code_handle: resource<oauth.authorization_code>
) -> PkceLoginResult {
    let verifier_handle: resource<oauth.verifier> = begin.verifier_handle;
    let generation: CodeGenerationValue = generation_value(
        code_handle,
        verifier_handle,
        request.expected_generation
    );
    let generation_ok: bool = generation.ok;
    let generation_code: string = generation.code;
    let captured_generation: int = generation.generation;
    if !generation_ok => {
        failed(generation_code)
    } else => {
        exchange_and_save(
            home,
            policy,
            request,
            config,
            generation.code_handle,
            generation.verifier_handle,
            captured_generation
        )
    }
}

struct CodeSlotPeek {
    present: bool,
    handle: Option<resource<oauth.authorization_code>>
}

fn peek_code_slot(value: Option<resource<oauth.authorization_code>>) -> CodeSlotPeek {
    match value {
        Some(handle) => {present: true, handle: Some(handle)},
        None => {present: false, handle: no_code_slot()}
    }
}

pub fn run(
    home: resource<auth.host_home>,
    policy: resource<auth.policy>,
    provider: ProviderEntry,
    credential_id: string,
    expected_generation: int,
    had_refresh_token: bool
) -> PkceLoginResult {
    let request: PkceLoginRequest = {
        provider: provider,
        credential_id: credential_id,
        expected_generation: expected_generation,
        had_refresh_token: had_refresh_token
    };
    let selected: PkceConfiguration = configured_pkce(request.provider.copy(), request.credential_id.copy());
    let result: PkceLoginResult = if !selected.ok.copy() => {
        failed(selected.code.copy())
    } else => {
        complete_session(home, policy, request, selected)
    };
    auth::cleanup_transients(&policy);
    result
}
