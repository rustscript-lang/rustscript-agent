        None => {present: false, envelope: no_begin()}
    }
}

struct CallbackPeek {
    present: bool,
    envelope: Option<CallbackEnvelope>
}

fn peek_callback(value: Option<CallbackEnvelope>) -> CallbackPeek {
    match value {
