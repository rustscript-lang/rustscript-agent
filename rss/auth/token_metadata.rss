use auth;
use oauth;

struct TokenMetadataIntent {
    provider: string,
    source: string,
    expected_generation: int,
    scopes: array<string>,
    expiry_pointer: string,
    token_type_pointer: string,
    account_pointer: Option<string>
}

struct TokenMetadataResult {
    ok: bool,
    code: string,
    value: Option<CredentialMetadata>
}

struct ParsedExpiry {
    valid: bool,
    seconds: int
}

struct ParsedTokenType {
    valid: bool,
    value: string
}

struct ParsedAccount {
    valid: bool,
    has_value: bool,
    value: string
}

fn max_int() -> int {
    9223372036854775807
}

// ---------------------------------------------------------------------------
// Logical Option carriers
// ---------------------------------------------------------------------------

fn failure_present(value: Option<AuthBridgeFailure>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn text_present(value: Option<string>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn int_present(value: Option<int>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn field_present(value: Option<PublicJsonFieldEnvelope>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn slot_present(value: Option<resource<auth.secret_slot>>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn no_failure() -> Option<AuthBridgeFailure> {
    None
}

fn no_text() -> Option<string> {
    None
}

fn no_int() -> Option<int> {
    None
}

fn no_metadata() -> Option<CredentialMetadata> {
    None
}

fn no_field() -> Option<PublicJsonFieldEnvelope> {
    None
}

fn empty_field() -> PublicJsonFieldEnvelope {
    {
        kind: "",
        string_value: no_text(),
        int_value: no_int(),
        float_value: no_float(),
        bool_value: no_bool(),
        length: no_int()
    }
}

fn no_float() -> Option<float> {
    None
}

fn no_bool() -> Option<bool> {
    None
}

fn failure(code: string) -> TokenMetadataResult {
    {ok: false, code: code, value: no_metadata()}
}

fn empty_transport_response() -> TransportResponseEnvelope {
    let access_slot: Option<resource<auth.secret_slot>> = None;
    let refresh_slot: Option<resource<auth.secret_slot>> = None;
    let device_handle: Option<resource<oauth.device_session>> = None;
    {
        ok: false,
        error: no_text(),
        status: 0,
        public_headers: [],
        body_without_secret_fields: "",
        retry_after_ms: no_int(),
        access_slot: access_slot,
        refresh_slot: refresh_slot,
        device_handle: device_handle
    }
}

fn parse_expiry(envelope: PublicJsonFieldResultEnvelope) -> ParsedExpiry {
    let mut parsed: ParsedExpiry = {valid: false, seconds: 0};
    let failure_value: Option<AuthBridgeFailure> = envelope.error;
    let envelope_value: Option<PublicJsonFieldEnvelope> = envelope.value;
    if envelope.ok && !failure_present(failure_value) && field_present(envelope_value) {
        let selected: PublicJsonFieldEnvelope = envelope_value.unwrap_or(empty_field());
        let seconds_value: Option<int> = selected.int_value;
        if selected.kind == "int" && int_present(seconds_value) {
            let seconds: int = seconds_value.unwrap_or(0);
            if seconds > 0 && seconds <= max_int() / 1000 {
                parsed = {valid: true, seconds: seconds};
            }
        }
    }
    parsed
}

fn parse_token_type(envelope: PublicJsonFieldResultEnvelope) -> ParsedTokenType {
    let mut parsed: ParsedTokenType = {valid: false, value: ""};
    let failure_value: Option<AuthBridgeFailure> = envelope.error;
    let envelope_value: Option<PublicJsonFieldEnvelope> = envelope.value;
    if envelope.ok && !failure_present(failure_value) && field_present(envelope_value) {
        let selected: PublicJsonFieldEnvelope = envelope_value.unwrap_or(empty_field());
        let text_value: Option<string> = selected.string_value;
        if selected.kind == "string" && text_present(text_value) {
            let value: string = text_value.unwrap_or("");
            if value == "Bearer" {
                parsed = {valid: true, value: value};
            }
        }
    }
    parsed
}

fn parse_account(envelope: PublicJsonFieldResultEnvelope) -> ParsedAccount {
    let mut parsed: ParsedAccount = {valid: false, has_value: false, value: ""};
    let failure_value: Option<AuthBridgeFailure> = envelope.error;
    let envelope_value: Option<PublicJsonFieldEnvelope> = envelope.value;
    if envelope.ok && !failure_present(failure_value) && field_present(envelope_value) {
        let selected: PublicJsonFieldEnvelope = envelope_value.unwrap_or(empty_field());
        let text_value: Option<string> = selected.string_value;
        if selected.kind.copy() == "missing" || selected.kind.copy() == "null" {
            parsed = {valid: true, has_value: false, value: ""};
        } else if selected.kind == "string" && text_present(text_value) {
            let value: string = text_value.unwrap_or("");
            if value != "" {
                parsed = {valid: true, has_value: true, value: value};
            }
        }
    }
    parsed
}

pub fn parse(
    policy_handle: resource<auth.policy>,
    response: TransportResponseEnvelope,
    intent: TokenMetadataIntent
) -> TokenMetadataResult {
    let mut result: TokenMetadataResult = failure("invalid_token_metadata");
    let account_pointer_present: bool = text_present(intent.account_pointer);
    let valid_intent: bool = intent.provider != "" && intent.source != "" &&
        intent.expected_generation >= 0 && intent.expiry_pointer != "" &&
        intent.token_type_pointer != "" &&
        (!intent.has("account_pointer") || !account_pointer_present || intent.account_pointer.unwrap_or("") != "");
    let transport_error: Option<string> = response.error;
    if valid_intent {
        if !response.ok || text_present(transport_error) {
            result = failure("token_transport_failed");
        } else if response.status != 200 {
            result = failure("token_http_rejected");
        } else if !slot_present(response.access_slot) {
            result = failure("invalid_token_metadata");
        } else {
            let body: string = response.body_without_secret_fields;
            let expiry_field: PublicJsonFieldResultEnvelope = oauth::public_json_field_result(&policy_handle, body.copy(), intent.expiry_pointer);
            let token_type_field: PublicJsonFieldResultEnvelope = oauth::public_json_field_result(&policy_handle, body.copy(), intent.token_type_pointer);
            let expiry: ParsedExpiry = parse_expiry(expiry_field);
            let token_type: ParsedTokenType = parse_token_type(token_type_field);
            let mut account: ParsedAccount = {valid: true, has_value: false, value: ""};
            if account_pointer_present {
                let pointer: string = intent.account_pointer.unwrap_or("");
                let account_field: PublicJsonFieldResultEnvelope = oauth::public_json_field_result(&policy_handle, body.copy(), pointer);
                account = parse_account(account_field);
            }
            if !expiry.valid || !token_type.valid || !account.valid {
                result = failure("invalid_token_metadata");
            } else {
                let clock: OAuthNowResultEnvelope = oauth::now_ms_result(&policy_handle);
                let clock_failure: Option<AuthBridgeFailure> = clock.error;
                let clock_value: Option<int> = clock.value;
                if !clock.ok || failure_present(clock_failure) || !int_present(clock_value) {
                    let code: string = match clock_failure {
                        Some(value) => value.code.copy(),
                        None => "clock_unavailable"
                    };
                    result = failure(code);
                } else {
                    let now_ms: int = clock_value.unwrap_or(-1);
                    if now_ms < 0 {
                        result = failure("invalid_token_metadata");
                    } else {
                        let lifetime_ms: int = expiry.seconds * 1000;
                        if now_ms > max_int() - lifetime_ms {
                            result = failure("invalid_token_metadata");
                        } else {
                            let mut account_id: Option<string> = no_text();
                            if account.has_value {
                                account_id = Some(account.value);
                            }
                            let has_refresh_token: bool = slot_present(response.refresh_slot);
                            let metadata: CredentialMetadata = {
                                provider: intent.provider,
                                kind: "oauth",
                                source: intent.source,
                                token_type: token_type.value,
                                expires_at_ms: now_ms + lifetime_ms,
                                scopes: intent.scopes,
                                account_id: account_id,
                                generation: intent.expected_generation,
                                status: "active",
                                last_refresh_at_ms: no_int(),
                                has_refresh_token: has_refresh_token
                            };
                            result = {ok: true, code: "ok", value: Some(metadata)};
                        }
                    }
                }
            }
        }
    }
    result
}

pub fn parse_transport_result(
    policy_handle: resource<auth.policy>,
    response: TransportResultEnvelope,
    intent: TokenMetadataIntent
) -> TokenMetadataResult {
    let mut result: TokenMetadataResult = failure("token_transport_failed");
    let transport_failure: Option<AuthBridgeFailure> = response.error;
    let envelope_value: Option<TransportResponseEnvelope> = response.value;
    if response.ok && !failure_present(transport_failure) {
        result = match envelope_value {
            Some(value) => parse(policy_handle, value, intent),
            None => failure("token_transport_failed")
        };
    }
    result
}
