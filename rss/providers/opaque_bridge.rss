use auth;
use oauth;

struct OpaqueProviderIntent {
    credential_id: string,
    method: string,
    path: string,
    public_headers: array<PublicHeader>,
    public_body: string
}

struct OpaquePolicyBinding {
    policy: resource<auth.policy>
}

struct PreparedProviderTransport {
    request: TransportPublicRequest,
    usage: TransportCredentialUse
}

struct PreparedProviderTransportResult {
    ok: bool,
    error: Option<AuthBridgeFailure>,
    value: Option<PreparedProviderTransport>
}

// ---------------------------------------------------------------------------
// Logical Option carriers
// ---------------------------------------------------------------------------

fn failure_present(value: Option<AuthBridgeFailure>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn envelope_present(value: Option<AuthMetadataEnvelope>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn no_failure() -> Option<AuthBridgeFailure> {
    None
}

fn no_text() -> Option<string> {
    None
}

fn text_present(value: Option<string>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn no_refresh_handle() -> Option<resource<auth.refresh>> {
    None
}

fn no_code_handle() -> Option<resource<oauth.authorization_code>> {
    None
}

fn no_verifier_handle() -> Option<resource<oauth.verifier>> {
    None
}

fn no_device_handle() -> Option<resource<oauth.device_session>> {
    None
}

fn empty_metadata() -> AuthMetadata {
    let account_id: Option<string> = None;
    let last_refresh_at_ms: Option<int> = None;
    {
        credential_id: "",
        provider: "",
        kind: "",
        source: "",
        token_type: "",
        expires_at_ms: 0,
        scopes: [],
        account_id: account_id,
        generation: 0,
        status: "",
        last_refresh_at_ms: last_refresh_at_ms,
        has_refresh_token: false
    }
}

fn empty_metadata_envelope() -> AuthMetadataEnvelope {
    {
        ok: false,
        error: no_text(),
        metadata: empty_metadata(),
        outcome: ""
    }
}

fn invalid_metadata_result() -> PreparedProviderTransportResult {
    let failure: AuthBridgeFailure = {
        code: "invalid_credential_metadata",
        cancelled: false,
        deadline_exceeded: false,
        revoked: false
    };
    {
        ok: false,
        error: Some(failure),
        value: no_prepared_transport()
    }
}

fn access_unavailable_result() -> PreparedProviderTransportResult {
    let failure: AuthBridgeFailure = {
        code: "access_unavailable",
        cancelled: false,
        deadline_exceeded: false,
        revoked: false
    };
    {
        ok: false,
        error: Some(failure),
        value: no_prepared_transport()
    }
}

fn no_prepared_transport() -> Option<PreparedProviderTransport> {
    None
}

/// The single access credential use. Every unselected handle is a tagged `None`
/// carrier, so the map never carries a physical null.
fn usage_with_access(handle: resource<auth.access>) -> TransportCredentialUse {
    {
        kind: "access",
        access_handle: Some(handle),
        refresh_handle: no_refresh_handle(),
        code_handle: no_code_handle(),
        verifier_handle: no_verifier_handle(),
        device_handle: no_device_handle()
    }
}

fn prepared_transport(
    binding: OpaquePolicyBinding,
    intent: OpaqueProviderIntent,
    usage: TransportCredentialUse
) -> PreparedProviderTransportResult {
    let request: TransportPublicRequest = {
        policy_handle: binding.policy,
        credential_id: intent.credential_id,
        method: intent.method,
        path: intent.path,
        public_headers: intent.public_headers,
        public_body: intent.public_body
    };
    let value: PreparedProviderTransport = {request: request, usage: usage};
    {
        ok: true,
        error: no_failure(),
        value: Some(value)
    }
}

fn prepare(binding: OpaquePolicyBinding, intent: OpaqueProviderIntent) -> PreparedProviderTransportResult {
    let loaded: AuthMetadataResultEnvelope =
        auth::load_metadata_result(intent.credential_id, &binding.policy);
    let loaded_failure: Option<AuthBridgeFailure> = loaded.error.copy();
    if failure_present(loaded_failure) => {
        {
            ok: false,
            error: loaded_failure,
            value: no_prepared_transport()
        }
    } else if !loaded.ok => {
        invalid_metadata_result()
    } else => {
        let maybe_metadata: Option<AuthMetadataEnvelope> = loaded.value;
        if !envelope_present(maybe_metadata) => {
            invalid_metadata_result()
        } else => {
            let metadata: AuthMetadataEnvelope =
                maybe_metadata.unwrap_or(empty_metadata_envelope());
            let metadata_failure: Option<string> = metadata.error;
            if !metadata.ok || text_present(metadata_failure) => {
                invalid_metadata_result()
            } else => {
                // Metadata presence is a locked read, not an access admission.
                // Issuance is the fallible access step: an exhausted access
                // lifetime must surface the canonical public code without
                // reaching the native transport.
                let issued: AccessHandleResultEnvelope = auth::access_handle_result(
                    intent.credential_id,
                    metadata.metadata.generation,
                    &binding.policy
                );
                let issued_has_value: bool = issued.has("value");
                let issued_ok: bool = issued.ok;
                let maybe_issue_error: Option<AuthBridgeFailure> = issued.error;
                if failure_present(maybe_issue_error) => {
                    {
                        ok: false,
                        error: maybe_issue_error,
                        value: no_prepared_transport()
                    }
                } else if !issued_ok => {
                    access_unavailable_result()
                } else if !issued_has_value => {
                    access_unavailable_result()
                } else => {
                    match issued.value {
                        Some(inner) => prepared_transport(binding, intent, usage_with_access(inner.handle)),
                        None => access_unavailable_result()
                    }
                }
            }
        }
    }
}

fn no_transport_response() -> Option<TransportResponseEnvelope> {
    None
}

pub fn call(binding: OpaquePolicyBinding, intent: OpaqueProviderIntent) -> TransportResultEnvelope {
    let prepared: PreparedProviderTransportResult = prepare(binding, intent);
    let has_value: bool = prepared.has("value");
    let has_error: bool = prepared.has("error");
    let ok: bool = prepared.ok;
    let failure: Option<AuthBridgeFailure> = if has_error => { prepared.error } else => { no_failure() };
    let inner: Option<PreparedProviderTransport> = if !ok || failure_present(failure) || !has_value => {
        no_prepared_transport()
    } else => {
        prepared.value
    };
    match inner {
        Some(value) => oauth::transport_result(&value.request, &value.usage),
        None => {
            ok: false,
            error: failure,
            value: no_transport_response()
        }
    }
}

fn no_stream_envelope() -> Option<OAuthStreamEnvelope> {
    None
}

pub fn start_stream(binding: OpaquePolicyBinding, intent: OpaqueProviderIntent, markers: array<string>) -> OAuthStreamStartResultEnvelope {
    let prepared: PreparedProviderTransportResult = prepare(binding, intent);
    let has_value: bool = prepared.has("value");
    let has_error: bool = prepared.has("error");
    let ok: bool = prepared.ok;
    let failure: Option<AuthBridgeFailure> = if has_error => { prepared.error } else => { no_failure() };
    let inner: Option<PreparedProviderTransport> = if !ok || failure_present(failure) || !has_value => {
        no_prepared_transport()
    } else => {
        prepared.value
    };
    match inner {
        Some(value) => oauth::stream_start_result(&value.request, &value.usage, markers),
        None => {
            ok: false,
            error: failure,
            value: no_stream_envelope()
        }
    }
}
