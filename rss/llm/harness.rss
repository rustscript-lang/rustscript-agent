// Generic adapter dispatch entry used by the provider integration tests.
// This is test/load bridging only: it selects a provider protocol adapter or
// profile by name and forwards the calling context. Chat Completions traffic
// (direct or profiled) routes through the shared admitted native-auth
// dispatch; it contains no protocol parsing and no agent-loop policy.
use json;
use self::types as types;
use self::openai_responses as openai_responses;
use self::anthropic_messages as anthropic_messages;
use super::providers::profile as profile;
use super::providers::openrouter as openrouter;
use super::providers::deepseek as deepseek;
use super::providers::opencode_zen as opencode_zen;
use super::providers::opencode_go as opencode_go;
use super::providers::custom as custom;

/// Test-bridging entry. Named `run_harness` (not `run`) because the native
/// runner resolves entries through the flattened exported-callable table by
/// bare name: this tree also contains the opaque Chat entry's canonical
/// `run`, so a second `run` here would shadow the dispatch. This mirrors why
/// the default provider dispatcher uses the entry name `dispatch`.
pub fn run_harness(context: map) -> map {
    let kind: string = context["kind"];
    if kind == "openai_chat" => {
        profile::profile_dispatch(context)
    } else if kind == "profile:openrouter" => {
        openrouter::call(context)
    } else if kind == "profile:deepseek" => {
        deepseek::call(context)
    } else if kind == "profile:opencode_zen" => {
        opencode_zen::call(context)
    } else if kind == "profile:opencode_go" => {
        opencode_go::call(context)
    } else if kind == "profile:custom" => {
        custom::call(context)
    } else if kind == "openai_responses" => {
        run_responses(context)
    } else if kind == "anthropic_messages" => {
        run_anthropic(context)
    } else => {
        types::fail(types::error_request("unknown_adapter", kind))
    }
}

fn run_responses(context: map) -> map {
    let request: map = types::request_map(context, "request");
    let profile: map = types::request_map(context, "profile");
    openai_responses::openai_responses_call(request, profile)
}

fn run_anthropic(context: map) -> map {
    let request: map = types::request_map(context, "request");
    let profile: map = types::request_map(context, "profile");
    anthropic_messages::anthropic_messages_call(request, profile)
}
