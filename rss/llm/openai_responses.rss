// OpenAI Responses adapter (protocol mapping only; no agent loop).
//
// Maps the canonical LlmRequest (rss/llm/types.rss) onto the OpenAI Responses
// API (`POST /responses`) wire protocol and back. Unlike Chat Completions, the
// Responses wire carries an `input` array of heterogeneous items instead of a
// `messages` array:
//
//   - a user message      -> {role: "user", content: "<text>"}
//   - a tool result part  -> {type: "function_call_output", call_id, output}
//   - an assistant message-> {role: "assistant", content: "<text>"}
//   - an assistant call   -> {type: "function_call", call_id, name, arguments}
//
// The response `output` array carries `message`, `reasoning`, and
// `function_call` items; usage is top-level `usage`. The streaming transport
// emits `response.output_text.delta`, `response.function_call_arguments.delta`,
// `response.output_item.done`, and `response.completed` events, ending with a
// bare `data: [DONE]`.
//
// Tool schemas arrive as `schema_json` strings and are spliced into the encoded
// wire body through per-tool indexed literal markers
// (`__RSS_TOOL_SCHEMA_<i>__`), because json::encode only accepts
// struct-shaped values (see rss/llm/openai_chat.rss and the A3 plan P3 note).
use json;
use bytes;
use http;
use self::types as types;

struct RespInputItem {
    role: string?,
    content: string?,
    type: string?,
    call_id: string?,
    output: string?,
    name: string?,
    arguments: string?
}

struct RespTool {
    type: string,
    name: string,
    description: string,
    parameters: string
}

struct RespRequest {
    model: string,
    input: array<RespInputItem>,
    tools: array<RespTool>?,
    tool_choice: string?,
    parallel_tool_calls: bool?,
    max_output_tokens: int?,
    temperature: float?,
    top_p: float?,
    stream: bool
}

/// Marker for one tool's raw schema (see rss/llm/openai_chat.rss).
fn tool_schema_marker(index: int) -> string {
    let encoded: string = json::encode(index);
    "__RSS_TOOL_SCHEMA_" + encoded + "__"
}

// ---------------------------------------------------------------------------
// Entry
// ---------------------------------------------------------------------------

pub fn openai_responses_call(request: map, profile: map) -> map {
    let stream: bool = types::request_bool(request, "stream", false);
    if stream => {
        openai_responses_stream_dispatch(request, profile)
    } else => {
        openai_responses_complete_dispatch(request, profile)
    }
}

/// Reads the profile fields (the only map read in this function) and hands
/// them to the transport as primitives. The parameter order is a retained
/// layout workaround (see rss/llm/openai_chat.rss header): `profile` (the read
/// map) sits second.
fn openai_responses_complete_dispatch(request: map, profile: map) -> map {
    let base_url: string = types::profile_string(profile, "base_url");
    let api_key: string = types::profile_string(profile, "api_key");
    openai_responses_complete(request, base_url, api_key)
}

fn openai_responses_complete(request: map, base_url: string, api_key: string) -> map {
    let model: string = types::request_string(request, "model");
    if model == "" => {
        types::fail(types::error_request("missing_model", "request.model is required"))
    } else => {
        responses_send_complete(request, model, base_url, api_key)
    }
}

/// The whole buffered path: wire building, tool-schema splicing, and the
/// transport call.
fn responses_send_complete(
    request: map,
    model: string,
    base_url: string,
    api_key: string
) -> map {
    let body_text: string = responses_encode_wire(request, model, false);
    let url: string = base_url + "/responses";
    let body: string = responses_splice_tool_schemas(
        body_text,
        types::request_array(request, "tools")
    );
    let response: map = http::client::request({
        method: "POST",
        url: url,
        headers: {
            "content-type": "application/json",
            "authorization": "Bearer " + api_key
        },
        body: body
    });
    let status: int = response["status"].copy();
    if status >= 200 && status < 300 => {
        responses_parse_response(response, status)
    } else => {
        responses_parse_error(response, status)
    }
}

// ---------------------------------------------------------------------------
// Wire request building
// ---------------------------------------------------------------------------

fn responses_encode_wire(request: map, model: string, stream: bool) -> string {
    let body_text: string = json::encode(responses_build_wire(request, model, stream));
    body_text
}

fn responses_build_wire(request: map, model: string, stream: bool) -> RespRequest {
    let input: array<RespInputItem> = responses_build_input(
        types::request_array(request, "messages")
    );
    let tools: array<RespTool> = responses_build_tools(types::request_array(request, "tools"));
    let mut wire_tools: array<RespTool>? = null;
    if tools.length > 0 {
        wire_tools = tools;
    }
    let sampling: map = types::request_map(request, "sampling");
    let temperature_raw: map = types::sampling_float(sampling, "temperature");
    let top_p_raw: map = types::sampling_float(sampling, "top_p");
    let temperature_present: bool = temperature_raw["present"];
    let temperature_value: float = temperature_raw["value"];
    let top_p_present: bool = top_p_raw["present"];
    let top_p_value: float = top_p_raw["value"];
    let max_output: int = types::request_int(request, "max_output_tokens", 0);
    // Canonical contract (rss/llm/types.rss): tool_choice is a TOP-LEVEL
    // request field, exactly like the chat adapter. The legacy
    // provider_options.tool_choice alias remains a fallback for older
    // callers; the top-level value always wins when both are present.
    // parallel_tool_calls lives in provider_options as a presence-aware
    // bool (absent -> omitted from the wire; false stays false).
    let tool_choice: string = types::request_string(request, "tool_choice");
    let options: map = types::request_map(request, "provider_options");
    let mut tool_choice_effective: string = tool_choice;
    if tool_choice_effective == "" {
        tool_choice_effective = types::request_string(options, "tool_choice");
    }
    let parallel_raw: map = responses_parallel_bool(options);
    let parallel_present: bool = parallel_raw["present"];
    let parallel_value: bool = parallel_raw["value"];
    let mut temperature: float? = null;
    let mut top_p: float? = null;
    let mut max_tokens: int? = null;
    let mut wire_tool_choice: string? = null;
    let mut wire_parallel: bool? = null;
    if temperature_present {
        temperature = temperature_value;
    }
    if top_p_present {
        top_p = top_p_value;
    }
    if max_output > 0 {
        max_tokens = max_output;
    }
    if tool_choice_effective != "" {
        wire_tool_choice = tool_choice_effective;
    }
    if parallel_present {
        wire_parallel = parallel_value;
    }
    {
        model: model,
        input: input,
        tools: wire_tools,
        tool_choice: wire_tool_choice,
        parallel_tool_calls: wire_parallel,
        max_output_tokens: max_tokens,
        temperature: temperature,
        top_p: top_p,
        stream: stream
    }
}

/// Presence-aware bool read for one provider_options knob: absent -> present
/// false; a bool value -> present true with the value. Mirrors the
/// `sampling_float` {present, value} pattern so absent knobs can be omitted
/// from the wire (null optional struct fields are dropped by the encoder).
fn responses_parallel_bool(options: map) -> map {
    let mut present = false;
    let mut value = false;
    if options.has("parallel_tool_calls") {
        if type(options["parallel_tool_calls"]) == "bool" {
            let raw: bool = options["parallel_tool_calls"];
            value = raw;
            present = true;
        }
    }
    { present: present, value: value }
}

/// Converts canonical messages into the heterogeneous `input` item array.
fn responses_build_input(messages: array) -> array<RespInputItem> {
    let mut wire: array<RespInputItem> = [];
    let mut i = 0;
    while i < messages.length {
        let message: map = types::array_entry(messages, i);
        if message.has("role") {
            wire = responses_append_message_by_role(wire, message);
        }
        i += 1;
    }
    wire
}

fn responses_append_message_by_role(
    wire: array<RespInputItem>,
    message: map
) -> array<RespInputItem> {
    let role: string = types::message_role(message);
    if role == "user" => {
        responses_append_user_message(wire, message)
    } else if role == "assistant" => {
        responses_append_assistant_message(wire, message)
    } else => {
        responses_append_simple_message(wire, role, message)
    }
}

/// Appends one `user` message item (text) and one `function_call_output` item
/// per tool_result part. Text is joined across parts into a plain string.
fn responses_append_user_message(
    wire: array<RespInputItem>,
    message: map
) -> array<RespInputItem> {
    let parts: array = types::message_content(message);
    let mut result: array<RespInputItem> = wire;
    let mut text: string = "";
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            if types::part_type(part) == "tool_result" {
                let call_id: string = types::request_string(part, "tool_call_id");
                let output: string = types::request_string(part, "content");
                result[result.length] = {
                    role: null,
                    content: null,
                    type: "function_call_output",
                    call_id: call_id,
                    output: output,
                    name: null,
                    arguments: null
                };
            }
        }
        i += 1;
    }
    let text_joined: string = responses_join_text_parts(message);
    if text_joined != "" {
        result[result.length] = {
            role: "user",
            content: text_joined,
            type: null,
            call_id: null,
            output: null,
            name: null,
            arguments: null
        };
    }
    result
}

/// Appends one `assistant` message item (text) plus one `function_call` item
/// per tool_call part. Text is joined into a plain string.
fn responses_append_assistant_message(
    wire: array<RespInputItem>,
    message: map
) -> array<RespInputItem> {
    let parts: array = types::message_content(message);
    let mut result: array<RespInputItem> = wire;
    let mut text: string = "";
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            if types::part_type(part) == "text" {
                let text_part: string = types::request_string(part, "text");
                text = text + text_part;
            }
        }
        i += 1;
    }
    let mut tool_calls: array<RespInputItem> = [];
    let mut j = 0;
    while j < parts.length {
        let part: map = types::array_entry(parts, j);
        if part.has("type") {
            if types::part_type(part) == "tool_call" {
                let call_id: string = types::request_string(part, "tool_call_id");
                let name: string = types::request_string(part, "name");
                let arguments_json: string = types::request_string(part, "arguments_json");
                tool_calls[tool_calls.length] = {
                    role: null,
                    content: null,
                    type: "function_call",
                    call_id: call_id,
                    output: null,
                    name: name,
                    arguments: arguments_json
                };
            }
        }
        j += 1;
    }
    if text != "" {
        result[result.length] = {
            role: "assistant",
            content: text,
            type: null,
            call_id: null,
            output: null,
            name: null,
            arguments: null
        };
    }
    let mut k = 0;
    while k < tool_calls.length {
        result[result.length] = tool_calls[k].copy();
        k += 1;
    }
    result
}

fn responses_append_simple_message(
    wire: array<RespInputItem>,
    role: string,
    message: map
) -> array<RespInputItem> {
    let text: string = responses_join_text_parts(message);
    let mut result: array<RespInputItem> = wire;
    if text != "" {
        result[result.length] = {
            role: role,
            content: text,
            type: null,
            call_id: null,
            output: null,
            name: null,
            arguments: null
        };
    }
    result
}

/// Joins the `text` parts of one canonical message into a plain string.
fn responses_join_text_parts(message: map) -> string {
    let parts: array = types::message_content(message);
    let mut joined: string = "";
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            if types::part_type(part) == "text" {
                let text_part: string = types::request_string(part, "text");
                joined = joined + text_part;
            }
        }
        i += 1;
    }
    joined
}

fn responses_build_tools(tools: array) -> array<RespTool> {
    let mut wire: array<RespTool> = [];
    let mut i = 0;
    while i < tools.length {
        let tool: map = types::array_entry(tools, i);
        if tool.has("name") {
            let name: string = types::tool_name(tool);
            let description: string = types::tool_description(tool);
            // Official Responses tool shape: flat {type, name, description,
            // parameters} — NOT nested under a `function` key (that is the
            // Chat Completions shape).
            wire[wire.length] = {
                type: "function",
                name: name,
                description: description,
                parameters: tool_schema_marker(i)
            };
        }
        i += 1;
    }
    wire
}

/// Replaces each tool schema marker with the tool's raw schema JSON (indexed
/// marker, see rss/llm/openai_chat.rss).
fn responses_splice_tool_schemas(body: string, tools: array) -> string {
    let mut result: string = body;
    let mut i = 0;
    while i < tools.length {
        let tool: map = types::array_entry(tools, i);
        if tool.has("schema_json") {
            let schema_json: string = types::tool_schema_json(tool);
            result = string_replace_literal(
                result,
                "\"" + tool_schema_marker(i) + "\"",
                schema_json
            );
        }
        i += 1;
    }
    result
}

// ---------------------------------------------------------------------------
// Response parsing (buffered)
// ---------------------------------------------------------------------------

fn responses_parse_response(response: map, status: int) -> map {
    let body_bytes: bytes = response["body"];
    let body_text: string = bytes::to_utf8(body_bytes);
    let body: map = json::decode(body_text);
    let output: array = types::request_array(body, "output");
    let mut text: string = "";
    let mut reasoning: string = "";
    let mut calls: array = [];
    let mut i = 0;
    while i < output.length {
        let item: map = types::array_entry(output, i);
        let item_type: string = types::request_string(item, "type");
        if item_type == "message" {
            text = text + responses_output_text(item);
        }
        if item_type == "reasoning" {
            reasoning = reasoning + responses_reasoning_text(item);
        }
        if item_type == "function_call" {
            calls = responses_append_call(calls, item);
        }
        i += 1;
    }
    let usage: map = types::request_map(body, "usage");
    let usage_input: int = types::request_int(usage, "input_tokens", 0);
    let usage_output: int = types::request_int(usage, "output_tokens", 0);
    let usage_total: int = types::request_int(usage, "total_tokens", 0);
    let mut stop_reason: string = "stop";
    if calls.length > 0 {
        stop_reason = "tool_calls";
    }
    types::ok(types::response_new(
        text,
        calls,
        types::usage_new(usage_input, usage_output, usage_total),
        reasoning,
        stop_reason
    ))
}

/// Joins the `output_text` (and `text`) parts of a `message` output item.
fn responses_output_text(item: map) -> string {
    let content: array = types::request_array(item, "content");
    let mut joined: string = "";
    let mut i = 0;
    while i < content.length {
        let part: map = types::array_entry(content, i);
        let part_type: string = types::part_type(part);
        if part_type == "output_text" {
            joined = joined + types::request_string(part, "text");
        }
        if part_type == "text" {
            joined = joined + types::request_string(part, "text");
        }
        i += 1;
    }
    joined
}

/// Joins the `summary_text` parts of a `reasoning` output item.
fn responses_reasoning_text(item: map) -> string {
    let summary: array = types::request_array(item, "summary");
    let mut joined: string = "";
    let mut i = 0;
    while i < summary.length {
        let part: map = types::array_entry(summary, i);
        if types::part_type(part) == "summary_text" {
            joined = joined + types::request_string(part, "text");
        }
        i += 1;
    }
    joined
}

/// Appends one canonical tool call from a `function_call` output item. The
/// wire `call_id` maps to the canonical `id`; `arguments` is raw JSON text
/// decoded into a map.
fn responses_append_call(calls: array, item: map) -> array {
    let call_id: string = types::request_string(item, "call_id");
    let name: string = types::request_string(item, "name");
    let args_text: string = types::request_string(item, "arguments");
    let mut args: map = {};
    if args_text != "" {
        let decoded: map = json::decode(args_text);
        args = decoded;
    }
    let mut result: array = calls;
    result[result.length] = types::tool_call_new(call_id, name, args);
    result
}

fn responses_parse_error(response: map, status: int) -> map {
    let body_bytes: bytes = response["body"];
    let body_text: string = bytes::to_utf8(body_bytes);
    let payload: map = responses_error_payload(body_text);
    let mut error_type: string = "api_error";
    let mut code: string = "http_error";
    let mut message: string = "provider request failed";
    let mut param: string = "";
    let mut request_id: string = "";
    let payload_type: string = types::request_string(payload, "type");
    let payload_code: string = types::request_string(payload, "code");
    let payload_message: string = types::request_string(payload, "message");
    let payload_param: string = types::request_string(payload, "param");
    let payload_request_id: string = types::request_string(payload, "request_id");
    if payload_type != "" {
        error_type = payload_type;
    }
    if payload_code != "" {
        code = payload_code;
    }
    if payload_message != "" {
        message = payload_message;
    }
    if payload_param != "" {
        param = payload_param;
    }
    if payload_request_id != "" {
        request_id = payload_request_id;
    }
    types::fail(types::error_new(status, error_type, code, message, param, request_id))
}

/// Extracts the `error` object from a non-2xx JSON body.
fn responses_error_payload(body_text: string) -> map {
    let decoded: map = json::decode(body_text);
    if type(decoded) == "map" => {
        types::request_map(decoded, "error")
    } else => {
        {}
    }
}

// ---------------------------------------------------------------------------
// Streaming — http::client::sse with a shared-accumulator closure
// ---------------------------------------------------------------------------
//
// Aggregates Responses streaming events into canonical fields. The stream
// summary follows the same fail-closed contract as the chat adapter (A3
// review P2): a legal `[DONE]` stream must succeed, EOF without `[DONE]` must
// fail as a typed provider error.

fn openai_responses_stream_dispatch(request: map, profile: map) -> map {
    let base_url: string = types::profile_string(profile, "base_url");
    let api_key: string = types::profile_string(profile, "api_key");
    openai_responses_stream(request, base_url, api_key)
}

fn openai_responses_stream(request: map, base_url: string, api_key: string) -> map {
    let model: string = types::request_string(request, "model");
    if model == "" => {
        types::fail(types::error_request("missing_model", "request.model is required"))
    } else => {
        responses_send_stream(request, model, base_url, api_key)
    }
}

fn responses_send_stream(
    request: map,
    model: string,
    base_url: string,
    api_key: string
) -> map {
    let body_text: string = responses_encode_wire(request, model, true);
    let url: string = base_url + "/responses";
    let body: string = responses_splice_tool_schemas(
        body_text,
        types::request_array(request, "tools")
    );
    let mut text: string = "";
    let mut input_tokens: int = 0;
    let mut output_tokens: int = 0;
    let mut total_tokens: int = 0;
    let mut tools: array = [];
    let mut done = false;
    let mut completed = false;
    let stream_result: map = http::client::sse({
        method: "POST",
        url: url,
        headers: {
            "content-type": "application/json",
            "authorization": "Bearer " + api_key
        },
        body: body
    }, |item| if item["kind"] == "event" => {
        let data: string = item["data"].copy();
        if data == "[DONE]" => {
            done = true;
            { action: "stop" }
        } else => {
            let chunk: map = json::decode(data);
            let event_type: string = types::request_string(chunk, "type");
            if event_type == "response.output_text.delta" {
                let delta: string = types::request_string(chunk, "delta");
                if delta != "" {
                    text = text + delta;
                }
            }
            if event_type == "response.function_call_arguments.delta" {
                let output_index: int = types::request_int(chunk, "output_index", 0);
                let delta_args: string = types::request_string(chunk, "delta");
                tools = responses_stream_append_args(tools, output_index, delta_args);
            }
            if event_type == "response.output_item.done" {
                let item: map = types::request_map(chunk, "item");
                if types::request_string(item, "type") == "function_call" {
                    let output_index: int = types::request_int(chunk, "output_index", 0);
                    let call_id: string = types::request_string(item, "call_id");
                    let name: string = types::request_string(item, "name");
                    tools = responses_stream_set_call(tools, output_index, call_id, name);
                }
            }
            if event_type == "response.completed" {
                completed = true;
                let response_map: map = types::request_map(chunk, "response");
                let usage: map = types::request_map(response_map, "usage");
                input_tokens = types::request_int(usage, "input_tokens", 0);
                output_tokens = types::request_int(usage, "output_tokens", 0);
                total_tokens = types::request_int(usage, "total_tokens", 0);
            }
            { action: "continue" }
        }
    } else => {
        { action: "continue" }
    });
    let status: int = types::request_int(stream_result, "status", 0);
    let calls: array = responses_stream_parse_tool_calls(tools);
    // Fail-closed verdict: the SSE reader stops ONLY on the explicit
    // `data: [DONE]` branch (done=true); every other termination — EOF or
    // transport error — leaves done=false and must fail. A `[DONE]` that
    // arrived without the terminal response.completed event (bare [DONE])
    // is equally malformed. `done` with a non-stopped outcome is
    // unreachable (the only stop action is the [DONE] branch), so the
    // verdict reduces to done && completed.
    if !done => {
        types::fail(types::error_new(
            status,
            "api_error",
            "stream_eof_without_done",
            "provider stream ended without [DONE] terminator",
            "",
            ""
        ))
    } else if !completed => {
        // The [DONE] terminator arrived without the terminal
        // response.completed event: the stream is malformed and the partial
        // accumulation must not surface as a success (fail closed, same
        // contract as EOF-without-[DONE]).
        types::fail(types::error_new(
            status,
            "api_error",
            "stream_missing_completion",
            "provider stream ended without a response.completed event",
            "",
            ""
        ))
    } else => {
        let mut stop_reason: string = "stop";
        if calls.length > 0 {
            stop_reason = "tool_calls";
        }
        types::ok(types::response_new(
            text,
            calls,
            types::usage_new(input_tokens, output_tokens, total_tokens),
            "",
            stop_reason
        ))
    }
}

/// Appends one `function_call_arguments.delta` fragment to the accumulator
/// entry keyed by `output_index`, creating it if absent.
fn responses_stream_append_args(tools: array, output_index: int, fragment: string) -> array {
    let mut merged: array = tools;
    let mut found = false;
    let mut j = 0;
    while j < merged.length {
        let existing: map = types::array_entry(merged, j);
        if types::request_int(existing, "key", -1) == output_index {
            let mut updated: map = existing;
            updated["args"] = types::request_string(updated, "args") + fragment;
            merged[j] = updated;
            found = true;
        }
        j += 1;
    }
    if !found {
        merged[merged.length] = {
            key: output_index,
            id: "",
            name: "",
            args: fragment
        };
    }
    merged
}

/// Sets `id`/`name` on the accumulator entry keyed by `output_index` (from a
/// `function_call` item in `response.output_item.done`), creating it if absent.
fn responses_stream_set_call(tools: array, output_index: int, call_id: string, name: string) -> array {
    let mut merged: array = tools;
    let mut found = false;
    let mut j = 0;
    while j < merged.length {
        let existing: map = types::array_entry(merged, j);
        if types::request_int(existing, "key", -1) == output_index {
            let mut updated: map = existing;
            if call_id != "" {
                updated["id"] = call_id;
            }
            if name != "" {
                updated["name"] = name;
            }
            merged[j] = updated;
            found = true;
        }
        j += 1;
    }
    if !found {
        merged[merged.length] = {
            key: output_index,
            id: call_id,
            name: name,
            args: ""
        };
    }
    merged
}

/// Converts the streaming accumulator entries into canonical tool calls,
/// decoding each accumulated `arguments` JSON fragment.
fn responses_stream_parse_tool_calls(tools: array) -> array {
    let mut calls: array = [];
    let mut i = 0;
    while i < tools.length {
        let entry: map = types::array_entry(tools, i);
        let id: string = types::request_string(entry, "id");
        let name: string = types::request_string(entry, "name");
        let args_text: string = types::request_string(entry, "args");
        let mut args: map = {};
        if args_text != "" {
            let decoded: map = json::decode(args_text);
            args = decoded;
        }
        calls[calls.length] = types::tool_call_new(id, name, args);
        i += 1;
    }
    calls
}
