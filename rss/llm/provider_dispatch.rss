// Provider selection and host_home remain in this RSS VM.
// dispatch avoids the opaque entry's exported run name.
use auth;
use self::types as types;
use self::openai_opaque_chat::{run as opaque_chat_run};
use super::providers::profile as profile;
use super::providers::openrouter as openrouter;
use super::providers::deepseek as deepseek;
use super::providers::opencode_zen as opencode_zen;
use super::providers::opencode_go as opencode_go;
use super::providers::custom as custom;
use super::providers::opaque_responses as opaque_responses;

/// Public provider names that select the opaque OpenAI Chat entry. An empty
/// provider is the canonical default and maps to the same entry.
fn is_openai_provider(provider: string) -> bool {
    let mut selected = false;
    if provider == "" {
        selected = true;
    }
    if provider == "openai" {
        selected = true;
    }
    if provider == "openai_chat" {
        selected = true;
    }
    selected
}

/// Known profile aliases route through the same-context profile call, which
/// merges its public defaults and dispatches through admitted native auth.
/// Unknown providers keep the existing unavailable guard.
pub fn dispatch(context: map) -> map {
    let request: map = types::request_map(context, "request");
    let provider: string = types::request_string(request, "provider");
    let options: map = types::provider_options(request);
    let protocol: string = types::profile_string(options, "protocol");
    let result: map = if provider == "openai-codex" && protocol == "codex-responses" => {
        dispatch_codex_responses(context, request, options)
    } else if is_openai_provider(provider) => {
        dispatch_openai_request(context, request)
    } else if provider == "openrouter" => {
        openrouter::call(context)
    } else if provider == "deepseek" => {
        deepseek::call(context)
    } else if provider == "opencode_zen" => {
        opencode_zen::call(context)
    } else if provider == "opencode_go" => {
        opencode_go::call(context)
    } else if provider == "custom" => {
        custom::call(context)
    } else => {
        types::fail(types::error_request(
            "adapter_unavailable",
            "provider is unavailable for default opaque dispatch"
        ))
    };
    result
}

fn dispatch_codex_responses(context: map, request: map, profile: map) -> map {
    let credential_id: string = types::request_string(request, "credential_id");
    let home: resource<auth.host_home> = context["host_home"];
    let child: map = {
        request: request,
        profile: profile,
        credential_id: credential_id,
        host_home: home
    };
    opaque_responses::run_responses_stream(child)
}

fn dispatch_openai_request(context: map, request: map) -> map {
    let credential_id: string = types::request_string(request, "credential_id");
    if credential_id == "" => {
        types::fail(types::error_request(
            "missing_credential",
            "request.credential_id is required"
        ))
    } else => {
        dispatch_openai_chat(context, request, credential_id)
    }
}

/// Builds the private local context and hands it to the opaque Chat entry. The
/// child `AuthHost` is created natively inside that invocation; only this
/// in-VM context carries `host_home`.
fn dispatch_openai_chat(context: map, request: map, credential_id: string) -> map {
    let home: resource<auth.host_home> = context["host_home"];
    let profile: map = { provider: "openai" };
    let child: map = {
        request: request,
        profile: profile,
        credential_id: credential_id,
        host_home: home
    };
    opaque_chat_run(child)
}
