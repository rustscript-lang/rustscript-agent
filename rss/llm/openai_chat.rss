// OpenAI Chat Completions adapter (protocol mapping only; no agent loop).
//
// Maps the canonical LlmRequest (rss/llm/types.rss) onto the
// /chat/completions wire protocol and back. With core revision fd4b570 (B4),
// `json::encode` admits runtime string-key maps recursively, so the wire
// request is built as a runtime map and encoded directly — no marker-based
// splicing, and no struct-shaped placeholder layout. Tool schemas arrive as
// `schema_json` strings, are `json::decode`d into nested runtime maps, and
// are embedded in place; user message content parts are embedded as real
// arrays. A user text that equals any previous marker string survives
// byte-identical because it is a real string value, never re-interpreted as a
// marker.
//
// Compiler-contract notes for this adapter module (non-root module). Before
// core revision d8cf291 the emitted callable schemas were corrupted for a
// subset of call sites, and the notes below documented the worked-around
// layout. B1–B4 plus the residual parameter-liveness fix (fd4b570; see
// plans/2026-08-14_a3-rustscript-core-unblock.md) fixed the root causes;
// the layout workarounds below remain as the adapter's stable shape:
// - Script-function calls inside statement-if bodies were rejected by the
//   runtime callable-schema guard; call dispatch therefore uses
//   expression-if branches and top-level statements, and calls inside
//   `while` bodies (including nested statement-ifs) are safe.
// - Annotated locals whose initializer type the checker cannot prove (for
//   example `json::encode` results) live at function top level or in
//   helpers with declared return types, never in expression-if branches.
// - `bytes::to_utf8` requires a concretely typed argument, so the body is
//   read into an annotated `bytes` local first.
use json;
use bytes;
use http;
use self::types as types;

// ---------------------------------------------------------------------------
// Entry
// ---------------------------------------------------------------------------

pub fn openai_chat_call(request: map, profile: map) -> map {
    let stream: bool = types::request_bool(request, "stream", false);
    if stream => {
        openai_chat_stream_dispatch(request, profile)
    } else => {
        openai_chat_complete_dispatch(request, profile)
    }
}

/// Reads the profile fields (the only map read in this function) and hands
/// them to the transport as primitives. The parameter order is a retained
/// layout workaround (see the file header): `profile` (the read map) sits
/// second.
fn openai_chat_complete_dispatch(request: map, profile: map) -> map {
    let base_url: string = types::profile_string(profile, "base_url");
    let api_key: string = types::profile_string(profile, "api_key");
    let provider: string = types::profile_string(profile, "provider");
    let request = chat_apply_profile_token_field(request, profile);
    openai_chat_complete(request, base_url, api_key, provider)
}

fn openai_chat_complete(request: map, base_url: string, api_key: string, provider: string) -> map {
    let model: string = types::request_string(request, "model");
    if model == "" => {
        types::fail(types::error_request("missing_model", "request.model is required"))
    } else => {
        chat_send_complete(request, model, base_url, api_key, provider)
    }
}

fn chat_apply_profile_token_field(request: map, profile: map) -> map {
    let request_field: string = types::request_string(request, "max_output_tokens_field");
    let profile_field: string = types::profile_string(profile, "max_tokens_field");
    let mut enriched: map = request;
    if request_field == "" && profile_field != "" {
        enriched["max_output_tokens_field"] = profile_field;
    }
    enriched
}

/// The whole completion path: wire building and the buffered transport call.
/// Every script call here is at top level or in an expression-if branch
/// (statement-if bodies must not contain calls in this module; see the file
/// header).
fn chat_send_complete(
    request: map,
    model: string,
    base_url: string,
    api_key: string,
    provider: string
) -> map {
    let body: string = chat_encode_wire(request, model, false);
    let url: string = base_url + "/chat/completions";
    let response: map = http::client::request({
        method: "POST",
        url: url,
        headers: {
            "content-type": "application/json",
            "authorization": "Bearer " + api_key
        },
        body: body
    });
    let status: int = response["status"].copy();
    if status >= 200 && status < 300 => {
        chat_parse_response(response, status, provider)
    } else => {
        chat_parse_error(response, status)
    }
}

// ---------------------------------------------------------------------------
// Wire request building
// ---------------------------------------------------------------------------
//
// The wire request is built as a runtime string-key map and encoded with a
// single `json::encode` call (core revision fd4b570 / B4 admits runtime maps
// recursively). No struct-shaped placeholders and no marker-based splicing:
// tool `parameters` are `json::decode`d schema maps embedded in place, and
// user message `content` parts are embedded as real arrays.

/// Encodes the wire request map as JSON. `json::encode`'s return type is
/// unknown to the type checker, so the annotated local lives here with a
/// declared `string` return.
fn chat_encode_wire(request: map, model: string, stream: bool) -> string {
    let body_text: string = json::encode(chat_build_wire(request, model, stream));
    body_text
}

fn chat_build_wire(request: map, model: string, stream: bool) -> map {
    let messages: array = chat_build_messages(types::request_array(request, "messages"));
    let tools: array = chat_build_tools(types::request_array(request, "tools"));
    let tool_choice: string = types::request_string(request, "tool_choice");
    let reasoning: string = types::request_string(request, "reasoning");
    let sampling: map = types::request_map(request, "sampling");
    let temperature_raw: map = types::sampling_float(sampling, "temperature");
    let top_p_raw: map = types::sampling_float(sampling, "top_p");
    let temperature_present: bool = temperature_raw["present"];
    let temperature_value: float = temperature_raw["value"];
    let top_p_present: bool = top_p_raw["present"];
    let top_p_value: float = top_p_raw["value"];
    let max_output: int = types::request_int(request, "max_output_tokens", 0);
    let mut max_output_field: string = types::request_string(request, "max_output_tokens_field");
    if max_output_field == "" {
        max_output_field = "max_tokens";
    }
    if max_output_field != "max_completion_tokens" {
        max_output_field = "max_tokens";
    }
    let mut wire: map = {
        model: model,
        messages: messages,
        stream: stream
    };
    if tools.length > 0 {
        wire["tools"] = tools;
    }
    if tool_choice != "" {
        wire["tool_choice"] = tool_choice;
    }
    if temperature_present {
        wire["temperature"] = temperature_value;
    }
    if top_p_present {
        wire["top_p"] = top_p_value;
    }
    if max_output > 0 {
        wire[max_output_field] = max_output;
    }
    if stream {
        wire["stream_options"] = { include_usage: true };
    }
    if reasoning != "" {
        wire["reasoning_effort"] = reasoning;
    }
    wire
}

/// Converts canonical messages into wire messages. User `tool_result` parts
/// become dedicated `tool` role messages; assistant `tool_call` parts become
/// assistant `tool_calls`.
fn chat_build_messages(messages: array) -> array {
    let mut wire: array = [];
    let mut i = 0;
    while i < messages.length {
        let message: map = types::array_entry(messages, i);
        if message.has("role") {
            wire = chat_append_message_by_role(wire, message);
        }
        i += 1;
    }
    wire
}

fn chat_append_message_by_role(wire: array, message: map) -> array {
    let role: string = types::message_role(message);
    if role == "user" => {
        chat_append_user_message(wire, message)
    } else if role == "tool" => {
        // The canonical `tool` message the serial loop appends carries one
        // `tool_result` part per executed call; the OpenAI wire convention
        // renders it as one dedicated `tool` role message per part (the
        // user-message path already builds exactly that shape).
        chat_append_user_message(wire, message)
    } else if role == "assistant" => {
        chat_append_assistant_message(wire, message)
    } else => {
        chat_append_simple_message(wire, role, message)
    }
}

/// Appends one `user` message (only when it carries text parts; the wire
/// `content` holds the real parts array) plus one `tool` message per
/// tool_result part.
fn chat_append_user_message(wire: array, message: map) -> array {
    let parts: array = types::message_content(message);
    let mut result: array = wire;
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            if types::part_type(part) == "tool_result" {
                let tool_call_id: string = types::request_string(part, "tool_call_id");
                let content: string = types::request_string(part, "content");
                result[result.length] = {
                    role: "tool",
                    content: content,
                    tool_call_id: tool_call_id
                };
            }
        }
        i += 1;
    }
    let text_parts: array = chat_user_text_parts(message);
    if text_parts.length > 0 {
        result[result.length] = {
            role: "user",
            content: text_parts
        };
    }
    result
}

/// The `[{type: "text", text}]` parts of one canonical user message.
fn chat_user_text_parts(message: map) -> array {
    let parts: array = types::message_content(message);
    let mut text_parts: array = [];
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            if types::part_type(part) == "text" {
                let text: string = types::request_string(part, "text");
                text_parts[text_parts.length] = { type: "text", text: text };
            }
        }
        i += 1;
    }
    text_parts
}

/// Appends one `assistant` message with text content and/or tool_calls.
fn chat_append_assistant_message(wire: array, message: map) -> array {
    let parts: array = types::message_content(message);
    let mut text: string = "";
    let mut tool_calls: array = [];
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            let part_type: string = types::part_type(part);
            if part_type == "text" {
                let text_part: string = types::request_string(part, "text");
                text = text + text_part;
            }
            if part_type == "tool_call" {
                let id: string = types::request_string(part, "tool_call_id");
                let name: string = types::request_string(part, "name");
                let arguments_json: string = types::request_string(part, "arguments_json");
                tool_calls[tool_calls.length] = {
                    id: id,
                    type: "function",
                    function: { name: name, arguments: arguments_json }
                };
            }
        }
        i += 1;
    }
    let mut wire_message: map = { role: "assistant" };
    if text != "" {
        wire_message["content"] = text;
    }
    if tool_calls.length > 0 {
        wire_message["tool_calls"] = tool_calls;
    }
    let mut result: array = wire;
    result[result.length] = wire_message;
    result
}

fn chat_append_simple_message(wire: array, role: string, message: map) -> array {
    let parts: array = types::message_content(message);
    let mut text: string = "";
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            if types::part_type(part) == "text" {
                let text_part: string = types::request_string(part, "text");
                text = text + text_part;
            }
        }
        i += 1;
    }
    let mut result: array = wire;
    result[result.length] = { role: role, content: text };
    result
}

fn chat_build_tools(tools: array) -> array {
    let mut wire: array = [];
    let mut i = 0;
    while i < tools.length {
        let tool: map = types::array_entry(tools, i);
        if tool.has("name") {
            let name: string = types::tool_name(tool);
            let description: string = types::tool_description(tool);
            let schema_json: string = types::tool_schema_json(tool);
            let mut parameters: map = {};
            if schema_json != "" {
                let decoded: map = json::decode(schema_json);
                parameters = decoded;
            }
            wire[wire.length] = {
                type: "function",
                function: {
                    name: name,
                    description: description,
                    parameters: parameters
                }
            };
        }
        i += 1;
    }
    wire
}

// ---------------------------------------------------------------------------
// Response parsing
// ---------------------------------------------------------------------------

fn chat_parse_response(response: map, status: int, provider: string) -> map {
    let body_bytes: bytes = response["body"];
    let body_text: string = bytes::to_utf8(body_bytes);
    let body: map = json::decode(body_text);
    chat_parse_response_body(body, status, provider)
}

fn chat_parse_response_body(body: map, status: int, provider: string) -> map {
    let choices: array = types::request_array(body, "choices");
    if choices.length > 0 => {
        chat_parse_first_choice(choices, body, status, provider)
    } else => {
        types::fail(types::error_malformed(
            status,
            "chat completion response is missing 'choices'"
        ))
    }
}

fn chat_parse_first_choice(choices: array, body: map, status: int, provider: string) -> map {
    let first: map = types::array_entry(choices, 0);
    let stop_reason: string = types::request_string(first, "finish_reason");
    let usage: map = types::request_map(body, "usage");
    let usage_input: int = types::request_int(usage, "prompt_tokens", 0);
    let usage_output: int = types::request_int(usage, "completion_tokens", 0);
    let usage_total: int = types::request_int(usage, "total_tokens", 0);
    let message: map = types::request_map(first, "message");
    let result: map = if first.has("message") => {
        let tool_calls: array = types::request_array(message, "tool_calls");
        chat_parse_message(
            message,
            stop_reason,
            usage_input,
            usage_output,
            usage_total,
            tool_calls,
            provider
        )
    } else => {
        types::fail(types::error_malformed(
            status,
            "chat completion response is missing 'choices[0].message'"
        ))
    };
    result
}

fn chat_parse_message(
    message: map,
    stop_reason: string,
    usage_input: int,
    usage_output: int,
    usage_total: int,
    tool_calls: array,
    provider: string
) -> map {
    let content: string = chat_message_text(message);
    let reasoning: string = types::request_string(message, "reasoning_content");
    let calls: array = chat_parse_tool_calls(tool_calls);
    types::ok(types::response_new(
        content,
        calls,
        types::usage_new(usage_input, usage_output, usage_total),
        reasoning,
        stop_reason
    ))
}

/// Reads `message.content` in either standard wire shape: a plain string
/// (chat completions) or an array of `{type, text}` parts (Responses,
/// Anthropic-style transcripts). Part arrays are joined over their text-ish
/// parts (`text`/`output_text`).
fn chat_message_text(message: map) -> string {
    let direct: string = types::request_string(message, "content");
    let mut text: string = direct;
    if type(message["content"]) == "array" {
        let parts: array = message["content"];
        let mut joined: string = "";
        let mut i = 0;
        while i < parts.length {
            let part: map = types::array_entry(parts, i);
            let part_type: string = types::part_type(part);
            if part_type == "text" {
                joined = joined + types::request_string(part, "text");
            }
            if part_type == "output_text" {
                joined = joined + types::request_string(part, "text");
            }
            i += 1;
        }
        text = joined;
    }
    text
}

fn chat_parse_tool_calls(tool_calls: array) -> array {
    let mut calls: array = [];
    let mut i = 0;
    while i < tool_calls.length {
        let call: map = types::array_entry(tool_calls, i);
        if call.has("id") {
            let id: string = types::request_string(call, "id");
            let function: map = types::request_map(call, "function");
            let name: string = types::request_string(function, "name");
            let args_text: string = types::request_string(function, "arguments");
            let mut args: map = {};
            if args_text != "" {
                let decoded: map = json::decode(args_text);
                args = decoded;
            }
            calls[calls.length] = types::tool_call_new(id, name, args);
        }
        i += 1;
    }
    calls
}

fn chat_parse_error(response: map, status: int) -> map {
    let body_bytes: bytes = response["body"];
    let body_text: string = bytes::to_utf8(body_bytes);
    let payload: map = chat_error_payload(body_text);
    let mut error_type: string = "api_error";
    let mut code: string = "http_error";
    let mut message: string = "provider request failed";
    let mut param: string = "";
    let mut request_id: string = "";
    let payload_type: string = types::request_string(payload, "type");
    let payload_code: string = types::request_string(payload, "code");
    let payload_message: string = types::request_string(payload, "message");
    let payload_param: string = types::request_string(payload, "param");
    let payload_request_id: string = types::request_string(payload, "request_id");
    if payload_type != "" {
        error_type = payload_type;
    }
    if payload_code != "" {
        code = payload_code;
    }
    if payload_message != "" {
        message = payload_message;
    }
    if payload_param != "" {
        param = payload_param;
    }
    if payload_request_id != "" {
        request_id = payload_request_id;
    }
    types::fail(types::error_new(status, error_type, code, message, param, request_id))
}

/// Extracts the `error` object from a non-2xx JSON body. A structurally
/// invalid body yields an empty map and the caller falls back to the default
/// `api_error`/`http_error` shape; a body that is not JSON at all fails the
/// invocation (the same contract as `chat_parse_response`).
fn chat_error_payload(body_text: string) -> map {
    let decoded: map = json::decode(body_text);
    if type(decoded) == "map" => {
        types::request_map(decoded, "error")
    } else => {
        {}
    }
}

// ---------------------------------------------------------------------------
// Streaming — http::client::sse with a shared-accumulator closure
// ---------------------------------------------------------------------------
//
// Consumes core revision fd4b570 (B1–B4 plus the §11a parameter-liveness
// fix): the callable-schema fix (B1), the shared mutable closure capture
// fix (B3), and the parameter-slot liveness fix (fd4b570) make the SSE
// delta-aggregation pattern expressible and the module graph pass the VM
// callable-schema guard. The callback closure mutates captured accumulator
// locals (`text`, `stop_reason`, usage counters, `tools`) through BorrowMut
// capture cells; after the stream completes the same locals are read to
// build the canonical response. `http::client::sse` is exposed in the
// restricted registry (see `src/runtime/rss_runner.rs`).
//
// The transport validates status and Content-Type itself: a non-2xx SSE
// response fails the invocation as a typed host error, so the summary map
// is not inspected for transport-level failures.
//
// Fail-closed contract (A3 review P2): the stream summary map carries
// `outcome` — `"stopped"` when the callback returned `{action: "stop"}`
// (the `[DONE]` terminator path) and `"eof"` when the server closed the
// body without a stop (the callback sees the transport terminal
// `kind: "end"` item and continues). A legal `[DONE]` stream must succeed,
// so the shared `done` accumulator is set exactly where the callback
// stops; EOF without `[DONE]` — partial text included — must fail closed
// as a typed provider error instead of surfacing the partial accumulation
// as `ok`. Cancellation never reaches this check: it fails the invocation
// as a typed `Cancelled` error before the summary exists.

fn chat_utf8_bytes(text: string) -> int {
    let encoded: bytes = bytes::from_utf8(text);
    encoded.length
}

fn openai_chat_stream_dispatch(request: map, profile: map) -> map {
    let base_url: string = types::profile_string(profile, "base_url");
    let api_key: string = types::profile_string(profile, "api_key");
    let provider: string = types::profile_string(profile, "provider");
    let request = chat_apply_profile_token_field(request, profile);
    openai_chat_stream(request, base_url, api_key, provider)
}

fn openai_chat_stream(request: map, base_url: string, api_key: string, provider: string) -> map {
    let model: string = types::request_string(request, "model");
    if model == "" => {
        types::fail(types::error_request("missing_model", "request.model is required"))
    } else => {
        chat_send_stream(request, model, base_url, api_key, provider)
    }
}

/// The whole streaming path: wire building (same runtime-map encode as the
/// buffered path, with `stream: true` + `stream_options.include_usage`), the SSE
/// transport with the accumulator closure, and canonical response
/// construction from the accumulated locals.
fn chat_send_stream(
    request: map,
    model: string,
    base_url: string,
    api_key: string,
    provider: string
) -> map {
    let body: string = chat_encode_wire(request, model, true);
    let url: string = base_url + "/chat/completions";
    let mut text: string = "";
    let mut stop_reason: string = "";
    let mut input_tokens: int = 0;
    let mut output_tokens: int = 0;
    let mut total_tokens: int = 0;
    let mut output_bytes: int = 0;
    let mut output_overflow: bool = false;
    let mut tools: array = [];
    let mut done = false;
    let stream_result: map = http::client::sse({
        method: "POST",
        url: url,
        headers: {
            "content-type": "application/json",
            "authorization": "Bearer " + api_key
        },
        body: body
    }, |item| if item["kind"] == "event" => {
        let data: string = item["data"].copy();
        if data == "[DONE]" => {
            done = true;
            { action: "stop" }
        } else => {
            let chunk: map = json::decode(data);
            let choices: array = types::request_array(chunk, "choices");
            if choices.length > 0 => {
                let choice: map = types::array_entry(choices, 0);
                let delta: map = types::request_map(choice, "delta");
                let content: string = types::request_string(delta, "content");
                let content_bytes: int = chat_utf8_bytes(content);
                if output_bytes + content_bytes > 1048576 => {
                    output_overflow = true;
                    0
                } else if content != "" => {
                    text = text + content;
                    output_bytes = output_bytes + content_bytes;
                    0
                } else => {
                    0
                };
                let reason: string = types::request_string(choice, "finish_reason");
                if reason != "" {
                    stop_reason = reason;
                }
                let call_deltas: array = types::request_array(delta, "tool_calls");
                if call_deltas.length > 0 {
                    tools = chat_stream_merge_tool_calls(tools, call_deltas);
                }
                { action: "continue" }
            } else => {
                let usage: map = types::request_map(chunk, "usage");
                if usage.has("total_tokens") {
                    input_tokens = types::request_int(usage, "prompt_tokens", 0);
                    output_tokens = types::request_int(usage, "completion_tokens", 0);
                    total_tokens = types::request_int(usage, "total_tokens", 0);
                }
                { action: "continue" }
            }
        }
    } else => {
        { action: "continue" }
    });
    let outcome: string = types::request_string(stream_result, "outcome");
    let status: int = types::request_int(stream_result, "status", 0);
    if output_overflow => {
        types::fail(types::error_new(
            status,
            "api_error",
            "output_too_large",
            "assistant output exceeds the 1048576 UTF-8 byte durable bound",
            "",
            ""
        ))
    } else if done && outcome == "stopped" => {
        types::ok(types::response_new(
            text,
            chat_stream_parse_tool_calls(tools),
            types::usage_new(input_tokens, output_tokens, total_tokens),
            "",
            stop_reason
        ))
    } else => {
        types::fail(types::error_new(
            status,
            "api_error",
            "stream_eof_without_done",
            "provider stream ended without [DONE] terminator",
            "",
            ""
        ))
    }
}

/// Merges one chunk's tool-call deltas into the accumulator list. Each entry
/// is `{index, id, name, args}`; a delta whose `index` already exists fills
/// missing `id`/`name` and appends its `arguments` fragment to `args`.
/// Returns a new array (the caller assigns the result back to the captured
/// accumulator).
fn chat_stream_merge_tool_calls(tools: array, deltas: array) -> array {
    let mut merged: array = tools;
    let mut i = 0;
    while i < deltas.length {
        let delta: map = types::array_entry(deltas, i);
        let index: int = types::request_int(delta, "index", -1);
        let id: string = types::request_string(delta, "id");
        // The OpenAI wire places the tool-call name inside the nested
        // `function` object (`function.name`); there is no top-level
        // `name` field on the delta.
        let function: map = types::request_map(delta, "function");
        let name: string = types::request_string(function, "name");
        let fragment: string = types::request_string(function, "arguments");
        let mut found = false;
        let mut j = 0;
        while j < merged.length {
            let existing: map = types::array_entry(merged, j);
            if types::request_int(existing, "index", -1) == index {
                let mut updated: map = existing;
                if id != "" {
                    updated["id"] = id;
                }
                if name != "" {
                    updated["name"] = name;
                }
                if fragment != "" {
                    updated["args"] = types::request_string(updated, "args") + fragment;
                }
                merged[j] = updated;
                found = true;
            }
            j += 1;
        }
        if !found {
            merged[merged.length] = {
                index: index,
                id: id,
                name: name,
                args: fragment
            };
        }
        i += 1;
    }
    merged
}

/// Converts the accumulator entries into canonical `{id, name, arguments}`
/// tool calls, decoding each accumulated `arguments` JSON fragment.
fn chat_stream_parse_tool_calls(tools: array) -> array {
    let mut calls: array = [];
    let mut i = 0;
    while i < tools.length {
        let entry: map = types::array_entry(tools, i);
        let id: string = types::request_string(entry, "id");
        let name: string = types::request_string(entry, "name");
        let args_text: string = types::request_string(entry, "args");
        let mut args: map = {};
        if args_text != "" {
            let decoded: map = json::decode(args_text);
            args = decoded;
        }
        calls[calls.length] = types::tool_call_new(id, name, args);
        i += 1;
    }
    calls
}
