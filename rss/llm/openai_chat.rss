// OpenAI Chat Completions helpers (public body builders and response parsers;
// no transport, no agent loop).
//
// Maps the canonical LlmRequest (rss/llm/types.rss) onto the
// /chat/completions wire protocol and back. Tool schemas arrive as
// `schema_json` strings and are spliced into the encoded wire body because
// RustScript's json::encode only accepts struct-shaped values (generic maps
// are rejected by the type checker). Each tool and user message gets its own
// indexed literal marker (`__RSS_TOOL_SCHEMA_<i>__`,
// `__RSS_USER_PARTS_<i>__`), replaced by string_replace_literal (which
// replaces ALL occurrences — see the plan's P3 marker note for the collision
// surface).
//
// Compiler-contract notes for this adapter module (non-root module). Before
// core revision d8cf291 the emitted callable schemas were corrupted for a
// subset of call sites, and the notes below documented the worked-around
// layout. B1–B4 plus the residual parameter-liveness fix (fd4b570; see
// plans/2026-08-14_a3-rustscript-core-unblock.md) fixed the root causes;
// the layout workarounds below remain as the adapter's stable shape:
// - Script-function calls inside statement-if bodies were rejected by the
//   runtime callable-schema guard; call dispatch therefore uses
//   expression-if branches and top-level statements, and calls inside
//   `while` bodies (including nested statement-ifs) are safe.
// - Annotated locals whose initializer type the checker cannot prove (for
//   example `json::encode` results) live at function top level or in
//   helpers with declared return types, never in expression-if branches.
use json;
use self::types as types;

struct WireTextPart {
    type: string,
    text: string
}

struct WireFunction {
    name: string,
    description: string,
    parameters: string
}

struct WireTool {
    type: string,
    function: WireFunction
}

struct WireFunctionCall {
    name: string,
    arguments: string
}

struct WireToolCall {
    id: string,
    type: string,
    function: WireFunctionCall
}

struct WireMessage {
    role: string,
    content: string?,
    tool_call_id: string?,
    tool_calls: array<WireToolCall>?
}

struct WireStreamOptions {
    include_usage: bool
}

struct WireRequest {
    model: string,
    messages: array<WireMessage>,
    tools: array<WireTool>?,
    tool_choice: string?,
    temperature: float?,
    top_p: float?,
    max_tokens: int?,
    stream: bool,
    stream_options: WireStreamOptions?,
    reasoning_effort: string?
}

/// Marker for one tool's raw schema. The encoded body carries the marker as
/// the tool's `parameters` string and `chat_splice_tool_schemas` replaces it
/// with the raw schema JSON (spliced because json::encode only accepts
/// struct-shaped values). The marker is per-tool INDEXED: a shared marker
/// would make every replace pass hit every tool's placeholder, so with two or
/// more tools all schemas would collapse to the first tool's.
fn tool_schema_marker(index: int) -> string {
    let encoded: string = json::encode(index);
    "__RSS_TOOL_SCHEMA_" + encoded + "__"
}

/// Marker for one user message's text parts. The encoded body carries the
/// marker as the message's `content` string and `chat_splice_user_parts`
/// replaces it with the raw JSON parts array (same splice mechanism as tool
/// schemas), producing the standard `"content": [{"type":"text",...}]` wire
/// shape.
fn user_parts_marker(index: int) -> string {
    let encoded: string = json::encode(index);
    "__RSS_USER_PARTS_" + encoded + "__"
}

// ---------------------------------------------------------------------------
// Wire request building
// ---------------------------------------------------------------------------

/// Encodes the wire request struct as JSON. `json::encode`'s return type is
/// unknown to the type checker, so the annotated local lives here with a
/// declared `string` return.
fn chat_encode_wire(request: map, model: string, stream: bool) -> string {
    let body_text: string = json::encode(chat_build_wire(request, model, stream));
    body_text
}

pub fn chat_build_public_body(request: map, model: string) -> string {
    let body_text: string = chat_encode_wire(request, model, false);
    let with_user_parts: string = chat_splice_user_parts(
        body_text,
        types::request_array(request, "messages")
    );
    chat_splice_tool_schemas(with_user_parts, types::request_array(request, "tools"))
}

/// Public streaming body: identical to the buffered builder except the wire
/// request encodes `stream: true` with `stream_options.include_usage`. Shares
/// the same marker-splice helpers and user/tool content semantics, and carries
/// no URL, header, key, or credential argument.
pub fn chat_build_public_stream_body(request: map, model: string) -> string {
    let body_text: string = chat_encode_wire(request, model, true);
    let with_user_parts: string = chat_splice_user_parts(
        body_text,
        types::request_array(request, "messages")
    );
    chat_splice_tool_schemas(with_user_parts, types::request_array(request, "tools"))
}

fn chat_build_wire(request: map, model: string, stream: bool) -> WireRequest {
    let messages: array<WireMessage> = chat_build_messages(
        types::request_array(request, "messages")
    );
    let tools: array<WireTool> = chat_build_tools(types::request_array(request, "tools"));
    let mut wire_tools: array<WireTool>? = null;
    if tools.length > 0 {
        wire_tools = tools;
    }
    let tool_choice: string = types::request_string(request, "tool_choice");
    let mut wire_tool_choice: string? = null;
    if tool_choice != "" {
        wire_tool_choice = tool_choice;
    }
    let reasoning: string = types::request_string(request, "reasoning");
    let sampling: map = types::request_map(request, "sampling");
    let temperature_raw: map = types::sampling_float(sampling, "temperature");
    let top_p_raw: map = types::sampling_float(sampling, "top_p");
    let temperature_present: bool = temperature_raw["present"];
    let temperature_value: float = temperature_raw["value"];
    let top_p_present: bool = top_p_raw["present"];
    let top_p_value: float = top_p_raw["value"];
    let max_output: int = types::request_int(request, "max_output_tokens", 0);
    let mut temperature: float? = null;
    let mut top_p: float? = null;
    let mut max_tokens: int? = null;
    let mut stream_options: WireStreamOptions? = null;
    let mut reasoning_effort: string? = null;
    if temperature_present {
        temperature = temperature_value;
    }
    if top_p_present {
        top_p = top_p_value;
    }
    if max_output > 0 {
        max_tokens = max_output;
    }
    if stream {
        stream_options = { include_usage: true };
    }
    if reasoning != "" {
        reasoning_effort = reasoning;
    }
    {
        model: model,
        messages: messages,
        tools: wire_tools,
        tool_choice: wire_tool_choice,
        temperature: temperature,
        top_p: top_p,
        max_tokens: max_tokens,
        stream: stream,
        stream_options: stream_options,
        reasoning_effort: reasoning_effort
    }
}

/// Converts canonical messages into wire messages. User `tool_result` parts
/// become dedicated `tool` role messages; assistant `tool_call` parts become
/// assistant `tool_calls`.
fn chat_build_messages(messages: array) -> array<WireMessage> {
    let mut wire: array<WireMessage> = [];
    let mut i = 0;
    while i < messages.length {
        let message: map = types::array_entry(messages, i);
        if message.has("role") {
            wire = chat_append_message_by_role(wire, message, i);
        }
        i += 1;
    }
    wire
}

fn chat_append_message_by_role(wire: array<WireMessage>, message: map, index: int) -> array<WireMessage> {
    let role: string = types::message_role(message);
    if role == "user" => {
        chat_append_user_message(wire, message, index)
    } else if role == "assistant" => {
        chat_append_assistant_message(wire, message)
    } else => {
        chat_append_simple_message(wire, role, message)
    }
}

/// Appends one `user` message (only when it carries text parts; the wire
/// `content` holds a marker that `chat_splice_user_parts` replaces with the
/// standard parts array) plus one `tool` message per tool_result part.
fn chat_append_user_message(wire: array<WireMessage>, message: map, index: int) -> array<WireMessage> {
    let parts: array = types::message_content(message);
    let mut result: array<WireMessage> = wire;
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            if types::part_type(part) == "tool_result" {
                let tool_call_id: string = types::request_string(part, "tool_call_id");
                let content: string = types::request_string(part, "content");
                result[result.length] = {
                    role: "tool",
                    content: content,
                    tool_call_id: tool_call_id,
                    tool_calls: null
                };
            }
        }
        i += 1;
    }
    let text_parts: array<WireTextPart> = chat_user_text_parts(message);
    if text_parts.length > 0 {
        result[result.length] = {
            role: "user",
            content: user_parts_marker(index),
            tool_call_id: null,
            tool_calls: null
        };
    }
    result
}

/// The `[{type: "text", text}]` parts of one canonical user message.
fn chat_user_text_parts(message: map) -> array<WireTextPart> {
    let parts: array = types::message_content(message);
    let mut text_parts: array<WireTextPart> = [];
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            if types::part_type(part) == "text" {
                let text: string = types::request_string(part, "text");
                text_parts[text_parts.length] = { type: "text", text: text };
            }
        }
        i += 1;
    }
    text_parts
}

/// Appends one `assistant` message with text content and/or tool_calls.
fn chat_append_assistant_message(wire: array<WireMessage>, message: map) -> array<WireMessage> {
    let parts: array = types::message_content(message);
    let mut text: string = "";
    let mut tool_calls: array<WireToolCall> = [];
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            let part_type: string = types::part_type(part);
            if part_type == "text" {
                let text_part: string = types::request_string(part, "text");
                text = text + text_part;
            }
            if part_type == "tool_call" {
                let id: string = types::request_string(part, "tool_call_id");
                let name: string = types::request_string(part, "name");
                let arguments_json: string = types::request_string(part, "arguments_json");
                tool_calls[tool_calls.length] = {
                    id: id,
                    type: "function",
                    function: { name: name, arguments: arguments_json }
                };
            }
        }
        i += 1;
    }
    let mut content: string? = null;
    if text != "" {
        content = text;
    }
    let mut wire_calls: array<WireToolCall>? = null;
    if tool_calls.length > 0 {
        wire_calls = tool_calls;
    }
    let mut result: array<WireMessage> = wire;
    result[result.length] = {
        role: "assistant",
        content: content,
        tool_call_id: null,
        tool_calls: wire_calls
    };
    result
}

fn chat_append_simple_message(wire: array<WireMessage>, role: string, message: map) -> array<WireMessage> {
    let parts: array = types::message_content(message);
    let mut text: string = "";
    let mut i = 0;
    while i < parts.length {
        let part: map = types::array_entry(parts, i);
        if part.has("type") {
            if types::part_type(part) == "text" {
                let text_part: string = types::request_string(part, "text");
                text = text + text_part;
            }
        }
        i += 1;
    }
    let mut result: array<WireMessage> = wire;
    result[result.length] = {
        role: role,
        content: text,
        tool_call_id: null,
        tool_calls: null
    };
    result
}

fn chat_build_tools(tools: array) -> array<WireTool> {
    let mut wire: array<WireTool> = [];
    let mut i = 0;
    while i < tools.length {
        let tool: map = types::array_entry(tools, i);
        if tool.has("name") {
            let name: string = types::tool_name(tool);
            let description: string = types::tool_description(tool);
            wire[wire.length] = {
                type: "function",
                function: {
                    name: name,
                    description: description,
                    parameters: tool_schema_marker(i)
                }
            };
        }
        i += 1;
    }
    wire
}

/// Replaces each tool schema marker with the tool's raw schema JSON. The
/// marker is unique per tool (indexed), so each replace pass touches exactly
/// one placeholder — a shared marker would collapse every tool's schema to
/// the first tool's.
fn chat_splice_tool_schemas(body: string, tools: array) -> string {
    let mut result: string = body;
    let mut i = 0;
    while i < tools.length {
        let tool: map = types::array_entry(tools, i);
        if tool.has("schema_json") {
            let schema_json: string = types::tool_schema_json(tool);
            result = string_replace_literal(
                result,
                "\"" + tool_schema_marker(i) + "\"",
                schema_json
            );
        }
        i += 1;
    }
    result
}

/// Replaces each user-parts marker (`__RSS_USER_PARTS_<index>__`, with the
/// surrounding quotes) with the JSON-encoded `[{type: "text", text}]` array,
/// so user messages carry the standard OpenAI content-parts wire shape.
/// The marker index is the canonical message position, matching
/// `chat_append_user_message`'s marker assignment.
fn chat_splice_user_parts(body: string, messages: array) -> string {
    let mut result: string = body;
    let mut i = 0;
    while i < messages.length {
        let message: map = types::array_entry(messages, i);
        if message.has("role") {
            if types::message_role(message) == "user" {
                let text_parts: array<WireTextPart> = chat_user_text_parts(message);
                if text_parts.length > 0 {
                    let encoded: string = json::encode(text_parts);
                    result = string_replace_literal(
                        result,
                        "\"" + user_parts_marker(i) + "\"",
                        encoded
                    );
                }
            }
        }
        i += 1;
    }
    result
}

// ---------------------------------------------------------------------------
// Response parsing
// ---------------------------------------------------------------------------


pub fn chat_parse_public_response(body_text: string, status: int, provider: string) -> map {
    let body: map = json::decode(body_text);
    chat_parse_response_body(body, status, provider)
}

fn chat_parse_response_body(body: map, status: int, provider: string) -> map {
    let choices: array = types::request_array(body, "choices");
    if choices.length > 0 => {
        chat_parse_first_choice(choices, body, status, provider)
    } else => {
        types::fail(types::error_malformed(
            status,
            "chat completion response is missing 'choices'"
        ))
    }
}

fn chat_parse_first_choice(choices: array, body: map, status: int, provider: string) -> map {
    let first: map = types::array_entry(choices, 0);
    let stop_reason: string = types::request_string(first, "finish_reason");
    let usage: map = types::request_map(body, "usage");
    let usage_input: int = types::request_int(usage, "prompt_tokens", 0);
    let usage_output: int = types::request_int(usage, "completion_tokens", 0);
    let usage_total: int = types::request_int(usage, "total_tokens", 0);
    let message: map = types::request_map(first, "message");
    let result: map = if first.has("message") => {
        let tool_calls: array = types::request_array(message, "tool_calls");
        chat_parse_message(
            message,
            stop_reason,
            usage_input,
            usage_output,
            usage_total,
            tool_calls,
            provider
        )
    } else => {
        types::fail(types::error_malformed(
            status,
            "chat completion response is missing 'choices[0].message'"
        ))
    };
    result
}

fn chat_parse_message(
    message: map,
    stop_reason: string,
    usage_input: int,
    usage_output: int,
    usage_total: int,
    tool_calls: array,
    provider: string
) -> map {
    let content: string = chat_message_text(message);
    let reasoning: string = types::request_string(message, "reasoning_content");
    let calls: array = chat_parse_tool_calls(tool_calls);
    types::ok(types::response_new(
        content,
        calls,
        types::usage_new(usage_input, usage_output, usage_total),
        reasoning,
        stop_reason
    ))
}

/// Reads `message.content` in either standard wire shape: a plain string
/// (chat completions) or an array of `{type, text}` parts (Responses,
/// Anthropic-style transcripts). Part arrays are joined over their text-ish
/// parts (`text`/`output_text`).
fn chat_message_text(message: map) -> string {
    let direct: string = types::request_string(message, "content");
    let mut text: string = direct;
    if type(message["content"]) == "array" {
        let parts: array = message["content"];
        let mut joined: string = "";
        let mut i = 0;
        while i < parts.length {
            let part: map = types::array_entry(parts, i);
            let part_type: string = types::part_type(part);
            if part_type == "text" {
                joined = joined + types::request_string(part, "text");
            }
            if part_type == "output_text" {
                joined = joined + types::request_string(part, "text");
            }
            i += 1;
        }
        text = joined;
    }
    text
}

fn chat_parse_tool_calls(tool_calls: array) -> array {
    let mut calls: array = [];
    let mut i = 0;
    while i < tool_calls.length {
        let call: map = types::array_entry(tool_calls, i);
        if call.has("id") {
            let id: string = types::request_string(call, "id");
            let function: map = types::request_map(call, "function");
            let name: string = types::request_string(function, "name");
            let args_text: string = types::request_string(function, "arguments");
            let mut args: map = {};
            if args_text != "" {
                let decoded: map = json::decode(args_text);
                args = decoded;
            }
            calls[calls.length] = types::tool_call_new(id, name, args);
        }
        i += 1;
    }
    calls
}


pub fn chat_parse_public_error(body_text: string, status: int) -> map {
    chat_parse_error_text(body_text, status)
}

fn chat_parse_error_text(body_text: string, status: int) -> map {
    let payload: map = chat_error_payload(body_text);
    let mut error_type: string = "api_error";
    let mut code: string = "http_error";
    let mut message: string = "provider request failed";
    let mut param: string = "";
    let mut request_id: string = "";
    let payload_type: string = types::request_string(payload, "type");
    let payload_code: string = types::request_string(payload, "code");
    let payload_message: string = types::request_string(payload, "message");
    let payload_param: string = types::request_string(payload, "param");
    let payload_request_id: string = types::request_string(payload, "request_id");
    if payload_type != "" {
        error_type = payload_type;
    }
    if payload_code != "" {
        code = payload_code;
    }
    if payload_message != "" {
        message = payload_message;
    }
    if payload_param != "" {
        param = payload_param;
    }
    if payload_request_id != "" {
        request_id = payload_request_id;
    }
    types::fail(types::error_new(status, error_type, code, message, param, request_id))
}

/// Extracts the `error` object from a non-2xx JSON body. A structurally
/// invalid body yields an empty map and the caller falls back to the default
/// `api_error`/`http_error` shape; a body that is not JSON at all fails the
/// invocation (the same contract as `chat_parse_response`).
fn chat_error_payload(body_text: string) -> map {
    let decoded: map = json::decode(body_text);
    if type(decoded) == "map" => {
        types::request_map(decoded, "error")
    } else => {
        {}
    }
}

// ---------------------------------------------------------------------------
/// Merges one chunk's tool-call deltas into the accumulator list. Each entry
/// is `{index, id, name, args}`; a delta whose `index` already exists fills
/// missing `id`/`name` and appends its `arguments` fragment to `args`.
/// Returns a new array (the caller assigns the result back to the captured
/// accumulator). Public so the pure stream codec reuses it unchanged.
pub fn chat_stream_merge_tool_calls(tools: array, deltas: array) -> array {
    let mut merged: array = tools;
    let mut i = 0;
    while i < deltas.length {
        let delta: map = types::array_entry(deltas, i);
        let index: int = types::request_int(delta, "index", -1);
        let id: string = types::request_string(delta, "id");
        // The OpenAI wire places the tool-call name inside the nested
        // `function` object (`function.name`); there is no top-level
        // `name` field on the delta.
        let function: map = types::request_map(delta, "function");
        let name: string = types::request_string(function, "name");
        let fragment: string = types::request_string(function, "arguments");
        let mut found = false;
        let mut j = 0;
        while j < merged.length {
            let existing: map = types::array_entry(merged, j);
            if types::request_int(existing, "index", -1) == index {
                let mut updated: map = existing;
                if id != "" {
                    updated["id"] = id;
                }
                if name != "" {
                    updated["name"] = name;
                }
                if fragment != "" {
                    updated["args"] = types::request_string(updated, "args") + fragment;
                }
                merged[j] = updated;
                found = true;
            }
            j += 1;
        }
        if !found {
            merged[merged.length] = {
                index: index,
                id: id,
                name: name,
                args: fragment
            };
        }
        i += 1;
    }
    merged
}

/// Converts the accumulator entries into canonical `{id, name, arguments}`
/// tool calls, decoding each accumulated `arguments` JSON fragment. Public so
/// the pure stream codec reuses it unchanged.
pub fn chat_stream_parse_tool_calls(tools: array) -> array {
    let mut calls: array = [];
    let mut i = 0;
    while i < tools.length {
        let entry: map = types::array_entry(tools, i);
        let id: string = types::request_string(entry, "id");
        let name: string = types::request_string(entry, "name");
        let args_text: string = types::request_string(entry, "args");
        let mut args: map = {};
        if args_text != "" {
            let decoded: map = json::decode(args_text);
            args = decoded;
        }
        calls[calls.length] = types::tool_call_new(id, name, args);
        i += 1;
    }
    calls
}