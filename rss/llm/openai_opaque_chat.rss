use auth;
use oauth;
use json;
use stream;
use self::openai_stream_codec as codec;
use self::types as types;
use self::openai_chat as openai_chat;
use super::agent::provider_runtime as provider_runtime;

struct OpaqueProviderIntent {
    credential_id: string,
    method: string,
    path: string,
    public_headers: array<PublicHeader>,
    public_body: string
}

struct OpaqueHostHomeBinding {
    home: resource<auth.host_home>
}

pub fn run(context: map) -> map {
    let request: map = types::request_map(context, "request");
    let profile: map = types::request_map(context, "profile");
    let model: string = types::request_string(request, "model");
    let streaming: bool = types::request_bool(request, "stream", false);
    let options: map = types::provider_options(request);
    let options_are_public: bool = types::profile_options_are_public(options);
    let result: map = if model == "" => {
        types::fail(types::error_request("missing_model", "request.model is required"))
    } else if !options_are_public => {
        types::fail(types::error_request(
            "config",
            "credential-bearing provider options are not public"
        ))
    } else if streaming => {
        chat_send_stream(request, profile, context, model)
    } else => {
        chat_send_buffered(request, profile, context, model)
    };
    result
}

/// Optional profile path intent; defaults to the exact canonical Chat
/// Completions path. Resource-free: the native transport trusts and
/// validates the intent against the admitted policy.
fn chat_path_or_default(profile: map) -> string {
    let configured: string = types::profile_string(profile, "chat_path");
    let path: string = if configured == "" => {
        "/v1/chat/completions"
    } else => {
        configured
    };
    path
}

fn chat_send_buffered(request: map, profile: map, context: map, model: string) -> map {
    let body: string = openai_chat::chat_build_public_body(request, model);
    let binding: OpaqueHostHomeBinding = { "home": context["host_home"], };
    let credential_id: string = types::request_string(context, "credential_id");
    let intent: OpaqueProviderIntent = {
        credential_id: credential_id,
        method: "POST",
        path: chat_path_or_default(profile),
        public_headers: [
            { name: "accept", value: "application/json" },
            { name: "content-type", value: "application/json" }
        ],
        public_body: body
    };
    let envelope: TransportResultEnvelope = provider_runtime::call(binding, intent);
    chat_interpret_transport(envelope)
}

fn chat_interpret_transport(envelope: TransportResultEnvelope) -> map {
    if envelope.ok => {
        match envelope.value {
            Some(response) => chat_parse_transport_response(response),
            None => types::fail(types::error_request("transport_error", "provider transport failed"))
        }
    } else => {
        match envelope.error {
            Some(failure) => types::fail(types::error_request(failure.code, "provider transport failed")),
            None => types::fail(types::error_request("transport_error", "provider transport failed"))
        }
    }
}

fn chat_parse_transport_response(response: TransportResponseEnvelope) -> map {
    let status: int = response.status;
    let body: string = response.body_without_secret_fields;
    if status >= 200 && status < 300 => {
        openai_chat::chat_parse_public_response(body, status)
    } else => {
        openai_chat::chat_parse_public_error(body, status)
    }
}

fn stream_transport_failure(failure: Option<AuthBridgeFailure>) -> map {
    let detail: AuthBridgeFailure = failure.unwrap_or({code: "transport_error", cancelled: false, deadline_exceeded: false, revoked: false, transport_phase: None, transport_category: None});
    let mut error: map = types::error_request(detail.code, "provider transport failed");
    let category: Option<string> = detail.transport_category;
    let phase: Option<string> = detail.transport_phase;
    if text_present(category.copy()) && text_present(phase.copy()) {
        error.transport_category = category.unwrap_or("");
        error.transport_phase = phase.unwrap_or("");
    }
    types::fail(error)
}

fn text_present(value: Option<string>) -> bool {
    match value {
        Some(_) => true,
        None => false
    }
}

fn failure_present(failure: Option<AuthBridgeFailure>) -> bool {
    match failure {
        Some(_) => true,
        None => false
    }
}

fn malformed_stream(status: int) -> map {
    types::fail(types::error_malformed(status, "malformed provider stream record"))
}

/// The open result as one carrier: a refused open (`ok == false`) or a present
/// failure means there is no envelope to read records from.
fn open_stream_envelope(
    ok: bool,
    refused: bool,
    value: Option<OAuthStreamEnvelope>
) -> Option<OAuthStreamEnvelope> {
    if !ok || refused => {
        None
    } else => {
        value
    }
}

/// An absent record. Only reachable if the read envelope reported no value while
/// claiming success; it decodes to the malformed-record refusal.
fn empty_stream_record() -> OAuthStreamRecord {
    let literal_index: Option<int> = None;
    {kind: "", json: "", literal_index: literal_index}
}

/// One record carrier plus its presence. The record is taken apart once so the
/// read field is moved exactly one time.
struct RecordPeek {
    present: bool,
    record: OAuthStreamRecord
}

fn peek_record(value: Option<OAuthStreamRecord>) -> RecordPeek {
    match value {
        Some(record) => {present: true, record: record},
        None => {present: false, record: empty_stream_record()}
    }
}

/// A read envelope is usable only when it reported success without a failure and
/// carried a record; every other combination is the transport-failure path.
fn stream_record_ready(
    ok: bool,
    failure: Option<AuthBridgeFailure>,
    record_present: bool
) -> bool {
    ok && !failure_present(failure) && record_present
}

fn first_literal(index: Option<int>) -> bool {
    match index {
        Some(value) => value == 0,
        None => false
    }
}

fn chat_send_stream(request: map, profile: map, context: map, model: string) -> map {
    let binding: OpaqueHostHomeBinding = {home: context["host_home"]};
    let intent: OpaqueProviderIntent = {
        credential_id: types::request_string(context, "credential_id"),
        method: "POST",
        path: chat_path_or_default(profile),
        public_headers: [
            {name: "accept", value: "text/event-stream"},
            {name: "content-type", value: "application/json"}
        ],
        public_body: openai_chat::chat_build_public_stream_body(request, model)
    };
    let started: OAuthStreamStartResultEnvelope = provider_runtime::start_stream(binding, intent, ["[DONE]"]);
    let ok: bool = started.ok;
    let failure: Option<AuthBridgeFailure> = started.error;
    let result: map = match open_stream_envelope(ok, failure_present(failure), started.value) {
        Some(envelope) => consume_stream(envelope),
        None => stream_transport_failure(failure)
    };
    result
}

fn consume_stream(envelope: OAuthStreamEnvelope) -> map {
    let stream: resource<oauth.stream> = envelope.stream;
    let head: OAuthStreamHead = envelope.head;
    let status: int = head.status;
    let mut state: map = codec::begin();
    let mut result: map = {};
    let mut finished: bool = false;
    while !finished {
        let read: OAuthStreamReadResultEnvelope = oauth::stream_read_result(&stream);
        let read_ok: bool = read.ok;
        let read_failure: Option<AuthBridgeFailure> = read.error;
        let peeked_record: RecordPeek = peek_record(read.value);
        let record_ready: bool = stream_record_ready(read_ok, read_failure, peeked_record.present);
        if !record_ready {
            result = stream_transport_failure(read_failure);
            finished = true;
        } else {
            let record: OAuthStreamRecord = peeked_record.record;
            let kind: string = record.kind;
            if kind == "json" {
                let body: string = record.json;
                // Native records are strict canonical JSON objects or arrays.
                // Reject arrays before the map-typed decoder is invoked.
                if body.copy()[0:1] != "{" {
                    result = malformed_stream(status);
                    finished = true;
                } else if status < 200 || status >= 300 {
                    result = openai_chat::chat_parse_public_error(body, status);
                    finished = true;
                } else {
                    let previous_text: string = types::request_string(state, "text");
                    state = codec::push_json(state, body);
                    if types::request_bool(state, "failed", false) {
                        result = codec::finish(state);
                        finished = true;
                    } else {
                        // Publish only text accepted by the codec, before the next upstream read.
                        let text: string = types::request_string(state, "text");
                        if text.length > previous_text.length {
                            let delta: string = text.copy()[previous_text.length:text.length];
                            stream::emit({type: "model.delta", delta: delta});
                        }
                    }
                }
            } else if status < 200 || status >= 300 {
                result = malformed_stream(status);
                finished = true;
            } else if kind == "literal" {
                if first_literal(record.literal_index) {
                    state = codec::push_done(state);
                    result = codec::finish(state);
                } else {
                    result = malformed_stream(status);
                }
                finished = true;
            } else if kind == "eof" {
                result = codec::finish(state);
                finished = true;
            } else {
                result = malformed_stream(status);
                finished = true;
            }
        }
    }
    oauth::stream_close(stream);
    result
}
