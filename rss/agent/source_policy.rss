// Task9 RSS-owned agent source-selection policy.
//
// Public contract: `run(context)` selects the agent source from the two
// trusted configuration inputs `source` and `legacy_script`.
//
//   source         absent | null | string   (explicit, authoritative)
//   legacy_script  absent | null | string    (deprecated migration input)
//
// When `source` is present and non-null it is authoritative: an invalid or
// unsupported explicit source NEVER falls back to legacy_script. When no
// explicit source is supplied, a present non-null `legacy_script` is used.
// When neither is supplied the default `bundled:coding` is selected.
//
// Success returns ok/source/descriptor/deprecated_override and omits `error`
// (the v2 optional-output contract). Failure returns
// ok/deprecated_override/error and omits source/descriptor. Failure output
// never echoes the hostile input.
//
// The bounded length limit is 4096 Unicode scalar characters (`.length` is a
// scalar count, not a UTF-8 byte count). NUL/CR/LF/TAB are rejected by exact
// scalar comparison. Paths are preserved verbatim: no trim, no repair, no URL
// decoding, no path canonicalization. Filesystem authority, UTF-8 byte limits
// and the native gate remain outside this policy.
//
// This policy has no imports and no host side effects: it only reads the
// bounded context map and returns a decision map.

fn char_at(value: string, index: int) -> string {
    value[index:(index + 1)]
}

fn starts_with(value: string, prefix: string) -> bool {
    let mut result: bool = false;
    if prefix.length <= value.length {
        result = value[0:prefix.length] == prefix;
    }
    result
}

// True when `value` holds a present, non-null field `key`.
fn field_present(value: map, key: string) -> bool {
    let mut present: bool = false;
    if value.has(key) {
        if type(value[key]) != "null" {
            present = true;
        }
    }
    present
}

// True when the present field holds a string value.
fn field_is_string(value: map, key: string) -> bool {
    let mut is_string: bool = false;
    if type(value[key]) == "string" {
        is_string = true;
    }
    is_string
}

fn has_control_character(value: string) -> bool {
    let mut found: bool = false;
    let mut index: int = 0;
    while found == false && index < value.length {
        let ch: string = char_at(value, index);
        if ch == "\0" || ch == "\n" || ch == "\r" || ch == "\t" {
            found = true;
        }
        index = index + 1;
    }
    found
}

// Empty, overlength (>4096 Unicode scalars) or control-bearing tokens are
// invalid for both the explicit and the legacy input.
fn is_invalid_token(value: string) -> bool {
    let mut invalid: bool = false;
    if value.length == 0 {
        invalid = true;
    } else {
        if value.length > 4096 {
            invalid = true;
        } else {
            if has_control_character(value) {
                invalid = true;
            }
        }
    }
    invalid
}

fn is_absolute_path(value: string) -> bool {
    let mut absolute: bool = false;
    if starts_with(value, "/") {
        if value.length > 1 {
            absolute = true;
        }
    }
    absolute
}

fn bundled_success() -> map {
    {
        ok: true,
        source: "bundled:coding",
        descriptor: {
            kind: "bundled",
            resource: "coding"
        },
        deprecated_override: false
    }
}

fn file_success(canonical: string, path: string, deprecated_override: bool) -> map {
    {
        ok: true,
        source: canonical,
        descriptor: {
            kind: "file",
            path: path
        },
        deprecated_override: deprecated_override
    }
}

fn failure(code: string, message: string) -> map {
    {
        ok: false,
        deprecated_override: false,
        error: {
            code: code,
            message: message
        }
    }
}

fn failure_invalid_source() -> map {
    failure("invalid_agent_source", "agent source is invalid")
}

fn failure_unsupported_source() -> map {
    failure("unsupported_agent_source", "agent source is unsupported")
}

fn failure_invalid_legacy() -> map {
    failure("invalid_legacy_agent_source", "legacy agent source is invalid")
}

// Exact explicit-source algorithm (never consults legacy):
//   `bundled:coding`                 -> default bundled descriptor
//   `file:<absolute path>` (len > 1) -> file descriptor, unchanged path
//   `file:<relative or empty>`       -> invalid_agent_source
//   any other well-formed string     -> unsupported_agent_source
fn select_explicit_source(value: string) -> map {
    let mut decision: map = failure_unsupported_source();
    if value == "bundled:coding" {
        decision = bundled_success();
    } else {
        if starts_with(value, "file:") {
            let path: string = value[5:value.length];
            if is_absolute_path(path) {
                decision = file_success("file:" + path, path, false);
            } else {
                decision = failure_invalid_source();
            }
        }
    }
    decision
}

// Legacy migration: a valid absolute raw path is re-expressed as the same
// file descriptor with a canonical `file:` source and deprecated_override
// true; a relative or exactly-root path is invalid_legacy_agent_source.
fn select_legacy_source(raw: string) -> map {
    let mut decision: map = failure_invalid_legacy();
    if is_absolute_path(raw) {
        decision = file_success("file:" + raw, raw, true);
    }
    decision
}

pub fn run(context: map) -> map {
    let mut decision: map = bundled_success();
    if field_present(context, "source") {
        if field_is_string(context, "source") == false {
            decision = failure_invalid_source();
        } else {
            let value: string = context["source"];
            if is_invalid_token(value) {
                decision = failure_invalid_source();
            } else {
                decision = select_explicit_source(value);
            }
        }
    } else {
        if field_present(context, "legacy_script") {
            if field_is_string(context, "legacy_script") == false {
                decision = failure_invalid_legacy();
            } else {
                let raw: string = context["legacy_script"];
                if is_invalid_token(raw) {
                    decision = failure_invalid_legacy();
                } else {
                    decision = select_legacy_source(raw);
                }
            }
        }
    }
    decision
}
