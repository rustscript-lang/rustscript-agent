// Serial provider/tool agent loop.
//
// `run(context)` drives canonical LlmRequest construction, the bounded host
// provider bridge, serial RSS tool dispatch, and retry/backoff until a
// typed terminal decision. Follow-up assistant `tool_call` parts use
// `arguments_json` strings; tool results stay user-role `tool_result` parts so
// adapters see one contract. Parallel/task execution is rejected.
// Provider/network errors consume the retry budget; completed tool effects are
// never retried. Durability of messages/events is owned by AgentService.

use agent;
use agent_runtime;
use json;
use super::tools::dispatch as tools;
use super::agent::guardian as guardian;
use super::agent::provider_body;

/// The canonical committed tool result, as far as this harness projects it.
/// `data` is that result's own open payload and therefore its serialized text;
/// nothing else about it is re-shaped here.
struct HarnessToolFailure {
    code: string,
    message: string
}

struct HarnessToolResult {
    ok: bool,
    content: string,
    data: string,
    truncated: bool,
    artifacts: array<string>,
    error: Option<HarnessToolFailure>
}

// ---------------------------------------------------------------------------
// Typed context accessors (same-module; defensive dynamic navigation)
// ---------------------------------------------------------------------------

fn ctx_string(value: map, key: string, fallback: string) -> string {
    let mut result: string = fallback;
    if value.has(key) {
        if type(value[key]) == "string" {
            let coerced: string = value[key];
            result = coerced;
        }
    }
    result
}

fn ctx_int(value: map, key: string, fallback: int) -> int {
    let mut result: int = fallback;
    if value.has(key) {
        if type(value[key]) == "int" {
            let coerced: int = value[key];
            result = coerced;
        }
    }
    result
}

fn ctx_bool(value: map, key: string, fallback: bool) -> bool {
    let mut result: bool = fallback;
    if value.has(key) {
        if type(value[key]) == "bool" {
            let coerced: bool = value[key];
            result = coerced;
        }
    }
    result
}

fn ctx_map(value: map, key: string) -> map {
    let mut result: map = {};
    if value.has(key) {
        if type(value[key]) == "map" {
            let coerced: map = value[key];
            result = coerced;
        }
    }
    result
}

fn ctx_array(value: map, key: string) -> array {
    let mut result: array = [];
    if value.has(key) {
        if type(value[key]) == "array" {
            let coerced: array = value[key];
            result = coerced;
        }
    }
    result
}

fn array_map(items: array, index: int) -> map {
    let mut result: map = {};
    if items.has(index) {
        if type(items[index].copy()) == "map" {
            let coerced: map = items[index].copy();
            result = coerced;
        }
    }
    result
}

// ---------------------------------------------------------------------------
// Decision builders
// ---------------------------------------------------------------------------

fn run_completed_decision(answer: string, turn: int, retry_count: int, tool_calls_used: int, events: array) -> map {
    {
        kind: "run.completed",
        answer: answer,
        turn: turn,
        retry_count: retry_count,
        tool_calls_used: tool_calls_used,
        events: events
    }
}

fn run_failed_decision(code: string, message: string, turn: int, retry_count: int, tool_calls_used: int, error: map) -> map {
    let mut payload: map = error;
    if !payload.has("code") {
        payload = {
            status: ctx_int(error, "status", 0),
            type: ctx_string(error, "type", "api_error"),
            code: code,
            message: message,
            param: ctx_string(error, "param", ""),
            request_id: ctx_string(error, "request_id", "")
        };
    }
    {
        kind: "run.failed",
        error: payload,
        reason: code,
        turn: turn,
        retry_count: retry_count,
        tool_calls_used: tool_calls_used,
        events: []
    }
}

fn failed_code(code: string, message: string, turn: int, retry_count: int, tool_calls_used: int) -> map {
    run_failed_decision(
        code,
        message,
        turn,
        retry_count,
        tool_calls_used,
        {
            status: 0,
            type: "invalid_request_error",
            code: code,
            message: message,
            param: "",
            request_id: ""
        }
    )
}

fn control_failed(control: map, turn: int, retry_count: int, tool_calls_used: int) -> map {
    let error: map = ctx_map(control, "error");
    let code: string = ctx_string(error, "code", "cancelled");
    run_failed_decision(code, ctx_string(error, "message", code), turn, retry_count, tool_calls_used, error)
}

// ---------------------------------------------------------------------------
// Retry classification and backoff
// ---------------------------------------------------------------------------

fn error_is_retryable(error: map) -> bool {
    let code: string = ctx_string(error, "code", "");
    let mut retryable = false;
    let mut decided = false;
    if code == "setup" {
        decided = true;
    }
    if code == "config" {
        decided = true;
    }
    if code == "adapter_unavailable" {
        decided = true;
    }
    if code == "malformed_payload" {
        decided = true;
    }
    if code == "provider_step_persist_failed" {
        decided = true;
    }
    if code == "interrupted_provider" {
        decided = true;
    }
    if code == "scripted_exhausted" {
        decided = true;
    }
    if code == "cancelled" {
        decided = true;
    }
    if code == "deadline_elapsed" {
        decided = true;
    }
    if code == "corrupt_provider_step" {
        decided = true;
    }
    if code == "run_terminal" {
        decided = true;
    }
    if code == "missing_tool_parent" {
        decided = true;
    }
    if decided == false {
        if error.has("retryable") {
            if type(error["retryable"]) == "bool" {
                let flagged: bool = error["retryable"];
                retryable = flagged;
                decided = true;
            }
        }
    }
    if decided == false {
        let status: int = ctx_int(error, "status", 0);
        let error_type: string = ctx_string(error, "type", "");
        if status == 429 {
            retryable = true;
        }
        if status == 408 {
            retryable = true;
        }
        if status >= 500 {
            if status <= 599 {
                retryable = true;
            }
        }
        if error_type == "rate_limit_error" {
            retryable = true;
        }
        if error_type == "overloaded_error" {
            retryable = true;
        }
        if error_type == "server_error" {
            retryable = true;
        }
        if error_type == "timeout_error" {
            retryable = true;
        }
    }
    retryable
}

fn backoff_delay_ms(base: int, retry_count: int, cap: int) -> int {
    let mut delay: int = base;
    let mut ceiling: int = cap;
    if delay < 0 {
        delay = 0;
    }
    if ceiling < 0 {
        ceiling = 0;
    }
    if delay > ceiling {
        delay = ceiling;
    }
    let mut step = 0;
    while step < retry_count {
        if delay >= ceiling || delay == 0 {
            break;
        }
        if delay > ceiling / 2 {
            delay = ceiling;
        } else {
            delay = delay * 2;
        }
        step += 1;
    }
    delay
}

// ---------------------------------------------------------------------------
// Canonical request / message helpers
// ---------------------------------------------------------------------------

fn text_part(text: string) -> map {
    { type: "text", text: text }
}

/// Canonical JSON text for a guest value.
///
/// The host owns serialization (`agent::json_text`): this pin rejects the typed
/// `json::encode::<map>` form, and an open payload may only leave the guest as
/// text. Failure is reported as an empty string, never as `{}`.
fn json_text_of(value: map) -> string {
    let encoded = agent::json_text(value);
    let mut text: string = "";
    if encoded.ok {
        text = encoded.text;
    }
    text
}

/// The provider's own `arguments_json` text, verbatim.
///
/// A call that only carries an `arguments` map is serialized by the host. A
/// call with neither is left empty so the tool boundary fails closed instead of
/// silently sending `{}` in place of the provider's arguments.
fn call_arguments_json(call: map) -> string {
    let mut text: string = "";
    if call.has("arguments_json") {
        if type(call.arguments_json.copy()) == "string" {
            text = ctx_string(call, "arguments_json", "");
        }
    }
    if text == "" {
        if call.has("arguments") {
            if type(call.arguments.copy()) == "map" {
                text = json_text_of(ctx_map(call, "arguments"));
            }
        }
    }
    text
}

fn tool_call_part(call: map) -> map {
    {
        type: "tool_call",
        tool_call_id: ctx_string(call, "id", ""),
        name: ctx_string(call, "name", ""),
        arguments_json: call_arguments_json(call)
    }
}

fn user_text_message(text: string) -> map {
    let mut content: array = [];
    content[content.length] = text_part(text);
    { role: "user", content: content }
}

fn system_text_message(text: string) -> map {
    let mut content: array = [];
    content[content.length] = text_part(text);
    { role: "system", content: content }
}

fn assistant_message(text: string, calls: array) -> map {
    let mut content: array = [];
    if text != "" {
        content[content.length] = text_part(text);
    }
    let mut i = 0;
    while i < calls.length {
        content[content.length] = tool_call_part(array_map(calls, i));
        i += 1;
    }
    { role: "assistant", content: content }
}

fn tool_result_message(block: map) -> map {
    let mut content: array = [];
    content[content.length] = block;
    { role: "user", content: content }
}

fn seed_messages(context: map, messages: array) -> array {
    let mut seeded: array = [];
    let prompt: string = ctx_string(context, "coding_system_prompt", "");
    if prompt != "" {
        seeded[seeded.length] = system_text_message(prompt);
    }
    if messages.length == 0 {
        let mut text: string = "";
        if context.has("input") {
            if type(context["input"]) == "map" {
                let input: map = ctx_map(context, "input");
                text = ctx_string(input, "message", ctx_string(input, "text", ""));
            } else if type(context["input"]) == "string" {
                text = ctx_string(context, "input", "");
            }
        }
        if text != "" {
            seeded[seeded.length] = user_text_message(text);
        }
    } else {
        let mut i = 0;
        while i < messages.length {
            seeded[seeded.length] = messages[i].copy();
            i += 1;
        }
    }
    seeded
}

// Native `RunContext.tool_schemas` entries are validated registry
// `ToolDescriptor` maps (`{name, description, toolset, risk_class, schema}`).
// The canonical LlmRequest contract still carries the schema as a JSON string
// in `schema_json`, which the Chat/Gemini/Anthropic codecs splice into their
// wire bodies; convert only at this boundary so native and canonical shapes
// stay distinct everywhere else.
fn native_tool_to_canonical(descriptor: map) -> map {
    let schema: map = descriptor["schema"];
    let schema_json: string = json_text_of(schema);
    {
        name: ctx_string(descriptor, "name", ""),
        description: ctx_string(descriptor, "description", ""),
        schema_json: schema_json
    }
}

fn native_tools_to_canonical(descriptors: array) -> array {
    let mut tools: array = [];
    let mut index = 0;
    while index < descriptors.length {
        let descriptor: map = array_map(descriptors, index);
        tools[tools.length] = native_tool_to_canonical(descriptor);
        index += 1;
    }
    tools
}

fn tools_from_context(context: map) -> array {
    let mut tools: array = ctx_array(context, "tools");
    if tools.length == 0 {
        let native_descriptors: array = ctx_array(context, "tool_schemas");
        tools = native_tools_to_canonical(native_descriptors);
    }
    tools
}

// Local tool dispatch and admitted-registry authority consume the native
// descriptor shape (risk class, toolset, schema object); it must not see the
// canonical LLM conversion above.
fn native_tools_from_context(context: map) -> array {
    let mut tools: array = ctx_array(context, "tools");
    if tools.length == 0 {
        tools = ctx_array(context, "tool_schemas");
    }
    tools
}

fn build_llm_request(context: map, messages: array) -> map {
    let limits: map = ctx_map(context, "limits");
    let sampling: map = ctx_map(context, "sampling");
    let provider_options: map = ctx_map(context, "provider_options");
    let mut credential_id: string = ctx_string(context, "credential_id", "");
    if !context.has("credential_id") {
        credential_id = ctx_string(provider_options, "credential_id", "");
    }
    {
        provider: ctx_string(context, "provider", "openai"),
        model: ctx_string(context, "model", ""),
        messages: messages,
        tools: tools_from_context(context),
        tool_choice: ctx_string(context, "tool_choice", ""),
        credential_id: credential_id,
        reasoning: ctx_string(context, "reasoning", ""),
        sampling: sampling,
        max_output_tokens: ctx_int(context, "max_output_tokens", ctx_int(limits, "max_output_tokens", 0)),
        stream: ctx_string(context, "platform", "") == "telegram",
        provider_options: provider_options
    }
}

fn response_is_malformed(response: map) -> bool {
    let mut malformed = false;
    if !response.has("text") {
        if !response.has("tool_calls") {
            malformed = true;
        }
    }
    if response.has("tool_calls") {
        if type(response["tool_calls"]) != "array" {
            malformed = true;
        }
    }
    malformed
}

fn approval_settings(context: map) -> map {
    let metadata: map = ctx_map(context, "metadata");
    let sealed: map = ctx_map(metadata, "approval_settings");
    let mut configured: map = sealed;
    if configured.length == 0 {
        configured = ctx_map(context, "approval_settings");
    }
    let provider_options: map = ctx_map(context, "provider_options");
    let guardian_options: map = ctx_map(provider_options, "guardian");
    {
        read: ctx_string(configured, "read", ctx_string(guardian_options, "read", "allow")),
        write: ctx_string(configured, "write", ctx_string(guardian_options, "write", "ask")),
        process: ctx_string(configured, "process", ctx_string(guardian_options, "process", "ask")),
        reviewer: ctx_string(configured, "reviewer", ctx_string(guardian_options, "reviewer", "guardian")),
        reviewer_model: ctx_string(configured, "reviewer_model", ctx_string(guardian_options, "model", "")),
        allow_user_fallback: ctx_bool(configured, "allow_user_fallback", ctx_bool(guardian_options, "allow_user_fallback", false)),
        required: ctx_bool(configured, "required", ctx_bool(guardian_options, "required", true))
    }
}

fn persist_approval_request(context: map, metadata: map, action: map) -> map {
    let run_id: string = ctx_string(context, "run_id", "");
    let session_id: string = ctx_string(context, "session_id", "");
    let call_id: string = ctx_string(metadata, "call_id", "");
    let approval_id: string = "guardian-approval:" + run_id + ":" + call_id;
    let created_at_ms: int = ctx_int(ctx_map(context, "metadata"), "created_at_ms", 0);
    let deadline_at_ms: int = ctx_int(ctx_map(context, "metadata"), "deadline_at_ms", 0);
    let preview_result: map = guardian::action_preview(action);
    let owner_preview: string = ctx_string(preview_result, "text", "");
    let reviewer: string = ctx_string(approval_settings(context), "reviewer", "guardian");
    let mut expected_scope: string = "single_call";
    if reviewer == "auto" { expected_scope = "guardian_pending"; }
    // A refused projection (malformed text, a wrongly typed field) reports its
    // own code: "no preview" is not one failure, and the owner-facing approval
    // reason must not disguise an unparseable action as an unsupported one.
    let mut code: string = "approval_preview_unavailable";
    if ctx_bool(preview_result, "ok", false) == false {
        code = ctx_string(preview_result, "code", "approval_preview_unavailable");
    }
    let mut request: map = {
        id: approval_id,
        run_id: run_id,
        session_id: session_id,
        tool_call_id: call_id,
        tool_name: ctx_string(action, "tool_name", ""),
        arguments_json: "{}",
        risk_class: ctx_string(action, "risk_class", ""),
        decision_scope: expected_scope,
        one_time: 1,
        requested_at_ms: created_at_ms,
        expires_at_ms: deadline_at_ms
    };
    request.owner_preview = owner_preview;
    let owner_argv_preview: string = ctx_string(preview_result, "owner_text", "");
    if owner_argv_preview != "" && agent::utf8_byte_len(owner_argv_preview) <= 2048 { request.owner_argv_preview = owner_argv_preview; }
    let mut created: int = 0;
    let mut stored_ok: bool = false;
    let mut stored_rows: int = 0;
    if ctx_bool(preview_result, "ok", false) && owner_preview != "" && agent::utf8_byte_len(owner_preview) <= 2048 {
        // The durable request is open JSON: it crosses as text and the host
        // parses it, keeping the stored row byte-for-byte as before.
        let stored = agent::approval_storage("request", json_text_of(request));
        let stored_row_list: array<AgentApprovalRow> = stored.rows.copy();
        stored_ok = stored.ok;
        stored_rows = stored_row_list.length;
        created = stored.created;
        code = stored.code;
        if stored_ok && stored_rows == 1 {
            let row: AgentApprovalRow = stored_row_list[0].copy();
            let scope_ok: bool = row.decision_scope.copy() == expected_scope || (reviewer == "auto" && created == 0 && (row.decision_scope.copy() == "guardian_pending" || row.decision_scope.copy() == "human_pending"));
            if row.id != approval_id
                || row.run_id != run_id
                || row.session_id != session_id
                || row.tool_call_id != call_id
                || row.tool_name != ctx_string(action, "tool_name", "")
                || row.arguments_json != "{}"
                || row.risk_class != ctx_string(action, "risk_class", "")
                || row.state != "pending"
                || !scope_ok
                || row.one_time != 1
            {
                stored_ok = false;
            }
        }
    }
    let mut valid: bool = stored_ok && stored_rows == 1;
    if code == "" {
        code = "approval_storage_unavailable";
    }
    { ok: valid, approval_id: approval_id, code: code, reason: ctx_string(preview_result, "reason", ""), created: created }
}

fn resolve_approval(context: map, approval_id: string, state: string, reason: string) -> bool {
    let run_id: string = ctx_string(context, "run_id", "");
    let resolved_at_ms: int = ctx_int(ctx_map(context, "metadata"), "created_at_ms", 0);
    let result = agent::approval_storage("resolve", json_text_of({
        id: approval_id,
        run_id: run_id,
        state: state,
        resolver: "guardian",
        decision_reason: reason,
        resolved_at_ms: resolved_at_ms
    }));
    result.ok && result.rows_affected == 1
}

fn wait_for_user_approval(context: map, approval_id: string) -> map {
    let run_id: string = ctx_string(context, "run_id", "");
    let session_id: string = ctx_string(context, "session_id", "");
    let mut done: bool = false;
    let mut result: map = { ok: false, code: "approval_wait_failed", message: "user approval could not be confirmed" };
    while done == false {
        let checked = agent::control_check();
        let control: map = { ok: checked.ok, error: match checked.error { Some(failure) => { code: failure.code, message: failure.message }, None => { code: "control_contract_violation", message: "control_check reported a failure without a structured error" } } };
        if ctx_bool(control, "ok", false) == false {
            let error: map = ctx_map(control, "error");
            result = { ok: false, code: ctx_string(error, "code", "cancelled"), message: "user approval wait was interrupted" };
            done = true;
        } else {
            let stored = agent::approval_storage("get", json_text_of({ run_id: run_id, approval_id: approval_id }));
            let stored_row_list: array<AgentApprovalRow> = stored.rows.copy();
            let rows: int = stored_row_list.length;
            if stored.ok == false || rows != 1 {
                result = { ok: false, code: "approval_storage_unavailable", message: "pending user approval could not be read" };
                done = true;
            } else {
                let row: AgentApprovalRow = stored_row_list[0].copy();
                if row.id != approval_id || row.run_id != run_id || row.session_id != session_id {
                    result = { ok: false, code: "approval_owner_mismatch", message: "approval owner changed; no action was executed" };
                    done = true;
                } else {
                    let state: string = row.state.copy();
                    if state == "approved" {
                        result = { ok: true, code: "user_approved", message: "user approved this exact action" };
                        done = true;
                    } else if state == "denied" {
                        result = { ok: false, code: "user_denied", message: "user denied this action; no action was executed" };
                        done = true;
                    } else if state == "expired" {
                        result = { ok: false, code: "approval_expired", message: "approval expired; no action was executed" };
                        done = true;
                    } else if state != "pending" {
                        result = { ok: false, code: "approval_state_invalid", message: "approval state is invalid" };
                        done = true;
                    } else {
                        agent::sleep_ms(100);
                    }
                }
            }
        }
    }
    result
}

fn approval_handoff(context: map, approval_id: string, tool_call_id: string, tool_name: string) -> map {
    let run_id: string = ctx_string(context, "run_id", "");
    let session_id: string = ctx_string(context, "session_id", "");
    let stored: map = agent::approval_storage("handoff", json_text_of({
        id: approval_id,
        run_id: run_id,
        session_id: session_id,
        tool_call_id: tool_call_id,
        tool_name: tool_name,
        now_ms: 0
    }));
    let mut result: map = { ok: false, code: "approval_handoff_rejected", message: "approval handoff failed; no action was executed" };
    if ctx_bool(stored, "ok", false) {
        let readback: map = agent::approval_storage("get", json_text_of({ run_id: run_id, approval_id: approval_id }));
        let data: map = ctx_map(readback, "result");
        let rows: array = ctx_array(data, "rows");
        if ctx_bool(readback, "ok", false) && rows.length == 1 {
            let row: array = rows[0];
            if row.length >= 10 && row[0] == approval_id && row[1] == run_id && row[2] == session_id && row[3] == tool_call_id && row[4] == tool_name && row[7] == "pending" && row[8] == "human_pending" && row[9] == 1 {
                result = { ok: true, code: "ok", message: "" };
            }
        }
    }
    result
}

fn decide_approval(context: map, action: map, approval_id: string, created: int) -> map {
    let settings: map = approval_settings(context);
    let provider_options: map = ctx_map(context, "provider_options");
    let guardian_options: map = ctx_map(provider_options, "guardian");
    let reviewer: string = ctx_string(settings, "reviewer", ctx_string(guardian_options, "reviewer", "guardian"));
    let allow_user_fallback: bool = ctx_bool(settings, "allow_user_fallback", ctx_bool(guardian_options, "allow_user_fallback", false));
    let mut result: map = { ok: false, code: "approval_failed", message: "Approval failed closed; no action was executed" };
    if reviewer == "user" {
        result = wait_for_user_approval(context, approval_id);
    } else if reviewer == "auto" {
        if created != 1 {
            let existing: map = agent::approval_storage("get", json_text_of({ run_id: ctx_string(context, "run_id", ""), approval_id: approval_id }));
            let data: map = ctx_map(existing, "result");
            let rows: array = ctx_array(data, "rows");
            let mut waiting: bool = false;
            if rows.length == 1 {
                let row: array = rows[0];
                if row.length >= 9 && row[7] == "pending" && row[8] == "human_pending" {
                    waiting = true;
                }
            }
            if waiting {
                result = wait_for_user_approval(context, approval_id);
            } else {
                result = { ok: false, code: "approval_review_in_progress", message: "existing guardian review is not repeated; no action was executed" };
            }
        } else {
            let tool_call_id: string = ctx_string(action, "tool_call_id", "");
            let tool_name: string = ctx_string(action, "tool_name", "");
            let mut review_action: map = action;
            review_action["_provider_step_key"] = "review:" + approval_id;
            let assessment: map = guardian::review(context, review_action);
            if ctx_string(assessment, "code", "") == "guardian_needs_user" {
                let handed: map = approval_handoff(context, approval_id, tool_call_id, tool_name);
                if ctx_bool(handed, "ok", false) {
                    result = wait_for_user_approval(context, approval_id);
                } else {
                    result = handed;
                }
            } else if ctx_bool(assessment, "ok", false) == false {
                let mut reason: string = ctx_string(assessment, "reason", "");
                if reason == "" {
                    reason = ctx_string(assessment, "code", "guardian_review_failed");
                }
                if resolve_approval(context, approval_id, "denied", reason) {
                    result = assessment;
                } else {
                    result = { ok: false, code: "approval_resolution_failed", message: "Guardian decision could not be durably recorded; no action was executed" };
                }
            } else if resolve_approval(context, approval_id, "approved", "guardian_allowed") {
                result = { ok: true, code: "guardian_allowed", message: "Guardian approved this exact action" };
            } else {
                result = { ok: false, code: "approval_resolution_failed", message: "Guardian approval could not be durably recorded; no action was executed" };
            }
        }
    } else {
        if reviewer != "guardian" {
            result = { ok: false, code: "reviewer_invalid", message: "configured approval reviewer is invalid; no action was executed" };
        } else {
            let mut review_action: map = action;
            review_action["_provider_step_key"] = "review:" + approval_id;
            let assessment: map = guardian::review(context, review_action);
            if ctx_string(assessment, "code", "") == "guardian_context_insufficient"
                && allow_user_fallback
                && ctx_bool(settings, "required", true) == false
            {
                result = wait_for_user_approval(context, approval_id);
            } else {
                if ctx_bool(assessment, "ok", false) == false {
                    let mut reason: string = ctx_string(assessment, "reason", "");
                    if reason == "" {
                        reason = ctx_string(assessment, "code", "guardian_review_failed");
                    }
                    let mut returned: map = assessment;
                    if reason == "guardian_needs_user" {
                        reason = "guardian_denied";
                        returned = { ok: false, code: "guardian_denied", message: "Guardian denied this action; no action was executed" };
                    }
                    if resolve_approval(context, approval_id, "denied", reason) {
                        result = returned;
                    } else {
                        result = { ok: false, code: "approval_resolution_failed", message: "Guardian decision could not be durably recorded; no action was executed" };
                    }
                } else {
                    if resolve_approval(context, approval_id, "approved", "guardian_allowed") {
                        result = { ok: true, code: "guardian_allowed", message: "Guardian approved this exact action" };
                    } else {
                        result = { ok: false, code: "approval_resolution_failed", message: "Guardian approval could not be durably recorded; no action was executed" };
                    }
                }
            }
        }
    }
    result
}

/// The managed publication as the plain map the durable protocol already
/// understands. The host publishes it as one logical `Option` slot.
fn publication_fields(publication: ManagedPublicationRef) -> map {
    let mut carried: map = {};
    carried.format = publication.format.copy();
    carried.effect_id = publication.effect_id.copy();
    carried.workspace_id = publication.workspace_id.copy();
    carried.branch_id = publication.branch_id.copy();
    carried.epoch = publication.epoch;
    carried.base_head = publication.base_head.copy();
    carried.base_head_version = publication.base_head_version;
    carried.observed_head = publication.observed_head.copy();
    carried.observed_head_version = publication.observed_head_version;
    carried.status = publication.status.copy();
    carried
}

fn publication_of(value: Option<ManagedPublicationRef>) -> map {
    match value {
        Some(publication) => publication_fields(publication),
        None => {}
    }
}

fn execute_pinned_dispatch(context: map, dispatch_input: map, facts: map) -> map {
    let action: map = ctx_map(facts, "action");
    let mut call: map = ctx_map(dispatch_input, "call");
    if ctx_bool(facts, "ok", false) {
        call.arguments = ctx_map(action, "arguments");
    }
    // The canonical arguments are the provider's own JSON text: the pinned
    // invocation compares that text's parsed object with the durable parent, so
    // re-encoding an empty map here would break both the digest and the
    // admission check. Only a call that carries no text at all is serialized
    // from its map by the host, and a call with neither stays empty.
    let mut canonical_arguments: string = "";
    if ctx_bool(facts, "ok", false) {
        canonical_arguments = ctx_string(action, "arguments_json", "");
    }
    if canonical_arguments == "" {
        canonical_arguments = call_arguments_json(call);
    }
    // Descriptor/approval resolution stays in this original harness. The
    // child needs the normalized call and bounded limits, not a second copy
    // of all six public schemas.
    let normalized_input: map = { call: call, config: ctx_map(dispatch_input, "config") };
    let canonical_input: string = json_text_of(normalized_input);
    let tool_metadata: map = ctx_map(facts, "metadata");
    let digest: string = canonical_arguments.copy();
    let tool_name: string = ctx_string(tool_metadata, "name", ctx_string(call, "name", ""));
    let call_id: string = ctx_string(tool_metadata, "call_id", ctx_string(call, "id", ""));
    let metadata: map = ctx_map(context, "metadata");
    let invoked: PinnedToolInvokeResult = agent_runtime::invoke_pinned_tool({
        tool_name: tool_name,
        call_id: call_id,
        canonical_arguments: canonical_arguments,
        canonical_input: canonical_input,
        run_id: ctx_string(context, "run_id", ""),
        registry_identity: ctx_string(metadata, "registry_identity", ""),
        argument_digest: digest,
        risk_class: ctx_string(tool_metadata, "risk_class", ""),
        summary: ctx_string(tool_metadata, "summary", tool_name),
        untrusted_graph_id: ""
    });
    let canonical_result: string = invoked.guest_result.copy();
    let mut result: map = tools::approval_failure(
        dispatch_input,
        invoked.code.copy(),
        invoked.message.copy()
    );
    if canonical_result.length > 0 {
        // The committed result is open JSON text; only the fields the public
        // envelope needs are declared, and its own `data` payload stays text.
        let decoded: HarnessToolResult = json::decode::<HarnessToolResult>(canonical_result);
        let projected: map = {
            ok: decoded.ok,
            content: decoded.content,
            data: decoded.data,
            truncated: decoded.truncated,
            artifacts: decoded.artifacts,
            error: match decoded.error { Some(failure) => { code: failure.code, message: failure.message }, None => { code: "", message: "" } }
        };
        if projected.has("ok") {
            result = tools::result_envelope(call, projected);
            let publication: map = publication_of(invoked.managed_publication);
            if publication.length > 0 {
                if ctx_string(publication, "format", "") == "agent.managed-effect/v1" {
                    result.managed_publication = publication;
                } else {
                    result = tools::approval_failure(dispatch_input, "managed_outcome_invalid", "Native managed publication format is invalid");
                }
            }
        }
    }
    result
}

fn dispatch_reviewed(context: map, call: map) -> map {
    let metadata: map = ctx_map(context, "metadata");
    let identity: string = ctx_string(metadata, "registry_identity", "");
    let dispatch_input: map = {
        call: call,
        registry: native_tools_from_context(context),
        registry_identity: identity,
        admitted_registry_identity: identity,
        run_id: ctx_string(context, "run_id", ""),
        session_id: ctx_string(context, "session_id", ""),
        created_at_ms: ctx_int(metadata, "created_at_ms", 0),
        deadline_at_ms: ctx_int(metadata, "deadline_at_ms", 0),
        config: ctx_map(context, "limits")
    };
    let facts: map = tools::approval_context(dispatch_input);
    let mut result: map = {};
    if ctx_bool(facts, "ok", false) == false {
        result = tools::dispatch(dispatch_input);
    } else {
        let tool_metadata: map = ctx_map(facts, "metadata");
        let replay: map = agent_runtime::tool_replay(json_text_of(tool_metadata));
        if ctx_bool(replay, "ok", false) == false {
            result = tools::approval_failure(
                dispatch_input,
                "tool_replay_failed",
                "tool replay validation failed; no action was executed"
            );
        } else {
            let replayed: bool = ctx_string(replay, "kind", "") == "replay";
            let tool_metadata: map = ctx_map(facts, "metadata");
            let action: map = ctx_map(facts, "action");
            let settings: map = approval_settings(context);
            let risk: string = ctx_string(tool_metadata, "risk_class", "");
            let mode: string = if risk == "read" => {
                ctx_string(settings, "read", "allow")
            } else => {
                if risk == "write" => {
                    ctx_string(settings, "write", "ask")
                } else => {
                    if risk == "execute" => {
                        ctx_string(settings, "process", "ask")
                    } else => {
                        "invalid"
                    }
                }
            };
            if replayed {
                result = execute_pinned_dispatch(context, dispatch_input, facts);
            } else if mode == "deny" {
                result = tools::approval_failure(
                    dispatch_input,
                    "approval_policy_denied",
                    "configured approval policy denied this action"
                );
            } else if mode == "allow" {
                if ctx_bool(facts, "review_required", false) {
                    let attested: map = agent_runtime::approval_attest(json_text_of(tool_metadata));
                    if ctx_bool(attested, "ok", false) {
                        result = execute_pinned_dispatch(context, dispatch_input, facts);
                    } else {
                        result = tools::approval_failure(
                            dispatch_input,
                            "approval_attestation_rejected",
                            "native policy facts rejected this action"
                        );
                    }
                } else {
                    result = execute_pinned_dispatch(context, dispatch_input, facts);
                }
            } else if mode == "ask" && ctx_bool(facts, "review_required", false) {
                let persisted: map = persist_approval_request(context, tool_metadata, action);
                if ctx_bool(persisted, "ok", false) == false {
                    let persist_code: string = ctx_string(persisted, "code", "approval_persist_failed");
                    let mut persist_message: string = "approval request could not be durably recorded; no action was executed";
                    if persist_code == "approval_preview_unavailable" {
                        persist_message = "action preview is unavailable; no action was executed and no approval was recorded";
                        if ctx_string(persisted, "reason", "") == "shell_eval" {
                            persist_message = "terminal argv uses an unpreviewable shell or eval form; no action was executed and no approval was recorded. Use a direct argv with empty stdin.";
                        }
                    }
                    if persist_code == "approval_terminal_uninformed" {
                        persist_message = "terminal actions cannot be approved in this chat without an informed preview; no action was executed and no approval was recorded";
                    }
                    result = tools::approval_failure(
                        dispatch_input,
                        persist_code,
                        persist_message
                    );
                } else {
                    let approval_id: string = ctx_string(persisted, "approval_id", "");
                    let mut decision_action: map = action;
                    decision_action["tool_call_id"] = ctx_string(tool_metadata, "call_id", "");
                    let decision: map = decide_approval(context, decision_action, approval_id, ctx_int(persisted, "created", 0));
                    if ctx_bool(decision, "ok", false) == false {
                        result = tools::approval_failure(
                            dispatch_input,
                            ctx_string(decision, "code", "guardian_review_failed"),
                            ctx_string(decision, "message", "Approval failed closed; no action was executed")
                        );
                    } else {
                        let attested: map = agent_runtime::approval_attest(json_text_of(tool_metadata));
                        if ctx_bool(attested, "ok", false) == false {
                            result = tools::approval_failure(
                                dispatch_input,
                                "approval_attestation_rejected",
                                "native approval facts changed; no action was executed"
                            );
                        } else {
                            result = execute_pinned_dispatch(context, dispatch_input, facts);
                        }
                    }
                }
            } else if mode == "ask" {
                result = tools::approval_failure(
                    dispatch_input,
                    "approval_risk_unsupported",
                    "the configured review mode is unsupported for this action"
                );
            } else {
                result = tools::approval_failure(
                    dispatch_input,
                    "approval_policy_invalid",
                    "configured approval policy is invalid"
                );
            }
        }
    }
    result
}

fn dispatch_serial(context: map, calls: array, max_tool_calls: int, tool_calls_used: int) -> map {
    let mut messages: array = [];
    let mut used: int = tool_calls_used;
    let mut i = 0;
    let mut failed: map = {};
    let mut stopped = false;
    while i < calls.length {
        if stopped == false {
            if used >= max_tool_calls {
                failed = failed_code(
                    "max_tool_calls",
                    "max_tool_calls exceeded",
                    0,
                    0,
                    used
                );
                stopped = true;
            } else {
                let checked = agent::control_check();
                let control: map = { ok: checked.ok, error: match checked.error { Some(failure) => { code: failure.code, message: failure.message }, None => { code: "control_contract_violation", message: "control_check reported a failure without a structured error" } } };
                if ctx_bool(control, "ok", false) == false {
                    failed = control_failed(control, 0, 0, used);
                    stopped = true;
                } else {
                    let call: map = array_map(calls, i);
                    let dispatched: map = dispatch_reviewed(context, call);
                    let checked_after = agent::control_check();
                    let after: map = { ok: checked_after.ok, error: match checked_after.error { Some(failure) => { code: failure.code, message: failure.message }, None => { code: "control_contract_violation", message: "control_check reported a failure without a structured error" } } };
                    messages[messages.length] = tool_result_message(ctx_map(dispatched, "content_block"));
                    used += 1;
                    if ctx_bool(dispatched, "ok", false) == false {
                        if ctx_bool(dispatched, "terminal", false) == true {
                            failed = run_failed_decision(
                                ctx_string(ctx_map(dispatched, "error"), "code", "tool_failed"),
                                ctx_string(ctx_map(dispatched, "error"), "message", "tool dispatch failed"),
                                0,
                                0,
                                used,
                                ctx_map(dispatched, "error")
                            );
                            stopped = true;
                        }
                    }
                    if ctx_bool(after, "ok", false) == false {
                        failed = control_failed(after, 0, 0, used);
                        stopped = true;
                    }
                }
            }
        }
        i += 1;
    }
    {
        messages: messages,
        tool_calls_used: used,
        stopped: stopped,
        failure: failed
    }
}

