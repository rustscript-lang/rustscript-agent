// ---------------------------------------------------------------------------
// Typed context accessors (same-module; defensive dynamic navigation)
// ---------------------------------------------------------------------------

fn ctx_string(value: map, key: string, fallback: string) -> string {
    let mut result: string = fallback;
    if value.has(key) {
        if type(value[key]) == "string" {
            let coerced: string = value[key];
            result = coerced;
        }
    }
    result
}

fn ctx_int(value: map, key: string, fallback: int) -> int {
    let mut result: int = fallback;
    if value.has(key) {
        if type(value[key]) == "int" {
            let coerced: int = value[key];
            result = coerced;
        }
    }
    result
}

fn ctx_bool(value: map, key: string, fallback: bool) -> bool {
    let mut result: bool = fallback;
    if value.has(key) {
        if type(value[key]) == "bool" {
            let coerced: bool = value[key];
            result = coerced;
        }
    }
    result
}

fn ctx_map(value: map, key: string) -> map {
    let mut result: map = {};
    if value.has(key) {
        if type(value[key]) == "map" {
            let coerced: map = value[key];
            result = coerced;
        }
    }
    result
}

fn ctx_array(value: map, key: string) -> array {
    let mut result: array = [];
    if value.has(key) {
        if type(value[key]) == "array" {
            let coerced: array = value[key];
            result = coerced;
        }
    }
    result
}

/// One entry from a dynamic array, or an empty map when the index is out of
/// range or the entry is not a map.
fn loop_array_entry(items: array, index: int) -> map {
    let mut result: map = {};
    if items.has(index) {
        if type(items[index].copy()) == "map" {
            let entry: map = items[index].copy();
            result = entry;
        }
    }
    result
}

// ---------------------------------------------------------------------------
// Decision builders
// ---------------------------------------------------------------------------

fn run_completed_decision(turn: int, text: string, messages: array) -> map {
    {
        kind: "run.completed",
        turn: turn,
        text: text,
        messages: messages
    }
}

fn run_failed_decision(turn: int, reason: string, error: map) -> map {
    { kind: "run.failed", turn: turn, reason: reason, error: error }
}

fn retry_decision(delay_ms: int, retry_count: int, turn: int, messages: array, last_text: string) -> map {
    {
        kind: "retry",
        delay_ms: delay_ms,
        retry_count: retry_count,
        turn: turn,
        messages: messages,
        last_text: last_text
    }
}

fn approval_wait_decision(
    call: map,
    risk_class: string,
    tool_calls: array,
    index: int,
    messages: array,
    turn: int,
    last_text: string
) -> map {
    {
        kind: "approval.wait",
        approval: {
            approval_id: "",
            tool_call_id: types::request_string(call, "id"),
            tool_name: types::request_string(call, "name"),
            arguments: types::request_map(call, "arguments"),
            risk_class: risk_class
        },
        tool_calls: tool_calls,
        tool_index: index,
        messages: messages,
        turn: turn,
        last_text: last_text
    }
}

fn compact_decision(plan: map, messages: array, turn: int, last_text: string) -> map {
    {
        kind: "compact",
        plan: plan,
        messages: messages,
        turn: turn,
        retry_count: 0,
        last_text: last_text
    }
}

fn rejected_decision(code: string, message: string, turn: int) -> map {
    { kind: "rejected", code: code, message: message, turn: turn }
}

/// A6 handoff: when parallel/task execution is requested, the serial loop
/// does not execute it and never invents a parallel/subagent outcome — it
/// defers with a typed, non-executable handoff decision (the A6 native
/// supervisor needs the A7 run-admission interface to drive real child
/// runs).
fn handoff_decision(phase: string, capability: string, parent_run_id: string, turn: int, message: string) -> map {
    {
        kind: phase,
        capability: capability,
        parent_run_id: parent_run_id,
        turn: turn,
        message: message,
        executable: false,
        blocked_reason: "the serial loop defers parallel/subagent execution to the dedicated native supervisor; it cannot itself advertise a parallel or subagent result",
        events: []
    }
}

// ---------------------------------------------------------------------------
// Retry classification and backoff
// ---------------------------------------------------------------------------

/// Typed ProviderError classification: rate limits (429), request timeouts
/// (408), server errors (5xx), and the canonical `rate_limit_error` /
/// `server_error` error types are retryable; everything else (including the
/// typed `invalid_request_error` family) is not.
fn error_is_retryable(error: map) -> bool {
    let status: int = ctx_int(error, "status", 0);
    let error_type: string = ctx_string(error, "type", "");
    let mut retryable = false;
    if status == 429 {
        retryable = true;
    }
    if status == 408 {
        retryable = true;
    }
    if status >= 500 {
        if status <= 599 {
            retryable = true;
        }
    }
    if error_type == "rate_limit_error" {
        retryable = true;
    }
    if error_type == "server_error" {
        retryable = true;
    }
    retryable
}

/// Exponential backoff for the attempt AFTER `retry_count` failures:
/// `min(max(base, 0) * 2^retry_count, max(cap, 0))` with defined edge
/// semantics (clamp, saturate, terminate for any i64 inputs).
fn backoff_delay_ms(base: int, retry_count: int, cap: int) -> int {
    let mut delay: int = base;
    let mut ceiling: int = cap;
    if delay < 0 {
        delay = 0;
    }
    if ceiling < 0 {
        ceiling = 0;
    }
    if delay > ceiling {
        delay = ceiling;
    }
    let mut step = 0;
    while step < retry_count {
        if delay >= ceiling || delay == 0 {
            break;
        }
        if delay > ceiling / 2 {
            delay = ceiling;
        } else {
            delay = delay * 2;
        }
        step += 1;
    }
    delay
}

// ---------------------------------------------------------------------------
// Canonical request construction
// ---------------------------------------------------------------------------

/// Tool descriptors from the A4 bounded registry (name, description,
/// schema_json) — the model-facing tool list.
fn request_tool_descriptors() -> array {
    let mut tools: array = [];
    tools[tools.length] = registry_tool_descriptor("file.read");
    tools[tools.length] = registry_tool_descriptor("file.write");
    tools[tools.length] = registry_tool_descriptor("patch.apply");
    tools[tools.length] = registry_tool_descriptor("terminal.run");
    tools
}

/// One registry descriptor converted to the canonical request tool shape.
fn registry_tool_descriptor(name: string) -> map {
    let descriptor: map = registry_describe(name);
    {
        name: name,
        description: types::request_string(descriptor, "description"),
        schema_json: types::request_string(descriptor, "schema_json")
    }
}

fn registry_describe(name: string) -> map {
    let result: map = registry_run({ op: "describe", tool_name: name });
    ctx_map(result, "descriptor")
}

/// Prepends the system prompt as a system message when present.
fn messages_with_system(messages: array, system_prompt: string) -> array {
    let mut result: array = messages;
    if system_prompt != "" {
        let mut with_system: array = [];
        with_system[with_system.length] = {
            role: "system",
            content: [{ type: "text", text: system_prompt }]
        };
        let mut index = 0;
        while index < messages.length {
            with_system[with_system.length] = messages[index].copy();
            index += 1;
        }
        result = with_system;
    }
    result
}

/// Builds the canonical LlmRequest (rss/llm/types.rss shape) from the loop
/// context: model, messages (with system prompt, ordinals stripped), registry
/// tools, sampling, stream flag, and provider_options.
fn build_request(context: map, messages: array) -> map {
    let config: map = ctx_map(context, "config");
    {
        model: ctx_string(context, "model", ""),
        messages: messages_with_system(request_messages(messages), ctx_string(context, "system_prompt", "")),
        tools: request_tool_descriptors(),
        tool_choice: "auto",
        reasoning: "",
        sampling: { temperature: null, top_p: null },
        max_output_tokens: ctx_int(config, "max_output_tokens", 1024),
        stream: ctx_bool(config, "stream", true),
        provider_options: ctx_map(context, "provider_options")
    }
}

/// Strips the internal `ordinal` field from the loop's message entries — the
/// canonical request carries only `{role, content}`.
fn request_messages(messages: array) -> array {
    let mut request: array = [];
    let mut index = 0;
    while index < messages.length {
        let entry: map = loop_array_entry(messages, index);
        request[request.length] = {
            role: types::request_string(entry, "role"),
            content: types::request_array(entry, "content")
        };
        index += 1;
    }
    request
}

/// The next internal ordinal for an appended message (max in-run ordinal +
/// 1, or 1 for an empty list). Ordinals mirror the durable session message
/// ordinals so compaction plans reference real rows.
fn next_ordinal(messages: array) -> int {
    let mut ordinal: int = 0;
    let mut index = 0;
    while index < messages.length {
        let entry: map = loop_array_entry(messages, index);
        let entry_ordinal: int = ctx_int(entry, "ordinal", 0);
        if entry_ordinal > ordinal {
            ordinal = entry_ordinal;
        }
        index += 1;
    }
    ordinal + 1
}

/// Builds the adapter profile for direct adapter dispatch from the
/// provider_options; profile modules merge these overrides themselves.
fn build_profile(provider: string, options: map) -> map {
    {
        provider: provider,
        base_url: types::request_string(options, "base_url"),
        api_key: types::request_string(options, "api_key"),
        model: types::request_string(options, "model"),
        adapter: types::request_string(options, "adapter"),
        capabilities: types::request_map(options, "capabilities")
    }
}

/// Dispatches one provider call by name to the completed adapters / profile
/// modules. Cross-module calls live in expression-if branches (the pinned
/// core's documented layout for this module graph).
fn provider_call(request: map, provider: string, profile: map) -> map {
    if provider == "openai_chat" => {
        openai_chat::openai_chat_call(request, profile)
    } else if provider == "openai_responses" => {
        openai_responses::openai_responses_call(request, profile)
    } else if provider == "anthropic_messages" => {
        anthropic_messages::anthropic_messages_call(request, profile)
    } else if provider == "openrouter" => {
        openrouter::call(request)
    } else if provider == "deepseek" => {
        deepseek::call(request)
    } else if provider == "opencode_zen" => {
        opencode_zen::call(request)
    } else if provider == "opencode_go" => {
        opencode_go::call(request)
    } else if provider == "custom" => {
        custom::call(request)
    } else => {
        types::fail(types::error_request("unknown_provider", provider))
    }
}

// ---------------------------------------------------------------------------
// Phase handlers
// ---------------------------------------------------------------------------

/// Phase "start": bounded by max_turns; at a turn boundary (retry_count 0)
/// the compaction gate runs first, then `model.started` + the provider call.
fn start_phase(context: map) -> map {
    let turn: int = ctx_int(context, "turn", 0);
    let max_turns: int = ctx_int(context, "max_turns", 1);
    let retry_count: int = ctx_int(context, "retry_count", 0);
    let last_text: string = ctx_string(context, "last_text", "");
    let mut decision: map = run_completed_decision(turn, last_text, ctx_array(context, "messages"));
    if turn < max_turns {
        if retry_count == 0 {
            decision = start_turn(context, turn, max_turns, last_text);
        } else {
            decision = provider_attempt(context, turn, max_turns, retry_count, last_text);
        }
    }
    decision
}

/// First attempt of a turn: the durable compaction gate, then the provider
/// call.
fn start_turn(context: map, turn: int, max_turns: int, last_text: string) -> map {
    let messages: array = ctx_array(context, "messages");
    let config: map = ctx_map(context, "config");
    let window: int = ctx_int(config, "max_context_messages", 0);
    let compact_needed: bool = window >= 1 && messages.length > window;
    if compact_needed => {
        compact_plan_decision(context, turn, last_text)
    } else => {
        provider_attempt(context, turn, max_turns, 0, last_text)
    }
}

/// One provider attempt for the current turn: `model.started` on the first
/// attempt only, canonical request, adapter call, typed result handling.
fn provider_attempt(context: map, turn: int, max_turns: int, retry_count: int, last_text: string) -> map {
    if retry_count == 0 {
        stream::emit({
            type: "model.started",
            turn: turn,
            model: ctx_string(context, "model", "")
        });
    }
    let provider: string = ctx_string(context, "provider", "");
    let options: map = ctx_map(context, "provider_options");
    let missing_base: bool = direct_adapter(provider) && types::request_string(options, "base_url") == "";
    let mut decision: map = run_failed_decision(
        turn,
        "non_retryable",
        types::error_request(
            "missing_base_url",
            "provider options must carry base_url for the direct adapter " + provider
        )
    );
    if missing_base == false {
        let request: map = build_request(context, ctx_array(context, "messages"));
        let result: map = provider_call(request, provider, build_profile(provider, options));
        decision = provider_result(context, turn, max_turns, retry_count, result, last_text);
    }
    decision
}

/// Direct adapters require `provider_options.base_url`; profile modules
/// carry their own endpoint metadata.
fn direct_adapter(provider: string) -> bool {
    provider == "openai_chat" || provider == "openai_responses" || provider == "anthropic_messages"
}

/// Handles the typed `{ok, response, error}` call result.
fn provider_result(context: map, turn: int, max_turns: int, retry_count: int, result: map, last_text: string) -> map {
    let ok_flag: bool = ctx_bool(result, "ok", false);
    let mut decision: map = run_failed_decision(
        turn,
        "non_retryable",
        types::error_request("malformed_provider_result", "provider call result is not decidable")
    );
    if ok_flag == true {
        decision = provider_ok_result(context, turn, max_turns, retry_count, result, last_text);
    } else {
        decision = provider_error_result(context, turn, retry_count, result, last_text);
    }
    decision
}

/// Success path: canonical `model.delta` + `model.completed`; text-only
/// completes the run (the final assistant message is service-owned), tool
/// calls enter the tool cycle with the assistant message appended.
fn provider_ok_result(context: map, turn: int, max_turns: int, retry_count: int, result: map, last_text: string) -> map {
    let response: map = ctx_map(result, "response");
    let text: string = types::request_string(response, "text");
    let tool_calls: array = types::request_array(response, "tool_calls");
    let config: map = ctx_map(context, "config");
    stream::emit({
        type: "model.delta",
        turn: turn,
        delta: text,
        stream: ctx_bool(config, "stream", true)
    });
    stream::emit({
        type: "model.completed",
        turn: turn,
        text: text,
        tool_calls: tool_calls.length
    });
    let mut decision: map = run_completed_decision(turn + 1, text, ctx_array(context, "messages"));
    if tool_calls.length > 0 {
        let mut messages: array = ctx_array(context, "messages");
        messages[messages.length] = assistant_message(next_ordinal(messages), text, tool_calls.copy());
        decision = tool_cycle(context, turn, messages, tool_calls, 0, last_text);
    }
    decision
}

/// Error path: typed retry/backoff or typed terminal failure.
fn provider_error_result(context: map, turn: int, retry_count: int, result: map, last_text: string) -> map {
    let error: map = ctx_map(result, "error");
    let max_retries: int = ctx_int(context, "max_retries", 2);
    let mut decision: map = run_failed_decision(turn, "non_retryable", error);
    if !error_is_retryable(error) {
        decision = run_failed_decision(turn, "non_retryable", error);
    } else if retry_count >= max_retries {
        decision = run_failed_decision(turn, "max_retries_exceeded", error);
    } else {
        let config: map = ctx_map(context, "config");
        let base: int = ctx_int(config, "base_retry_delay_ms", 1000);
        let cap: int = ctx_int(config, "max_retry_delay_ms", 30000);
        let delay: int = backoff_delay_ms(base, retry_count, cap);
        decision = retry_decision(delay, retry_count + 1, turn, ctx_array(context, "messages"), last_text);
    }
    decision
}

/// One canonical assistant message: internal ordinal, text part plus one
/// `tool_call` part per requested call.
fn assistant_message(ordinal: int, text: string, tool_calls: array) -> map {
    let mut parts: array = [];
    if text != "" {
        parts[parts.length] = { type: "text", text: text };
    }
    let mut index = 0;
    while index < tool_calls.length {
        let call: map = loop_array_entry(tool_calls, index);
        let arguments: map = types::request_map(call, "arguments");
        parts[parts.length] = {
            type: "tool_call",
            tool_call_id: types::request_string(call, "id"),
            name: types::request_string(call, "name"),
            arguments_json: encode_json(arguments)
        };
        index += 1;
    }
    { ordinal: ordinal, role: "assistant", content: parts }
}

// ---------------------------------------------------------------------------
// Tool cycle
// ---------------------------------------------------------------------------

/// Processes one tool call per step: registry -> approval -> dispatch (or
/// typed denial / approval.wait); after the last call the loop continues
/// with the next turn inline. The continuation is NOT evaluated eagerly —
/// the cycle decision must be produced first (an eager default would recurse
/// into the next turn before dispatching the current call).
fn tool_cycle(context: map, turn: int, messages: array, tool_calls: array, index: int, last_text: string) -> map {
    let mut decision: map = rejected_decision("tool_cycle_invalid", "tool cycle state is not decidable", turn);
    if index < tool_calls.length {
        decision = tool_step(context, turn, messages, tool_calls, index, last_text);
    } else {
        decision = continue_next_turn(context, turn, messages, last_text);
    }
    decision
}

fn tool_step(context: map, turn: int, messages: array, tool_calls: array, index: int, last_text: string) -> map {
    let call: map = loop_array_entry(tool_calls, index);
    let name: string = types::request_string(call, "name");
    let call_id: string = types::request_string(call, "id");
    stream::emit({ type: "tool.started", tool_call_id: call_id, name: name, turn: turn });
    let registry_result: map = registry_run({ op: "describe", tool_name: name });
    let mut decision: map = run_failed_decision(
        turn,
        "non_retryable",
        types::error_request("tool_registry_unavailable", name)
    );
    if ctx_bool(registry_result, "ok", false) == true {
        decision = approval_step(context, turn, messages, tool_calls, index, call, registry_result, last_text);
    } else {
        let code: string = types::request_string(registry_result, "code");
        decision = tool_result_step(
            context,
            turn,
            messages,
            tool_calls,
            index,
            call,
            true,
            code + ": no bounded capability is registered for this tool",
            last_text
        );
    }
    decision
}

/// Approval policy: approve -> real dispatch; deny -> typed denial; pending
/// -> `approval.required` + `approval.wait` (the durable bridge persists and
/// the service parks the run).
fn approval_step(context: map, turn: int, messages: array, tool_calls: array, index: int, call: map, registry_result: map, last_text: string) -> map {
    let config: map = ctx_map(context, "config");
    let descriptor: map = ctx_map(registry_result, "descriptor");
    let name: string = types::request_string(call, "name");
    let risk: string = types::request_string(descriptor, "risk_class");
    let decision_result: map = approval_run({
        op: "decide",
        tool_name: name,
        risk_class: risk,
        approval_mode: ctx_string(config, "approval_mode", "auto"),
        native_hard_deny: ctx_bool(config, "native_hard_deny", false)
    });
    let action: string = approval_action(decision_result);
    let mut decision: map = run_failed_decision(
        turn,
        "non_retryable",
        types::error_request("approval_policy_unavailable", name)
    );
    if action == "approve" {
        decision = tool_dispatch(context, turn, messages, tool_calls, index, call, true, "", last_text);
    } else if action == "deny" {
        decision = tool_dispatch(
            context,
            turn,
            messages,
            tool_calls,
            index,
            call,
            false,
            "approval policy denied " + name,
            last_text
        );
    } else {
        let call_id: string = types::request_string(call, "id");
        stream::emit({
            type: "approval.required",
            approval_id: "",
            tool_call_id: call_id,
            tool_name: name,
            risk_class: risk,
            turn: turn
        });
        decision = approval_wait_decision(call, risk, tool_calls, index, messages, turn, last_text);
    }
    decision
}

/// The policy action from the approval decision envelope.
fn approval_action(decision_result: map) -> string {
    let decision: map = ctx_map(decision_result, "decision");
    ctx_string(decision, "action", "deny")
}

/// A typed `is_error` tool result for a call the registry cannot dispatch
/// (unknown tool): the model sees the typed failure and the loop continues.
fn tool_result_step(context: map, turn: int, messages: array, tool_calls: array, index: int, call: map, approved: bool, reason: string, last_text: string) -> map {
    let name: string = types::request_string(call, "name");
    let call_id: string = types::request_string(call, "id");
    let result: map = if approved == true => {
        { ok: false, code: "unknown_tool", message: reason, tool: name }
    } else => {
        typed_denial(name, reason)
    };
    let content: string = tool_result_content(result, true);
    stream::emit({
        type: "tool.completed",
        tool_call_id: call_id,
        name: name,
        ok: false,
        turn: turn
    });
    let mut updated: array = messages;
    updated[updated.length] = {
        ordinal: next_ordinal(messages),
        role: "tool",
        content: [{
            type: "tool_result",
            tool_call_id: call_id,
            content: content,
            is_error: true
        }]
    };
    tool_cycle(context, turn, updated, tool_calls, index + 1, last_text)
}

/// Dispatches one call (approved) or produces the typed denial (denied /
/// expired), appends the canonical tool message, and continues the cycle.
fn tool_dispatch(context: map, turn: int, messages: array, tool_calls: array, index: int, call: map, approved: bool, reason: string, last_text: string) -> map {
    let name: string = types::request_string(call, "name");
    let call_id: string = types::request_string(call, "id");
    let result: map = if approved == true => {
        execute_tool(name, types::request_map(call, "arguments"))
    } else => {
        typed_denial(name, reason)
    };
    let is_error: bool = !ctx_bool(result, "ok", false);
    let content: string = tool_result_content(result, is_error);
    stream::emit({
        type: "tool.completed",
        tool_call_id: call_id,
        name: name,
        ok: !is_error,
        turn: turn
    });
    let mut updated: array = messages;
    updated[updated.length] = {
        ordinal: next_ordinal(messages),
        role: "tool",
        content: [{
            type: "tool_result",
            tool_call_id: call_id,
            content: content,
            is_error: is_error
        }]
    };
    tool_cycle(context, turn, updated, tool_calls, index + 1, last_text)
}

/// The typed denial/expiry tool result: `is_error` with the typed reason —
/// never a fabricated success.
fn typed_denial(name: string, reason: string) -> map {
    {
        ok: false,
        code: "approval_denied",
        message: reason,
        tool: name
    }
}

/// Serializes one tool result map into the canonical tool_result content.
/// `json::encode`'s return type is unknown to the checker, so the annotated
/// local lives here with a declared `string` return.
fn tool_result_content(result: map, is_error: bool) -> string {
    let mut payload: map = result;
    if is_error {
        payload["is_error"] = true;
    }
    let encoded: string = json::encode(payload);
    encoded
}

/// `json::encode` bridge with a declared return type.
fn encode_json(value: map) -> string {
    let encoded: string = json::encode(value);
    encoded
}

/// Bounded capability dispatch by tool name (cross-module harness calls in
/// expression-if branches). The terminal gap (core `io::popen` lacks a
/// per-invocation timeout and argv form) is returned as a typed
/// `capability_unavailable` result — never fabricated success.
fn execute_tool(name: string, arguments: map) -> map {
    if name == "file.read" => {
        file_run({
            op: "read",
            path: types::request_string(arguments, "path"),
            max_bytes: 0
        })
    } else if name == "file.write" => {
        file_run({
            op: "write",
            path: types::request_string(arguments, "path"),
            content: types::request_string(arguments, "content")
        })
    } else if name == "patch.apply" => {
        patch_run({
            op: "apply",
            path: types::request_string(arguments, "path"),
            from: types::request_string(arguments, "from"),
            to: types::request_string(arguments, "to")
        })
    } else if name == "terminal.run" => {
        terminal_run({
            op: "run",
            command: types::request_string(arguments, "command"),
            timeout_ms: types::request_int(arguments, "timeout_ms", 0)
        })
    } else => {
        {
            ok: false,
            code: "unknown_tool",
            message: "no bounded capability is registered for this tool"
        }
    }
}

/// Rebuilds the context for the next turn and continues the loop inline —
/// the turn budget is enforced here (the next provider round only starts
/// while `next_turn < max_turns`).
fn continue_next_turn(context: map, turn: int, messages: array, last_text: string) -> map {
    let next_turn: int = turn + 1;
    let max_turns: int = ctx_int(context, "max_turns", 1);
    let mut decision: map = run_completed_decision(next_turn, last_text, messages);
    if next_turn < max_turns {
        let mut next_context: map = context;
        next_context["turn"] = next_turn;
        next_context["retry_count"] = 0;
        next_context["messages"] = messages;
        next_context["last_text"] = last_text;
        decision = start_turn(next_context, next_turn, max_turns, last_text);
    }
    decision
}

// ---------------------------------------------------------------------------
// Approval resume
// ---------------------------------------------------------------------------

/// Phase "approval.resume": the durable bridge resolved exactly once. The
/// pending call is dispatched when approved, or folded into a typed
/// `is_error` tool result when denied/expired; the cycle then continues.
fn approval_resume_phase(context: map) -> map {
    let approval: map = ctx_map(context, "approval");
    let tool_calls: array = ctx_array(context, "tool_calls");
    let index: int = ctx_int(context, "tool_index", 0);
    let turn: int = ctx_int(context, "turn", 0);
    let messages: array = ctx_array(context, "messages");
    let last_text: string = ctx_string(context, "last_text", "");
    let approval_id: string = types::request_string(approval, "approval_id");
    let call_id: string = types::request_string(approval, "tool_call_id");
    let resolved: bool = ctx_bool(approval, "resolved", false);
    let reason: string = types::request_string(approval, "reason");
    stream::emit({
        type: "approval.resolved",
        approval_id: approval_id,
        tool_call_id: call_id,
        resolved: resolved,
        reason: reason,
        turn: turn
    });
    let call: map = loop_array_entry(tool_calls, index);
    let mut decision: map = rejected_decision("approval_mismatch", "resume tool call does not match the pending approval", turn);
    if types::request_string(call, "id") == call_id {
        decision = tool_dispatch(context, turn, messages, tool_calls, index, call, resolved, reason, last_text);
    }
    decision
}

// ---------------------------------------------------------------------------
// Durable compaction
// ---------------------------------------------------------------------------

/// Plans a compaction from the DB-resident portion of the in-run message
/// list (entries whose internal ordinals mirror durable session rows) when
/// the history exceeds the configured window, and yields the `compact`
/// decision carrying the typed A2 command sequence. The SERVICE executes the
/// plan commands (compaction.start -> message.compact -> compaction.commit,
/// or compaction.fail on any typed rejection) — script-to-script construction
/// of the A2 `StorageCommand` struct is blocked by a core gap (see
/// plans/2026-08-15_a5-production-serial-loop.md and the core repro fixture);
/// executing the RSS-planned typed commands is durable sequencing, the
/// service's ownership lane.
fn compact_plan_decision(context: map, turn: int, last_text: string) -> map {
    let config: map = ctx_map(context, "config");
    let session_id: string = ctx_string(context, "session_id", "");
    let run_id: string = ctx_string(context, "run_id", "");
    let messages: array = ctx_array(context, "messages");
    let generation: int = ctx_int(config, "generation", 0);
    let compact_context: map = {
        session_id: session_id,
        run_id: run_id,
        compaction_id: ctx_string(config, "compaction_id", ""),
        generation: generation,
        messages: db_resident_messages(messages, ctx_int(config, "message_count", 0)),
        config: {
            max_context_messages: ctx_int(config, "max_context_messages", 0),
            retained_tail: ctx_int(config, "retained_tail", 0),
            now_ms: ctx_int(config, "now_ms", 0),
            model: ctx_string(context, "model", ""),
            token_estimate: 0
        }
    };
    let plan: map = compact_run(compact_context);
    if ctx_string(plan, "kind", "") == "compact.plan" => {
        stream::emit({ type: "compact.started", turn: turn });
        compact_decision(plan, messages, turn, last_text)
    } else => {
        provider_attempt(context, turn, ctx_int(context, "max_turns", 1), 0, last_text)
    }
}

/// The DB-resident portion of the in-run message list: entries whose
/// internal ordinal does not exceed the durable message count carried by the
/// service. The compaction plan must only reference rows that exist in the
/// session's message table (the A2 start guard verifies the range endpoints).
fn db_resident_messages(messages: array, message_count: int) -> array {
    let mut resident: array = [];
    let mut index = 0;
    while index < messages.length {
        let entry: map = loop_array_entry(messages, index);
        let ordinal: int = ctx_int(entry, "ordinal", 0);
        if ordinal >= 1 {
            if ordinal <= message_count {
                resident[resident.length] = entry;
            }
        }
        index += 1;
    }
    resident
}

/// Phase "compact.result": the service executed the planned commands. On
/// success the compacted prefix is trimmed from the in-run list; on failure
/// the full history is retained (the typed failure was recorded durably).
/// Either way the loop continues with the provider call.
fn compact_result_phase(context: map) -> map {
    let plan: map = ctx_map(context, "plan");
    let ok_flag: bool = ctx_bool(context, "compact_ok", false);
    let error: string = ctx_string(context, "compact_error", "");
    let messages: array = ctx_array(context, "messages");
    let turn: int = ctx_int(context, "turn", 0);
    let last_text: string = ctx_string(context, "last_text", "");
    stream::emit({
        type: "compact.completed",
        ok: ok_flag,
        error: error,
        turn: turn
    });
    let mut next_context: map = context;
    if ok_flag {
        next_context["messages"] = compact_trim(messages, plan);
    }
    provider_attempt(next_context, turn, ctx_int(context, "max_turns", 1), 0, last_text)
}

/// Trims the compacted prefix from the in-run message list (the plan's
/// `count`, decoded from the struct summary).
fn compact_trim(messages: array, plan: map) -> array {
    let summary: map = json::decode(ctx_string(plan, "summary_json", "{}"));
    let count: int = ctx_int(summary, "count", 0);
    let mut trimmed: array = [];
    let mut index = count;
    while index < messages.length {
        trimmed[trimmed.length] = messages[index].copy();
        index += 1;
    }
    trimmed
}

// ---------------------------------------------------------------------------
// Entry
// ---------------------------------------------------------------------------
//
// The exported entry is `agent_run`, NOT `run`: every imported harness /
// storage module also exports `run`, and the pinned core flattens ALL merged
// modules' exported callables into one name-keyed table
// (`Program::exported_callables`, `Vm::resolve_exported_callable`), so a
// multi-module program cannot expose a root entry named `run` without
// resolving to an arbitrary module's function. This is a documented core gap
// (see plans/2026-08-15_a5-production-serial-loop.md and the
// `a5-core-repros` fixtures); the embedding resolves the unique
// `agent_run` entry for the production loop.

pub fn agent_run(context: map) -> map {
    let phase: string = ctx_string(context, "phase", "start");
    let run_id: string = ctx_string(context, "run_id", "");
    let turn: int = ctx_int(context, "turn", 0);
    let config: map = ctx_map(context, "config");
    let parallel: bool = ctx_bool(config, "parallel", false);
    let task: bool = ctx_bool(config, "task", false);
    let mut decision: map = rejected_decision("unknown_phase", "run phase is not recognized by the serial loop", turn);
    if parallel == true {
        decision = handoff_decision(
            "parallel.handoff",
            "parallel.plan",
            run_id,
            turn,
            "parallel orchestration requested; the serial loop defers to the A6 parallel policy (parallel.rss)"
        );
    } else if task == true {
        decision = handoff_decision(
            "subagent.handoff",
            "subagent.admit",
            run_id,
            turn,
            "task delegation requested; the serial loop defers to the A6 subagent policy (subagents.rss)"
        );
    } else if phase == "start" {
        decision = start_phase(context);
    } else if phase == "approval.resume" {
        decision = approval_resume_phase(context);
    } else if phase == "compact.result" {
        decision = compact_result_phase(context);
    }
    decision
}
